#include "dkli.dkh"
#!
program "instalador"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "dbr.dkh"

    TableExist::&db,table
    {
        table >> p
        name_table=dbr.str(db,"SHOW TABLES LIKE '"+table+"';",p)
        return trim(name_table)!=""
    }
    // Archivos de datos iniciales (Orden de importación)
    // deben estar en la carpeta _install/initial_data
    ref @files_to_import = from.json('[
        "cclaseproducto.csv",
        "cmetodosvaluacion.csv",
        "ctipoproducto.csv",
        "ctiposcomisionesproducto.csv",
        "cformacomisionproducto.csv",
        "cimpadicionales.csv",
        "almacen.csv",
        "cproduccion.csv",
        "linea.csv",
        "divisa.csv",
        "dmnszona.csv",
        "cstatusordenproduccion.csv",
        "ccantidades.csv"
    ]')

    // Lista de privilegios iniciales (arreglo de id de privilegios)
    ref @permissions_to_import = from.json('[]')

    // Id del grupo de tareas (recomendado: prefijo del paquete), si se omite se calculará automáticamente.
    // https://docs.induxsoft.net/es/productos/v12/devops/official-v12-packs.dkl
    /**
    * Los programas deben estar en la ruta: _install\tasks
    * Ejemplo:
    * _install\tasks
    *    - importar.productos.dkl -> Archivo de programa
    *    - importar.productos.json -> Configuración de parámetros del archivo de programas
    */
    @jobs_group_id = "CA"
    
    /*************************************************************************************/
    #include "v12.install.lib.dk"
    if not(isset("database"))
    {
        do print("No se encontró la variable 'database'")
        return
    }
    if not(dbr.is_open(database)){ref database=dbr.open(qname)}
    do reconnect(database,qname)

    path_initial_data="alibeb/_install/initial_data/"
    file_views=path.concat(path_initial_data,"views.sql")

    if file.exists(file_views)
    {
        do print("Creando vistas de la base de datos")
        do dbr.execute(database,file.rtext(file_views),@null)
    }

    if not(TableExist(database,"cconsumo_cproduccion_")){do print("No se insertó datos en la tabla 'cconsumo_cproduccion_' se requiere el paquete 'catfab' ")}
    else
    {
        //cconsumo prdeterminada
        cconsumo=dbr.num(database,"select sys_pk from cconsumo where sys_guid='0DB65C0695344B38B89524D528009020'",@null)
        if cconsumo > 0
        {
            cprod_cocina=dbr.num(database,"select sys_pk from cproduccion where sys_guid='D23F782846974D11B36BB98B847C3856'",@null)
            cprod_barra=dbr.num(database,"select sys_pk from cproduccion where sys_guid='16301B7CB6D64BB086B0C3663B14985B'",@null)
            
            cconsumo,cprod_cocina,cprod_barra >> p
            if cprod_cocina > 0 && dbr.num(database,"select count(*) from cconsumo_cproduccion_ where icproduccion=@cprod_cocina and iconsumo=@cconsumo",p) < 1
            {
                do print("Insertando centro de consumo y centro de produción 'COCINA' ")
                new _cccp
                {
                    @"sys_timestamp*":now()
                    @"icproduccion":cprod_cocina
                    @"iconsumo":cconsumo
                }
                do dbr.vars.save(database,"cconsumo_cproduccion_",_cccp)
            }
            
            if cprod_barra > 0 && dbr.num(database,"select count(*) from cconsumo_cproduccion_ where icproduccion=@cprod_barra and iconsumo=@cconsumo",p) < 1
            {
                do print("Insertando centro de consumo y centro de produción 'BARRA' ")
                new _cccp
                {
                    @"sys_timestamp*":now()
                    @"icproduccion":cprod_barra
                    @"iconsumo":cconsumo
                }
                do dbr.vars.save(database,"cconsumo_cproduccion_",_cccp)
            }

        }
    }
    

    exception
    {
        do print("Error: "+last_error())
    }

    do dbr.close(database)
}