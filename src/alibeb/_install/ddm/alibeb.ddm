#include "ddm.dkh"
model "alibeb"
{
    /** 
    alimentos y bebidas
    =======================================================================
    */
	#include "induxsoft.abstracts.ddm"

    abstract "NmModel"
    {
        @"sys_pk" int key required autoincrement
        @"sys_timestamp" datetime required
        @"sys_recver" int
        @"sys_deleted" bool
        @"sys_lock" int
    }
    wide compatibility
    entity "ccantidades" : "EnumModel" {}
    entity "cstatusordenproduccion" : "EnumModel" {}
    entity "divisa" : "TableModel" {}
    entity "producto" : "TableModel" {}
    entity "agente" : "TableModel" {}
	entity "cclaseproducto" : "EnumModel" {}
    entity "cformacomisionproducto" : "EnumModel" {}
    entity "ctipoproducto" : "EnumModel" {}
    entity "cmetodosvaluacion" : "EnumModel" {}
    entity "ctiposcomisionesproducto" : "EnumModel" {}
    entity "ctasasiva" : "EnumModel" {}
    entity "cimpadicionales" : "EnumModel" {}
    entity "cconsumo" : "TableModel" {}
    entity "venta" : "TableModel" {}
    entity "clase_almacen" : "EnumModel"
    {
        // 0-"Almacén de propósito general"
        // 1-"Almacén vinculado a otro elemento de datos"
        // 2-"Almacén virtual o imaginario"
    }
    /* uod.dmnsasignbarra */
    entity "dmnsasignbarra"
    {
        @"sys_pk" int key required autoincrement
        @"tipo" int
        @"fk" int
        @"fkbarra" int
        @"auto" int
    }
    /* uod.dmnsbarra */
    entity "dmnsbarra"
    {
        @"sys_pk" int key required autoincrement
        @"nombre" string(50)
        @"tipo" int
        @"opciones" memo
    }
    /* uod.cconsumo_cproduccion_ */
    entity "cconsumo_cproduccion_" : "NmModel"
    {
        @"icproduccion" ref:"cproduccion" required
        @"iconsumo" ref:"cconsumo" required
    }
    //configuración de la terminal de meseros
    entity "ut_dm_tmm_gprn"
    {
        @"id" string(32) key unique required
        @"data" memo
    }
    
    entity "ut_dm_tmm_cgprn"
    {
        @"id" string(32) key unique required
        @"ref_cprod" ref:"cproduccion" required
        @"ref_gprn" ref:"ut_dm_tmm_gprn" required
    }

    entity "ut_dm_tmm"
    {
        @"sys_pk" int key required autoincrement
        @"access_movil" int
        @"agente" int
        @"cc" int
        @"zn" int
        @"pwd" string(32)
    }

    entity "ut_dn_dmm_token"
    {
        @"sys_pk" int key required autoincrement
        @"token" string(32) required
        @"creacion" datetime required
        @"expiracion" datetime required
        @"revocado" int
        @"datos" memo
    }

    
    //Gestion de kds
    entity "dm_kds" 
    {
        @"access_movil" bool
        @"cproduccion" int 
        @"pwd" string(32)
        @"shortpool" int
    }
    
    entity "dmns_destino":"TableModel"
    {
        @"nombre" string(80) required
        @"telefono" string(15) unique required
        @"direccion" memo
        @"longitud" decimal(8,3)
        @"latitud" decimal(8,3)
        @"notas" memo
    }

    entity "dmns_entrega":"TableModel"
    {
        @"destino" ref:"dmns_destino" required
        @"venta" ref:"venta" required
        
        index "u_entrega" unique
        {
            field "destino"
            field "venta"
        }
    }
    /* uod.dmnszona */
    entity "dmnszona" : "TableModel"
    {
        @"archivo" string(255)
        @"color" int
        @"fumar" bool
        @"id" string(35)
        @"mesero" string(32)
        @"notas" memo
    }
    /* uod.dmnsmesa */
    entity "dmnsmesa" : "TableModel"
    {
        @"bandera" int
        @"h" int
        @"id" string(10)
        @"mesero" string(32)
        @"notas" string(4096)
        @"personas" int
        @"w" int
        @"x" int
        @"y" int
        @"izona" int required
    }
    // Registro de las ordenes de producción y ensamble.
    entity "orden" : "TableModel"
    {
        @"sys_info" string(50)

        @"cdirecto" decimal(18,8) //Costo de los materiales o componentes
        @"cindirecto" decimal(18,8) //Costos indirectos
        @"cmanoobra" decimal(18,8) //Costo de la mano de obra
        @"cmaquinaria" decimal(18,8) //Costo de las maquinarias
        @"d1" decimal(18,8) //Descuento 1
        @"d2" decimal(18,8) //Descuento 2
        @"fecha" date //Fecha del documento
        @"fprevista" date //Fecha en que esta prevista la ejecución
        @"fproduccion" date //Fecha en que se ejecuto la orden
        @"hora" datetime //Hora de la fecha
        @"hprevista" datetime //Hora de 'fprevista'
        @"hproduccion" datetime //Hora de 'fproducción'
        @"importe" decimal(18,8) //Importe total de la orden
        @"notas" string(4096)
        @"auditada" bool
        @"contabilizada" bool
        @"partida" string(32) //Referencia a una partida presupuestal o contable
        @"poliza" string(32) //Referencia a una poliza contable
        @"referencia" string(50) unique
        @"status" ref:"cstatusordenproduccion" required
        @"tiempoproduccion" int //Indica el orden en que debe ejecutarse un grupo de ordenes de producción
        @"tiemposervicio" int //Indica el orden en que debe servirse o entregarse una orden ejecutada
        @"tipocambio" decimal(18,8)
        @"iagente" ref:"agente"
        @"icconsumo" ref:"cconsumo" required
        @"icproduccion" ref:"cproduccion" required //Indica el centro de producción en que se ejecuta
        @"idivisa" ref:"divisa"
        @"iventa" ref:"venta"
        @"atendido" bool
        @"fatendido" datetime
    }
    // Detalle de las ordenes de producción y ensamble.
    entity "dorden" : "TableModel"
    {
        @"cantidad" decimal(18,8)
        @"cdirecto" decimal(18,8)
        @"cindirecto" decimal(18,8)
        @"cmanoobra" decimal(18,8)
        @"cmaquinaria" decimal(18,8)
        @"d1" decimal(18,8)
        @"d2" decimal(18,8)
        @"especificaciones" string(4096)
        @"precio" decimal(18,8)
        @"tiempoproduccion" int
        @"tiemposervicio" int
        @"tipocambio" decimal(18,8)
        @"idivisa" ref:"divisa" required
        @"iproducto" ref:"producto" required
        @"fk_orden_detalle" ref:"orden" required
    }

    entity "dcantidades" : "TableModel"
    {
        @"cantidad" ref:"ccantidades" required
        @"iproducto" ref:"producto" required
        @"fk_dorden_cantidadesvariadas" ref:"dorden" required
    }

    entity "dadicionales" : "TableModel"
    {
        @"cantidad" decimal(18,8)
        @"cdirecto" decimal(18,8)
        @"cindirecto" decimal(18,8)
        @"cmanoobra" decimal(18,8)
        @"cmaquinaria" decimal(18,8)
        @"notas" string(255)
        @"precio" decimal(18,8)
        @"iproducto" ref:"producto" required
        @"fk_dorden_adicionales" ref:"dorden" required
    }
    //#region Domicilio
    entity "pais" : "TableModel"
    {
        @"codigo" string(8) unique required
        @"nombre" string(100) unique required

        @"th_sep" string(3)
        @"dc_sep" string(3)
        //https://es.wikipedia.org/wiki/ISO_3166-1
        @"iso3166" string(2) unique
        @"iso3166_a3" string(3) unique
        //https://es.wikipedia.org/wiki/Anexo:Prefijos_telef%C3%B3nicos_mundiales
        @"codigotel" string(5)
    }
    entity "edoprov" : "TableModel"
    {
        @"codigo" string(8) unique required
        @"nombre" string(50) required
        @"ipais" ref:"pais" required
    }
    entity "ciudad" : "TableModel"
    {
        @"codigo" string(8) unique required
        @"codigotel" string(5)
        @"nombre" string(100) required
        @"estado" ref:"edoprov" required
    }
    entity "domicilio" : "TableModel"
    {
        @"codpos" string(10)
        @"colonia" string(150)
        @"direccion" string(1024)
        @"notas" string(150)
        @"telefonos" string(150)
        @"iciudad" ref:"ciudad"
        @"numint" string(1024)
        @"numext" string(1024)
    }
    //#endregion

    entity "departamento" : "TableModel"
    {
        @"codigo" string(5) unique required
        @"comision1" decimal(18,8)
        @"comision2" decimal(18,8)
        @"comision3" decimal(18,8)
        @"comision4" decimal(18,8)
        @"comision5" decimal(18,8)
        @"descripcion" string(50) unique required
    }
    entity "divisa" : "TableModel"
    {
        @"codigo" string(5) unique required
        @"descripcion" string(30) unique required
        @"tcambio" decimal(18,8)
    }
    entity "marca" : "TableModel"
    {
        @"codigo" string(5) unique required
        @"descripcion" string(50) unique required
    }
    entity "cfgimpuesto" : "TableModel"
    {
        @"i1compra" string(128)
        @"i1venta" string(128)
        @"i2compra" string(128)
        @"i2venta" string(128)
        @"i3compra" string(128)
        @"i3venta" string(128)
        @"i4compra" string(128)
        @"i4venta" string(128)
        @"nombre" string(25) unique required
        @"uf_tipoi1" string(25)
        @"uf_tipoi2" string(25)
        @"uf_tipoi3" string(25)
        @"uf_tipoi4" string(25)
        @"tasa" bool
        @"objetoimp" string(2)
    }
    entity "tipoproveedor" : "TableModel"
    {
        @"codigo" string(15) unique required
        @"descripcion" string(50) unique required
        @"notas" memo
    }
	entity "proveedor" : "TableModel"
    {
        @"codcuenta" string(50) unique
        @"codigo" string(35) unique required
        @"curp" string(35) unique
        @"diascredito" int
        @"diasentrega" int
        @"email" string(50)
        @"fax" string(50)
        @"limitecredito" decimal(18,8)
        @"nombre" string(150) unique required
        @"notas" memo
        @"rfc" string(15)
        @"saldo" decimal(18,8)
        @"tasaiva" ref:"ctasasiva" required
        @"telefonos" string(50)
        @"website" string(150)
        @"idivisa" ref:"divisa" required
        @"tipo" ref:"tipoproveedor" required
        @"uf_sys_baja" bool
        @"uf_vueltaviajero" int
    }

    entity "linea": "TableModel"
    {
        @"clase" ref:"cclaseproducto" required
        @"codigo" string(15) unique required
        @"color" int
        @"comision1" decimal(18,8)
        @"comision2" decimal(18,8)
        @"comision3" decimal(18,8)
        @"comision4" decimal(18,8)
        @"comision5" decimal(18,8)
        @"descripcion" string(50) unique required
        @"notas" memo
        @"visible" bool
        @"uf_indicaciones" string(1024)
    }
    entity "producto" : "TableModel"
    {
        @"adicional" bool
        @"cdirecto" decimal(18,8)
        @"cindirecto" decimal(18,8)
        @"cmanoobra" decimal(18,8)
        @"cmaquinaria" decimal(18,8)
        @"codbar1" string(35) unique
        @"codbar2" string(35) unique
        @"codbar3" string(35) unique
        @"codigo" string(35) unique required
        @"color" int
        @"comision" decimal(18,8)
        @"comision1" decimal(18,8)
        @"comision2" decimal(18,8)
        @"comision3" decimal(18,8)
        @"comision4" decimal(18,8)
        @"comision5" decimal(18,8)
        @"costopromedio" decimal(18,8)
        @"costoultimo" decimal(18,8)
        @"data1" string(500)
        @"data2" string(500)
        @"data3" string(500)
        @"desc2" decimal(18,8)
        @"desc3" decimal(18,8)
        @"desc4" decimal(18,8)
        @"desc5" decimal(18,8)
        @"descripcion" string(150) unique required
        @"diasentrega" int
        @"existencia" decimal(18,8)
        @"factorb" decimal(18,8)
        @"factorc" decimal(18,8)
        @"factord" decimal(18,8)
        @"factore" decimal(18,8)
        @"flaglimites" bool
        @"flagutilidad" bool
        @"formacomision" ref:"cformacomisionproducto"
        @"iclase" ref:"cclaseproducto" required
        @"itipo" ref:"ctipoproducto" required
        @"lim2" decimal(18,8)
        @"lim3" decimal(18,8)
        @"lim4" decimal(18,8)
        @"lim5" decimal(18,8)
        @"maximo" decimal(18,8)
        @"metodovaluacion" ref:"cmetodosvaluacion" required
        @"minimo" decimal(18,8)
        @"notas" memo
        @"padic1" decimal(18,8)
        @"padic2" decimal(18,8)
        @"padic3" decimal(18,8)
        @"padic4" decimal(18,8)
        @"padic5" decimal(18,8)
        @"ppuntos" decimal(18,8)
        @"precio1" decimal(18,8)
        @"precio2" decimal(18,8)
        @"precio3" decimal(18,8)
        @"precio4" decimal(18,8)
        @"precio5" decimal(18,8)
        @"puntoro" decimal(18,8)
        @"reqlote" bool required
        @"reqserie" bool required
        @"saldo" decimal(18,8)
        @"tipocomision" ref:"ctiposcomisionesproducto"
        @"unidad" string(10) required
        @"unidadb" string(10)
        @"unidadc" string(10)
        @"unidadd" string(10)
        @"unidade" string(10)
        @"util1" decimal(18,8)
        @"util2" decimal(18,8)
        @"util3" decimal(18,8)
        @"util4" decimal(18,8)
        @"util5" decimal(18,8)
        @"utilmin" decimal(18,8)
        @"vinculardata" bool
        @"visible" bool
        @"idepartamento" ref:"departamento"
        @"idivisa" ref:"divisa" required
        @"ilinea" ref:"linea" required
        @"imarca" ref:"marca"
        @"impuestos" ref:"cfgimpuesto" required
        @"ivariables" int
        @"proveedor1" ref:"proveedor"
        @"proveedor2" ref:"proveedor"
        @"proveedor3" ref:"proveedor"
        @"uf_solicitarcantidad" bool
        @"uf_sys_baja" bool
        @"uf_complemento" bool
        @"precio106" decimal(18,8)
        @"precio107" decimal(18,8)
        @"precio108" decimal(18,8)
        @"precio109" decimal(18,8)
        @"precio110" decimal(18,8)
        @"precio111" decimal(18,8)
        @"precio112" decimal(18,8)
        @"precio113" decimal(18,8)
        @"precio114" decimal(18,8)
        @"precio115" decimal(18,8)
        @"precio116" decimal(18,8)
        @"precio117" decimal(18,8)
        @"precio118" decimal(18,8)
        @"precio119" decimal(18,8)
        @"precio120" decimal(18,8)
        @"util106" decimal(18,8)
        @"util107" decimal(18,8)
        @"util108" decimal(18,8)
        @"util109" decimal(18,8)
        @"util110" decimal(18,8)
        @"util111" decimal(18,8)
        @"util112" decimal(18,8)
        @"util113" decimal(18,8)
        @"util114" decimal(18,8)
        @"util115" decimal(18,8)
        @"util116" decimal(18,8)
        @"util117" decimal(18,8)
        @"util118" decimal(18,8)
        @"util119" decimal(18,8)
        @"util120" decimal(18,8)
        @"uf_codigoparaproveedor1" string(50)
        @"uf_codigoparaproveedor2" string(50)
        @"uf_codigoparaproveedor3" string(50)
        @"uf_pdv" decimal(18,8)
        @"uf_dv_diasreorden" int
        @"uf_dv_inventarioseguridaddias" int
        @"uf_gruposimilares" int
        @"uf_inhabilitado" bool
        @"uf_fechainhabilitacion" datetime
        @"uf_sat_proser" string(50) required
        @"uf_sat_uniproser" string(50) required

        index "producto_sys_info"
        {
            field "sys_info"
        }
    }
    entity "iensamble" : "TableModel"
    {
        @"cantdemasiado" decimal(18,8)
        @"cantidad" decimal(18,8)
        @"cantmucho" decimal(18,8)
        @"cantpoco" decimal(18,8)
        @"omitible" bool
        @"elemento" ref:"producto" required
        @"reemplazo" ref:"producto"
        @"fk_producto_elementos" ref:"producto" required
    }
    entity "grupoproductos" : "TableModel"
    {
        @"comision1" decimal(18,8)
        @"comision2" decimal(18,8)
        @"comision3" decimal(18,8)
        @"comision4" decimal(18,8)
        @"comision5" decimal(18,8)
        @"nombre" string(25) unique required
        @"notas" string(4096)
        @"tasa_iva" decimal(18,8)
    }
    entity "grupoproductos_producto_" : "NmModel"
    {
        @"iproductos" ref:"producto" required
        @"igrupos" ref:"grupoproductos" required
    }
	entity "ivariable" : "TableModel"
    {
        @"cdirectoprom" decimal(18,8)
        @"cindirectoprom" decimal(18,8)
        @"cmanoobraprom" decimal(18,8)
        @"cmaquinariaprom" decimal(18,8)
        @"descripcion" string(35)
        @"factor" decimal(18,8)
        @"maximo" decimal(18,8)
        @"minimo" decimal(18,8)
        @"padicional" ref:"cimpadicionales"
        @"grupo" ref:"grupoproductos"
        @"fk_producto_ivariables" ref:"producto"
    }
    entity "almacen" : "TableModel"
    {
        @"codcuenta" string(50) unique
        @"codigo" string(10) unique required
        @"descripcion" string(50) unique required
        @"email" string(50)
        @"fax" string(150)
        @"telefonos" string(150)
        @"website" string(150)
        @"domicilio1" ref:"domicilio"
        @"uf_movremoto" bool
        @"uf_inhabilitado" bool
        @"uf_fechainhabilitacion" datetime
        @"uf_formaproduccion" int
        @"clase" ref:"clase_almacen"
        @"ubicacion" ref:"ubicacion"
    }
    entity "ubicacion" : "TableModel"
    {
        @"codigo" string(10) unique required
        @"descripcion" string(50) required
        @"notas" memo
    }
	entity "cproduccion" : "TableModel"
    {
        @"codigo" string(5) unique required
        @"descripcion" string(30) unique required
        @"almacenmp" ref:"almacen" required
        @"almacenpt" ref:"almacen" required
    }
	entity "cproduccion_producto_" : "NmModel"
    {
        @"iproductos" ref:"producto" required
        @"icentrosproduccion" ref:"cproduccion" required
    }

    // Información de la aplicación
    entity "sys_app_catalog"
    {
        @"pack_id" string(32) required
        @"app_id" string(32) key
        @"app_title" string(255)
        @"created" datetime required
        @"app_info" mmemo
    }
    // Categoria de la aplicación
    entity "sys_app_category"
    {
        @"id" string(32) key
        @"title" string(255) required
    }
    // Recursos de la aplicación
    entity "sys_app_shortcut" 
    {
        @"id" string(32) key
        @"title" string(255) required
        @"icon96x96" string(1024) required
        @"src" string(1024) required
        @"_blank" bool
        @"appid" ref : "sys_app_catalog"
        @"cat" ref :"sys_app_category"
    }
}