#include "dkli.dkh"
#!
module ":gmesero"
{
    list::&db,&params
    {
        do dbr.apps.action.grant("CA40")
        return list.create()
    }
    read::&db,&params
    {
        do dbr.apps.action.grant("CA40")
        return read.create()
    }

    point @list to gmesero.list
    point @read to gmesero.read
}