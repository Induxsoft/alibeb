#include "dkli.dkh"
#!
program "Consulta el menú del Punto de Venta V12"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "dbr.dkh"
    #include "dbr.vars.dkl"
    #include "lib.sise.dk"
    #include "comandas/impuesto.dk"

    function GetLines(&db)
    {
        clases = ""

        if parse.bool(dbr.vars.get(db,"pos_mostrar_recetas")) { clases = clases + "2," }
        if parse.bool(dbr.vars.get(db,"pos_mostrar_servicios")) { clases = clases + "3," }
        if parse.bool(dbr.vars.get(db,"pos_mostrar_articulos")) { clases = clases + "4," }

        if clases == "" { return list.create() }
        else { clases = rremove(clases,1) }

        sql = ftext("
        SELECT
            l.sys_pk,
            l.codigo,
            l.descripcion,
            l.uf_req_indicaciones,
            l.uf_indicaciones,
            l.notas
        FROM
            linea l
        WHERE
            NOT ifnull(l.sys_deleted,0)
            AND ifnull(l.visible,1) = 1
            AND l.clase IN (#<clases>);
        ")

        return dbr.list(db,sql,@null)
    }

    function GetRecipesByLine(&db,ilinea)
    {
        sb_group = ftext("select g.sys_pk from grupoproductos_producto_ g where g.iproductos = p.sys_pk and g.igrupos = #<@visible_group>")
        
        sql = ftext("
        SELECT
            p.sys_pk,
            p.codigo,
            p.descripcion,
            p.precio1,
            p.precio2,
            p.precio3,
            p.precio4,
            p.precio5,
            p.notas,
            i.i1venta,
            i.i2venta,
            i.i3venta,
            i.i4venta
        FROM
            producto p
            INNER JOIN cfgimpuesto AS i ON p.impuestos = i.sys_pk
        WHERE
            NOT ifnull(p.sys_deleted,0)
            AND p.ilinea = #<ilinea>
            AND (
                CASE '#<@visibility_rule>'
                    WHEN 'pos' THEN ifnull(p.visible,1) = 1
                    WHEN 'e-commerce' THEN p.sys_info <> 'HIDDEN'
                    WHEN 'both' THEN (ifnull(p.visible,1) = 1 OR p.sys_info <> 'HIDDEN')
                    WHEN 'group' THEN (#<sb_group>) > 0
                END
            )
        ")

        return dbr.list(db,sql,@null)
    }

    function GetAdditionalIngredientsByLine(&db,ilinea)
    {
        sql = ftext("
        SELECT
            p.codigo,
            p.descripcion,
            p.padic1,
            p.padic2,
            p.padic3,
            p.padic4,
            p.padic5,
            i.i1venta,
            i.i2venta,
            i.i3venta,
            i.i4venta
        FROM
            producto p
            INNER JOIN cfgimpuesto i ON p.impuestos = i.sys_pk 
        WHERE
            NOT ifnull(p.sys_deleted,0)
            AND ifnull(p.adicional,0) = 1
            AND p.ilinea = #<ilinea>
        ORDER BY p.codigo;
        ")

        return dbr.list(db,sql,@null)
    }

    function GetGroupsOfVariableIngredients(&db,iproducto)
    {
        sql = ftext("
        SELECT v.sys_pk AS id, g.nombre, v.grupo, v.minimo, v.maximo
        FROM
            ivariable v
            INNER JOIN grupoproductos g ON v.grupo = g.sys_pk
        WHERE
            v.fk_producto_ivariables = #<iproducto>;
        ")

        return dbr.list(db,sql,@null)
    }

    function GetIngredientsOfVarGroup(&db,igrupo)
    {
        sql = ftext("
        SELECT p.codigo, p.descripcion
        FROM
            grupoproductos_producto_ gp
            INNER JOIN producto p ON gp.iproductos = p.sys_pk
        WHERE
            gp.igrupos = #<igrupo>;
        ")

        return dbr.list(db,sql,@null)
    }

    function SetLine(&db,&line,&output)
    {
        do text.say(output,@@(line,"$descripcion"))
        do text.say(output,"")

        notes = trim(@@(line,"$notas"))
        if notes != "" && @add_line_notes
        {
            do text.say(output,notes)
            do text.say(output,"")
        }

        options = trim(@@(line,"$uf_indicaciones"))
        if options != ""
        {
            options = replace(options,"\r\n","\n")
            options = replace(options,"\n",", ")
            options = ifstr(@@(line,"#uf_req_indicaciones"), "(Requerido)", "(Opcional)") + " Elegir indicaciones: " + options

            do text.say(output,options)
            do text.say(output,"")
        }

        ref additional = GetAdditionalIngredientsByLine(db,@@(line,"#sys_pk"))
        total = list.count(additional)
        if total > 0
        {
            do text.say(output,"(Opcional) Elegir adicionales:")
            for i = 0; i < total
            {
                ref item = list.obj(additional,i)
                
                precio = aplImpuestos(@@(item,campoPrecioAdcR5(@PrecioAdcs)), parseImpuesto(@@(item,"i1venta"),@zonaImpuesto), parseImpuesto(@@(item,"i2venta"),@zonaImpuesto), parseImpuesto(@@(item,"i3venta"),@zonaImpuesto), parseImpuesto(@@(item,"i4venta"),@zonaImpuesto))
                
                ingredient = "- "+ @@(item,"$codigo") +" "+ @@(item,"$descripcion") +" "+ format(precio,@formato_moneda)
                do text.say(output,ingredient)
            }
            do text.say(output,"")
        }
    }

    function SetVariableIngredients(&db,iproducto,&output)
    {
        ref groups = GetGroupsOfVariableIngredients(db,iproducto)

        c_groups = list.count(groups)
        if c_groups > 0 { do text.say(output,"{") }

        for i = 0; i < c_groups
        {
            ref vg = list.obj(groups,i)
            ref ingredients = GetIngredientsOfVarGroup(db,@@(vg,"#grupo"))

            total = list.count(ingredients)
            if total > 0
            {
                do field.remove(vg,"grupo")
                label = "Elegir grupo ingrediente:" + to.json(vg)
                do text.say(output,label)

                for j = 0; j < total
                {
                    ref item = list.obj(ingredients,j)
                    do text.say(output,"- "+ @@(item,"$codigo") +" "+ @@(item,"$descripcion"))
                }
            }
        }
        
        if c_groups > 0 { do text.say(output,"}") }
    }

    function SetRecipes(db,&recipes,&output)
    {
        do text.say(output,"Recetas (Código - Descripción - Precio { ...componentes })")
        do text.say(output,"")

        for i = 0; i < list.count(recipes)
        {
            ref recipe = list.obj(recipes,i)

            precio = aplImpuestos(@@(recipe,campoPrecioR5(@PrecioVenta)), parseImpuesto(@@(recipe,"i1venta"),@zonaImpuesto), parseImpuesto(@@(recipe,"i2venta"),@zonaImpuesto), parseImpuesto(@@(recipe,"i3venta"),@zonaImpuesto), parseImpuesto(@@(recipe,"i4venta"),@zonaImpuesto))

            row = @@(recipe,"$codigo") +" - "+ @@(recipe,"$descripcion") +" - "+ format(precio,@formato_moneda)
            do text.say(output,row)

            notes = trim(@@(recipe,"$notas"))
            if notes != "" && @add_recipe_notes { do text.say(output,notes) }

            do SetVariableIngredients(db,@@(recipe,"#sys_pk"),output)
        }
    }

    function BuildMenu(&db)
    {
        ref lines = GetLines(db)

        c_lines = list.count(lines)
        if c_lines < 1 { return "No hay líneas disponibles." }

        ref menu = text.create()
        for i = 0; i < c_lines
        {
            ref line = list.obj(lines,i)
            ref recipes = GetRecipesByLine(db,@@(line,"#sys_pk"))

            if list.count(recipes) > 0
            {
                do SetLine(db,line,menu)
                do SetRecipes(db,recipes,menu)
                do text.say(menu,"---")
            }
        }

        content = text.get(menu)
        do text.clear(menu)
        do _free(menu)

        return content
    }

    if not(isset("@__process_request")) { @__process_request = @true }
    if parse.bool(@__process_request)
    {
        do errordet(@false)

        // -- Procesar solicitud HTTP -------------------------
        go sise_base_service(params:params, payload:payload, response:response)
        {
            ref db = _db()

            @DecimalesEnImportes = parse.num(dbr.vars.get(db,"FXCA001"))
            @add_line_notes = parse.bool(dbr.vars.getd(db, "alibeb.notas_de_linea_en_menu", "true"))
            @add_recipe_notes = parse.bool(dbr.vars.getd(db, "alibeb.notas_de_receta_en_menu", "true"))
            @visibility_rule = dbr.vars.getd(db, "alibeb.menu_visibility_rule", "pos")
            @visible_group = parse.num(dbr.vars.get(db,"alibeb.visible_group"))

            response<"message"> : BuildMenu(db)

            exception
            {
                using response
                {
                    @"success": @false
                    @"message": "No fue posible obtener el menú: "+last_error()
                }
            }
        }
    }
}