#include "dkli.dkh"
#!
module "list.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "dbr.dkh"
    #include "dbr.apps.dkl"
    #include "uielements.v12.dkl"
    #include "../_lib/config.dk"
    #include "../_lib/scape_special_charactes2.dk"

    do @context.begin(@crud_context)
    ref productos = @('&./productos')
    do scape_special_charactes(productos,"codigo,descripcion")

    exist_pack_prodserv=file.exists("prodserv/_install/install.dkl")

    url_prod_serv=replace(@PROD_SERV_GALERIA,"@id","${DataRow.sys_pk}")+"?url_exit_encode="+url_encode(@ALIBEB_RECETAS)
    new table_definition
    {
        @"datatable*": productos
        @"table_footer": "Mostrando los primeros # productos ordenados por código"
        member @"columns"
        {
            member @"codigo" { @"caption":"Código" }
            member @"descripcion" { @"caption":"Descripción" }
            member @"unidad" { @"caption":"Unidad" }
            member @"existencia" { @"caption":"Existencia" }
            member @"precio1" { @"caption":"Precio1" }
            member @"precio2" { @"caption":"Precio2" }
            member @"precio3" { @"caption":"Precio3" }
            member @"precio4" { @"caption":"Precio4" }
            member @"precio5" { @"caption":"Precio5" }
            member @"saldo" { @"caption":"Saldo" }
            member @"costoultimo" { @"caption":"Costo último" }
            member @"linea" { @"caption":"Línea" }
            member @"_actions" 
            { 
                @"caption":"Acciones" 
                @"template":ftext('
                    <div style="display:flex;gap:8px;justify-content:center;width:100%;" class="no-print">
                        <a href="#<@ALIBEB_RECETAS>${DataRow.sys_pk}/" style="cursor:pointer; text-decoration: none; padding: 0px 8px; background-color: #F5F5F5; color: #000;">Editar</a>
                        <button onclick="InduxsoftCrudlModel.Delete(${DataRow.sys_pk})" style="cursor:pointer; border: none; outline: none; padding: 0px 8px; background-color: #F5F5F5; color: #000;">Eliminar</button>
                        ${#<exist_pack_prodserv> ? `<a href="#<url_prod_serv>" style="cursor:pointer; text-decoration: none; padding: 0px 8px; background-color: #F5F5F5; color: #000;">Galeria</a>`:``}
                    </div>')
                @"no-print":@true
            }
        }
    }

    new nav_config
    {
        @"title": "Catálogo de recetas"
        @"buttons*": @null
        @"urlexit": "/"
        @"actions*": dbr.apps.itemactions(@('&database'),"DET045","action","",0)
        @"reports*": dbr.apps.itemactions(@('&database'),"DET045","report","",0)
        @"jscurrentcontext": "getCurrentContext"
    }
     new fil_linea
    {
        @"id": "fil_linea"
        @"datatable*": ifnull(@("&./list_lineas"),list.create())
        new member @"attributes"
        {
            @"class": "induxsoft-form-select"
            @"name": "fil_linea"
            @"onchange": "document.querySelector('#form_search').submit()"
        }
        @"first_text": "(Todas las lineas)"
        @"first_value": "*"
        @"text_field": "descripcion"
        @"value_field": "sys_pk"
        @"selected": @("#parameters/fil_linea")
    }
    #$ div(class="container-fluid p-0")
    {
        #! do uie.printV12FormBar(nav_config)

        #$ div(id="work_area" class="container-section mt-1 p-2 pt-0")
        {
            p{$"#<@('$error/message')>"}

            form(action="./" method="GET" id="form_search" class="no-print my-1 d-flex py-1")
            {
                div(class="d-flex gap-2 w-100")
                {
                    div(style="width:20%"){#! do uie.dbSelect(fil_linea) }#$
                    div(style="width:80%")
                    {
                        "filter-text"(
                            "id"="ft_search"
                            "text-field"="s"
                            "placeholder"="Buscar por código o descripción"
                            "form"="#form_search"
                            "value"="#<@@(@@(@crud_context,'&http/request/get'),'$s')>"
                            "auto-submit"="true"
                            "class"="w-100"
                        ){$""}
                    }
                }
                
            }
            #! do uie.dbeditable(table_definition, "tbl_recetas")
        }

        #$
		script(type="text/javascript")
		{$'
			function getCurrentContext()
			{
				const table = document.getElementById("tbl_recetas");
				const id = (table?.DataArray[table.CurrentRowIndex()]?.sys_pk ?? "");
    			return { item_id:id, context: {} }
			}
		'}
    }
}