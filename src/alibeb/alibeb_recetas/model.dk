#include "dkli.dkh"
#!
module "model"
{
    #include "webcl.dkh"

    #include "../_lib/config.dk"
    #include "../_lib/lib.dk"

    @table_name = "producto"

    function check_autocode(&db,table,field,&data)
    {
        varvalue = dbr.vars.getd(db,"FXCA124","|0000")

        if contains(varvalue,"@Linea")
        {
            var = dbr.str(db, "SELECT codigo FROM linea WHERE sys_pk=@ilinea", data)
            varvalue = replace(varvalue,"@Linea",var)
        }

        ref config = dbr.autocode.info(varvalue)
        config<"start">: 2
        new_code = dbr.autocode.new(db,table,field,config)

        data<"codigo">: new_code

        exception
        { }
    }

    function alibeb.crearProducto(&db, &params, &data)
    {
        // if @@(params,"$_entity_id") == "_new" && not(dbr.security.isauth(db,@AUT_CREATE_PRODUCTO)) { do rise_error(500,"No autorizado") }
        // if @@(params,"$_entity_id") != "_new" && not(dbr.security.isauth(db,@AUT_UPDATE_PRODUCTO)) { do rise_error(500,"No autorizado") }

        @table_name = "producto"
        if field.exist(data,"codbar1") && trim(@@(data,"$codbar1")) == "" { data<"codbar1*"> : @null }
        if field.exist(data,"codbar2") && trim(@@(data,"$codbar2")) == "" { data<"codbar2*"> : @null }
        if field.exist(data,"codbar3") && trim(@@(data,"$codbar3")) == "" { data<"codbar3*"> : @null }
        if field.exist(data,"idepartamento") && trim(@@(data,"$idepartamento")) == "" { data<"idepartamento*">:@null }
        if field.exist(data,"imarca") && trim(@@(data,"$imarca")) == "" { data<"imarca*">:@null }
        if field.exist(data,"proveedor1") && trim(@@(data,"$proveedor1")) == "" { data<"proveedor1*">:@null }
        if field.exist(data,"proveedor2") && trim(@@(data,"$proveedor2")) == "" { data<"proveedor2*">:@null }
        if field.exist(data,"proveedor3") && trim(@@(data,"$proveedor3")) == "" { data<"proveedor3*">:@null }
        if field.exist(data,"uf_sat_proser") && trim(@@(data,"$uf_sat_proser")) == "" { data<"uf_sat_proser"> : "01010101" }
        if field.exist(data,"uf_sat_uniproser") && trim(@@(data,"$uf_sat_uniproser")) == "" { data<"uf_sat_uniproser"> : "H87" }
        
        if @@(params,"$_entity_id") == "_new" { data<"existencia"> : 0 }
        if @@(data,"codigo")=="" { do check_autocode(db,"producto","codigo",data) }

        data<"iclase">: 2

        ref res = entity.create(db, params, data)

        return res
        exception
		{
			do cu_error("receta")
			do rise_error(last_error_code(), last_error())
            do alibeb.prepareView(db, params, data)
		}
    }
    function alibeb.read(&db, &params)
    {
        // if not(dbr.security.isauth(db,@AUT_READ_PRODUCTO)) { do rise_error(500,"No autorizado") }

        sql_producto = "
            SELECT
                p.sys_pk, p.sys_recver, p.codigo, p.descripcion, IFNULL(p.ilinea,'') ilinea, 
                IFNULL(p.idepartamento,'') idepartamento, p.itipo, IFNULL(p.idivisa,'') idivisa,
                IFNULL(p.codbar1,'') codbar1, IFNULL(p.codbar2,'') codbar2, IFNULL(p.codbar3,'') codbar3,
                IFNULL(p.visible,0) visible, p.unidad, IFNULL(p.factorb,1) factorb, IFNULL(p.unidadB,'') unidadB,
                IFNULL(cdirecto,0) cdirecto, IFNULL(cmanoobra,0) cmanoobra, IFNULL(cindirecto,0) cindirecto
                p.metodovaluacion, p.impuestos, IFNULL(p.costoultimo,0) costoultimo, IFNULL(p.utilmin,0) utilmin,
                IFNULL(p.tipocomision,'') tipocomision, IFNULL(p.formacomision,'') formacomision,
                IFNULL(p.comision,0) comision, IFNULL(p.ppuntos,0) ppuntos,
                IFNULL(p.precio1,0) precio1, IFNULL(p.precio2,0) precio2, IFNULL(p.precio3,0) precio3, IFNULL(p.precio4,0) precio4, IFNULL(p.precio5,0) precio5,
                IFNULL(p.adicional,0) adicional,
                IFNULL(padic1,0) padic1, IFNULL(padic2,0) padic2, IFNULL(padic3,0) padic3, IFNULL(padic4,0) padic4, IFNULL(padic5,0) padic5,
                IFNULL(p.comision1,0) comision1, IFNULL(p.comision2,0) comision2, IFNULL(p.comision3,0) comision3, IFNULL(p.comision4,0) comision4, IFNULL(p.comision5,0) comision5,
                IFNULL(p.flagutilidad,0) flagutilidad, IFNULL(p.flaglimites,0) flaglimites,
                IFNULL(p.unidadc,'') unidadc, IFNULL(p.unidadd,'') unidadd, IFNULL(p.unidade,'') unidade,
                IFNULL(p.factorc,0) factorc, IFNULL(p.factord,0) factord,  IFNULL(p.factore,0) factore,
                IFNULL(p.maximo,0) maximo, IFNULL(p.puntoro,0) puntoro,  IFNULL(p.minimo,0) minimo, IFNULL(p.diasentrega,0) diasentrega,
                IFNULL(p.proveedor1,'') proveedor1, IFNULL(p.proveedor2,'') proveedor2, IFNULL(p.proveedor3,'') proveedor3,
                IFNULL(p.uf_solicitarcantidad,0) uf_solicitarcantidad,
                IFNULL(p.notas,'') notas,
                IFNULL(p.uf_sat_proser,'01010101') uf_sat_proser,
                IFNULL(p.uf_sat_uniproser,'H87') uf_sat_uniproser,
            FROM producto p
            WHERE p.sys_pk=@_entity_id LIMIT 1;
        "

        new data
        {
            @"producto*": dbr.rec(db, sql_producto, params)
        }

        do alibeb.prepareView(db, params, data)

        return data
    }
    function alibeb.obtenerDivisas(&db, &params)
    {
        return dbr.list(db, ftext("
            SELECT sys_pk, codigo, descripcion FROM divisa
            WHERE IFNULL(sys_deleted,0)=0 
                AND IF(IFNULL(@s,'')='', true, (codigo LIKE CONCAT('%',@s,'%') OR descripcion LIKE CONCAT('%',@s,'%')))
            LIMIT #<@default_max_rows>;
        "), params)
    }
    function alibeb.obtenerDepartamentos(&db, &params)
    {
        return dbr.list(db, ftext("
            SELECT sys_pk, codigo, descripcion FROM departamento
            WHERE IFNULL(sys_deleted,0)=0 
                AND IF(IFNULL(@s,'')='', true, (codigo LIKE CONCAT('%',@s,'%') OR descripcion LIKE CONCAT('%',@s,'%')))
            ORDER BY descripcion
            LIMIT #<@default_max_rows>;
        "), params)
    }
    function alibeb.obtenerProveedores(&db, &params)
    {
        return dbr.list(db,ftext("
            SELECT sys_pk, codigo, nombre FROM proveedor
            WHERE IFNULL(sys_deleted,0)=0 
                AND IF(IFNULL(@s,'')='', true, (codigo LIKE CONCAT('%',@s,'%') OR nombre LIKE CONCAT('%',@s,'%')))
            ORDER BY nombre
            LIMIT #<@default_max_rows>;
        "), params)
    }
    function alibeb.obtenerLineas(&db, &params)
    {
        query="SELECT sys_pk, clase, codigo, descripcion, IFNULL(notas,'') notas
            FROM linea
            WHERE IFNULL(sys_deleted,0)=0 
                AND IF(IFNULL(@s,'')='', true, (codigo LIKE CONCAT('%',@s,'%') OR descripcion LIKE CONCAT('%',@s,'%')))
                AND clase=2
            ORDER BY descripcion
            LIMIT #<@default_max_rows>;"
        return dbr.list(db, ftext(query), params)
    }
    function alibeb.obtenerProductos(&db,&params)
    {
        sql = "
            SELECT p.sys_pk, p.codigo, p.descripcion, p.unidad, IFNULL(p.costoultimo,0) costoultimo
            FROM producto p
            WHERE IFNULL(p.sys_deleted,0) = 0
                AND IF(IFNULL(@s,'')='', true, (p.codigo LIKE CONCAT('%',@s,'%') OR p.descripcion LIKE CONCAT('%',@s,'%')))
            ORDER BY p.descripcion
            LIMIT #<@default_max_rows>;
        "
        return dbr.list(db, ftext(sql), params)
    }
    function alibeb.obtenerGrupoProd(&db,&params)
    {
        sql = "
            SELECT gp.sys_pk grupo, gp.nombre grupo_desc,
                AVG(IFNULL(p.costoultimo,0)) cdirectoprom, AVG(IFNULL(p.cindirecto,0)) cindirectoprom, AVG(IFNULL(p.cmanoobra,0)) cmanoobraprom,
                AVG(IFNULL(p.costoultimo,0)) _cdirectoprom, AVG(IFNULL(p.cindirecto,0)) _cindirectoprom, AVG(IFNULL(p.cmanoobra,0)) _cmanoobraprom
            FROM grupoproductos gp
                LEFT JOIN grupoproductos_producto_ gp_p ON gp_p.igrupos = gp.sys_pk
                LEFT JOIN producto p ON gp_p.iproductos = p.sys_pk
            WHERE IFNULL(gp.sys_deleted,0) = 0
                AND IF(IFNULL(@s,'')='', true, gp.nombre LIKE CONCAT('%',@s,'%'))
            GROUP BY gp.sys_pk ORDER BY gp.nombre;
        "
        return dbr.list(db, sql, params)
    }

    function alibeb.list(&db, &params)
    {
        // if not(dbr.security.isauth(db,@AUT_ACCESS_PRODUCTO)) { do rise_error(500,"No autorizado") }

        query = "
            SELECT 
                p.sys_pk, 
                p.codigo, 
                p.descripcion, 
                p.unidad, 
                IFNULL(p.existencia,0) existencia,
                IFNULL(precio1,0) precio1, 
                IFNULL(precio2,0) precio2, 
                IFNULL(precio3,0) precio3, 
                IFNULL(precio4,0) precio4, 
                IFNULL(precio5,0) precio5,
                IFNULL(p.saldo,0) saldo, 
                IFNULL(p.costoultimo,0) costoultimo, 
                l.descripcion linea
            FROM producto p
                INNER JOIN cclaseproducto cc ON p.iclase = cc.id
                INNER JOIN divisa d ON p.idivisa = d.sys_pk
                INNER JOIN linea l ON p.ilinea = l.sys_pk
            WHERE cc.id = 2
                AND IF(IFNULL(@s,'')='', true, (p.codigo LIKE CONCAT('%',@s,'%') OR p.descripcion LIKE CONCAT('%',@s,'%')))
            ORDER BY p.codigo
            LIMIT #<@default_max_rows>;
        "
        return dbr.list(db, ftext(query), params)
    }
    function alibeb.delete(&db, &params)
    {
        // if not(dbr.security.isauth(db,@AUT_DELETE_PRODUCTO)) { do rise_error(500,"No autorizado") }

        do dbr.execute(db, "DELETE FROM grupoproductos_producto_ WHERE iproductos=@_entity_id", params)
        do entity.delete(db, params)
    }

    function cu_error(table)
    {
        new fields {
            @"codbar1": "El código de barras 1"
            @"codbar2": "El código de barras 2"
            @"codbar3": "El código de barras 3"
            @"codigo": "El código"
            @"descripcion": "La descripción"
        }
        do valide_duplicate(fields, table, last_error(), last_error_code())
    }
    function alibeb.blank(&db, &params)
    {
        // if not(dbr.security.isauth(db,@AUT_READ_PRODUCTO)) { do rise_error(500,"No autorizado") }

        ref data = record.create()
        do alibeb.prepareView(db, params, data)
        return data
    }
    function alibeb.prepareView(&db, &params, &data)
    {
        sql_tipoprod = "SELECT id, REPLACE(SUBSTR(IFNULL(const,''),2),'_',' ') const FROM ctipoproducto ORDER BY id DESC;"
        sql_metodval = "SELECT id, const FROM cmetodosvaluacion;"
        sql_impuesto = "SELECT sys_pk, nombre FROM cfgimpuesto;"
        sql_tipocomi = "SELECT id, REPLACE(SUBSTR(IFNULL(const,''),2),'_',' ') const FROM ctiposcomisionesproducto ORDER BY id;"
        sql_formcomi = "SELECT id, REPLACE(SUBSTR(IFNULL(const,''),2),'_',' ') const FROM cformacomisionproducto ORDER BY id;"
        sql_cimpadic = "SELECT CONCAT(id,' - ',SUBSTR(const,2)) id, SUBSTR(const,2) const FROM cimpadicionales ORDER BY id;"
        sql_ensamble = "
            SELECT
                ie.sys_pk, ie.sys_recver, ie.elemento,
                p.codigo, p.descripcion, p.unidad, IFNULL(ie.cantidad,0) cantidad, IFNULL(p.costoultimo,0) costoultimo, 
                IFNULL(p.costoultimo,0) importe, '100' AS representacion, IFNULL(ie.cantdemasiado,0) cantdemasiado, 
                IFNULL(ie.cantmucho,0) cantmucho, IFNULL(ie.cantpoco,0) cantpoco, IFNULL(omitible,0) omitible,
                IFNULL(p3.descripcion,'') reemplazo, IFNULL(p3.sys_pk,-99) pk_reemplazo
            FROM iensamble ie INNER JOIN producto p ON ie.elemento=p.sys_pk
                INNER JOIN producto p2 ON ie.fk_producto_elementos = p2.sys_pk
                LEFT JOIN producto p3 ON ie.reemplazo = p3.sys_pk
            WHERE p2.sys_pk=@sys_pk;
        "
        sql_variable = "
            SELECT iv.grupo grupo, gp.nombre grupo_desc, IFNULL(iv.descripcion,'') descripcion, IFNULL(iv.factor,0) factor,
                IFNULL(iv.maximo,0) maximo, IFNULL(iv.minimo,0) minimo, CONCAT(cia.id,' - ',SUBSTR(cia.const,2)) padicional,
                AVG(IFNULL(p.cdirecto,0)) cdirectoprom, AVG(IFNULL(p.cindirecto,0)) cindirectoprom, AVG(IFNULL(p.cmanoobra,0)) cmanoobraprom,
                AVG(IFNULL(p.cdirecto,0)) _cdirectoprom, AVG(IFNULL(p.cindirecto,0)) _cindirectoprom, AVG(IFNULL(p.cmanoobra,0)) _cmanoobraprom
            FROM ivariable iv
                INNER JOIN grupoproductos gp ON iv.grupo = gp.sys_pk
                INNER JOIN grupoproductos_producto_ gp_p ON gp_p.igrupos = gp.sys_pk
                INNER JOIN producto p ON gp_p.iproductos = p.sys_pk
                LEFT JOIN cimpadicionales cia ON iv.padicional=cia.id
            WHERE iv.fk_producto_ivariables=@sys_pk
            GROUP BY iv.grupo;
        "
        sql_cproducc = "
            SELECT cp.codigo id, cp.descripcion text, IF(IFNULL(cpp.prod,-99)=-99,0,1) done
            FROM cproduccion cp
                LEFT JOIN (SELECT icentrosproduccion prod FROM cproduccion_producto_ WHERE iproductos=@sys_pk) cpp ON cpp.prod=cp.sys_pk
            ORDER BY cp.descripcion;
        "

        using data
        {
            @"tipoprod*": dbr.list(db, sql_tipoprod, @null)
            @"metodval*": dbr.list(db, sql_metodval, @null)
            @"impuesto*": dbr.list(db, sql_impuesto, @null)
            @"tipocomi*": dbr.list(db, sql_tipocomi, @null)
            @"formcomi*": dbr.list(db, sql_formcomi, @null)
            @"cimpadic*": dbr.list(db, sql_cimpadic, @null)
            @"ensamble*": dbr.list(db, sql_ensamble, @@(data,"&producto"))
            @"variable*": dbr.list(db, sql_variable, @@(data,"&producto"))
            @"cproducc*": dbr.list(db, sql_cproducc, @@(data,"&producto"))
        }

        return data
    }
    function alibeb.add_empty_value(&list, keyfield, valuefield)
    {
        ref empty = record.create()
        empty<keyfield>: ""
        empty<valuefield>: ""

        do list.ins(list, 0, empty)
        return list
    }

    function alibeb.obtenerGaleria(&db, &params)
    {
        ref product = dbr.rec(db, "SELECT descripcion, REPLACE(TRIM(codigo),' ','-') codigo FROM producto WHERE sys_pk=@_entity_id", params)

        sku = ""
        if isnull(product) { do rise_error(0, "El producto no existe") }
        sku = @@(product, "$codigo")

        endpoint = @URL_IMAGES
        endpoint = replace(endpoint, "@sku", sku)
        endpoint = add_host_to_url(endpoint)
        
        response = http.request(endpoint, "GET", @null, '')
        ref data = from.json(response)

        new res
        {
            @"product*": product
            @"images*": data
        }

        return res
    }
    function add_host_to_url(url)
    {
        method = ifstr(parse.bool(@@(@http_context,"request/headers/HTTPS")),"https","http")
        host = @@(@http_context, "request/headers/HTTP_HOST")
        port = @@(@http_context, "request/headers/SERVER_PORT")

        url = path.concat(method+"://"+host+":"+port, url)

        return (url + "?ids=" + @@(@http_context, "session/user/ids"))
    }

    point @create to alibeb.crearProducto
    point @update to alibeb.crearProducto
    point @delete to alibeb.delete
    point @read to alibeb.read
    point @list to alibeb.list
    point @blank to alibeb.blank
}