#include "dkli.dkh"
#!
module "controller"
{
    switch @@(@http_context,"$request/get/_view")
    {
        case "divisa"
        {
            @table_name = "divisa"
            point @list to alibeb.obtenerDivisas
            break
        }
        case "departamento"
        {
            @table_name = "departamento"
            point @list to alibeb.obtenerDepartamentos
            break
        }
        case "proveedor"
        {
            @table_name = "proveedor"
            point @list to alibeb.obtenerProveedores
            break
        }
        case "producto"
        {
            @table_name = "producto"
            point @list to alibeb.obtenerProductos
            break
        }
        case "linea"
        {
            @table_name = "linea"
            point @list to alibeb.obtenerLineas
            break
        }
        case "galeria"
        {
            @table_name = "producto"
            point @read to alibeb.obtenerGaleria

            @form_view = "galeria.dk"
        }
    }
}