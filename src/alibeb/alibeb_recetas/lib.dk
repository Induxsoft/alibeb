    function lib.get_divisa(&db, pk)
    {
        sql = "SELECT sys_pk, codigo, descripcion FROM divisa WHERE sys_pk=@pk LIMIT 1;"
        return lib.get_data(db, sql, pk)
    }
    function lib.get_linea(&db, pk)
    {
        sql = "SELECT sys_pk, codigo, descripcion FROM linea WHERE sys_pk=@pk LIMIT 1;"
        return lib.get_data(db, sql, pk)
    }
    function lib.get_departamento(&db, pk)
    {
        sql = "SELECT sys_pk, codigo, descripcion FROM departamento WHERE sys_pk=@pk LIMIT 1;"
        return lib.get_data(db, sql, pk)
    }
    function lib.get_proveedor(&db, pk)
    {
        sql = "SELECT sys_pk, codigo, nombre FROM proveedor WHERE sys_pk=@pk LIMIT 1;"
        return lib.get_data(db, sql, pk)
    }
    function lib.get_data(&db, sql, pk)
    {
        new prm { @"pk": pk }
        ref rec = dbr.rec(db, sql, prm)
        return  ifnull(rec, record.create())
    }
    function filter_forma_comision(&formas, tipo)
    {
        ref list = list.create()
        for i = 0; i < list.count(formas)
        {
            ref forma = list.obj(formas, i)
            id_forma = @@(forma, '$id')
            
            if tipo == 0 && id_forma == '0' {
                do list.add(list, forma)
            }
            else if  tipo == 1 && (id_forma == '1' || id_forma == '2') {
                do list.add(list, forma)
            }
            else if tipo == 2 && (id_forma == '1' || id_forma == '2' || id_forma == '3') {
                do list.add(list, forma)
            }
        }
        return list
    }

    function set_ml_images(&images)
    {
        ref list = list.create()
        if not(isnull(images)) && list.count(images) > 0
        {
            for i = 0; i < list.count(images)
            {
                ref img = list.obj(images,i)
                url = @@(img,"src")
                mini = @@(img,"src")
                
                ref vars = ifnull(@@(img,"&variations"), list.create())
                ref min_var = get_variation_with_min_value(vars,"size")
                
                new ml_img
                {
                    @"id": @@(img,"$id")
                    @"url": url
                    @"mini": field.dstr(min_var, "src", mini)
                }
                do list.add(list, ml_img)
            }
        }

        return list
    }
    function get_variation_with_min_value(&lst,field)
    {
        ref variation = record.create()
        
        for i = 0; i < list.count(lst)
        {
            ref obj = list.obj(lst,i)
            if i == 0 { ref variation = obj }
            if @@(obj,"#"+field) < @@(variation, "#"+field){
                ref variation = obj
            }
        }

        return variation
    }

    function proccessEnsambles(&ensambles,minrows)
    {
        // calcular la representacion de cada fila
        cantidad_total = 0
        for i = 0; i < list.count(ensambles)
        {
            ref ensamble = list.obj(ensambles,i)
            cantidad_total = cantidad_total + @@(ensamble,"#cantidad")
        }
        for i = 0; i < list.count(ensambles)
        {
            ref ensamble = list.obj(ensambles,i)
            ensamble<"representacion">: (div(@@(ensamble,"#cantidad"),cantidad_total)*100)
        }
        // si no hay más de {minrows} filas autorellenar con filas vacias
        do autoFillRows(ensambles,minrows)
        return ensambles
    }
    function getTotal(&list,field)
    {
        total = 0
        for i = 0; i < list.count(list)
        {
            ref obj = list.obj(list,i)
            total = total + @@(obj,"#"+field)
        }
        return total
    }
    function proccessVariables(&variables,minrows)
    {
        // calcular los costos a partir del campo factor y maximo
        for i = 0; i < list.count(variables)
        {
            ref variable = list.obj(variables,i)
            fac = field.dnum(variable,"factor",1)
            max = field.dnum(variable,"maximo",1)
            if max==0 { max=1 }
            mul = (fac * max)
            variable<"cdirectoprom">: (mul * field.dnum(variable,"_cdirectoprom",0))
            variable<"cmanoobraprom">: (mul * field.dnum(variable,"_cmanoobraprom",0))
            variable<"cindirectoprom">: (mul * field.dnum(variable,"_cindirectoprom",0))
        }
        // si no hay más de {minrows} filas autorellenar con filas vacias
        do autoFillRows(variables,minrows)
        return variables
    }
    function autoFillRows(&list,minrows)
    {
        if list.count(list) < minrows
        {
            for i = list.count(list); i < minrows
            {
                new row {}
                do list.add(list, row)
            }
        }
    }
    function list_to_record(&listObj, keyfield, valuefield)
    {
        ref record = record.create()
        
        for i = 0; i < list.count(listObj) {
            ref obj = list.obj(listObj, i)
            record<@@(obj,"$"+str(keyfield))>: @@(obj, "$"+str(valuefield))
        }

        return record
    }
    function get_checklistdata(&items,title)
    {
        new data
        {
            @"text": title
            @"items*": items
        }

        return data
    }
}