        style{$'
            .input-symbol-container { position: relative; }
            .input-symbol-prefix { position: absolute; top: 50%; transform: translateY(-50%); margin-left: 6px; }
            .input-number-text { padding-left: 17px !important; }
            .input-symbol-text { padding-left: 20px !important; }
        '}
        script(src="#<@JS_MAIN>"){$""}
        script(src="#<@JS_RECETAS>"){$""}
        script{$'
            recetas.urlFormActn = "#<formActn>";
            recetas.urlMasPrecios = "#<@CATBAS_MAS_PRECIOS>";
            recetas.currentReceta = "#<entityId>";
            recetas.exist_mp_app = #<exists_mp>;
            recetas.curr_url = "#<curr_url>";
            recetas.urlBack = "#<@ALIBEB_RECETAS>";
            recetas.formcomi = #<to.json(formcomi)>;
            recetas.minrowsRecConst = #<minrowsRecConst>;
            recetas.minrowsRecVarbl = #<minrowsRecVarbl>;
        '}
