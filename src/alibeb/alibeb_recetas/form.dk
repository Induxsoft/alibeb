#include "dkli.dkh"
#!
module "form.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "dbr.dkh"
    #include "uielements.dkl"
    #include "uielements.v12.dkl"
    #include "../_lib/config.dk"
    #include "../_lib/icons.dk"
    #include "lib.dk"

    do @context.begin(@crud_context)

    minrowsRecConst=15
    minrowsRecVarbl=15

    decs_imp=@("#./decs_imp")
    decs_vol=@("#./decs_vol")

    ref producto = ifnull(@("&./producto"), record.create())
    ref ensamble = proccessEnsambles(@("&./ensamble"),minrowsRecConst)
    ref variable = proccessVariables(@("&./variable"),minrowsRecVarbl)
    ref tipoprod = @("&./tipoprod")
    ref metodval = @("&./metodval")
    ref impuesto = @("&./impuesto")
    ref tipocomi = @("&./tipocomi")
    ref formcomi = @("&./formcomi")
    ref formascm = filter_forma_comision(formcomi, @@(producto,'#tipocomision'))
    ref cimpadic = list_to_record(@("&./cimpadic"), "id", "const")
    ref cproducc = get_checklistdata(@("&./cproducc"),"Centros de producción")

    ref database = @("&database")
    
    entityId = @("$parameters/_entity_id")
    errorMsg = @("$error/message")
    @isNewEnt = (entityId == "_new")
    formActn = @ALIBEB_RECETAS + entityId + "/"
    curr_url = url_encode(path.concat(get_base_url(@('&http')),formActn))

    ref divsa = lib.get_divisa(database, field.dnum(producto,"idivisa",1))
    ref linea = lib.get_linea(database, @@(producto,"$ilinea"))
    ref depar = lib.get_departamento(database, @@(producto,"$idepartamento"))
    ref prov1 = lib.get_proveedor(database, @@(producto,"$proveedor1"))
    ref prov2 = lib.get_proveedor(database, @@(producto,"$proveedor2"))
    ref prov3 = lib.get_proveedor(database, @@(producto,"$proveedor3"))

    codigoprd = field.dstr(producto,"codigo","<A>")
    exists_mp = dir.exists(@CATBAS_MAS_PRECIOS_PATH)

    header_act::
    { 
        if not(@isNewEnt) { #$ button(type="button" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" id="btn_more_prices" title="Más precios"){ $'Más precios' } }
        button(type="button" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" id="btn_submit" title="Guardar"){ $'#<@ICON_SAVE>' }
    }

    #! point general_act to header_act

    new nav_config
    {
        @"title": ifstr(@isNewEnt,'Agregar','Editar') + ' receta' + ifstr(@isNewEnt,""," - "+@@(producto,'$descripcion'))
        @"buttons*": general_act
        @"urlexit": @ALIBEB_RECETAS
        member @"hidden"
        {
            @"print": @true
        }
    }

    total_ensamble = getTotal(ensamble,"importe")
    total_variable = getTotal(variable,"cdirectoprom")

    #$ div(class="container")
    {
        form(method="POST" action="#<formActn>" id="form")
        {
            #! #! do uie.printV12FormBar(nav_config)

            #$ div(id="work_area" class="container-section")
            {
                div(class="#<ifstr(@('error/message')!='','alert alert-danger','')>"){$"#<@('error/message')>"}

                #$
                input(type="hidden" name="sys_pk" value="#<@@(producto, '#sys_pk')>")
                input(type="hidden" name="sys_recver" value="#<@@(producto, '#sys_recver')>")

                // NAV TABS
                ul(class="nav nav-tabs mt-3" id="myTab" role="tablist")
                {
                    li(class="nav-item" role="presentation") {
                        button(class="nav-link active" id="general-tab" "data-bs-toggle"="tab" "data-bs-target"="#general" type="button" role="tab" "aria-controls"="general" "aria-selected"="true"){$"General"}
                    }
                    li(class="nav-item" role="presentation") {
                        button(class="nav-link" id="recetaconstante-tab" "data-bs-toggle"="tab" "data-bs-target"="#recetaconstante" type="button" role="tab" "aria-controls"="recetaconstante" "aria-selected"="false"){$"Receta constante"}
                    }
                    li(class="nav-item" role="presentation") {
                        button(class="nav-link" id="recetavariable-tab" "data-bs-toggle"="tab" "data-bs-target"="#recetavariable" type="button" role="tab" "aria-controls"="recetavariable" "aria-selected"="false"){$"Receta variable"}
                    }
                    li(class="nav-item" role="presentation") {
                        button(class="nav-link" id="produccion-tab" "data-bs-toggle"="tab" "data-bs-target"="#produccion" type="button" role="tab" "aria-controls"="produccion" "aria-selected"="false"){$"Producción y costos"}
                    }
                    li(class="nav-item" role="presentation") {
                        button(class="nav-link" id="control-tab" "data-bs-toggle"="tab" "data-bs-target"="#control" type="button" role="tab" "aria-controls"="control" "aria-selected"="false"){$"Precios"}
                    }
                    li(class="nav-item" role="presentation") {
                        button(class="nav-link" id="inventario-tab" "data-bs-toggle"="tab" "data-bs-target"="#inventario" type="button" role="tab" "aria-controls"="inventario" "aria-selected"="false"){$"Inventario"}
                    }
                    li(class="nav-item" role="presentation") {
                        button(class="nav-link" id="notes-tab" "data-bs-toggle"="tab" "data-bs-target"="#notes" type="button" role="tab" "aria-controls"="notes" "aria-selected"="false"){$"Notas"}
                    }
                    li(class="nav-item" role="presentation") {
                        button(class="nav-link" id="sat-tab" "data-bs-toggle"="tab" "data-bs-target"="#sat" type="button" role="tab" "aria-controls"="sat" "aria-selected"="false"){$"SAT"}
                    }
                }

                // PANEL TABS
                div(class="tab-content" id="tabContent")
                {
                    // PANEL GENERAL
                    div(class="tab-pane fade show active" id="general" role="tabpanel" "aria-labelledby"="general-tab")
                    {
                        #! isServ = @false

                        #$ div(class="border-bottom py-4")
                        {
                            div(class="row mb-2")
                            {
                                div(class="col-sm-4")
                                {
                                    small(class="fw-bold"){$"Código:"}
                                    input(type="text" class="induxsoft-form-control" name="codigo" value="#<codigoprd>" maxlength="35" placeholder="<A>")
                                }
                                div(class="col-sm-4")
                                {
                                    small(class="fw-bold"){$"Descripción:"}
                                    input(type="text" class="induxsoft-form-control" name="descripcion" value="#<@@(producto,'$descripcion')>" required="true" maxlength="150")
                                }
                                div(class="col-sm-4")
                                {
                                    small(class="fw-bold"){$"Línea:"}
                                    "input-key"(id="ik_linea" name="ilinea" "data-value"='#<to.json(linea)>' "data-key"="sys_pk" "data-search"="codigo" "data-text"="descripcion" "data-source"="#<@ALIBEB_SEARCH_LINEA>" columns="codigo,descripcion" colcaptions="Código,Descripción" "box-title-text"="Seleccione una línea" "box-placeholder-text"="Buscar línea" "box-nodata-text"="No se encontraron líneas" required="true" "control-styles"="#search_container{padding-left: 0 !important;}#description_container{padding-right: 0 !important;}"){$""}
                                }
                            }
                            div(class="row mb-2")
                            {
                                div(class="col-sm-4")
                                {
                                    small{$"Departamento:"}
                                    "input-key"(id="ik_departamento" name="idepartamento" "data-value"='#<to.json(depar)>' "data-key"="sys_pk" "data-search"="codigo" "data-text"="descripcion" "data-source"="#<@ALIBEB_SEARCH_DEPARTAMENTO>" columns="codigo,descripcion" colcaptions="Código,Descripción" "box-title-text"="Seleccione un departamento" "box-placeholder-text"="Buscar departamento" "box-nodata-text"="No se encontraron departamentos" "control-styles"="#search_container{padding-left: 0 !important;}#description_container{padding-right: 0 !important;}"){$""}
                                }
                                div(class="col-sm-4")
                                {
                                    small(class="fw-bold"){$"Tipo:"}
                                    #! ref def_tp = lib.def_tipos_producto(tipoprod, @@(producto,'itipo'))
                                    if isServ { def_tp<"attributes/disabled">:"" }
                                    do uie.dbSelect(def_tp)
                                }
                                #$ div(class="col-sm-4")
                                {
                                    small(class="fw-bold"){$"Moneda:"}
                                    "input-key"(id="ik_divisa" name="idivisa" "data-value"='#<to.json(divsa)>' "data-key"="sys_pk" "data-search"="codigo" "data-text"="descripcion" "data-source"="#<@ALIBEB_SEARCH_DIVISA>" columns="codigo,descripcion" colcaptions="Código,Descripción" "box-title-text"="Seleccione una moneda" "box-placeholder-text"="Buscar moneda" "box-nodata-text"="No se encontraron monedas" required="true" "control-styles"="#search_container{padding-left: 0 !important;}#description_container{padding-right: 0 !important;}"){$""}
                                }
                                
                            }
                        }
                        div(class="border-bottom py-4 row")
                        {
                            h6{$"Códigos alternos"}
                            div(class="col-sm-4")
                            {
                                small{$"Código de barras 1:"}
                                input(type="text" class="induxsoft-form-control mb-2" name="codbar1" value="#<@@(producto,'$codbar1')>" maxlength="35")
                            }
                            div(class="col-sm-4")
                            {
                                small{$"Código de barras 2:"}
                                input(type="text" class="induxsoft-form-control mb-2" name="codbar2" value="#<@@(producto,'$codbar2')>" maxlength="35")
                            }
                            div(class="col-sm-4")
                            {
                                small{$"Código de barras 3:"}
                                input(type="text" class="induxsoft-form-control mb-2" name="codbar3" value="#<@@(producto,'$codbar3')>" maxlength="35")
                            }
                        }
                        div(class="pt-4 pb-2")
                        {
                            div(class="form-check")
                            {
                                input(class="form-check-input induxsoft-corners" type="checkbox" ipt="ipt_visible" id="check_view_pv" "#<ifstr(field.dnum(producto,'visible',1)==1,'checked','')>"="true")
                                label(class="form-check-label" "for"="check_view_pv"){small{$"Visible en Punto de Venta"}}
                                input(type="hidden" name="visible" id="ipt_visible" value="#<field.dnum(producto,'visible',1)>")
                            }
                        }
                        div(class="py-3 row")
                        {
                            div(class="col-sm-6")
                            {
                                div(class="d-flex gap-2 align-items-center mb-2")
                                {
                                    div
                                    {
                                        small(class="fw-bold"){$"Unidad estandar:"}
                                        div(class="d-flex gap-2 align-items-center")
                                        {
                                            input(type="text" class="induxsoft-form-control elem-unidad" name="unidad" value="#<field.dstr(producto,'unidad','PZA')>" required="true" maxlength="10" "#<ifstr(isServ,'disabled','')>"="")
                                            p(class="m-0"){$"x"}
                                        }
                                    }
                                    div
                                    {
                                        small{$"Factor:"}
                                        div(class="d-flex gap-2 align-items-center")
                                        {
                                            input(type="number" class="induxsoft-form-control elem-unidad" name="factorb" value="#<field.dnum(producto,'factorb',1)>" "#<ifstr(isServ,'disabled','')>"="")
                                            p(class="m-0"){$"="}
                                        }
                                    }
                                    div
                                    {
                                        small{$"Unidad de compra:"}
                                        input(type="text" class="induxsoft-form-control elem-unidad" name="unidadB" value="#<field.dstr(producto,'unidadB','PZA')>" maxlength="10" "#<ifstr(isServ,'disabled','')>"="")
                                    }
                                }
                                div(class="d-flex justify-content-center")
                                {
                                    small(id="mesage_factor"){$""}
                                }
                            }                           
                        }
                    }

                    // PANEL RECETA CONSTANTE
                    div(class="tab-pane fade" id="recetaconstante" role="tabpanel" "aria-labelledby"="recetaconstante-tab")
                    {
                        div(class="table-controls d-flex align-items-center justify-content-end border mt-4")
                        {
                            small(class="flex-grow-1 ps-3 text-secondary"){$"Elementos que incluye la receta"}
                            button(class="btn btn-sm" type="button" title="Agregar" onclick="recetas.searchProdRecCon()"){$"#<@ICON_ADD_ROW>"}
                            button(class="btn btn-sm" type="button" title="Eliminar" onclick="recetas.deleteProdRecCon()"){$"#<@ICON_REMOVE_ROW>"}
                        }
                        div(style="height: 60vh; display: flex;" class="border border-top-0")
                        {
                            "edit-table"(id="table_receta_constante" style="width: 100%;" data='#<to.json(ensamble)>' style="width: 100%;" "control-styles"="tr td{font-size:.8rem;} th{font-size:.9rem; outline: none !important;} table{ background-color:#FFF !important; } #__table_input{ font-size: unset !important; }tbody tr:hover{background-color:#EDEDED;}input[type='checkbox']{accent-color:#EDEDED;}")
                            {
                                "edit-thead"
                                {
                                    "edit-tr"
                                    {
                                        "edit-th"(type="Text" field="codigo" button="true"){$"Código"}
                                        "edit-th"(type="Text" field="descripcion" button="true"){$"Descripción"}
                                        "edit-th"(type="Text" field="unidad"){$"Unidad"}
                                        "edit-th"(type="Number" field="cantidad" textalign="end" format="true" decs="#<decs_vol>"){$"Cantidad"}
                                        "edit-th"(type="NoEditable" field="costoultimo" textalign="end" format="true" decs="#<decs_imp>" prefix="$" thousandssep="true"){$"Costo"}
                                        "edit-th"(type="NoEditable" field="importe" textalign="end" format="true" decs="#<decs_imp>" prefix="$" thousandssep="true"){$"Importe"}
                                        "edit-th"(type="NoEditable" field="representacion" textalign="end" format="true" decs="#<decs_vol>" sufix="%"){$"Representación"}
                                        "edit-th"(type="Number" field="cantdemasiado" textalign="end" format="true" decs="#<decs_vol>"){$"Demasiado"}
                                        "edit-th"(type="Number" field="cantmucho" textalign="end" format="true" decs="#<decs_vol>"){$"Mucho"}
                                        "edit-th"(type="Number" field="cantpoco" textalign="end" format="true" decs="#<decs_vol>"){$"Poco"}
                                        "edit-th"(type="Check" field="omitible" textalign="center"){$"Omitible"}
                                        "edit-th"(type="Text" field="reemplazo_desc" button="true"){$"Reemplazo"}
                                    }
                                }
                            }
                            "input-key"(
                                "id"="ik_producto"
                                "data-key"="sys_pk"
                                "data-search"="codigo"
                                "data-text"="descripcion"
                                "data-source"="#<@ALIBEB_SEARCH_PRODUCTO>"
                                "columns"="codigo,descripcion"
                                "colcaptions"="Código,Descripción"
                                "box-title-text"="Seleccione un producto"
                                "box-placeholder-text"="Buscar producto"
                                "box-nodata-text"="No se encontraron productos"
                                "control-styles"="#container{ display: none !important; }"
                                "hidden-input"="false"
                            ){$""}
                            "input-key"(
                                "id"="ik_producto_reeplazo"
                                "data-key"="sys_pk"
                                "data-search"="codigo"
                                "data-text"="descripcion"
                                "data-source"="#<@ALIBEB_SEARCH_PRODUCTO>" 
                                "columns"="codigo,descripcion"
                                "colcaptions"="Código,Descripción"
                                "box-title-text"="Seleccione un producto"
                                "box-placeholder-text"="Buscar producto"
                                "box-nodata-text"="No se encontraron productos"
                                "control-styles"="#container{ display: none !important; }"
                                "hidden-input"="false"
                            ){$""}
                        }
                        div(class="mt-2 d-flex align-items-center gap-2")
                        {
                            small{$"Costo de materias primas:"}
                            div{input(class="induxsoft-form-control" id="RC_cdirecto" disabled="true" value="#<total_ensamble>")}
                        }
                    }

                    // PANEL RECETA VARIABLE
                    div(class="tab-pane fade" id="recetavariable" role="tabpanel" "aria-labelledby"="recetavariable-tab")
                    {
                        div(class="table-controls d-flex align-items-center justify-content-end border mt-4")
                        {
                            small(class="flex-grow-1 ps-3 text-secondary"){$"Elementos variables de la receta"}
                            button(class="btn btn-sm" type="button" title="Agregar" onclick="recetas.searchProdRecVar()"){$"#<@ICON_ADD_ROW>"}
                            button(class="btn btn-sm" type="button" title="Eliminar" onclick="recetas.deleteProdRecVar()"){$"#<@ICON_REMOVE_ROW>"}
                        }
                        div(style="height: 60vh; display: flex;" class="border border-top-0")
                        {
                            "edit-table"(id="table_receta_variable" style="width: 100%;" data='#<to.json(variable)>' style="width: 100%;" "control-styles"="tr td{font-size:.8rem;} th{font-size:.9rem; outline: none !important;} table{ background-color:#FFF !important; } #__table_input{ font-size: unset !important; }tbody tr:hover{background-color:#EDEDED;}input[type='checkbox']{accent-color:#EDEDED;}")
                            {
                                "edit-thead"
                                {
                                    "edit-tr"
                                    {
                                        "edit-th"(type="Text" field="grupo_desc" button="true"){$"Grupo"}
                                        "edit-th"(type="Text" field="descripcion"){$"Descripción"}
                                        "edit-th"(type="Number" field="factor" textalign="end"){$"Factor"}
                                        "edit-th"(type="Number" field="maximo" textalign="end" format="true" decs="#<decs_vol>"){$"Máximo"}
                                        "edit-th"(type="Number" field="minimo" textalign="end" format="true" decs="#<decs_vol>"){$"Mínimo"}
                                        "edit-th"(type="Select" field="padicional" 'options'='#<to.json(cimpadic)>'){$"Importe adicional"}
                                        "edit-th"(type="NoEditable" field="cdirectoprom" textalign="end" format="true" decs="#<decs_imp>" prefix="$" thousandssep="true"){$"Costo directo"}
                                        "edit-th"(type="NoEditable" field="cmanoobraprom" textalign="end" format="true" decs="#<decs_imp>" prefix="$" thousandssep="true"){$"Costo mano obra"}
                                        "edit-th"(type="NoEditable" field="cindirectoprom" textalign="end" format="true" decs="#<decs_imp>" prefix="$" thousandssep="true"){$"Costo indirecto"}
                                    }
                                }
                            }
                            "input-key"(
                                "id"="ik_grupos"
                                "data-key"="grupo"
                                "data-search"="grupo"
                                "data-text"="grupo_desc"
                                "data-source"="#<@ALIBEB_SEARCH_GRUPOPROD>"
                                "columns"="grupo,grupo_desc"
                                "colcaptions"="Sys_PK,Grupo"
                                "box-title-text"="Seleccione un grupo de recetas"
                                "box-placeholder-text"="Buscar grupo de recetas"
                                "box-nodata-text"="No se encontraron grupos de recetas"
                                "control-styles"="#container{ display: none !important; }"
                                "hidden-input"="false"
                            ){$""}
                        }
                        div(class="mt-2 d-flex align-items-center gap-2")
                        {
                            small{$"Costo promedio de materias primas:"}
                            div{input(class="induxsoft-form-control" id="RV_costo" disabled="true" value="#<total_variable>")}
                        }
                    }

                    // PANEL PRODUCCIÓN Y COSTOS
                    div(class="tab-pane fade" id="produccion" role="tabpanel" "aria-labelledby"="produccion-tab")
                    {
                        div(class="row p-0 m-0 mt-4" style="height: 60vh;")
                        {
                            div(class="col-sm-6 d-flex flex-column")
                            {
                                div(class="p-1 border" style="background-color: #EDEDED;"){ h6(class="m-0"){$"Análisis de costos"} }
                                div(class="pt-2 border border-top-0 p-3 flex-grow-1")
                                {
                                    small(class="fw-bold"){$"Costo directo"}
                                    div(class="d-flex justify-content-end py-3")
                                    {
                                        div(class="row w-100 align-items-center")
                                        {
                                            div(class="col-6 mb-2 text-end"){ small{$"Materias primas:"} }
                                            div(class="col-6 mb-2 input-symbol-container")
                                            { 
                                                small(class="input-symbol-prefix"){$"$"}
                                                input(class="induxsoft-form-control input-number-text" id="ipt_costodirecto" disabled="true" name="cdirecto" value="#<@@(producto,'#cdirecto')>") 
                                            }
                                            div(class="col-6 text-end"){ small{$"Mano de obra:"} }
                                            div(class="input-symbol-container col-6")
                                            {
                                                small(class="input-symbol-prefix"){$"$"}
                                                input(type="number" class="induxsoft-form-control input-number-text" id="ipt_costomanoobra" name="cmanoobra" value="#<@@(producto,'#cmanoobra')>")
                                            }
                                        }
                                    }
                                    small(class="fw-bold"){$"Costo indirecto"}
                                    div(class="d-flex justify-content-end py-3")
                                    {
                                        div(class="row w-100 align-items-center")
                                        {
                                            div(class="col-6 text-end"){ small{$""} }
                                            div(class="input-symbol-container col-6")
                                            {
                                                small(class="input-symbol-prefix"){$"$"}
                                                input(type="number" class="induxsoft-form-control input-number-text" id="ipt_costoindirecto" name="cindirecto" value="#<@@(producto,'#cindirecto')>") 
                                            }
                                        }
                                    }
                                    small(class="fw-bold"){$"Costo total de producción"}
                                    div(class="d-flex justify-content-end py-3")
                                    {
                                        div(class="row w-100 align-items-center")
                                        {
                                            div(class="col-6 text-end"){ small{$"Total:"} }
                                            div(class="input-symbol-container col-6")
                                            {
                                                small(class="input-symbol-prefix"){$"$"}
                                                input(class="induxsoft-form-control input-number-text" id="ipt_costototprod" disabled="true" value="#<@@(producto,'#cdirecto')+@@(producto,'#cmanoobra')+@@(producto,'#cindirecto')>") 
                                            }
                                        }
                                    }
                                }
                            }
                            div(class="col-sm-6 d-flex flex-column")
                            {
                                div(class="p-1 border" style="background-color: #EDEDED;"){ h6(class="m-0"){$"Centros de producción"} }
                                div(class="pt-2 border border-top-0 p-3 flex-grow-1" style="max-height:57vh;overflow-y:auto;")
                                {
                                    "check-list"(
                                        "id"="cl_centros_prod"
                                        "data"='#<to.json(cproducc)>'
                                        "can-add"="false"
                                        "hide-header"="true"
                                    ){$""}
                                }
                            }
                        }
                    }

                    // PANEL PRECIOS
                    div(class="tab-pane fade" id="control" role="tabpanel" "aria-labelledby"="control-tab")
                    {
                        #! sinComi = (@@(producto,'#tipocomision') == 0)
                        _formaComi = @@(producto,'#formacomision')
                        showpanelC = (not(sinComi) && _formaComi==2)

                        // comiXPrice = (@@(producto,'#formacomision') == 2)
                        // comiXVnddr = (@@(producto,'#formacomision') == 3)

                        #$ div(class="border-bottom py-4")
                        {
                            div(class="row mb-2")
                            {
                                div(class="col-sm-3")
                                {
                                    small(class="fw-bold"){$"Método de valuación:"}
                                    #! do uie.dbSelect(lib.def_metodo_valuacion(metodval, @@(producto,'metodovaluacion')))
                                }
