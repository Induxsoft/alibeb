#include "dkli.dkh"
#!
module "config"
{
    // _PACKAGE
    @ALIBEB_LINEA = "/!/alibeb/alibeb_lineas/"
    @ALIBEB_RECETAS = "/!/alibeb/alibeb_recetas/"

    @ALIBEB_SEARCH_LINEA = "/!/ALIBEB/alibeb_recetas/?_view=linea&s=@search"
    @ALIBEB_SEARCH_DIVISA  = "/!/ALIBEB/alibeb_recetas/?_view=divisa&s=@search"
    @ALIBEB_SEARCH_DEPARTAMENTO  = "/!/ALIBEB/alibeb_recetas/?_view=departamento&s=@search"
    @ALIBEB_SEARCH_PROVEEDOR  = "/!/ALIBEB/alibeb_recetas/?_view=proveedor&s=@search"
    @ALIBEB_SEARCH_PRODUCTO  = "/!/ALIBEB/alibeb_recetas/?_view=producto&s=@search"
    @ALIBEB_SEARCH_GRUPOPROD  = "/!/ALIBEB/alibeb_recetas/?_view=grupoprod&s=@search"

    @CATBAS_MAS_PRECIOS = "/!/prodserv/mas_precios/"
    @CATBAS_MAS_PRECIOS_PATH = "prodserv/mas_precios/"

    // _STATIC
    @JS_LINEA = "/$/alibeb/js/linea.js"
    @JS_RECETAS = "/$/alibeb/js/recetas.js"
    @JS_MAIN = "/$/alibeb/js/main.js"

    @PROD_SERV_GALERIA="/!/prodserv/productos/@id/galeria/"

	@GESTION_PRN="/!/alibeb/gestion-prn/"
	@CONFIG_PRN_CP="/!/alibeb/config-prn-cp/"
    @default_max_rows=250


    ///comandas
    @id_reopen="_open"
	@idtables="tables"
	@idlines="fblines"
	@idfooddbev="foodbev"
	@idadcdmns="foodbev-adds"
	@idwaiters="waiters"
	@idccs="ccs"
	@idzns="zns"
	@idaccessmovil="accessmovil"
	@idlogin="login"
	@token="token"

	@path_map=""
	@folder_map="prod_printers/"

	@path_file_map=@path_map+"printers.map"
	@id_printer_tickets="tickets"

	@use_bdconfig=@true
	@accept_qnames=@true

	//css
	@style_css="/$/alibeb/_css/style.css"
	new @config
	{
		@"connection":""
	}
}