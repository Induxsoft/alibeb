#include "dkli.dkh"
#!
module ":gkds"
{
    list::&db,&params
    {
        do dbr.apps.action.grant("CA30")

        return list.create()
    }
    read::&db,&params
    {
        do dbr.apps.action.grant("CA30")

        return record.create()
    }
    

    point @list to gkds.list
    point @read to gkds.read
}