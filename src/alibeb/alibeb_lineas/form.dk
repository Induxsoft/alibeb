#include "dkli.dkh"
#!
module "form.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "dbr.dkh"
    #include "uielements.v12.dkl"
    #include "../_lib/config.dk"
    #include "../_lib/icons.dk"
    #include "dbr.vars.dkl"
    #include "prodserv/_lib/lib.dk"

    do @context.begin(@crud_context)
    ref @http_context=@("&http")

    ref linea = @("&./")
    entityId = @("$parameters/_entity_id")
    errorMsg = @("$error/message")
    isNewEnt = (entityId == "_new")
    formActn = @ALIBEB_LINEA+entityId+"/"

    codigo_linea = field.dstr(linea,'codigo','<A>')

    header_act::
    { 
        #$ button(type="submit" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print"){$"#<@ICON_SAVE>"}
    }

    #! point general_act to header_act

    new nav_config
    {
        @"title": ftext("#<ifstr(isNewEnt,'Agregar','Editar')> línea")
        @"buttons*": general_act
        @"urlexit": @ALIBEB_LINEA
        member @"hidden" { @"print": @true }
    }

    prodserv_path_img_lns_url=dbr.vars.get(@("&database"),"prodserv_path_img_lns_url")
    attachment_path=dbr.vars.get(@("&database"),"prodserv_path_img_lns")
    ref dtfile=GetDataFile(@@(linea,"$codigo"),attachment_path,prodserv_path_img_lns_url,@@(linea,"$img_file"))

    #$ div(class="container")
    {
        form(method="POST" action="#<formActn>" id="form" enctype="multipart/form-data")
        {
            #! do uie.printV12FormBar(nav_config)

            #$ div(id="work_area" class="container-section")
            {
                div(class="#<ifstr(@('error/message')!='','alert alert-danger','')>"){$"#<@('error/message')>"}

                input(type="hidden" name="sys_pk" value="#<@@(linea, '#sys_pk')>")
                input(type="hidden" name="sys_recver" value="#<@@(linea, '#sys_recver')>")

                div(class="row mb-2")
                {
                    div(class="col-sm-2")
                    {
                        small(class="fw-bold"){$"Código:"}
                        input(type="text" class="induxsoft-form-control mb-2" name="codigo" value="#<codigo_linea>" maxlength="15" placeholder="<A>")
                    }
                    div(class="col-sm-10")
                    {
                        small(class="fw-bold"){$"Descripción:"}
                        input(type="text" class="induxsoft-form-control mb-2" name="descripcion" value="#<@@(linea,'$descripcion')>" required="true" maxlength="50")
                    }
                }
                div(class="form-check")
                {
                    input(class="form-check-input induxsoft-corners genrl-check" type="checkbox" id="check_visible" "#<ifstr(@@(linea,'#visible')==1,'checked','')>"="true")
                    label(class="form-check-label" "for"="check_visible"){$"Visible en punto de venta"}
                    input(type="hidden" name="visible" id="ipt_visible" value="#<@@(linea,'#visible')>")
                }
                div(class="row mb-2 mt-3")
                {
                    div(class="col-12")
                    {
                        label(class="mb-1"){$"Instrucciones de preparación:"}
                        textarea(class="induxsoft-form-control mb-2" name="uf_indicaciones" rows="12"){$"#<@@(linea,'$uf_indicaciones')>"}
                    }
                }
                hr{""}
                input(type="file" class="induxsoft-form-control d-none" id="line_file" name="line_file"  accept=".png, .jpg, .jpeg")
                label(class="btn btn-sm btn-secondary induxsoft-corners" "for"="line_file" id="lbl_file"){"Asignar imagen a esta línea"}
                p(id="name_file"){""}
                #!
                if @@(dtfile,"$url")!="" 
                {
                    #$
                    div(class="pt-2")
                    {
                        img(src="#<@@(dtfile,'$url')>" loading="lazy" style="height: 10rem; width: 15rem; object-fit: contain;border: 1px solid #ced4da;"){""}
                    }
                }
            }
            div(id="status_bar" class="container-section")
            {
                $""
            }
        }
        script(src="#<@JS_LINEA>"){$""}
        script
        {
            $'
            linea._entity=#<@@(linea,"#sys_pk")>;
            '
        }
    }
}