#include "dkli.dkh"
#!
module "lib.dk"
{
    // *****************************functions de kds***********************************

    #!
    kds.get.ordenes_adcs::&db,&params
    {
        ref list_ords=dbr.list(db,@kds_orders,params)
        for i=0;i<@count(list_ords)
        {
            ref itm=@item(list_ords,i)
            itm<"adds*">:dbr.list(db,@addOrdendmns,itm)
        }
        return list_ords
    }
    pds.get.dventas::&db,&params
    {
        return dbr.list(db,@dventas_orden,params)
    }
    #!
    kdf.get.ordenes::&db,&params
    {
        ref list_commands=dbr.list(db,ftext(@kdf_tables_orders),params)

        for i=0;i<@count(list_commands)
        {
            ref item=@item(list_commands,i)
            
            new p
            {
                @"iventa":@@(item,"#sys_pk")
                @"cprod":@@(params,"cprod")
                @"orden":@@(item,"#pkorden")
            }
            
            if field.exist(params,"atendido"){p<"atendido">:@@(params,"$atendido")}
            if @@(p,"$cprod") == ""{p<"cprod">:@@(item,"$cp_code")}
            
            item<"orders*">:kds.get.ordenes_adcs(db,p)//get.ordenes(db,p)
        }
        return list_commands
    }
    pds.prepareGlobalVars::&db
    {
        cat=dbr.vars.get(db,"v12.ventas.salida")
        cat >> p
        cventa=dbr.num(db,"select sys_pk from categoria where codigo=@cat",p)
        if parse.num(cventa)<1{do rise_error(500,"No ha configurado una categoria Salidas por ventas `v12.ventas.salida` ")}

        new args
        {
            @"c-venta":cventa
        }
        @erp.dprod.CLASES="2,4,5,6" 
        @erp.dprod.TIPOS_PRODUCTOS_SALIDA_VENTAS="2"
        @dias_ventas=field.dnum(args,"dias-ventas",7) //dias-ventas=n. Cantidad de días atrás (n) a tomar en cuenta como máximo de la lista de ventas pendientes.
        @limit_ventas=field.dnum(args,"limit-ventas",100)//limit-ventas=l. Cantidad de filas (l) a tomar en cuenta como máximo de la lista de ventas pendientes.
        @cat_prod_ventas=field.dnum(args,"c-venta",8) //Clave primaria de la categoría para salida por ventas
        @pre_errors=@true //preservar-errores. Guarda los errores de producción o salida por ventas en la tabla 'dprod_log'.
        @f_inicio=@@(args,"$f_inicio")//f_inicio=f. Fecha de inicio del rango de fechas, en donde f es una expresada con el formato yyyy-mm-dd.
        @f_final=@@(args,"$f_final") //f_final=f. Fecha final del rango de fechas, en donde f es una expresada con el formato yyyy-mm-dd.
        @kventa=field.dnum(args,"k-venta",0)//k-venta=pk. La clave primaria (pk) de una venta en particular que será la única en ser procesada
        @rventa=field.dstr(args,"venta","")//venta=r. La referencia (r) de una venta en particular que será la única en ser procesada

        return args
    }
    #!
    kdf.close.table::&db,&params
    {
        pds_action=parse.num(GetVars("pds_btn_mode"))
        
        if pds_action < 1
        {
            return kds.updata.status(db,params,1)//stattus = 3 
        }
        do producirOrdenes(db,params)
        
        return kds.updata.status(db,params,1)//stattus = 3 
    }
    kds.updata.status::&db,&params,status
    {
        ref now=now()
        new table
        {
            @"StatusAdministrativo":status
            @"status":status
            @"idkdf":@@(params,"idkdf")
            @"cprod":@@(params,"cprod")
            @"sys_timestamp*":now
            // @"hproduccion*":now
            @"fatendido*":dbr.sql("date(now())")
            // @"fproduccion*":dbr.sql("date(now())")
        }
        do dbr.execute(db,@kds.updateorder,table)
        return table
    }

    #!
    kdf.get.lastorders::&db,&params
    {

        order=dbr.num(db,@kdf_last_order,params)
        if order<=0{return @null}

        //@kdf_tables_orders=@kdf_tables_orders+

        @where=" and o.sys_pk>@idkdf"
        return kdf.get.ordenes(db,params)
    }

    #!
    kds.get.orders_history::&db,&params
    {
        ref list_ords=dbr.list(db,@kds_orders_history,params)
        for i=0;i<@count(list_ords)
        {
            ref itm=@item(list_ords,i)
            itm<"adds*">:dbr.list(db,@addOrdendmns,itm)
        }
        return list_ords
    }
    
    #!
    kds.gethistory::&db,&params
    {
        ref list_history=dbr.list(db,@kdf_tables_orders_history,params)
        for i=0;i<@count(list_history)
        {
            ref item=@item(list_history,i)
            new p
            {
                @"orden":@@(item,"#pkorden")
                @"iventa":@@(item,"#sys_pk")
                @"cprod":@@(params,"cprod")
            }
            item<"orders*">:kds.get.orders_history(db,p)
        }
        return list_history
    }

    #!
    kds.update_history::&db,&params
    {
        return kds.updata.status(db,params,0)
    }
    // ********************************************************************************

}