#include "dkli.dkh"
#!
module "lib.dk"
{
	DocumentRoot::
	{
		return @@(@http_context,"$request/headers/DOCUMENT_ROOT")
	}

    @preserve_querystr_params="dmtm_token,dm_scr"
    preserveQSParams::url
	{
		preserve=@preserve_querystr_params
		//Pasar a url los parámetros en la url actual que se indican delimitados por comas
		ref ops=record.create()
		u=replace(field.dstr(@http_context,"request/headers/request_uri","/"),"\\","/")

		q=""
		if contains(u,"?")
		{
			ref oqs=split(u,"?")
			u=list.str(oqs,0) 
			q=list.str(oqs,1) 

			ref qps=split(q,"&")
			for i=0;i<@count(qps)
			{
				kv=list.str(qps,i)
				if contains(kv,"=")
				{
					ref lkv=split(kv,"=")
					if isanyword(list.str(lkv,0),preserve)
					{
						ops<list.str(lkv,0)>:list.str(lkv,1)
					}
				}
			}
			fd="?"
			if contains(url,"?"){fd="&"}
			ref l=list.create_from_fields(ops)
			if @count(l)>0
			{
				for i=0;i<@count(l)
				{
					if not(contains(url,list.str(l,i)+"="))
					{
						url=url+fd+list.str(l,i)+"="+field.str(ops,list.str(l,i))
						fd="&"
					}
				}
			}

		}
		
		exception{}
		return url
	}
	#!
	api_base_service::
    {
        expose responseJSONdata

        new responseJSONdata
        {
            @"success":@true
        }
        
        that
        
        @http_context<"response/headers/Content-Type">:"application/json;charset=utf-8"
        @http_context<"response/output">:"text"
        @http_context<"response/text">: to.json(responseJSONdata)
    }
	setResponse::content
	{
		@http_context<"response/headers/Content-Type">:"application/json;charset=utf-8"
        @http_context<"response/output">:"text"
        @http_context<"response/text">: content
	}
	TableExist::&db,table
    {
        table >> p
        name_table=dbr.str(db,"SHOW TABLES LIKE '"+table+"';",p)
        return trim(name_table)!=""
    }
    #!
	ref @database=@null
    open.db::qname
    {
        module
        {
            do reset()
            exception{}
        }
        if qname!=""{return dbr.open(qname)}
        
        return dbr.open(@@(@config,"connection"))
    }
	//si qname es vacio obtendrá de la configuración
	getDatabase::qname
	{
		if isnull(@database){ref @database=open.db(qname)}

		return @database
	}
	GetVars::var
	{
		ref db=getDatabase("")
		return dbr.vars.get(db,var)
	}
	#!
	GetDataDivisaPred::
	{
		ref db=getDatabase("")
		divisa =parse.num(dbr.vars.get(db,"FXCA013"))
		divisa >> p

		return dbr.rec(db,"select sys_pk,codigo,descripcion,tcambio from divisa where sys_pk=@divisa",p)
	}
    #!
    session.logout::ids
    {
        ref db=dbr.reconnect(@@(@config,"connection"),ids)
        do dbr.logout(db)
        exception{}
    }

	#!
	GetFilePrn::file
	{
		host=@@(@http_context,"$request/headers/http_host")

		path_file=path.concat(replace(@path_files_prn,"@host",host),file)
		_file_host=file.exists(path_file)
		
		if not(_file_host){path_file=path.concat(@path_file_prn_default,file)}
		
		if not(file.exists(path_file)){do rise_error(500,"No se encontró el archivo indicado:"+file)}

		ext=tolower(trim(file.extension(file)))

		if ext==".js"
		{
			if _file_host{return path.concat(replace(@path_route_prn_config,"@host",host),file)}

			return path.concat(@path_route_prn,file)
		}

		return path_file
	}
	PrnParseConfig::&db,&config
	{
		if @@(config,"$printer")=="device"
		{
			config<"req_data">:@true
			return config
		}
		else if @@(config,"$printer")=="server"
		{
			ref cprinter=dbr.rec(db,"SELECT * FROM ut_dm_tmm_gprn WHERE id=@driver",config)
			if trim(@@(cprinter,"$data"))==""{return @null}

			return from.json(@@(cprinter,"$data"))
		}
		else if not(isnull(config))
		{
			config<"req_data">:@true
			return config
		}
		else{return @null}
	}
	PrnParseConfigCmmd::&db,cprod
	{
		cprod >> p
		ref config=dbr.rec(db,"select gp.* from ut_dm_tmm_cgprn udm
		inner join cproduccion cp on udm.ref_cprod=cp.sys_pk
		inner join  ut_dm_tmm_gprn gp on udm.ref_gprn=gp.id
		where cp.codigo=@cprod",p)

		if trim(@@(config,"$data"))==""{return @null}

		return from.json(@@(config,"$data"))
	}
	showActions::action
	{
		if action{return ""}

		return "d-none"
	}
	ref @config_default=@null
	getVarsConfig::
	{
		if not(isnull(@config_default)){return @config_default}

		pos_color_encabezado=GetVars("pos_color_encabezado")
		pos_mostrar_cuentas=parse.bool(GetVars("pos_mostrar_cuentas"))
		pos_mostrar_comida_rapida=parse.bool(GetVars("pos_mostrar_comida_rapida"))
		pos_mostrar_servicio_domicilio=parse.bool(GetVars("pos_mostrar_servicio_domicilio"))
		pos_titulo_encabezado=GetVars("pos_titulo_encabezado")
		pos_subtitulo_encabezado=GetVars("pos_subtitulo_encabezado")
		pos_mostrar_recetas=parse.bool(GetVars("pos_mostrar_recetas"))
		pos_mostrar_servicios=parse.bool(GetVars("pos_mostrar_servicios"))
		pos_mostrar_articulos=parse.bool(GetVars("pos_mostrar_articulos"))
		pos_mostrar_control_propina=parse.bool(GetVars("pos_mostrar_control_propina"))

		new @config_default
		{
			@"pos_color_encabezado":ifstr(trim(pos_color_encabezado)!="",pos_color_encabezado,"#540883")
			@"pos_mostrar_cuentas":pos_mostrar_cuentas
			@"pos_mostrar_comida_rapida":pos_mostrar_comida_rapida
			@"pos_mostrar_servicio_domicilio":pos_mostrar_servicio_domicilio
			@"pos_titulo_encabezado":ifstr(trim(pos_titulo_encabezado)!="",pos_titulo_encabezado,"Induxsoft")
			@"pos_subtitulo_encabezado":ifstr(trim(pos_subtitulo_encabezado)!="",pos_subtitulo_encabezado,"")
			@"pos_mostrar_recetas":pos_mostrar_recetas
			@"pos_mostrar_servicios":pos_mostrar_servicios
			@"pos_mostrar_articulos":pos_mostrar_articulos
			@"show_cuentas":showActions(pos_mostrar_cuentas)
			@"show_foodfast":showActions(pos_mostrar_comida_rapida)
			@"show_foofhome":showActions(pos_mostrar_servicio_domicilio)
			@"show_propina":showActions(pos_mostrar_control_propina)
			@"pos_mostrar_control_propina":pos_mostrar_control_propina
			@"pos_porcentaje_propina":parse.num(GetVars("pos_porcentaje_propina"))
		}

		@config_default<"show_filter">:ifstr(showFilter(@config_default),"","d-none")
		@config_default<"class_prod">:ClassProd(@config_default)

		return @config_default
	}
	showFilter::&config
	{
		if (@@(config,"#pos_mostrar_cuentas") && @@(config,"#pos_mostrar_comida_rapida")) || (@@(config,"#pos_mostrar_cuentas") && @@(config,"#pos_mostrar_servicio_domicilio")){return @true}
		else if @@(config,"#pos_mostrar_comida_rapida") && @@(config,"#pos_mostrar_servicio_domicilio"){return @true}
		else if @@(config,"#pos_mostrar_servicio_domicilio"){return @true}

		return @false
	}
	ClassProd::&config
	{
		class_prod="-1"

		if @@(config,"#pos_mostrar_recetas"){class_prod=class_prod + ",2"}
		if @@(config,"#pos_mostrar_servicios"){class_prod=class_prod + ",3"}
		if @@(config,"#pos_mostrar_articulos"){class_prod=class_prod + ",4"}

		return class_prod
	}
}