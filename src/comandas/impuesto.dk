#include "dkli.dkh"
#!
module "impuestos"
{
	@DecimalesEnImportes=2 //Pendiente: Tomar este valor de la configuración 
	@zonaImpuesto=0 //0-Interior y 1-frontera
	@zonaImpuesto_sub_index=1 //1-Interior y 2-frontera
	@PrecioVenta=1 //Precio 1 a 5
	@PrecioAdcs=1 //precio de los productos adicionales 1 a 5
	@PrioridadBarras=0 //0-Prioridad a barras de Déminus (producto, linea), 1-Prioridad a barras de plaza mundial(producto, line) y 2-Ambas (producto, plazamundial y linea)

	@formato_moneda="$ #,#.00"
	// @decimales_montos=4
	@tasa_iva=.16
	@campo_iva="impuesto3"

	#!
	aplImpuestos:: p, i1, i2, i3, i4
	{
		p=round( p, @DecimalesEnImportes)
		
		x=round( if(i1>0,(p*i1/100),0), @DecimalesEnImportes)
		y=round( if(i2>0,(p*i2/100),0), @DecimalesEnImportes)
		
		p=p+x+y
		
		x=round( if(i3>0,(p*i3/100),0), @DecimalesEnImportes)
		y=round( if(i4>0,(p*i4/100),0), @DecimalesEnImportes)
		
		p=p+x+y
		
		return round(p, @DecimalesEnImportes)
	}

	#!
	parseImpuesto:: cad, zona
	{
		if trim(cad)==""
		{
			return 0
		}

		ref l=split(cad,"|")

		return val(replace(list.str(l,zona),"%",""))

		exception
		{
			return 0
		}
	}

	#!
	campoPrecioR5::np
	{
		if np>5
		{
			return "precio"+str(100+np)
		}

		return "precio"+str(np)
	}

	#!
	campoPrecioAdcR5::np
	{
		return "padic"+str(np)
	}

	GetDataImpuestos::&db,precio,cantidad,d1,d2,pkimpuesto
    {
		descuentos=d1 + d2
        subtotal=precio *  cantidad
        sub_desc=round(subtotal - descuentos,@DecimalesEnImportes)

        ref imp=TasaImpuesto(db,pkimpuesto)
		
        i1_tasa = @@(imp,"#i1_tasa")
        i2_tasa = @@(imp,"#i2_tasa")
        i3_tasa = @@(imp,"#i3_tasa")
        i4_tasa = @@(imp,"#i4_tasa")

        impuesto1 = round(sub_desc * i1_tasa,@DecimalesEnImportes)
        impuesto2 = round(sub_desc * i2_tasa,@DecimalesEnImportes)
		
        i1_i2 = (impuesto1 + impuesto2)
        sub_desc_i1_i2 = (sub_desc + i1_i2)
        impuesto3 = round(sub_desc_i1_i2 * i3_tasa,@DecimalesEnImportes)
        impuesto4 = round(sub_desc_i1_i2 * i4_tasa,@DecimalesEnImportes)

        i3_i4 = (impuesto3 + impuesto4)
        impuestos = (i1_i2 + i3_i4)
        total = (sub_desc + impuestos)

        new precioInfo
        {
			@"d1":d1
			@"d2":d2
            @"descuentos": descuentos
            @"impuesto1": impuesto1
            @"impuesto2": impuesto2
            @"impuesto3": impuesto3
            @"impuesto4": impuesto4
			@"impuestos": impuestos
            @"total": total
        }
        return precioInfo
    }
    TasaImpuesto::&db,impuesto
    {
        impuesto >> p

        ref imp=dbr.rec(db,ftext("select sys_pk,i1compra,i2compra,i3compra,i4compra,
         (CONVERT(REPLACE(SUBSTRING_INDEX(i.i1venta, '|', #<@zonaImpuesto_sub_index>),'%',''), DECIMAL(18,6)) / 100) AS i1_tasa,
         (CONVERT(REPLACE(SUBSTRING_INDEX(i.i2venta, '|', #<@zonaImpuesto_sub_index>),'%',''), DECIMAL(18,6)) / 100) AS i2_tasa,
         (CONVERT(REPLACE(SUBSTRING_INDEX(i.i3venta, '|', #<@zonaImpuesto_sub_index>),'%',''), DECIMAL(18,6)) / 100) AS i3_tasa,
         (CONVERT(REPLACE(SUBSTRING_INDEX(i.i4venta, '|', #<@zonaImpuesto_sub_index>),'%',''), DECIMAL(18,6)) / 100) AS i4_tasa
         from cfgimpuesto as i where sys_pk=@impuesto"),p)

        if isnull(imp){do rise_error(500,"No se encontró datos del impuesto indicado")}

        return imp
    }
}