#include "dkli.dkh"
#!
module "index.dkl"
{
	#include "functions.dkh"
	#include "serialize.dkh"
	#include "dbr.dkh"
	#include "dbr.vars.dkl"
	#include "dbr.folios.dkl"
	#include "dbr.apps.dkl"
	#include "dbr.security.dkl"

	@SITE_INCLUDES="config.dk,lib.dk,list_query.dk,impuesto.dk"
	#include "website.dkl"
	do _map_function(@lib_dbr,"induxsoft.Connections.Manager","ResetStorage","reset","void","void")
	
	
	@http_context<"response/headers/Access-Control-Allow-Origin">:"*"
	@http_context<"response/headers/Access-Control-Allow-Methods">:"*"//permite al servicio soportar todos los metodos http
    @http_context<"response/headers/Access-Control-Allow-Headers">:"*"//"Content-Type, Authorization, X-Requested-With"

    if @@(@http_context,"request/headers/REQUEST_METHOD")=="OPTIONS"{return}

	method=@@(@http_context,"request/headers/REQUEST_METHOD")
	ref params=@@(@http_context,"&request/get")
	ref postData=@@(@http_context,"&request/post")

   	//comentar esto para ver las linea de los errores
	// do errordet(@false)
	_entity=@@(params,"$entity")
	if isanyword(_entity,"clientes,repartidores") 
	{
		ref db=getDatabase(@@(@config,"$connection"))

		switch _entity
		{
			case "clientes"
			{
				ref clientes=get.clientes(db,params)
				do setResponse(to.json(clientes))
				break
			}
			case "repartidores"
			{
				ref repartidores=getRepartidores(db,params)
				do setResponse(to.json(repartidores))
				break
			}
			// case "destino"
			// {
			// 	ref data = GetDestinationByPhone(db,params)
			// 	do setResponse(to.json(data))
			// 	break
			// }
		}
		
		exception
		{
			new r
			{
				@"success":@false
				@"message":last_error()
			}
			do setResponse(to.json(r))
		}
		if isset("db"){if dbr.is_open(db){do dbr.close(db)}}
		return
	}
	go api_base_service (responseJSONdata:response) 
	{
		
		dm_token=""
		module "Authorization"
		{
			admin=@@(@http_context,"request/headers/HTTP_ADMIN")
			workspace=""
			
			isadmin=@false
			if admin=="" && not(@@(params,"#admin"))
			{
				auth=@@(@http_context,"$request/headers/http_Authorization")
				if auth=="" && method != "GET" { do rise_error(0,"No autorizado") }

				if contains(tolower(auth),"bearer"){ auth=trim(replace(tolower(auth),"bearer","")) }
				ref dauth=split(auth,"+")
				
				if @count(dauth)>1
				{
					workspace=list.str(dauth,0)
					dm_token=list.str(dauth,1)
				}
				
				if dm_token=="" && not(parse.bool(@@(params,"access"))) && @@(params,"id_table")!=@idlogin{ do rise_error(0,"No autorizado") }
			}
			else
			{
				workspace=admin
				isadmin=@true
			}
			if not(@accept_qnames) && contains(workspace,"@"){do rise_error(99,"No se aceptan nombres cualificados.")}
			if workspace == ""{workspace=@@(@config,"$connection")}
			if workspace==""{do rise_error(99,"Falta la conexión a la base de datos.")}

			qname=""
			if @accept_qnames && contains(workspace,"@"){qname=workspace}
			else{qname="Connections@Induxsoft/ws"+workspace+"@workspaces"}

			ref db=getDatabase(qname)
			
			if not(isadmin) && not(parse.bool(@@(params,"access"))) && @@(params,"id_table")!=@idlogin
			{
				if dm_token==""{do rise_error(99,"Sin token de inicio de sesión.")}
				new t{@"token":dm_token}
				if isnull(token.valid(db,t)){do rise_error(99,"El token es inválido o ha sido revocado.")}	
			}
		}
		
		if isnull(postData) && (method=="POST" || method=="PATCH")
		{
			ref postData=from.json(field.dstr(@http_context,"request/post_string","{}"))
		}
		if @@(postData,"action")!=""{method="PATCH"}

		if isnull(postData){ref postData=record.create()}

		@dmtoken=dm_token
		using postData{@"dm_token":dm_token}

		ref data=@null
		@DecimalesEnImportes=parse.num(dbr.vars.get(db,"FXCA001"))
		@validar_existencia=parse.bool(dbr.vars.get(db,"pos_afectar_existencias"))
		do getVarsConfig()
		switch method
		{
			case "GET"
			{
				// do rise_error(0,@@(params,"$entity"))
				if field.exist(params,"prodc") && field.exist(params,"line") || @@(params,"entity")==@idfooddbev{ref data=get.foodbev(db,params)}
				else if field.exist(params,"prodc") || @@(params,"$entity")==@idlines{ref data=get.lines(db,params)}
				else if field.exist(params,"cc") && not(field.exist(params,"zone")){ref data=get.prodc_x_cc(db,params)}
				else if @@(params,"_key")!=""{ref data=data.foodbev(db,params)}

				switch @@(params,"$entity")
				{
					case @idadcdmns
					{
						ref data=get.adds.dmns(db,params)
						break
					}
					case @idwaiters
					{
						if @@(params,"waiter")!=""{ref data=get.dataWaiter(db,params)}
						else{ref data=get.waiters(db,params)}	
						break
					}
					case @idccs
					{
						ref data=get.ccs(db,params)
						break
					}
					case @idzns
					{
						ref data=get.zones(db,params)
						break
					}
					case "ubicacion"
					{
						ref data=get.ubicaciones(db,params) 
						break
					}
					case "cajeros"
					{
						ref data=get.cajeros(db,params) 
						break
					}
					case "cajas"
					{
						ref data=get.cajas(db,params) 
						break
					}
					case "cliente"
					{
						ref data=get.clientes(db,params) 
						break
					}
					case "get-drivers"
					{
						ref data=get.drivers(db,params) 
						break
					}
					case "get-data-ticket"
					{
						ref data=data.ticket(db,params) 
						break
					}
					case "tables"
					{
						if @@(params,"id_table")!=""{ref data=get.mesa(db,params)}
						else{ref data=get.mesas(db,params) }
						break
					}
					case "clientes"
					{
						ref response=get.clientes(db,params)
						return
					}
					case "destino"
					{
						ref data = GetDestinationByPhone(db,params)
						break
					}
					case "validate_existence"
					{
						do validar.existencia(db,params)
						break
					}
					case "load-tickets"
					{
						ref data=get.tickets_procesados(db,params)
						break
					}
					case "load-accounts"
					{
						ref data = get.cuentasDisponibles(db,params)
						break
					}
					case "account-details"
					{
						ref data = get.accountDetails(db,params)
						break
					}
					case "precio-producto"
					{
						ref data=precio.producto(db,params)
						break
					}
				}
			}
			case "POST"
			{
				if @@(params,"id_table")!="" && @@(params,"entity")==@idtables
				{
					ref data=execute.command(db,params,postData)
				}
				else if @@(params,"entity")==@idwaiters
				{
					if @@(params,"waiter")!=""{ref data=update.waiter(db,params,postData)}
					else if @@(params,"id_table")==@idlogin{ref data=login(db,params,postData)}
					else{ref data= insert.waiter(db,params,postData)}
				}
				else if @@(params,"entity")==@idaccessmovil{ref data=insert.accesmovil(db,params,postData)}
				else if @@(params,"entity")==@token{ref data=get.token(db,params,postData)}
				else if @@(params,"$entity")=="cobrar"{ref data=mesa.cobrar(db,params,postData)}
				else if @@(params,"$entity")=="corte"{ref data=pos.cortecaja(db,params,postData)}
				else if @@(params,"$entity")=="ingreso"{ref data=pos.ingreso(db,params,postData)}
				else if @@(params,"$entity")=="egreso"{ref data=pos.egreso(db,params,postData)}
				else if @@(params,"$entity")=="arqueo"{ref data=pos.arqueo(db,params,postData)}
				else if @@(params,"$entity")=="acces-config"{ref data=access.config(db,params,postData)}
				else if @@(params,"$entity")== "search_producto"
				{
					params<"search">:@@(postData,"$input")
					params<"codes*">:@@(postData,"&codes")
					ref data=get.productos(db,params)
				}
				else
				{
					if @@(postData,"$action") == "join" { ref data = joinAccounts(db,params,postData) }
					else { ref data = open.table(db,params,postData) }
				}
			}
			case "PATCH"
			{
				if @@(postData,"$action") == "join" { ref data = joinAccounts(db,params,postData) }
				else if @@(params,"id_table")==""{do rise_error(99,"Falta un identificador de la cuenta")}
				else if @@(postData,"$action")!=""
				{
					switch tolower(@@(postData,"$action"))
					{
						case "open"{ref data=reopen.table(db,params,postData)}
						case "close"{ref data=close.table(db,params,postData)}
						case "uptorder"
						{
							postData<"id_table">:@@(params,"$id_table")
							ref data=update.order(db,postData)
						}
						case "reprint"{ref data=printer_ordertable(db,@@(params,"#id_table"),postData)}
						case "cancel"{ref data=cancel.table(db,params,postData)}
						case "cortesia"{ref data=cortesia.table(db,params,postData)}
						case "enviar"{ref data=table.enviar(db,params,postData)}
						case "change-dealer"{ref data=table.setdealer(db,params,postData)}
						case "entregada"{ref data=table.entregada(db,params,postData)}
						case "enviada"{ref data=table.enviada(db,params,postData)}
						case "savenote"
						{
							ref data=table.savenote(db,params,postData)
							break
						}
						case "print_corte"
						{
							ref data=print.last_corte(db,params,postData)
							break
						}
						case "change_client"
						{
							ref data=change.client(db,params,postData)
							break
						}
						case "change-num-people"
						{
							ref data=change.numpeople(db,params,postData)
							break
						}
						case "split-account"
						{
							ref data=splitAccount(db,params,postData)
							break
						}
						case "cancel-ticket"
						{
							ref data=ticket.cancel(db,params,postData)
							break
						}
						default{do rise_error(99,"Acción no encontrada.")}
					}
				}
			}
			case "PUT"
			{
				if @@(params,"entity")==@idwaiters{ref data=delete.waiter(db,params)}
				else if @@(params,"entity")=="token"{ref data=token.logout(db,params)}
			}
			default{ref data=@null}
		}
		if dbr.is_open(db){do dbr.close(db)}
		using response
		{
			@"success":@true
			@"data*":data
		}

		exception
		{
			if isset("db"){if dbr.is_open(db){do dbr.close(db)}}
			using response
			{
				@"success":@false
				@"message":last_error()
			}
		}
	}
}