    //#region OBTENER DATOS
    obtenerPrecioProducto::&db,&params
    {
        //#region PrecioProducto()
        if not(field.exist(params,"decimals")){ params<"decimals"> : parse.num(dbr.vars.get(db,"FXCA001")) }
        decimals = @@(params,"#decimals")
        cantidad = @@(params,"#cantidad")
        precio = 0

        // Determinar precio estándar, cliente o centro de consumo.
        price_num = dbr.num(db,"select ifnull(precio,0) from cliente where sys_pk = @icliente",params)
        if price_num == 6 { price_num = dbr.num(db,"select ifnull(precio,0) from cconsumo where sys_pk = @icconsumo",params) }
        if price_num < 1{price_num= 1}
        // Campo 'precio#' de la tabla 'producto'.
        price_field = "precio"+str(price_num)

        ref producto = dbr.rec(db,ftext("
            select
                ifnull(flaglimites,0) flaglimites,
                ifnull(lim2,0) lim2,
                ifnull(lim3,0) lim3,
                ifnull(lim4,0) lim4,
                ifnull(lim5,0) lim5,
                ifnull(precio1,0) precio1,
                ifnull(precio2,0) precio2,
                ifnull(precio3,0) precio3,
                ifnull(precio4,0) precio4,
                ifnull(precio5,0) precio5,
                (case @unidad
                    when unidadb then factorb
                    when unidadc then factorc
                    when unidadd then factord
                    when unidade then factore
                    else 1
                end) as factor,
                ifnull(#<price_field>,0) AS PrecioA
            from producto
            where sys_pk = @iproducto
        "),params)

        PrecioA = round(producto.PrecioA, decimals)
        PrecioB = 0
        PrecioC = 0

        // Determinar precio por límites.
        if producto.flaglimites
        {
            if cantidad >= producto.lim2 { PrecioB = round(producto.precio2, decimals) }
            if cantidad >= producto.lim3 { PrecioB = round(producto.precio3, decimals) }
            if cantidad >= producto.lim4 { PrecioB = round(producto.precio4, decimals) }
            if cantidad >= producto.lim5 { PrecioB = round(producto.precio5, decimals) }
        }
        // Determinar precio para un cliente y producto determinado.
        ref precioventa = dbr.rec(db,"select ifnull(precio,0) precio, ifnull(limite,0) limite from precioventa where fk_cliente_listaprecios = @icliente and producto = @iproducto",params)
        if not(isnull(precioventa)) && cantidad >= @@(precioventa,"#limite") { PrecioC = round(precioventa.precio, decimals) }

        // Determinar valor del precio a devolver.
        if PrecioC > 0 { precio = PrecioC }
        else if PrecioB < PrecioA && PrecioB > 0 { precio = PrecioB }
        else { precio = PrecioA }

        new response
        {
            @"success": @true
            @"precio": round(precio * @@(producto,"#factor"), decimals)
        }
        return response

        exception
        {
            do errordet(@false)
            code = last_error_code()
            error = last_error()
            if contains(error,"Unknown column") {
                code = 404
                error = "No fue posible obtener el precio del producto para el Cliente o Centro de consumo seleccionado. En su lugar se tomará el 'Precio 1'."
            }
            do rise_error(code,error)
        }
    }
    print.last_corte::&db,&params,&postData
    {
        do getVarsConfig()

        ref caja=GetCaja(db)
        params<"caja">:@@(caja,"#caja")
        @time_last_corte=@@(@config_default,"#pos_tiempo_max_ult_corte")
        if @time_last_corte < 1{@time_last_corte= 30}
        //obetener el corte que se cerró anteriormente a 30minutos de la caja actual
        corte=dbr.num(db,ftext("SELECT sys_pk FROM corte c WHERE c.icaja=@caja AND c.cerrado=1 
            AND c.hcierre > DATE_ADD(NOW(),INTERVAL -#<@time_last_corte> minute)"),params)
        
        if corte < 1{do rise_error(500,"No hay un corte anterior")}
        
        module "imprimir arqueo"
        {
            ref arqueo=DataArqueo(db,corte)
            arqueo<"_config_prn*">:@@(postData,"&_config_prn")
            do PrintArqueo(db,arqueo)
            // exception{}
        }
        
        do field.remove(arqueo,"http")

        return arqueo
    }
    get.tickets_procesados::&db,&params
    {
        ref caja=GetCaja(db)
        params<"caja">:@@(caja,"#caja")
        @conditionals=""
        sql=@tickets_procesados
        switch tolower(@@(params,"$condition"))
        {
            case "where"
            {
                if trim(@@(params,"$search")) !=""{@conditionals="AND v.`referencia`=@search"}
                break
            }
            case "like"
            {
                if trim(@@(params,"$search")) !=""{@conditionals="AND v.`referencia` LIKE CONCAT('%',@search,'%')"}
                break
            }
            default
            {
                if trim(@@(params,"$search")) != ""
                {
                    @conditionals="AND CONCAT_WS(' ',v.`referencia`) LIKE CONCAT('%',@search,'%')"
                }
                break
            }
        }
        return dbr.list(db,ftext(sql),params)
    }
    get.productos::&db,&params
    {
        return get.foodbev(db,params)
    }

    //#region cuentasDisponibles
    /**
     * Obtiene las cuentas disponibles para apertura o selección.
     *
     * Se combinan dos tipos de registros:
       - Cuentas existentes, correspondientes a documentos de venta vigentes (abiertos o cerrados) asociados a una mesa.
       - Recursos libres, correspondientes a registros de 'dmnsmesa' que no participan en las cuentas vigentes.
     *
     * ---
     * Fecha: 26-08-2026
     * Autor: Francisco Ávila
     */
    get.cuentasDisponibles :: &db, &params
    {
        sql = "
        WITH cuentas AS (
            SELECT
                v.sys_pk,
                trim(v.fecha) fecha,
                v.referencia,
                v.dmnsmesa AS clave,
                ((IFNULL(v.subtotal,0)
                    - IFNULL(v.descuento1,0)
                    - IFNULL(v.descuento2,0))
                    + IFNULL(v.impuesto1,0)
                    + IFNULL(v.impuesto2,0)
                    + IFNULL(v.impuesto3,0)
                    + IFNULL(v.impuesto4,0)
                ) AS total,
                IF(v.statusadministrativo = 1, 'open', 'close') AS `status`
            FROM venta v
            WHERE v.documento = 6
            AND v.statusadministrativo IN (1, 2)
            AND IFNULL(v.sys_info, '') = ''
            AND IFNULL(v.dmnsmesa, '') <> ''
        )

        SELECT sys_pk, fecha, referencia, clave AS `key`, `status`, concat('$ ', format(total, 'C', 'es-MX')) AS amount
        FROM cuentas

        UNION ALL

        SELECT NULL, NULL, '', d.id, 'free', '$ 0.00'
        FROM dmnsmesa d
        WHERE NOT EXISTS (
            SELECT 1
            FROM cuentas c
            -- Secuencia de escape: \\\\ (DKL) => \\ (SQL)
            WHERE c.clave REGEXP CONCAT('(^|\\\\+)', d.id, '($|\\\\+|-|\\\\|)')
        )

        ORDER BY `key`;
        "
        return dbr.list(db,sql,@null)
    }

    //#region accountDetails
    /**
     * Obtiene las partidas (dventa) de la cuenta (venta) proporcionada (id_table).
     * Los datos se usan para poblar el diálogo de "Dividir cuenta".
     *
     * ---
     * Fecha: 02-09-2026
     * Autor: Francisco Ávila
     */
    get.accountDetails :: &db, &params
    {
        sql = "
        SELECT
            d.sys_pk AS `dventa`,
            d.cantidad AS quantity,
            p.descripcion AS descrip,
            (
                ( (ifnull(d.precio,0) * ifnull(d.cantidad,0))
                - ifnull(d.descuento1,0) - ifnull(d.descuento2,0) )
                + ifnull(d.impuesto1,0) + ifnull(d.impuesto2,0) + ifnull(d.impuesto3,0) + ifnull(d.impuesto4,0)
            ) AS amount
        FROM dventa d
            INNER JOIN producto p ON d.iproducto = p.sys_pk
        WHERE d.fk_venta_detalle = @id_table
        "
        return dbr.list(db,sql,params)
    }

