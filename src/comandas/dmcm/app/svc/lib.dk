    //#region PRCESOS
    updateAmounts::&db,vnt_sys_pk
    {
        //#region updateAmounts()
        new params { @"_entity_id": vnt_sys_pk }
        ref amounts = dbr.rec(db,@qry_imp_venta,params)
        do field.remove(amounts,"total")
        do dbr.update(db,"venta",amounts,ftext("sys_pk = @_entity_id"),params)
    }
    promociones_activas::&db
    {
        sql="SELECT *
        FROM promocion p
        WHERE p.activa = 1
        AND (p.fecha_inicio IS NULL OR p.fecha_inicio <= NOW())
        AND (p.fecha_fin IS NULL OR p.fecha_fin >= NOW())
        AND (
                (DAYOFWEEK(CURDATE()) = 1 AND p.domingo = 1)
            OR (DAYOFWEEK(CURDATE()) = 2 AND p.lunes = 1)
            OR (DAYOFWEEK(CURDATE()) = 3 AND p.martes = 1)
            OR (DAYOFWEEK(CURDATE()) = 4 AND p.miercoles = 1)
            OR (DAYOFWEEK(CURDATE()) = 5 AND p.jueves = 1)
            OR (DAYOFWEEK(CURDATE()) = 6 AND p.viernes = 1)
            OR (DAYOFWEEK(CURDATE()) = 7 AND p.sabado = 1)
        )
        AND (
                (MONTH(CURDATE()) = 1  AND p.enero = 1)
            OR (MONTH(CURDATE()) = 2  AND p.febrero = 1)
            OR (MONTH(CURDATE()) = 3  AND p.marzo = 1)
            OR (MONTH(CURDATE()) = 4  AND p.abril = 1)
            OR (MONTH(CURDATE()) = 5  AND p.mayo = 1)
            OR (MONTH(CURDATE()) = 6  AND p.junio = 1)
            OR (MONTH(CURDATE()) = 7  AND p.julio = 1)
            OR (MONTH(CURDATE()) = 8  AND p.agosto = 1)
            OR (MONTH(CURDATE()) = 9  AND p.septiembre = 1)
            OR (MONTH(CURDATE()) = 10 AND p.octubre = 1)
            OR (MONTH(CURDATE()) = 11 AND p.noviembre = 1)
            OR (MONTH(CURDATE()) = 12 AND p.diciembre = 1)
        )
        ORDER BY p.prioridad ASC;"
        ref promos=dbr.list(db,sql,@null)
        ref lpromos=list.create()

        for i = 0; i < @count(promos)
        {
            ref promo=@item(promos,i)
            ref pm=from.json(@@(promo,"$json_config"))
            pm<"id">:@@(promo,"#sys_pk")

            do list.add(lpromos,pm)
        }
        return lpromos
    }
    productos_x_linea::&db,fkventa
    {
        new p{@"venta":fkventa}

        if not(isset("@total_venta")){@total_venta= 0}
        sql="SELECT SUM(dv.cantidad)cantidad,
        dv.precio,
        (SUM(dv.cantidad) * dv.precio)subtotal,
        dv.descuento1,dv.descuento2,TRIM(dv.sys_dtcreated)fecha_captura,
        JSON_OBJECT(
                'id', p.sys_pk,
                'nombre', p.descripcion,
                'linea', JSON_OBJECT(
                    'id', l.sys_pk,
                    'nombre', l.descripcion
                ),
                'marca',JSON_OBJECT(
                    'id', m.sys_pk,
                    'nombre', m.descripcion
                ),
                'depto',JSON_OBJECT(
                    'id', d.sys_pk,
                    'nombre', d.descripcion
                )
            ) AS producto,
            dv.sys_pk as id,
            l.sys_pk as id_linea,
            p.sys_pk as id_producto
        FROM linea l
        INNER JOIN producto p ON l.sys_pk=p.ilinea
        INNER JOIN dventa dv ON p.sys_pk=dv.iproducto
        INNER JOIN venta v ON dv.fk_venta_detalle=v.sys_pk
        LEFT JOIN marca m ON p.imarca=m.sys_pk
        LEFT JOIN departamento d ON p.idepartamento=d.sys_pk
        WHERE v.sys_pk=@venta
        GROUP BY dv.sys_dtcreated,l.sys_pk,p.sys_pk;"

        ref dventas=dbr.list(db,ftext(sql),p)
        for i = 0; i < @count(dventas)
        {
            ref dventa=@item(dventas,i)
            ref producto=from.json(@@(dventa,"$producto"))

            ref grupo=dbr.rec(db,"SELECT gp.sys_pk AS id,gp.sys_pk AS codigo,gp.nombre FROM grupoproductos gp
                            INNER JOIN grupoproductos_producto_ gp_ ON gp.sys_pk=gp_.igrupos
                            WHERE gp_.iproductos=@id
                            AND ifnull(gp.sys_deleted,0)=0
                            ORDER BY gp.sys_pk DESC;",producto)
            
            if not(isnull(grupo)){producto<"grupo*">:grupo}

            if @@(producto,"#depto/id")< 1{do field.remove(producto,"depto")}
            if @@(producto,"#marca/id")< 1{do field.remove(producto,"marca")}

            dventa<"producto*">:producto
            @total_venta= @total_venta + @@(dventa,"#subtotal")
        }

        ref venta=dbr.rec(db,"SELECT v.sys_pk id,v.sys_guid,v.referencia,
        (v.subtotal - (v.descuento1 + v.descuento2)) + v.impuesto1+v.impuesto2 + v.impuesto3 + v.impuesto4 AS total,
        v.subtotal,
        v.descuento1,v.descuento2,v.impuesto1,v.impuesto2,v.impuesto3,v.impuesto4,v.importeadicional
        FROM venta v WHERE v.sys_pk=@venta",p)

        if isnull(venta){do rise_error(500,"No se encontró la venta indicado")}

        ref cliente=ifnull(dbr.rec(db,"SELECT c.sys_pk id,c.codigo,c.nombre,c.tipo AS itipo FROM cliente c
                        INNER JOIN venta v ON c.sys_pk=v.icliente
                        WHERE IFNULL(c.sys_deleted,0)=0
                        AND v.sys_pk=@venta",p),record.create())

        cliente<"tipo*">:dbr.rec(db,"SELECT t.sys_pk AS id,t.codigo,t.descripcion AS nombre FROM tipocliente t WHERE t.sys_pk=@itipo;",cliente)

        ref cgrupo=dbr.rec(db,"SELECT gc.sys_pk AS id,gc.sys_pk AS codigo,gc.nombre FROM grupoclientes gc
                        INNER JOIN cliente_grupoclientes_ cg ON gc.sys_pk=cg.igrupos
                        WHERE IFNULL(gc.sys_deleted,0)=0
                        AND cg.iclientes=@id
                            ORDER BY gc.sys_pk desc;",cliente)

        if not(isnull(cgrupo)){cliente<"grupo*">:cgrupo}

        venta<"lineas*">:dventas
        venta<"cliente*">:cliente
        return venta
    }
    apply_descuento::&db,&dventa,&linea,venta
    {
        ref producto=@@(linea,"&producto")
        
        _impuesto=dbr.num(db,"select impuestos from producto where sys_pk=@id",producto)
        ref dt_imp= GetDataImpuestos(db,@@(linea,"#precio"),@@(dventa,"#cantidad"),@@(linea,"#descuento1"),@@(linea,"#descuento2"),_impuesto)
        
        descuento1=@@(linea,"#descuento1")
        descuento2=@@(linea,"#descuento2")
        new reg_dventa
        {
            @"impuesto1":@@(dt_imp,"#impuesto1")
            @"impuesto2":@@(dt_imp,"#impuesto2")
            @"impuesto3":@@(dt_imp,"#impuesto3")
            @"impuesto4":@@(dt_imp,"#impuesto4")
            @"descuento1":descuento1
            @"descuento2":descuento2
            // @"descuento1*":dbr.sql(ftext("IFNULL(descuento1,0) + #<descuento1>"))
            // @"descuento2*":dbr.sql(ftext("IFNULL(descuento2,0) + #<descuento2>"))
        }
        do dbr.update(db,"dventa",reg_dventa,"sys_pk=@sys_pk",dventa)

        reg_dventa<"id_dventa">:@@(dventa,"$id_dventa")
        do dbr.execute(db,"UPDATE dorden set d1=@descuento1,d2=@descuento2 where sys_guid=@id_dventa",reg_dventa)
    }
    get_dventas_captura::&db,&linea
    {
        sql="SELECT dv.sys_pk,dv.cantidad,dv.sys_guid id_dventa FROM dventa dv 
        INNER JOIN producto p ON dv.iproducto=p.sys_pk
        WHERE dv.sys_dtcreated=@fecha_captura 
        AND p.ilinea=@id_linea
        AND p.sys_pk=@id_producto"

        return dbr.list(db,sql,linea)
    }
    desc_x_unidad::cant_reg,descuento_total,cantidad_total
    {
        return cant_reg * div(descuento_total,cantidad_total)
    }
    apply_descuento_create_traza::&db,&trazas,&lineas,venta,slot_promocional
    {
        if @count(trazas) < 1{return}

        for i = 0; i < @count(trazas)
        {
            ref traza=@item(trazas,i)
            ref linea=@item(lineas,@@(traza,"#linea_idx"))
            
            tipo_aplicacion=dbr.num(db,"select id from ctipoaplicacionpromocion where trim(lower(const))=trim(lower(@tipo))",traza)
            fk_promocion=dbr.num(db,"select sys_pk from promocion where codigo=@promocion",traza)
            ref dventas=get_dventas_captura(db,linea)

            for j = 0; j < @count(dventas)
            {
                ref dventa=@item(dventas,j)
                
                monto=desc_x_unidad(@@(dventa,"#cantidad"),@@(linea,"#"+slot_promocional),@@(linea,"#cantidad"))
                // traza<"monto">:monto

                do apply_descuento(db,dventa,linea,venta)

                ref now=dbr.sql("now()")
                new trazapromocion
                {
                    @"sys_guid":uuid()
                    @"sys_dtcreated*":now
                    @"sys_timestamp*":now
                    @"sys_recver":0

                    @"fk_venta":venta
                    @"fk_dventa":@@(dventa,"#sys_pk")
                    @"fk_promocion":fk_promocion

                    @"tipo_aplicacion":tipo_aplicacion
                    @"slot":slot_promocional
                    @"monto":monto

                    @"parametros":to.json(traza)
                    @"fecha_aplicacion*":now
                }
                do dbr.insert(db,"trazapromocion",trazapromocion)
            }
        }

        do updateAmounts(db,venta)
    }
    ref @data_promocion=@null
    /*
    * Summary:
    - db -> referencia a la base de datos
    - data objecto
    new data
    {
        @"producto":{}
        @"ventatotal":{}
    }
    - venta sys_pk de la tabla venta
    */

    save_data_promocion::&db,venta,&data,&promociones
    {
        venta >> p

        do dbr.execute(db,"DELETE FROM detailpromocion where fk_venta=@venta",p)

        new detailpromocion
        {
            @"sys_guid":uuid()
            @"sys_dtcreated*":dbr.sql("now()")
            @"sys_timestamp*":dbr.sql("now()")
            @"sys_recver": 0

            @"fk_venta":venta
            @"data_promocion":to.json(data)
            @"promociones":to.json(promociones)
        }

        do dbr.insert(db,"detailpromocion",detailpromocion)
    }
    field_descuento_orden::slot_promocional
    {
        return ifstr(tolower(trim(slot_promocional)) == "descuento2","d2","d1")
    }
    apply_promo::&db,&params
    {
        ref promos=promociones_activas(db)
        if @count(promos) < 1{return}

        ref venta=productos_x_linea(db,@@(params,"#venta"))

        metodo=parse.num(GetVars("FXCA021"))
        metodo_desc=trim(@@(@metodoDescuento,"$"+str(metodo)))
        if metodo_desc == ""{metodo_desc=@@(@metodoDescuento,"$1")}

        referencia_temporal=trim(GetVars("ventas_promo_referencia_temporal"))
        if referencia_temporal == ""{referencia_temporal=@@(@config_pos,"$def_referencia_temporal")}

        slot_promocional=trim(GetVars("ventas_slot_promocional"))
        if slot_promocional == ""{slot_promocional=@@(@config_pos,"$def_slot_promocional")}

        new configs 
        {
            @"referencia_temporal":referencia_temporal //"captura"
            @"slot_promocional": slot_promocional //"descuento2"
            @"decimales_redondeo": @@(@config_default,"#decimal_money")
            @"metodoDescuento": metodo_desc//"sustraccion"
        }

        /*
         * Summary:
         * - Actualizar campo de slot en la dventa
         * - Eliminar trazas y detalles de promoción de la venta indicada
        */
        field_descuento_ord=field_descuento_orden(slot_promocional)

        do dbr.execute(db,"UPDATE dorden d
        INNER JOIN orden o ON d.fk_orden_detalle=o.sys_pk
        SET d."+field_descuento_ord+"=0
        WHERE o.iventa=@venta;",params)

        ref details = dbr.list(db,"SELECT d.*, p.impuestos FROM dventa d INNER JOIN producto p ON d.iproducto=p.sys_pk WHERE d.fk_venta_detalle=@venta",params)
        for i = 0; i < list.count(details)
        {
            ref dventa = list.obj(details,i)
            
            descuento1 = if(slot_promocional=="descuento1", 0, @@(dventa,"#descuento1"))
            descuento2 = if(slot_promocional=="descuento2", 0, @@(dventa,"#descuento2"))
            
            ref amounts = GetDataImpuestos(db, @@(dventa,"#precio"), @@(dventa,"#cantidad"), descuento1, descuento2, @@(dventa,"#impuestos"))
            new taxes
            {
                @"descuento1": descuento1
                @"descuento2": descuento2
                @"impuesto1": @@(amounts,"#impuesto1")
                @"impuesto2": @@(amounts,"#impuesto2")
                @"impuesto3": @@(amounts,"#impuesto3")
                @"impuesto4": @@(amounts,"#impuesto4")
            }
            
            do dbr.update(db,"dventa",taxes,"sys_pk=@sys_pk",record.copy(dventa,"sys_pk"))
        }
        // do dbr.execute(db,"UPDATE dventa SET "+slot_promocional+"=0 WHERE fk_venta_detalle=@venta",params)
        do dbr.execute(db,"DELETE FROM trazapromocion WHERE fk_venta=@venta",params)
        do dbr.execute(db,"DELETE FROM detailpromocion WHERE fk_venta=@venta",params)

        /*
         * Summary:
         * aplicar promociones por productos y condiciones
         * guardar traza
        */
        ref promo_productos = promociones.motor.calcular_promociones_productos(venta, promos, configs)
        do apply_descuento_create_traza(db,@@(promo_productos,"&traza"),@@(promo_productos,"&venta/lineas"),@@(params,"#venta"),@@(configs,"$slot_promocional"))
        /*
         * Summary:
         * aplicar promociones por venta total
        */
        ref promo_total = promociones.motor.calcular_promociones_total(venta, promos, configs, @total_venta)
        do apply_descuento_create_traza(db,@@(promo_total,"&traza"),@@(promo_total,"&venta/lineas"),@@(params,"#venta"),@@(configs,"$slot_promocional"))
        /*
         * Summary:
         * - guardar datos de la promoción
        */
        ref @data_promocion=record.create()
        using @data_promocion
        {
            @"producto*":promo_productos
            @"ventatotal*":promo_total
            @"configs*":configs
        }

        do save_data_promocion(db,@@(params,"#venta"),@data_promocion,promos)

        @data_promocion<"promociones*">:promos
    }
    get_config::&db,cconsumo
    {
        cconsumo >> p
        str_config=dbr.str(db,"SELECT config from cconsumo where sys_pk=@cconsumo",p)

        if trim(str_config)!=""
        {
            return from.json(str_config)
        }

        // exception{}

        new config
		{
			@"option":"any"
			@"grupo":-1
			@"clases*":from.json('["2","6"]')
		}

        return config
    }
    exist.value.num::&l,value
    {
        for i = 0; i < @count(l)
        {
            n=parse.num(list.str(l,i))
            if n==value{return @true}
        }
        return @false
    }
    /*
    *```
    * transactions.globalpay ()
    * Descripción: 
    * Busca las transacciones realizadas con tarjeta en relació a la venta y devuelve la lista de transacciones
    * Parámetros
    *  - db conexion hacia la base de datos
    *  - venta - sys_pk de la venta
    * Summary
    * puede muchas trasacciones canceladas , falladas, devoluciones pero está función devuelve las transacciones vigentes y con AuthResultCode='00'
    *```
    */
    transactions.globalpay::&db,venta
    {
        ref ltransactions=list.create()
        //verificar table de globalpay
        exit_table_card_procesor=TableExist(db,"globalpay")
        new p{@"idt":venta}
        if exit_table_card_procesor
        {
            ref transactions=dbr.list(db,@sql_transaciones_realizadas,p)
            for i = 0; i < @count(transactions)
            {
                ref trans=@item(transactions,i)
                ref response=from.json(@@(trans,"$response"))
                if @@(response,"$AuthResultCode") == "00"{do list.add(ltransactions,response)}
            }
        }

        return ltransactions
    }
    ticket.cancel::&db,&params,&postData
    {
        ref movcaja=record.create()
        ref venta=dbr.rec(db,ftext("SELECT 
        v.sys_pk,
        v.sys_guid,
        v.`referencia`,
        v.`statusadministrativo` as `statusadministrativo`,
        v.`statusentrega` as `statusentrega`,
        v.`statusfacturacion` as `statusfacturacion`,
        v.`statusfinanciero` as `statusfinanciero`,
        v.`formapago` as formapago,
        v.`iagente` as `iagente`,
        v.`icaja` as `icaja`,
        v.`icconsumo` as `icconsumo`,
        v.`icliente` as `icliente`,
        v.`icorte` as `icorte`,
        v.`idivisa` as `idivisa`,
        v.`ifolio` as `ifolio`,
        v.tipocambio,
        ((((((IFNULL(v.subtotal,0)
                - IFNULL(v.descuento1,0))
                - IFNULL(v.descuento2,0))
                + IFNULL(v.impuesto1,0))
                + IFNULL(v.impuesto2,0))
                + IFNULL(v.impuesto3,0))
                + IFNULL(v.impuesto4,0)
            ) AS total,
        v.documento,
        v.imovcaja
        FROM venta v 
        WHERE v.sys_pk=@id_table
        AND V.statusadministrativo=#<@stt_adm_procesado>"),params)

        if isnull(venta){do rise_error(404,"No se encontró la venta indicada o no esta disponible")}
        corte= 0
        do dbr.begin(db)
        // 1. Se regresa la mercancía que haya salido con las  salvedades de la configuración
        // verificar si la venta realizó salida de inventario
        pk_cardex=dbr.num(db,"SELECT ifnull(sys_pk,0) FROM cardex WHERE (docventa=@sys_pk OR referencia=@referencia)",venta)
        if pk_cardex > 0 // realizar entrada
        {
            ref dventas=dbr.list(db,"SELECT dv.sys_pk,dv.ialmacen,dv.iproducto,ifnull(dv.xsalir,dv.cantidad) cantidad,p.costopromedio,p.costoultimo,
            (((IFNULL(dv.precio,0) * IFNULL(dv.cantidad,0)) - IFNULL(dv.descuento1,0)) - IFNULL(dv.descuento2,0)) AS cargos,
            dv.tipocambio,v.icliente,p.iclase
            FROM dventa dv 
            INNER JOIN dcardex dc on dv.sys_pk=dc.rventa
            INNER JOIN venta v ON dv.fk_venta_detalle=v.sys_pk
            INNER JOIN producto p ON dv.iproducto=p.sys_pk
            WHERE v.sys_guid=@sys_guid;",venta)

            ref config =get_config(db,@@(venta,"#icconsumo"))
            
            if @count(dventas) > 0
            {
                ref @LAST_DCARDEX=@null

                //cargar configuracion del centro de consumo
                almacen=@@(config,"#almacen")
                if isanyword(@@(config,"$option"),"all,any") && almacen < 1{do rise_error(500,"No ha configurado un almacén de mermas y devoluciones en el centro de consumo")}

                code_cat=dbr.vars.get(db,"v12.ventas.devinv")
                code_cat >> _p
                categoria=dbr.num(db,"SELECT ifnull(sys_pk,0) FROM categoria where codigo=@code_cat",_p)

                if categoria < 1{do rise_error(500,"No ha configurado una categoría:  v12.ventas.devinv")}
                
                new cardex
                {
                    @"sys_guid":uuid()
                    @"sys_dtcreated*":dbr.sql("now()")
                    @"sys_timestamp*":dbr.sql("now()")
                    @"sys_info":"flex-pos"
                    @"sys_recver": 0
                    @"descripcion":"Entrada por cancelación de venta: "+@@(venta,"$referencia")
                    @"icategoria":categoria
                    @"referencia":"DEV_"+@@(venta,"$referencia")
                    @"fecha*":dbr.sql("now()")
                    @"docventa":@@(venta,"#sys_pk")
                }

                do dbr.insert(db,"cardex",cardex)
                cardex<"sys_pk">:dbr.num(db,"SELECT sys_pk FROM cardex WHERE sys_guid=@sys_guid",cardex)

                for i = 0; i < @count(dventas)
                {
                    ref dv=@item(dventas,i)
                    almacen=@@(dv,"#ialmacen")
                    //verificar configuracion
                    switch @@(config,"$option")
                    {
                        case "all"
                        {
                            almacen=@@(config,"#almacen")
                            break
                        }
                        case "any"
                        {
                            if @@(config,"#grupo") < 1
                            {
                                //buscar por clase
                                if exist.value.num(@@(config,"&clases"),@@(dv,"#iclase")){almacen=@@(config,"#almacen")}
                            }
                            else
                            {
                                if exist.value.num(@@(config,"&clases"),@@(dv,"#iclase"))
                                {
                                    new p
                                    {
                                        @"grupo":@@(config,"#grupo")
                                        @"producto":@@(dv,"#iproducto")
                                    }
                                    if dbr.num(db,"SELECT ifnull(sys_pk,0) FROM grupoproductos_producto_ gp WHERE gp.igrupos=@grupo AND gp.iproductos=@producto;",p) > 0
                                    {
                                        almacen=@@(config,"#almacen")
                                    }
                                }
                            }
                            break
                        }
                    }
                    cantidad=@@(dv,"#cantidad")
                    new dcardex
                    {
                        @"sys_guid":uuid()
                        @"sys_dtcreated*":dbr.sql("now()")
                        @"sys_timestamp*":dbr.sql("now()")
                        @"sys_info":"flex-pos"
                        @"sys_recver": 0
                        @"ialmacen":almacen
                        @"iproducto":@@(dv,"#iproducto")
                        @"referencia":cut(uuid(),30)
                        @"entradas": cantidad
                        @"salidas":0
                        @"rventa":@@(dv,"#sys_pk")
                        @"fk_cardex_movimientos":@@(cardex,"#sys_pk")
                        @"cargos":@@(dv,"#cargos")
                    }

                    do dbr.insert(db,"dcardex",dcardex)
                }
                do erp.inventario.aplicar_mov(db,@@(cardex,"#sys_pk"),@false)
            }
        }
        // 2. Se devuelve el efectivo (ojo si se procesó una tarjeta) o se aplica nota de crédito (cxc) si fue a crédito
        if @@(venta,"#formapago") == @fp_credito
        {
            // Liberar a las cotizaciones o pedidos relacionados (`aplicadoa` y `xfacturar`).
            params<"_entity_id">:dbr.num(db,"SELECT sys_pk FROM dcxc d WHERE d.iventa=@sys_pk AND d.documento=@documento",venta)
            doctype = ftext("#<@cCotizacion>,#<@cPedido>")
            do dbr.execute(db,ftext(@qry_liberar_documentos),params)

            // Realizar la entrada de todos los productos que salieron por este documento al mismo costo de la salida.
            // do erp.ventas.procesos.cancelacion(db,@@(venta,"#sys_pk"))
            // Generar un movimiento a CxC inverso al que hubiere generado.
            do erp.ventas.procesos.reverseCxC(db,@@(venta,"#sys_pk"))

            movcaja<"reload">:@true
        }
        //efectivo o cualquier movimiento de caja
        if @@(venta,"#imovcaja") > 0
        {
            //verificar efectivo,tarjeta,depositos,vale
            //realizar retiro
            ref saldos=dbr.rec(db,"SELECT m.sys_pk,m.tarjetas,
            m.vales,m.depositos,m.efectivo,m.cheques
            FROM movcaja m WHERE m.sys_pk=@imovcaja;",venta)

            cheques=@@(saldos,"#cheques")
            vales=@@(saldos,"#vales")
            depositos=@@(saldos,"#depositos")
            tarjetas =@@(saldos,"#tarjetas")
            efectivo=@@(saldos,"#efectivo")

            tsaldos=cheques + vales + depositos + tarjetas + efectivo

            /*
             * Summary:
             * Si existe saldo en la caja en relacion a la venta , realizar un retiro de todo
             * 
             */
            if tsaldos > 0
            {
                cat_devefec=dbr.vars.get(db,"v12.ventas.devefec")

                if cat_devefec==""{do rise_error(500,"No ha configurado una categoría para realizar el egreso por cancelación de venta 'v12.ventas.devefec' ")}
                ref movcaja_egreso_fpagos=_CopyFieldsMov(PrepareMovCaja(db,GetCategoriaByCodigo(db,cat_devefec),0,"Devolución de mercancía por documento:"+@@(venta,"$referencia")))
                
                movcaja_egreso_fpagos<"referencia">:"DEV_"+@@(venta,"$referencia")
                
                if cheques > 0{movcaja_egreso_fpagos<"cheques">:cheques * -1}
                if vales > 0{movcaja_egreso_fpagos<"vales">:vales * -1}
                if tarjetas > 0{movcaja_egreso_fpagos<"tarjetas">:tarjetas * -1}
                if depositos > 0{movcaja_egreso_fpagos<"depositos">:depositos * -1}
                if efectivo > 0{movcaja_egreso_fpagos<"efectivo">:efectivo * -1}

                corte >> movcaja_egreso_fpagos
                movcaja_egreso_fpagos<"documento">:@DOCUMENTO_EGRESO
                ref movcaja=_insertMovcaja(db,movcaja_egreso_fpagos)

                /*
                 * Summary:
                 * Obtener datos del retiro(egreso) para imprimirlo como ticket
                 * - el objeto printer es importante ya que el js verifica si viene y así dispara a imprimir los datos
                 */
                movcaja<"printer*">:PrintIngresoEgreso(db,movcaja,"EGRESO",@@(postData,"&_config_prn"),@false)
            }
        }
        //verificar si existen transacciones de globalpay
        ref trans=transactions.globalpay(db,@@(venta,"#sys_pk"))
        if @count(trans) > 0{movcaja<"message">:"Se ha cancelado la venta mas sin embargo existe transacciones realizas con globalpay, dirijase al módulo de cancelación de transacciones y realice la cancelación de la venta: "+@@(venta,"$referencia")}
        // 3. Se marca la venta como "Cancelada"
        new status
        {
            @"statusadministrativo":@stt_adm_cancelado
            @"statusentrega":@stt_ent_na
            @"statusfinanciero":@stt_fin_na
        }
        do dbr.update(db,"venta",status,"sys_pk=@sys_pk",venta)

        do dbr.commit(db)

        return movcaja

        exception
        {
            if dbr.in_transaction(db){do dbr.rollback(db)}
            do rise_error(500,last_error())
        }
    }
    change.numpeople::&db,&params,&postData
    {
        if @@(postData,"#people") < 1 { do rise_error(400,"No se indicó una cantidad válida") }
        if dbr.num(db,"SELECT sys_pk FROM venta where sys_pk=@id_table",params) < 1 { do rise_error(404,"No se encontró la cuenta indicada") }

        params<"people"> : @@(postData,"#people")
        do dbr.execute(db,"UPDATE venta SET dmnspersonas = @people WHERE sys_pk = @id_table",params)

        return @null
    }
    change.client::&db,&params,&postData
    {
        if dbr.num(db,"SELECT sys_pk FROM venta where sys_pk=@id_table",params) < 1{do rise_error(500,"No se encontró la cuenta indicado")}

        if @@(postData,"#client") < 1{do rise_error(500,"No se encontró el cliente indicado")}

        new data{@"icliente":@@(postData,"#client")}

        do dbr.update(db,"venta",data,"sys_pk=@id_table",params)

        return @null
    }
    table.savenote::&db,&params,&postData
    {
        notas=trim(@@(postData,"$nota"))

        efectivo=parse.bool(@@(postData,"$efectivo"))
        tarjeta=parse.bool(@@(postData,"$tarjeta"))

        if efectivo || tarjeta
        {
            notas=notas + "\n\nForma de pago\n"
            notas=notas + ifstr(efectivo,"- Efectivo","")
            notas=notas + ifstr(tarjeta,"- Tarjeta","")
        }

        params<"nota_full">:notas
        params<"nota">:cut(notas,255)
        
        do dbr.execute(db,"UPDATE venta SET dmnsnota=@nota WHERE sys_pk=@id_table",params)
        do dbr.execute(db,"UPDATE dmns_destino d 
        INNER JOIN dmns_entrega e ON d.sys_pk=e.venta
        SET d.notas=@nota_full
        WHERE e.venta=@id_table",params)

        return @null
    }
    //validar existencia
    validar.existencia::&db,&params
    {
        ref dt= token.data.validate(db,@true)
        if not(@validar_existencia){return @null}
        
        params<"almacen">:dbr.num(db,"SELECT ialmacen FROM cconsumo WHERE sys_pk=@cc",params)
        existencia=dbr.num(db,"SELECT IFNULL(SUM(IFNULL(e.existencia,0)),0) from existencias e WHERE e.fk_producto_iexistencias=@prod AND e.ialmacen=@almacen;",params)
        if (existencia - @@(params,"#reserved")) < 1{do rise_error(500,"El producto no cuenta con existencia en el almacén del centro de consumo")}

        return @true
    }
    //ingreso y egreso
    pos.ingreso::&db,&params,&postData
    {
        ref data=_CopyFieldsMov(postData)
        data<"documento">:@DOCUMENTO_INGRESO
        ref movcaja=_insertMovcaja(db,data)

        movcaja<"printer*">:PrintIngresoEgreso(db,movcaja,"INGRESO",@@(postData,"&_config_prn"),@true)
        
        return movcaja
    }
    pos.egreso::&db,&params,&postData
    {
        ref data=_CopyFieldsMov(postData)
        data<"documento">:@DOCUMENTO_EGRESO
        data<"efectivo">:@@(data,"#efectivo") * -1

        ref movcaja=_insertMovcaja(db,data)
        movcaja<"printer*">:PrintIngresoEgreso(db,movcaja,"EGRESO",@@(postData,"&_config_prn"),@false)
        return movcaja
    }
    PrintIngresoEgreso::&db,&movcaja,title,&config,is_ingreso
    {
        ref config=PrnParseConfig(db,config)
        if isnull(config){return @null}
        
        ref datacorte=GetCajaCorte(db)
        ref cajero=dbr.rec(db,"select cj.sys_pk,cj.codigo,cj.nombre from cajero cj
                    inner join corte ct on cj.sys_pk=ct.icajero
                    where ct.sys_pk=@corte",datacorte)

        ref caja=dbr.rec(db,"SELECT sys_pk,codigo,descripcion FROM caja WHERE sys_pk=@caja;",datacorte)
        ref categoria=dbr.rec(db,"SELECT sys_pk,codigo,descripcion FROM categoria c WHERE c.sys_pk=@icategoria;",movcaja)
        ref divisa=dbr.rec(db,"SELECT sys_pk,codigo,descripcion FROM divisa c WHERE c.sys_pk=@idivisa;",movcaja)

        new headers
        {
            @"cajero":"CAJERO: "+@@(cajero,"$nombre")
            @"caja":"CAJA: "+@@(caja,"$descripcion")
        }

        new body
        {
            @"referencia":"REFERENCIA: "+@@(movcaja,"$referencia")
            @"categoria":"CATEGORIA: "+@@(categoria,"$descripcion")
            @"divisa":"DIVISA: "+@@(divisa,"$descripcion")
        }

        new saldos
        {
            @"efectivo":"Efectivo: "
            @"str_efectivo":number_format(@@(movcaja,"#efectivo"))
            @"total":number_format(@@(movcaja,"#efectivo"))
        }

        new extras
        {
            @"notas":"NOTAS: "+@@(movcaja,"$notas")
        }

        new data
        {
            @"database*":db
            @"title":title
            @"headers*":headers
            @"body*":body
            @"saldos*":saldos
            @"extras*":extras
            
        }
        
        if @@(config,"#req_data"){return data}
        
        data<"movcaja*">:movcaja
        data<"http*">:@http_context
        data<"config*">:config
        
        do ExecutePrinter(db,GetFilePrn(ifstr(is_ingreso,"prn_ingreso.dkl","prn_egreso.dkl")),data)

        return @null
        
        exception{}
    }
    _insertMovcaja::&db,&data
    {
        corte=@@(data,"#corte")
        do field.remove(data,"corte")
        if corte < 1
        {
            ref datacorte=GetCajaCorte(db)
            corte=@@(datacorte,"#corte")
            if corte < 1{do rise_error(500,"No se econtró un corte de caja abierto")}
        }
        
        using data
        {
            @"sys_guid":uuid()
            @"sys_dtcreated*":dbr.sql("now()")
            @"sys_timestamp*":dbr.sql("now()")
            @"sys_exported":0
            @"sys_dtexported*":dbr.sql("now()")
            @"sys_recver":0
            @"icorte": corte  
        }
        if not(field.exist(data,"auditado")){data<"auditado">: 1}
        if not(field.exist(data,"cheques")){data<"cheques">: 0}
        if not(field.exist(data,"contabilizado")){data<"contabilizado">: 0}
        if not(field.exist(data,"depositos")){data<"depositos">: 0}
        if not(field.exist(data,"efectivo")){data<"efectivo">: 0}
        if not(field.exist(data,"referencia")){data<"referencia">: uuid()}
        if not(field.exist(data,"tarjetas")){data<"tarjetas">: 0}
        if not(field.exist(data,"tipocambio")){data<"tipocambio">: 1}
        if not(field.exist(data,"vales")){data<"vales">: 0}
        if not(field.exist(data,"fecha")){data<"fecha*">: dbr.sql("now()")}
        if not(field.exist(data,"hora")){data<"hora*">: dbr.sql("now()")}
        if not(field.exist(data,"idivisa")){data<"idivisa">: GetDivisaPredet(db)}


        do dbr.insert(db,"movcaja",data)

        return data
    }
    
    mesa.cobrar::&db,&params,&postData
    {
        do getVarsConfig()

        sql="select
            qv.dmnsmesa as 'code',
            qv.sys_pk as 'sys_pk',
            qv.sys_guid as 'sys_guid',
            qv.referencia as 'reference',
            qv.statusadministrativo as 'status',
            qv.dmnspersonas as 'occupied_seats',
            qv.notas,
            qv.dmnsnota as 'notetable',
            qv.total as 'balance',
            '' as 'owner',
            0 as is_birthday,
            0 as is_celebration,
            qv.icliente as 'cliente',
            qv.icconsumo as 'cc',
            qv.iagente as 'ag',
            qv.idivisa AS 'divisa', 
            qv.tipocambio AS 'tcambio',
            qv.sys_info as service,
            qv.documento,
            c.diascredito,
            qv.formapago
        from
            qventasserviciomesa qv
            INNER JOIN cliente c on qv.icliente=c.sys_pk
        where
            qv.sys_pk = @venta "

        @mpago=tolower(trim(@@(postData,"$mpago")))

        ref totales=@@(postData,"&totales")
        ref rsource=dbr.rec(db,sql,postData)
        if @@(rsource,"#balance") < 0.1{do rise_error(500,"No existe un monto a cobrar")}
        //obtener datos de la sesión
        do token.data.validate(db,@true)

        ref datatoken=dbr.rec(db,"select * from ut_dn_dmm_token where token=@dm_token",postData)
        if isnull(datatoken){do rise_error(500,"Datos del token no econtrado")}
        if trim(@@(datatoken,"$datos"))==""{do rise_error(500,"No hay registrado del inicio de sesión, vuelva iniciar sesión")}

        ref datos=from.json(@@(datatoken,"$datos"))
        corte=@@(datos,"#corte")
        if  corte > 0 && field.exist(datos,"corte")
        {
            //verificar corte si esta abierto
            iscerradocorte=dbr.num(db,"select ifnull(cerrado,0) from corte where sys_pk=@corte",datos)
            if iscerradocorte{do rise_error(99,"El corte obtenido ya esta cerrado, vuelva iniciar sesión")}
        }
        else
        {
            ref cajas_agente=dbr.rec(db,"select caja,caja2 from agente where codigo=@key",datos)
            if @@(cajas_agente,"#caja")< 1 && @@(cajas_agente,"#caja2")< 1{do rise_error(500,"El agente no tiene una caja relacionada")}
            corte=dbr.num(db,"SELECT sys_pk FROM corte c WHERE c.icaja=@caja AND IFNULL(c.cerrado,0)=0;",cajas_agente)
            if corte < 1{corte=dbr.num(db,"SELECT sys_pk FROM corte c WHERE c.icaja=@caja2 AND IFNULL(c.cerrado,0)=0;",cajas_agente)}

            if corte < 1{do rise_error(500,"No se encontró un corte abierto en relación al agente")}
        }
        
        do dbr.begin(db)

        //actualizar cliente
        if @@(postData,"#client") > 0 && @@(postData,"#client") != @@(rsource,"#cliente")
        {
            params<"id_table">:@@(postData,"#venta")
            do change.client(db,params,postData)
            //obtener los datos del nuevo cliente
            ref rsource=dbr.rec(db,sql,postData)
        }

        postData<"icorte">:corte

        ref movcaja=record.create()

        pos_afectar_existencias=parse.bool(dbr.vars.get(db,"pos_afectar_existencias"))
        
        switch @mpago
        {
            case "credito"
            {
                @venta_fpago=@fp_credito
                new data
                {
                    @"procesar_salida":@false //no realizar salida, para tener mas control en las salidas
                    @"iventa": @@(postData,"#venta")//(int) Clave primaria del documento de venta a procesar.
                    @"icliente":@@(rsource,"#cliente") //(int) Clave primaria del cliente.
                    @"flimite":dbr.str(db,"SELECT date_format(DATE_ADD(NOW(),INTERVAL IFNULL(@diascredito,0) DAY),'%Y-%m-%d') ",rsource) //(string) Fecha [yyyy-MM-dd] limite.
                    @"referencia":@@(rsource,"$reference") //(string) Referencia del documento de venta.
                    @"documento": @@(rsource,"#documento")//(int) Clave primaria del tipo de documento de la venta.
                    @"concepto": ifstr(trim(@@(postData,"$concepto"))=="","Venta a crédito: "+@@(rsource,"$reference"),@@(postData,"$concepto"))//(string) Descripción de la operación
                }
                do erp.ventas.procesos.liquidacionCredito(db,data)
                break
            }
            default
            {
                @venta_fpago=@fp_contado
                code_cat=dbr.vars.get(db,"pos_cat_movcaja")
                code_cat >> _p
                categoria=dbr.num(db,"SELECT ifnull(sys_pk,0) FROM categoria where codigo=@code_cat",_p)
                if categoria < 1{do rise_error(500,"No ha configurado una categoría:  pos_cat_movcaja")}

                new movcaja
                {
                    @"sys_recver": 0
                    @"sys_guid":uuid()
                    @"sys_timestamp*":dbr.sql("now()")
                    @"sys_dtcreated*":dbr.sql("now()")
                    @"sys_exported": 0
                    @"sys_dtexported*":dbr.sql("now()")
                    @"auditado": 1
                    @"cheques": 0
                    @"contabilizado": 0
                    @"depositos": 0
                    @"documento": @documento_venta //ticket
                    @"efectivo":@@(postData,"#efectivo")
                    @"fecha*":dbr.sql("now()")
                    @"hora*":dbr.sql("now()")
                    @"notas":" Cobro de venta con referencia "+@@(rsource,"$reference")
                    @"referencia":toupper(uuid())
                    @"tarjetas":@@(postData,"#importe_tarjeta")
                    @"tipocambio": @@(rsource,"#tcambio")
                    @"vales": 0
                    @"icategoria":categoria
                    @"icorte": corte 
                    @"idivisa":@@(rsource,"#divisa")
                }
                
                ref divisa=dbr.rec(db,"select sys_pk,codigo,descripcion from divisa where sys_pk=@idivisa",movcaja)

                ref data_array=@@(postData,"&data_array")
                if field.exist(postData,"data_array") && @count(data_array) > 0{ref datarjeta=GetDataTarjeta(db,data_array)}
                else{ref datarjeta=GetDataTarjetaByVenta(db,@@(postData,"#venta"),@@(movcaja,"#idivisa"))}
                
                if @@(datarjeta,"#importetotal") >= @@(rsource,"#balance"){movcaja<"efectivo">: 0 }

                movcaja<"tarjetas">:@@(datarjeta,"#importetotal")
                pagos=@@(postData,"#efectivo") + @@(movcaja,"#tarjetas")
                
                if pagos <  @@(rsource,"#balance") {do rise_error(500,"El importe acumulado no cubre con la totalidad de la venta")}

                do dbr.insert(db,"movcaja",movcaja)
                idmovcaja=dbr.num(db,"select sys_pk from movcaja where sys_guid=@sys_guid",movcaja)

                //insertar tarjetas
                for i = 0; i < @count(@@(datarjeta,"&dtarjetas"))
                {
                    ref dtarjeta=@item(@@(datarjeta,"&dtarjetas"),i)
                    dtarjeta<"fk_movcaja_detalletarjetas">:idmovcaja
                    do dbr.insert(db,"dtarjeta",dtarjeta)
                }
                postData<"idmovcaja">:idmovcaja
                break
            }
        }
        
        //realizar salida de existencias
        //==============================================
        ref dventas=list.create()
        
        if pos_afectar_existencias
        {
            ref dventas=dbr.list(db,ftext("SELECT dv.sys_pk,dv.ialmacen,dv.iproducto,ifnull(dv.xsalir,dv.cantidad) cantidad,p.costopromedio,p.costoultimo,
            ((IFNULL(dv.precio,0) * ifnull(dv.cantidad,0)) - IFNULL(dv.descuento1,0) - IFNULL(dv.descuento2,0)) AS abonos
            FROM dventa dv 
            INNER JOIN venta v ON dv.fk_venta_detalle=v.sys_pk
            INNER JOIN producto p ON dv.iproducto=p.sys_pk
            WHERE
            (p.iclase in(#<@@(@config_default,'$class_prod')>) and p.itipo = 2)
            AND v.sys_guid=@sys_guid;"),rsource)
        }

        if @count(dventas) > 0
        {
            ref @LAST_DCARDEX=@null
            code_cat=dbr.vars.get(db,"v12.ventas.salida")
            code_cat >> _p
            categoria=dbr.num(db,"SELECT ifnull(sys_pk,0) FROM categoria where codigo=@code_cat",_p)

            if categoria < 1{do rise_error(500,"No ha configurado una categoría:  v12.ventas.salida")}

            /*
             * Summary:
             * - Crear cardex de la salida del invetario
             */
            mov_sys_pk=erp.ventas.procesos.salidaInventario(db,@@(postData,"#venta"),categoria)
            /*
             * Summary:
             * - Aplicar movimiento de salida
             */
            if mov_sys_pk > 0{do erp.inventario.aplicar_mov(db,mov_sys_pk,@true)}
        }
        //=========================================================
        //cargar datos del ticket antes de actualizar el estado de la venta
        params<"id_table">:@@(postData,"#venta")
        params<"venta">:@@(postData,"#venta")

        ref response=data.ticket(db,params)

        statusentrega=dbr.num(db,"SELECT statusentrega from venta where sys_pk=@venta",postData)
        sta_entrega= 3
        
        /*
         * Summary:
         * - Preparar datos para actualizar la venta
         */
        //actualizar venta
        icaja=dbr.num(db,"select icaja from corte where sys_pk=@icorte",postData)
        new venta
        {
            @"importeadicional":@@(postData,"#propina")
            @"statusadministrativo": 3
            @"statusentrega":sta_entrega
            @"statusfacturacion":1
            @"icaja":icaja
            @"icorte":corte
            @"formapago":@venta_fpago
        }
        
        if  @@(postData,"#idmovcaja") > 0{venta<"imovcaja">:@@(postData,"#idmovcaja")}

        if icaja < 1{do field.remove(venta,"icaja")}

        if toupper(@@(rsource,"$service")) == "DS"{do field.remove(venta,"statusentrega")}
        do dbr.update(db,"venta",venta,"sys_pk=@venta",postData)

        /*
         * Summary:
         * - Actualizar estado de la venta
         */
         do erp.ventas.procesos.setStatus(db,@@(postData,"#venta"),@venta_fpago)

        //órdenes pendientes
        ref ordenes=dbr.list(db,"SELECT o.*
                        FROM orden o 
                        INNER JOIN cconsumo cc ON o.icconsumo=cc.sys_pk
                        WHERE o.iventa=@venta AND IFNULL(o.`status`,0)=0;",postData)
        //producir orden     
        params<"trans">:@false
        params<"ordenes*">:ordenes

        pos_produccion_al_cobrar=parse.num(GetVars("pos_produccion_al_cobrar"))
        // configuracion pos_produccion_al_cobrar total estricta
        /*
         * Summary:
         * - Producir el producto final si la configuración es modo estricta
         */
        if pos_afectar_existencias && pos_produccion_al_cobrar == 1{do producir.x_ventas(db,params)}
        //ACTULIZAR ORDEN
        
        new orden
        {
            // @"status":3
            @"atendido":1
            @"fatendido*":dbr.sql("now()")
        }
        do dbr.update(db,"orden",orden,"iventa=@venta AND ifnull(atendido,0)=0",postData)
        
        //obetner datos del ticket
        //folio de la venta
        folio_factura=ticket.encode_folio(@@(response,"&fecha"),@@(response,"&sys_dtcreated"),from.json(@@(postData,"#venta")))
        
        using response
        {
            // @"cajero*":dbr.rec(db,"select codigo,nombre from cajero where codigo=@idcajero",datos)
            @"propina":@@(venta,"#importeadicional")
            @"efectivo":@@(movcaja,"#efectivo")
            @"tarjeta":@@(movcaja,"#tarjetas")
            @"cambio":@@(totales,"#cambio")
            // @"text_footer":"Gracias por su compra, esperamos regrese pronto!!!"
            @"folio_factura":folio_factura
            // @"divisa*":divisa
            @"url_redir":"/comandas/?view=vw_principal&dmtm_token="+@@(datatoken,"$token")
        }
        do dbr.commit(db)

        /*
         * Summary:
         * - Producir el producto final si el modo es ejecución fléxible
         */
        if pos_afectar_existencias && pos_produccion_al_cobrar == 2{do producir.x_ventas(db,params)}

        postData<"data_ticket*">:response

        do printer_ordertable(db,@@(postData,"#venta"),postData)

        return response

        exception
        {
            if dbr.in_transaction(db){do dbr.rollback(db)}
            do rise_error(500,last_error())
        }
        
    }
    pos.cortecaja::&db,&params,&postData
    {
        using postData{@"token":@dmtoken}
       
        ref datacorte=GetCajaCorte(db)
        caja=@@(datacorte,"#caja")
        corte=@@(datacorte,"#corte")
        if corte < 1{do rise_error(500,"No se econtró un corte de caja abierto")}

        @DECIMAL_PRECISION=parse.num(dbr.vars.get(db,"FXCA001"))
        using params
        {
            @"caja":caja
            @"corte":corte
        }
        //obtener variables globales al corte
        pos_cat_diferencia_al_corte=trim(dbr.vars.get(db,"pos_cat_diferencia_al_corte"))
        pos_cat_retiro_al_corte=trim(dbr.vars.get(db,"pos_cat_retiro_al_corte"))
        pos_cat_retiro_otras_fpago=trim(dbr.vars.get(db,"pos_cat_retiro_otras_fpago"))

        do dbr.begin(db)
        //validaciones
        efectivo_caja=@@(postData,"#efectivo_caja")
        retiro_corte=@@(postData,"#retiro_corte")
        importe_sig_turno=@@(postData,"#importe_sig_turno")

        if efectivo_caja < 0.1{do rise_error(500,"No ha indicado el efectivo en caja")}
        if importe_sig_turno < 0{do rise_error(500,"No ha indicado el fondo del siguiente turno")}

        //======================================================================================================
        //ingreso o egreso segun la diferencia entre efectivo en caja contra lo que se tiene en la base de datos
        saldo_inicial=GetSaldoInicial(db,corte,caja,0)//0 divisa predeterminada
        if saldo_inicial < 0{saldo_inicial= 0}

        saldocorte=SaldoEfectivo(db,corte) + saldo_inicial
        diferencia=saldocorte - efectivo_caja
        
        if diferencia != 0
        {
            if pos_cat_diferencia_al_corte==""{do rise_error(500,"No ha configurado una categoría para realizar ingreso/egreso de diferencia 'pos_cat_diferencia_al_corte' ")}
            //egreso
            if diferencia > 0
            {
                ref movcaja_egreso=PrepareMovCaja(db,GetCategoriaByCodigo(db,pos_cat_diferencia_al_corte),diferencia,"EGRESO POR DIFERENCIA AL CORTE")
                corte >> movcaja_egreso
                ref _egreso=pos.egreso(db,params,movcaja_egreso)
            }
            //ingreso
            else
            {
                ref movcaja_ingreso=PrepareMovCaja(db,GetCategoriaByCodigo(db,pos_cat_diferencia_al_corte),(diferencia * -1),"INGRESO POR DIFERENCIA AL CORTE")
                corte >> movcaja_ingreso
                ref _ingreso=pos.ingreso(db,params,movcaja_ingreso)
            }
        }
        //realizar retiro al corte de caja
        if retiro_corte > 0
        {
            if pos_cat_retiro_al_corte==""{do rise_error(500,"No ha configurado una categoría para realizar el retiro al corte 'pos_cat_retiro_al_corte' ")}

            ref movcaja=PrepareMovCaja(db,GetCategoriaByCodigo(db,pos_cat_retiro_al_corte),retiro_corte,"RETIRO AL CORTE")
            corte >> movcaja
            ref egreso=pos.egreso(db,params,movcaja)
        }
        
        
        //=============================================================================================================================================
        //Retiro por el importe de todas las demás formas de pago (depósitos, cheques, vales y tarjetas) 
        ref saldos=GetSaldoCorte(db,corte)
        cheques=@@(saldos,"#cheques")
        vales=@@(saldos,"#vales")
        depositos=@@(saldos,"#depositos")
        tarjetas =@@(saldos,"#tarjetas")

        tsaldos=cheques + vales + depositos + tarjetas
        if tsaldos > 0
        {
            if pos_cat_retiro_otras_fpago==""{do rise_error(500,"No ha configurado una categoría para realizar el retiro de otras formas de pagos 'pos_cat_retiro_otras_fpago' ")}
            ref movcaja_egreso_fpagos=_CopyFieldsMov(PrepareMovCaja(db,GetCategoriaByCodigo(db,pos_cat_retiro_otras_fpago),0,"EGRESO DE CAJA"))
            
            if cheques > 0{movcaja_egreso_fpagos<"cheques">:cheques * -1}
            if vales > 0{movcaja_egreso_fpagos<"vales">:vales * -1}
            if tarjetas > 0{movcaja_egreso_fpagos<"tarjetas">:tarjetas * -1}
            if depositos > 0{movcaja_egreso_fpagos<"depositos">:depositos * -1}

            corte >> movcaja_egreso_fpagos
            movcaja_egreso_fpagos<"documento">:@DOCUMENTO_EGRESO
            ref retiro_fpagos=_insertMovcaja(db,movcaja_egreso_fpagos)
        }
        
        //==========================================================================================================================
        //liberar venta y caja-corte
        sql="update venta set statusadministrativo=99 where statusfinanciero=0 and formapago=0 and subtotal=0 and statusadministrativo=1 and icorte is null and icaja=@caja"
        do dbr.execute(db,sql,params)

        sql="update corte set cerrado=1, fcierre=now(), hcierre=now() where sys_pk=@corte"
        do dbr.execute(db,sql,params)
        
        do token.logout(db,postData)
        module "imprimir arqueo"
        {
            ref arqueo=DataArqueo(db,corte)
            arqueo<"_config_prn*">:@@(postData,"&_config_prn")
            do PrintArqueo(db,arqueo)
            // exception{}
        }
        do dbr.commit(db)
        
        do field.remove(arqueo,"http")

        arqueo<"url_redir">:"/comandas/?view=login"
        
        return arqueo

        exception
        {
            if dbr.in_transaction(db){do dbr.rollback(db)}
            do rise_error(500,last_error())
        }
    }
    pos.arqueo::&db,&params,&postData
    {
        ref datacorte=GetCajaCorte(db)
        corte=@@(datacorte,"#corte")
        if corte < 1{do rise_error(500,"No se econtró un corte de caja abierto")}
        
        ref arqueo=DataArqueo(db,corte)
        arqueo<"_config_prn*">:@@(postData,"&_config_prn")
        
        do PrintArqueo(db,arqueo)
        do field.remove(arqueo,"http")
        return arqueo
    }
