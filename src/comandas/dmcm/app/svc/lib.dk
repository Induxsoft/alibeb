    PrepareMovCaja::&db,categoria,importe,notas
    {
        new data
        {
            @"referencia":toupper(uuid())
            @"divisa":GetDivisaPredet(db)
            @"categoria":categoria
            @"efectivo":importe
            @"descripcion":notas
        }
        return data
