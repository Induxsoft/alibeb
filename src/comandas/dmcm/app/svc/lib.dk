    //obtiene las barras del producto //para plazamundial
    get.bars_plazamundial::&db,&item,&list_barrs
    {
        ref bars_prod=dbr.list(db,@bars_prod_plazamundial,item)
        if list.count(bars_prod)>0
        {
            // do rise_error(77,to.json(bars_prod))
            for bl=0;bl<list.count(bars_prod)
            {
                ref data_bars=@item(bars_prod,bl)
                ref data_json=from.json(field.dstr(data_bars,"data","{}"))
                if not(isnull(data_json))
                {
                    ref options=@@(data_json,"&opciones")
                    for o=0;o<list.count(options)
                    {
                        ref option=@item(options,o)
                        ref bar_options=@@(option,"&opciones")
                        ref lb_p=list.create()
                        for p=0;p<list.count(bar_options)
                        {
                            ref itmop=@item(bar_options,p)
                            new opv
                            {
                                @"text":@@(itmop,"etiqueta")
                                @"amount":@@(itmop,"importe")
                            }
                            do list.add(lb_p,opv)
                        }
                        new bar
                        {
                            @"name":@@(option,"etiqueta")
                            @"required":@@(option,"requerido")
                            @"type":"single"
                            @"values*":lb_p
                            // @"data":"plazamundial"
                        }
                        do list.add(list_barrs,bar)
                    }

                    ref addic=@@(data_json,"&adicionales")
                    ref list_adc=list.create()
                    
                    for l=0;l<list.count(addic)
                    {
                        ref adc=@item(addic,l)
                        new dadic
                        {
                            @"text":@@(adc,"etiqueta")
                            @"amount":@@(adc,"importe")
                        }
                        do list.add(list_adc,dadic)
                    }
                    new ad
                    {
                        @"name":"__adds"
                        @"type":"multiple"
                        @"required":@false
                        @"values*":list_adc
                    }
                    do list.add(list_barrs,ad)
                }

            }
            
        }
        // do get.barrs_line(db,item,list_barrs)
    }
    
    //obtiene todas los centros de produccion y todas las lineas siempre y cuando los párametros prodc y line esten vacíos
    //prodc diferente a vacío se filtra 
    //line diferente a vacío se filtra
    get.foodbev::&db,&params
    {
        query=@foodbev
        prodc=@@(params,"$prodc")
        line=@@(params,"$line")
        search=trim(@@(params,"$search"))
        ref linea=record.create()

        quantity = 0
        if search == ""
        {
            ref linea=dbr.rec(db,@line,params)
            if isnull(linea){do rise_error(500,"No se encontró datos de la línea")}

            if trim(@@(params,"$cc"))==""{params<"cc">:dbr.num(db,"SELECT v.icconsumo FROM venta v WHERE v.sys_pk=@idt",params)}

            params<"almacen">:dbr.num(db,"SELECT ialmacen FROM cconsumo WHERE sys_pk=@cc",params)

            if @@(linea,"#clase") == @clase_prod_receta
            {
                query=query + " AND cc.sys_pk = @cc "
                if @@(params,"prodc")!=""{query=query +" and q.ICentrosProduccion=@prodc"}
            }
            
            if line!=""{query=query + " and q.ILinea=@line"}
            
            ref foodbev=dbr.list(db,ftext(query),params)
        }
        else //buscar productos con coincidencia
        {
            /*
             * Summary:
             * - verificar si trae * 
            */
            if contains(search,"*")
            {
                ref frags=split(search,"*")
                search=trim(list.str(frags,0))
                quantity = parse.num(trim(list.str(frags,1)))
            }
            
            params<"search">:search
            params<"almacen">:dbr.num(db,"SELECT ialmacen FROM cconsumo WHERE sys_pk=@cc",params)

            /*
             * Summary:
             * - buscar producto por codio y codigo de barras
            */
            query=@foodbev + " AND p.codigo=@search OR p.codbar1=@search OR p.codbar2=@search OR p.codbar3=@search"
            ref foodbev=dbr.list(db,ftext(query),params)

            /*
             * Summary:
             * - verficar producto por mascara
            */
            ref codes=ifnull(@@(params,"&codes"),list.create())
            if @count(codes) > 0 && @count(foodbev) < 1
            {
                ref _p=record.copy(params,"*")
                for i = 0; i < @count(codes)
                {
                    ref code=@item(codes,i)
                    
                    _p<"search">:trim(@@(code,"$k"))
                    /*
                     * Summary:
                     * - buscar producto con la mascara 
                    */
                    ref foodbev=dbr.list(db,ftext(query),_p)
                    if @count(foodbev) > 0
                    {
                        if @count(foodbev) == 1{quantity = div(@@(code,"#q"),@@(code,"#f")) }
                        break
                    }
                }
            }
            /*
             * Summary:
             * - buscar por descripcion segun el campo @search
            */
            if @count(foodbev) < 1
            {
                query=@foodbev + " AND p.descripcion like CONCAT('%',@search,'%')"
                ref foodbev=dbr.list(db,ftext(query),params)
            }
        }

        ref list_foodbev=list.create()

        for i=0;i<@count(foodbev)
        {
            ref item=@item(foodbev,i)
            ref dataline=dbr.rec(db,@line,item)
            ref list_barrs=list.create()
            ref options=record.create()

            switch @PrioridadBarras
            {
                case 0
                {
                    do get.barrs_dmns(db,item,list_barrs)
                    do get.barrs_line(db,item,list_barrs)
                }
                case 1
                {
                    do get.bars_plazamundial(db,item,list_barrs)
                    do get.barrs_line(db,item,list_barrs)
                }
                case 2
                {
                    do get.barrs_dmns(db,item,list_barrs)
                    do get.bars_plazamundial(db,item,list_barrs)
                    do get.barrs_line(db,item,list_barrs)
                }
            }

            iproducto = @@(item,"#sys_pk")
            new data_foodbev
            {
                @"pkprod":@@(item,"pkprod")
                @"sku":@@(item,"$sku")
                @"sys_pk":iproducto
                @"description":@@(item,"description")
                @"price":aplImpuestos(@@(item,campoPrecioR5(@PrecioVenta)),parseImpuesto(@@(item,"i1venta"),@zonaImpuesto),parseImpuesto(@@(item,"i2venta"),@zonaImpuesto),parseImpuesto(@@(item,"i3venta"),@zonaImpuesto),parseImpuesto(@@(item,"i4venta"),@zonaImpuesto))
                @"unit":@@(item,"unit")
                @"line*":dataline
                @"options*":list_barrs
                @"desc_cp":@@(item,"desc_cp")
                @"desc_cc":@@(item,"desc_cc")
                @"cod_cp":@@(item,"cod_cp")
                @"cod_cc":@@(item,"cod_cc")
                @"data_img*":CreateHost(db,tolower(@@(item,"$sku")),"")
                @"grupos*":getGroupProducts(db,iproducto)
                @"existencia":@@(item,"#existencia")
                @"validar_existencia":@@(item,"#validar_existencia")
                @"solicitarcantidad": @@(item,"#solicitarcantidad")
            }
            if quantity > 0{data_foodbev<"quantity">:quantity}

            iproducto >> p
            sql = "SELECT DISTINCT gp.sys_pk, gp.nombre FROM grupoproductos_producto_ gpp INNER JOIN grupoproductos gp ON gpp.igrupos = gp.sys_pk WHERE gpp.iproductos = @iproducto"
            data_foodbev<"grupoproductos*"> : dbr.list(db,sql,p)

            do list.add(list_foodbev,data_foodbev)
        }
        

        linea<"indicaciones*">:GetIndicaciones(@@(linea,"$indicaciones"))
        new datafood
        {
            @"line*":linea
            @"foodbev*":list_foodbev
        }
       
        return datafood

    }
    getGroupProducts::&db,producto
    {
        producto >> p

        ref grupos=dbr.list(db,"SELECT v.sys_pk,v.cdirectoprom,v.cindirectoprom,
        v.cmanoobraprom,v.cmaquinariaprom,v.descripcion,v.`factor`,
        v.maximo,v.minimo,v.padicional,v.grupo,
        gp.nombre,gp.notas
        FROM ivariable v
        INNER JOIN grupoproductos gp ON v.grupo=gp.sys_pk
        WHERE v.fk_producto_ivariables=@producto; ",p)

        for i = 0; i < @count(grupos)
        {
            ref grupo=@item(grupos,i)

            ref productos=dbr.list(db,"SELECT p.sys_pk,p.codigo as sku,p.descripcion as description,p.precio1 FROM grupoproductos_producto_ gp
            INNER JOIN producto p ON gp.iproductos=p.sys_pk
            WHERE gp.igrupos=@grupo;",grupo)

            for j = 0; j < @count(productos)
            {
                ref pdt=@item(productos,j)
                pdt<"data_img*">:CreateHost(db,tolower(@@(pdt,"$sku")),"")
            }
            grupo<"productos*">:productos
        }
        return grupos
    }
