    GetCategoriaByCodigo::&db,codcat
    {
        new p{@"codigo":codcat}
        categoria=dbr.num(db,"select sys_pk from categoria where codigo=@codigo",p)

        if categoria < 1{do rise_error(500,"No se contró la categoría con el código indicado: "+codcat)}
        
        return categoria
    }
    GetDivisaPredet::&db
    {
        divisa =parse.num(dbr.vars.get(db,"FXCA013"))
        if divisa < 1{do rise_error(500,"No hay divisa predeterminada 'FXCA013' ")}

        return divisa
    }

    SaldoCaja::&db,caja,divisa,forma
    {
        if divisa < 1{divisa=GetDivisaPredet(db)}

        new p
        {
            @"caja":caja
            @"divisa":divisa
        }
        sql="SELECT * FROM qrySaldosCaja WHERE icaja=@caja AND idivisa=@divisa"
        ref rescaja=dbr.rec(sb,sql,p)
        if isnull(rescaja){do rise_error(500,"No se encontró datos de la caja con la divisa indicado")}

        efectivo=@@(rescaja,"#efectivo")
        cheques=@@(rescaja,"#cheques")
        tarjetas=@@(rescaja,"#tarjetas")
        depositos=@@(rescaja,"#depositos")
        vales= @@(rescaja,"#vales")

        saldocaja = 0
        switch forma
        {
            case 0 //cTodos
            {
                saldocaja = cheques + depositos + efectivo + tarjetas + vales
            }
            case 1 //cMetalico
            {
                saldocaja = efectivo
            }
            case 2 //cCheques
            {
                saldocaja = cheques
            }
            case 3 //cTarjetas
            {
                saldocaja = tarjetas
            }
            case 4 //cDepositos
            {
                saldocaja = deposito
            }
            case 5 //cVales
            {
                saldocaja = vales
            }
        }

        return saldocaja
    }
    SaldoInicial::&db,corte,caja
    {
        new p
        {
            @"caja":caja
            @"corte":corte
        }

        sql="SELECT SUM(total) as saldoi from qryDetalleCorte where icorte < @corte AND icaja=@caja" 
        ref data=dbr.rec(sb,sql,p)

        return @@(data,"#saldoi")
    }
    GetSaldoInicial::&db,corte,caja,divisa
    {
        if divisa < 1{divisa=GetDivisaPredet(db)}

        new p
        {
            @"caja":caja
            @"corte":corte
            @"divisa":divisa
        }

        sql="select sum(ifnull(movcaja.cheques,0)+ifnull(movcaja.depositos,0)+ifnull(movcaja.efectivo,0)+ifnull(movcaja.tarjetas,0)+ifnull(movcaja.vales,0)) as saldo 
			from corte inner join movcaja on corte.sys_pk = movcaja.icorte 
			where movcaja.icorte<@corte and corte.icaja=@caja and movcaja.idivisa=@divisa;"
        
        ref data=dbr.rec(db,sql,p)

        saldo=@@(data,"#saldo")
        //se agregó que el saldo inicial no sea negativo
        // if saldo < 0{saldo = 0}

        return saldo
    }
    IngresoEgresoXCategoria::&db,sql,&p
    {
        ref data=dbr.list(db,sql,p)
        total= 0
        for i = 0; i < @count(data)
        {
            ref dt=@item(data,i)
            total=total + @@(dt,"#total")
        }
        return total
    }
    GetSaldoCorte::&db,corte
    {
        new p{@"corte":corte}
        sql="SELECT SUM(total) AS total,SUM(efectivo)AS efectivo,SUM(cheques)cheques,SUM(vales)vales,SUM(depositos)depositos,SUM(tarjetas)tarjetas 
        from qryDetalleCorte where icorte=@corte;"

        return dbr.rec(db,sql,p)
    }
    //saldo final , efectivo,tarjeta,vales,deposito,cheques
    SaldoFinal::&db,corte{return @@(GetSaldoCorte(db,corte),"#total")}
    SaldoEfectivo::db,corte{return @@(GetSaldoCorte(db,corte),"#efectivo")}

    
    DataArqueo::&db,pkcorte
    {
        if pkcorte < 1{do rise_error(500,"No ha indicado un corte válido")}

        new p
        {
            @"corte":pkcorte
            @"divisa":GetDivisaPredet(db)
        }

        sql="select 
        date_format(corte.fapertura,'%Y-%m-d')fapertura, 
        date_format(corte.fcierre,'%Y-%m-d')fcierre,
        date_format(corte.hapertura,'%H-%i-%s')hapertura, 
        date_format(corte.hcierre,'%H-%i-%s')hcierre, 
        corte.cerrado,
        caja.sys_pk as pkcaja,
        caja.codigo as codcaja, caja.descripcion as desccaja, 
        cajero.codigo as codcajero, cajero.nombre as nombrecajero 
        from cajero 
        inner join (caja inner join corte on caja.sys_pk = corte.icaja) on cajero.sys_pk = corte.icajero 
        where corte.sys_pk=@corte"

        ref corte=dbr.rec(db,sql,p)
        if isnull(corte){do rise_error(500,"No se encontrarón datos del corte")}

        sql="select venta.referencia, venta.formapago,venta.statusfacturacion,venta.statusadministrativo, 
        ((venta.subtotal-venta.descuento1-venta.descuento2)+venta.impuesto1+ venta.impuesto2+ venta.impuesto3+ venta.impuesto4) as total, 
        venta.importeadicional,
		  (case venta.statusadministrativo
		  	when 0 then '-SIN USO-'
		  	when 1 then '-ABIERTO-'
		  	when 2 then '-CERRADO-'
		  	when 3 then ''
		  	when 4 then '-POR ENTREGAR-'
		  	when 5 then '-REPARTO-'
		  	when 99 then '-CANCELADO-'
		  END) text_status
        from venta where venta.documento=6 and ((venta.icorte=@corte
        and venta.statusadministrativo>=3) or venta.statusadministrativo<3) 
        order by venta.referencia"

        ref detalle=dbr.list(db,sql,p)

        cerrado=@@(corte,"#cerrado")
        estado=ifstr(cerrado,"CERRADO","ABIERTO")

        fa=@@(corte,"$fapertura")
		fc=@@(corte,"$fcierre")
		ha=@@(corte,"$hapertura")
		hc=@@(corte,"$hcierre")
        p<"caja">:@@(corte,"#pkcaja")
        
        new response
        {
            @"fecha":date_str(now(),"yyyy-MM-dd HH:mm:ss")
            @"title":ifstr(cerrado,"- CORTE DE CAJA -","- ARQUEO DE CAJA -")
            @"header":dbr.vars.get(db,"FXCA112")
            @"text_corte":"CORTE #: "+str(pkcorte) + " "+estado
            @"text_del":"DEL: "+fa+" "+ha
            @"text_al":"AL : "+ifstr(cerrado,fc,date_str(now(),"yyyy-MM-dd")) +" "+ifstr(cerrado,hc,date_str(now(),"HH:mm:ss"))
            @"text_caja":"CAJA: "+@@(corte,"$codcaja")+" "+ @@(corte,"$desccaja")
            @"text_cajero":"CAJERO: "+@@(corte,"$codcajero") +" "+@@(corte,"$nombrecajero")
            @"venta_detalle*":GetDetalleVentaTicket(db,detalle)
            @"saldo_inicial":GetSaldoInicial(db,pkcorte,@@(corte,"#pkcaja"),0)//divisa predeterminado
            @"text_saldoinicial":"SALDO INICIAL"
            @"text_venta":"- VENTAS -"
            @"text_ingreso":"- INGRESOS -"
            @"text_egreso":"- EGRESOS -"
            @"divisa_predet":GetDivisaPredet(db)
            @"divisa_movcaja*":GetIngresosEgresosByDivisa(db,pkcorte,@@(corte,"#pkcaja"))
            @"http*":@http_context
        }

        return response
    }
    GetIngresos::&db,corte,divisa
    {
        new p
        {
            @"corte":corte
            @"divisa":divisa
        }

        sql="select categoria.descripcion as movcategoria, sum(movcaja.cheques+movcaja.depositos+movcaja.efectivo+ movcaja.tarjetas + movcaja.vales) as total 
        from categoria inner join movcaja on categoria.sys_pk = movcaja.icategoria where movcaja.icorte=@corte
        and movcaja.idivisa=@divisa and (movcaja.cheques>=0 and  movcaja.depositos>=0 and movcaja.efectivo>=0 and movcaja.tarjetas>=0 
        and movcaja.vales>=0) group by categoria.descripcion;"

        return dbr.list(db,sql,p)
    }
    GetEgresos::&db,corte,divisa
    {
        new p
        {
            @"corte":corte
            @"divisa":divisa
        }
        sql="select categoria.descripcion as movcategoria, sum(movcaja.cheques+movcaja.depositos+movcaja.efectivo+ movcaja.tarjetas + movcaja.vales) as total 
        from categoria inner join movcaja on categoria.sys_pk = movcaja.icategoria 
        where movcaja.icorte=@corte and movcaja.idivisa=@divisa
        and (movcaja.cheques<=0 and  movcaja.depositos<=0 
        and movcaja.efectivo<=0 and movcaja.tarjetas<=0 and movcaja.vales<=0)
        group by categoria.descripcion; "

        return dbr.list(db,sql,p)
    }
    GetFmpagos::&db,corte,divisa
    {
        new p
        {
            @"corte":corte
            @"divisa":divisa
        }
        sql="select
            sum(movcaja.cheques) as cheques,
            sum(movcaja.depositos) as depositos,
            sum(movcaja.efectivo) as efectivo,
            sum(movcaja.tarjetas) as tarjetas,
            sum(movcaja.vales) as vales
        from
            movcaja
        where
            movcaja.icorte = @corte
            and movcaja.idivisa = @divisa
            and (
                movcaja.cheques >= 0
                and movcaja.depositos >= 0
                and movcaja.efectivo >= 0
                and movcaja.tarjetas >= 0
                and movcaja.vales >= 0
            );"

        return dbr.rec(db,sql,p)
    }
    GetDetalleVentaTicket::&db,&detalle
    {
        contado= 0
        propinascaja= 0
        propinas= 0
        credito= 0

        for i = 0; i < @count(detalle)
        {
            ref dt=@item(detalle,i)
            tag=""
            total=@@(dt,"#total")

            if @@(dt,"#statusadministrativo")== 3
            {
                // facturado
                if @@(dt,"#statusfacturacion")== 3 {tag="F"}

                switch @@(dt,"#formapago")
                {
                    case 1 //contado
                    {
                        contado=contado + total
                        propinascaja=propinascaja + @@(dt,"#importeadicional")
                        if tag==""{tag=" "}
                        break
                    }
                    case 2 //credito
                    {
                        credito= credito + total
                        tag=tag+"C"
                        break
                    }
                }

                propinas= propinas + @@(dt,"#importeadicional")
                dt<"text_status">:number_format(total)+tag
            }
        }

        new response
        {
            @"detalle*":detalle
            @"text_total":"TOTAL:"
            @"str_total":number_format(contado+credito)
            @"total":contado+credito
            @"text_credito":"CRÉDITO"
            @"str_credito":number_format(credito)
            @"credito":credito
            @"text_contado":"CONTADO"
            @"str_contado":number_format(contado)
            @"contado":contado
            @"text_propina":"PROPINAS"
            @"str_propinas":number_format(propinas)
            @"propinas":propinas
            @"text_ingreso_caja":"INGRESOS EN CAJA"
            @"str_ingreso_caja":number_format(contado + propinascaja)
            @"ingreso_caja":contado + propinascaja
            @"text_footer":"(INCLUYE PROPINAS)"
        }
        return response
    }
    GetIngresosEgresosByDivisa::&db,corte,caja
    {
        new p
        {
            @"corte":corte
            @"caja":caja
        }

        sql="select distinct divisa.descripcion,movcaja.idivisa, movcaja.tipocambio 
        from divisa 
        inner join movcaja on divisa.sys_pk = movcaja.idivisa 
        where movcaja.icorte=@corte group by divisa.descripcion,movcaja.idivisa,movcaja.tipocambio;"

        ref divisa_movcaja=dbr.list(db,sql,p)
        for i = 0; i < @count(divisa_movcaja)
        {
            ref itm=@item(divisa_movcaja,i)
            itm<"saldo_inicial">:GetSaldoInicial(db,corte,caja,@@(itm,"#idivisa"))
            itm<"ingresos_categoria*">:GetIngresos(db,corte,@@(itm,"#idivisa"))
            itm<"egresos_categoria*">:GetEgresos(db,corte,@@(itm,"#idivisa"))
            itm<"formas_ing_pagos*">:GetFmpagos(db,corte,@@(itm,"#idivisa"))
        }
        
        return divisa_movcaja
    }
    get.cajeros::&db,&params
    {
        return dbr.list(db,"
                select codigo,nombre as descripcion from cajero where ifnull(sys_deleted,0)=0 AND if(ifnull(@ub,'*')='*',true,ubicacion=@ub);",params)
    }
    get.cajas::&db,&params
    {
        return dbr.list(db,"
                select codigo,descripcion from caja where ifnull(sys_deleted,0)=0 AND if(ifnull(@ub,'*')='*',true,ubicacion=@ub);",params)
    }

    
    get.ubicaciones::&db,&params
    {
        return dbr.list(db,"SELECT '*' codigo, 'Cualquiera' descripcion
                UNION 
                select sys_pk as codigo,descripcion from ubicacion where ifnull(sys_deleted,0)=0;",params)
    }
