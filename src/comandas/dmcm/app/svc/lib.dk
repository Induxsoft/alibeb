    // **********************functions printer****************************
    //#region IMPRESION/PRINTER
 
    printer_command::&db,sys_guid
    {
        new g{@"sys_guid":sys_guid}
        ref dataorden=dbr.rec(db,@getorden_xsys_guid,g)

        ref config=PrnParseConfigCmmd(db,trim(@@(dataorden,"$code")))
        if isnull(config){return}

        new order_data
        {
            @"database*":db
            @"order_guid":sys_guid
            @"config*":config
        }
        
        do runscript(GetFilePrn("print_order.dkl"),"printer_context",order_data)
    }

    
    printer_ordertable::&db,idtable,&postData
    {
        ref config=PrnParseConfig(db,@@(postData,"&_config_prn"))
        if isnull(config){return @null}

        new p{@"id_table":idtable}
        ref data=@@(postData,"&data_ticket")
        if isnull(data){ref data=data.ticket(db,p)}
        
        if @@(config,"#req_data"){return data}
        
        new table_data
        {
            @"database*":db
            @"ticket*":data
            @"config*":config
        }
        
        do runscript(GetFilePrn("prn_ticket.dkl"),"printer_context",table_data)

        return @null
    }
    
    PrintArqueo::&db,&data
    {
        ref config=PrnParseConfig(db,@@(data,"&_config_prn"))
        if isnull(config) || @@(config,"#req_data"){return}

        data<"config*">:config
        do ExecutePrinter(db,GetFilePrn("prn_arqueo.dkl"),data)
    }
    
    ExecutePrinter::&db,file,&data
    {
        ref _data=ifnull(data,record.create())
        _data<"database*">:db

        res= runscript(file,"printer_context",_data)

        return res
    }
    GetResponseTicket::&db,idtable,&totales,&table_data
    {
        new response
        {
            @"totales*":ifnull(totales,record.create())
        }
        do DataTicket(db,idtable,response)

        //obetner datos del ticket
        ref venta=dbr.rec(db,"select idivisa from venta where sys_pk=@id_table",table_data)

        ref divisa=dbr.rec(db,"select sys_pk,codigo,descripcion from divisa where sys_pk=@idivisa",venta)
        table_data<"token">:@dmtoken
        ref dttoken=get.token(db,@null,table_data)
        
        ref cajero=record.create()
        datos=trim(@@(dttoken,"$datos"))
        if datos!=""
        {
            ref dtsession=from.json(datos)
            ref cajero=ifnull(dbr.rec(db,"select codigo,nombre from cajero where codigo=@idcajero",dtsession),record.create())
        }

        using response
        {
            @"cajero*":cajero
            @"propina": 0
            @"efectivo": 0
            @"tarjeta": 0
            @"cambio": 0
            @"text_footer":"Gracias por su compra, esperamos regrese pronto!!!"
            @"folio_factura":""
            @"divisa*":divisa
            @"prin_timin":@true
        }

        return response
    }
    //#endregion
    
    // **********************************************************

    //#region VENTA/ORDEN
    get.mesas::&db,&params
    {
        //obtener variables globales
        pos_url_img_mesa=dbr.vars.get(db,"pos_url_img_mesa")
        pos_url_img_mesa_ff=dbr.vars.get(db,"pos_url_img_mesa_ff")
        pos_url_img_mesa_ds=dbr.vars.get(db,"pos_url_img_mesa_ds")
        
        if pos_url_img_mesa != ""
        {
            @pos_url_img_mesa=pos_url_img_mesa
        }

        if pos_url_img_mesa_ff != ""
        {
            @pos_url_img_mesa_ff=pos_url_img_mesa_ff
        }

        if pos_url_img_mesa_ds != ""
        {
            @pos_url_img_mesa_ds=pos_url_img_mesa_ds    
        }
        @icon_mesa=ftext(@icon_mesa_def)
        @icon_mesa_ff=ftext(@icon_mesa_ff)
        @icon_mesa_ds=ftext(@icon_mesa_ds)

        query=@list_mesa_waiter_cc 
        where="where true"
        if @@(params,"waiter")!=""
        {
            query=query+" INNER JOIN agente a ON qv.IAgente=a.Sys_PK " //where a.Codigo=@waiter
            // where=where + " and a.Codigo=@waiter"
        }
        if @@(params,"cc")!=""
        {
            query=query+" INNER JOIN cconsumo cc ON qv.ICConsumo=cc.Sys_PK "
            where = where + " AND cc.Sys_PK=@cc "
        }

        switch @@(params,"$cuentas")
        {
            case "sm"
            {
                where =where + " AND ifnull(qv.sys_info,'')<>'FF' AND ifnull(qv.sys_info,'')<>'DS'"
                break
            }
            case "ff"
            {
                where =where + " AND qv.sys_info='FF'"
                break
            }
            case "ds"
            {
                where =where + " AND qv.sys_info='DS'"
                break
            }
            case "ds-enviar"
            {
                where =where + " AND qv.sys_info='DS' AND (
                    qv.statusadministrativo=2 AND qv.statusentrega=0  
                    OR (qv.statusadministrativo = 3 AND qv.statusentrega = 0)
                    OR (qv.statusadministrativo=1 AND qv.statusentrega=0 )
                    )"
                break
            }
            case "ds-reparto"
            {
                where =where + " AND qv.sys_info='DS' AND qv.statusadministrativo=2 AND qv.statusentrega=1 "
                break
            }
            case "ds-entregada"
            {
                where =where + " AND qv.sys_info='DS' AND qv.statusentrega=3 AND qv.statusadministrativo=2"
                break
            }
        }
        //descomentar si a cada mesero pueda abrir la misma mesa
        // query=query+ifstr(@@(params,"waiter")!=""," where a.Codigo=@waiter ","")
        query=query + where
        query=query + " order by qv.dmnsmesa "
        
        ref record=record.create()

        //consulta para obtener las mesas de la zona
        ref mesas_zona=dbr.list(db,@list_mesas_zona,params)
        
        for i=0;i<@count(mesas_zona)
        {
            ref mz=@item(mesas_zona,i)
            new p
            {
                @"ag":dbr.num(db,@agente_mesero,mz)
                @"code":@@(mz,"code")
            }
            ref waiter=dbr.rec(db,@waiter,p)
            mz<"customer*">:@null
            mz<"cc*">:@null
            mz<"waiter*">:waiter

            mz<"open_at*">:@null
            mz<"close_at*">:@null
            mz<"status">:0
            mz<"reference">:""
            mz<"notes">:""
            mz<"balance">:0
            mz<"owner">:@@(waiter,"nombre")
            mz<"is_birthday">:0
            mz<"is_celebration">:0
            mz<"lifespan*">:@null
            mz<"flag">:dbr.num(db,@flag,p)
            mz<"img">:@icon_mesa
            record<@@(mz,"code")+"*">:mz

        }

        //consulta para obetener las mesas del mesero y del cc
        ref mesas_waiter_cc=dbr.list(db,query,params)
        for i=0;i<@count(mesas_waiter_cc)
        {
            ref itm=@item(mesas_waiter_cc,i)
            service=trim(@@(itm,"$service"))
            key_code=replace(ranychars(@@(itm,"$code"),"/,[]{}"," ")," ","")
            
            if service == "FF"{itm<"img">:@icon_mesa_ff}
            else if service == "DS"{itm<"img">:@icon_mesa_ds}
            else{itm<"img">:@icon_mesa}

            new p
            {
                @"cliente":@@(itm,"#cliente")
                @"cc":@@(itm,"#icc")
                @"ag":@@(itm,"#ag")
                @"code":key_code
            }
            
            itm<"customer*">:dbr.rec(db,@customer,p)
            itm<"cc*">:dbr.rec(db,@cc,p)
            itm<"waiter*">:dbr.rec(db,@waiter,p)
            itm<"owner">:""
            itm<"lifespan*">:get.lifespan(db,@@(itm,"sys_pk"))

            ref joined_tables=split(@@(p,"code"),"+")
            
            available=0
            for j=0;j<list.count(joined_tables)
            {
                new pa{@"code":list.str(joined_tables,j)}
                available=available + dbr.num(db,@available,pa)
            }
            if available==0{available =@@(itm,"#occupied_seats")}
            
            itm<"available_seats">:available
            itm<"flag">:dbr.num(db,@flag,p)

            do field.remove(itm,"cliente")
            do field.remove(itm,"icc")
            do field.remove(itm,"ag")
            
            record<key_code+"*">:itm
        }
        
        //lista para definir todas las mesas
        ref lf=list.create()
        ref lclaves=list.create_from_fields(record)
        for i=0; i<@count(lclaves)
        {
            do list.add(lf,field.obj(record,list.str(lclaves,i)))
        }

        return lf
    }

    
    get.ordenes::&db,&params
    {
        if trim(@@(params,"$sql"))==""{sql=@list_ordenes}
        else{sql=@@(params,"$sql")}
        
        ref ordenes=dbr.list(db,sql,params)

        ref data=list.create()

        for i=0;i<@count(ordenes)
        {
            ref rsource=@item(ordenes,i)
            ref row=record.create()

            total=aplImpuestos((@@(rsource,"#precio")*@@(rsource,"#cantidad"))-@@(rsource,"#d1")-@@(rsource,"#d2"),parseImpuesto(@@(rsource,"i1venta"),@zonaImpuesto),parseImpuesto(@@(rsource,"i2venta"),@zonaImpuesto),parseImpuesto(@@(rsource,"i3venta"),@zonaImpuesto),parseImpuesto(@@(rsource,"i4venta"),@zonaImpuesto))
            precio=aplImpuestos(@@(rsource,"#precio"),parseImpuesto(@@(rsource,"i1venta"),@zonaImpuesto),parseImpuesto(@@(rsource,"i2venta"),@zonaImpuesto),parseImpuesto(@@(rsource,"i3venta"),@zonaImpuesto),parseImpuesto(@@(rsource,"i4venta"),@zonaImpuesto))
            
            ref adds=dbr.list(db,@addOrdendmns,rsource)
            for j = 0; j < @count(adds)
            {
                ref itm=@item(adds,j)
                itm<"importe">:aplImpuestos(@@(itm,"#precio"),parseImpuesto(@@(itm,"i1venta"),@zonaImpuesto),parseImpuesto(@@(itm,"i2venta"),@zonaImpuesto),parseImpuesto(@@(itm,"i3venta"),@zonaImpuesto),parseImpuesto(@@(itm,"i4venta"),@zonaImpuesto))
            }
            using row
            {
                @"unidad":@@(rsource,"$unidad")
                @"pkdorden":@@(rsource,"#pkdorden")
                @"pkorden":@@(rsource,"#pkorden")
                @"linea":@@(rsource,"#linea")
                @"sku":@@(rsource,"sku")
                @"sys_pk":@@(rsource,"sys_pk")
                @"created":@@(rsource,"$sys_timeStamp")
                @"description":@@(rsource,"$descripcion")
                @"quantity":@@(rsource,"#cantidad")
                @"price":precio //ya con impuesto
                @"discount":round((@@(rsource,"#d1")+@@(rsource,"#d2"))/(@@(rsource,"#precio")*@@(rsource,"#cantidad")),1)
                @"total":total //ya con impuesto
                @"notes":@@(rsource,"$especificaciones")
                @"time":@@(rsource,"$tiempo")
                @"adds*":adds

                @"_precio":@@(rsource,"#precio") //sin impuesto
                @"_total":(@@(rsource,"#precio")*@@(rsource,"#cantidad")) - (@@(rsource,"#d1") + @@(rsource,"#d2")) //sin impuesto
                @"dventa":@@(rsource,"#dventa")
            }

            if @@(rsource,"#dventa") < 1 && trim(@@(rsource,"$id_dventa")) !=""
            {
                rsource<"dventa">:dbr.num(db,"SELECT sys_pk FROM dventa WHERE sys_guid=@id_dventa",rsource)
            }
            params<"dventa">:@@(rsource,"#dventa")

            ref promociones=dbr.list(db,"SELECT t.*,p.nombre,p.codigo,ta.const tipo_aplicacion FROM trazapromocion t 
            INNER JOIN promocion p ON t.fk_promocion=p.sys_pk
            INNER JOIN ctipoaplicacionpromocion ta ON t.tipo_aplicacion=ta.id
            WHERE t.fk_dventa=@dventa AND t.fk_venta=@iventa;",params)

            row<"promociones*">:promociones

            do list.add(data,row)
        }

        return data
    }

    
    get.mesa::&db,&params
    {
        ref mesa=dbr.rec(db,@data_mesa,params)
        if isnull(mesa){do rise_error(99,"No se encontro datos de la mesa seleccionada.")}
        new p
        {
            @"cliente":@@(mesa,"#cliente")
            @"cc":@@(mesa,"#cc")
            @"ag":@@(mesa,"#ag")
            @"code":@@(mesa,"code")
        }
        mesa<"owner">:""
        mesa<"customer*">:dbr.rec(db,@customer,p)
        // mesa<"zone*">:dbr.rec(db,tolower(@zone),@@(mesa,"&customer"))
        mesa<"cc*">:dbr.rec(db,@cc,p)
        mesa<"waiter*">:dbr.rec(db,@waiter,p)
        mesa<"lifespan*">:get.lifespan(db,@@(mesa,"sys_pk"))
        params<"iventa">:@@(mesa,"sys_pk")

        ref joined_tables=split(@@(p,"code"),"+")
        available=0
        for j=0;j<list.count(joined_tables)
        {
            new pa{@"code":list.str(joined_tables,j)}
            available=available + dbr.num(db,@available,pa)
        }
        if available==0{available =@@(mesa,"#occupied_seats")}

        mesa<"available_seats">:available
        mesa<"flag">:dbr.num(db,@flag,p)

        mesa<"orders*">:get.ordenes(db,params)

        do field.remove(mesa,"cliente")
        do field.remove(mesa,"icc")
        do field.remove(mesa,"ag")
        return mesa
    }

    
    insert.folio::db,params
    {
        iblock=@@(params,"#block")
        if iblock < 1{do rise_error(500,"No no se encontró el block de documentos indicado")}

        fultimo = dbr.folios.set_new(db, iblock, dbr.folios.get_new(db,iblock), 3)
        // folio=dbr.folios.set_new(db,6,dbr.num(db,@folio_doc,@null),3)

        return dbr.folios.info(db,iblock,fultimo)
    }
    
    get.referencia::serie,fultimo,ref_size
    {

        // lnum=length(numsig)
        // lserie=length(serie)
        // lformt=length(formato)

        // if length(lnum)>9 {return right(numsig,9) }

        // nformat=remove(str(formato),2,lserie)
        // // return nformat
        //  num= serie+format(val(numsig),nformat)

        // if length(num)>9 {return right(num,9) }
 
        // return num 
        referencia = serie + padleft(str(fultimo),ref_size,"0")

        return referencia
    }
    
    GetCorteMesero::&db,&json,&data
    {
        ref cajas_agente=dbr.rec(db,"select caja,caja2 from agente where codigo=@key",json)
        corte=dbr.num(db,"SELECT sys_pk FROM corte c WHERE c.icaja=@caja AND IFNULL(c.cerrado,0)=0;",cajas_agente)
        if corte > 0{data<"icaja">:@@(cajas_agente,"#caja")}
        else
        {
            corte=dbr.num(db,"SELECT sys_pk FROM corte c WHERE c.icaja=@caja2 AND IFNULL(c.cerrado,0)=0;",cajas_agente)
            if corte > 0{data<"icaja">:@@(cajas_agente,"#caja2")}
        }
        if corte < 1 && @@(data,"#validate"){do rise_error(500,"El mesero actual no tiene un corte abierta, en las cajas relacionados")}
        
        data<"icorte">:corte

        return corte
    }
    get.block::&db,icaja
    {
        icaja >> params

        if icaja > 0
        {
            iblock= dbr.num(db,"select ifnull(iblock,0) from caja where sys_pk=@icaja",params)
            if iblock > 0{return iblock}
        }
        
        exception{do pop_exception()}

        return parse.num(dbr.vars.get(db,"pos_serie_default"))
    }
    open.table::&db,&params,&data
    {
        start_transaction = @false

        if not(dbr.in_transaction(db)) {
            do dbr.begin(db)
            start_transaction = @true
        }
        
        data<"validate">:@false
        do VerifyToken(db,data)

        fastfoot=parse.bool(@@(params,"$fastfoot"))
        if fastfoot
        {
            if dbr.vars.get(db,"pos_crear_ticket_venta_rapida") == "02"
            {
                new venta
                {
                    @"sys_guid":uuid()
                    @"reference":""
                    @"code":""
                    @"sys_pk":0
                    @"reference":0
                    @"balance":0
                }
                return venta
            }
        }
        
        params<"block">:get.block(db,@@(data,"#icaja"))

        if @@(params,"#block") < 1{do rise_error(500,"No se ncontró datos de la serie configurada")}
        
        serie=dbr.str(db,@blockdoc,params)
        ref data_folio=insert.folio(db,params)
    
        referencia=get.referencia(serie,@@(data_folio,"#folio"),dbr.vars.getd(db, "ventas_fix_ref_size", 8))
        
        /*
         * Summary:
         * -  verificar si es venta rápida o venta a domicilio
        */
        if fastfoot || @@(params,"#gen_table_ff")
        {
            data<"info">:"FF"
            data<"table">:cut("FF/"+referencia,45)
        }
        else if parse.bool(@@(params,"$homedelivery"))
        {
            data<"info">:"DS"
            data<"table">:cut("DS/"+referencia,45)
            data<"notes">:@@(data,"$notas")
        }
        else
        {
            do exist.table(db,params,data)
        }
        
        @divisa=GetDivisaPredet(db)
        
        using params{@"divisa":@divisa}
        
        new venta
        {
            @"Sys_TimeStamp*":now()
            @"sys_guid":toupper(uuid())
            @"Sys_DTCreated*":now()
            @"Sys_Exported":0
            @"Sys_DTExported*":now()
            @"sys_info":@@(data,"$info")
            @"Auditado":0
            @"Contabilizado":0
            @"Descuento1":0
            @"Descuento2":0
            @"FormaPago":@formapago
            @"ImporteAdicional":0
            @"Impuesto1":0
            @"Impuesto2":0
            @"Impuesto3":0
            @"Impuesto4":0
            @"referencia":referencia
            @"dmnsMesa":@@(data,"$table")
            @"dmnsNota":@@(data,"$notes")
            @"dmnsPersonas":@@(data,"#num_people")
            @"documento":@documento_venta
            @"StatusAdministrativo":@_status_admin_abierto
            @"StatusEntrega":0
            @"StatusFacturacion":1
            @"StatusFinanciero":0
            @"Subtotal":0
            @"TipoDomicilio":0
            @"fecha*":now()
            @"FEmbarque*":now()
            @"FEntrega*":now()
            @"FLiquidacion*":now()
            @"FUltimoCobro*":now()
            @"TipoCambio":dbr.num(db,"select tcambio from divisa where sys_pk=@divisa",params)
            @"PComision":0
            @"Vencimiento*":now()
            @"IAgente":dbr.num(db,@ia_gente,data)
            @"ICConsumo":@@(data,"#cc")
            @"ICliente":dbr.num(db,@ic_cliente,data)
            @"IDivisa":@divisa
            @"IFolio":@@(data_folio,"sys_pk")
        }

        if @@(data,"#icaja") > 0{venta<"icaja">:@@(data,"#icaja")}
        if @@(data,"#icorte") > 0{venta<"icorte">:@@(data,"#icorte")}

        do dbr.insert(db,"venta",venta)
        params<"id_table">:dbr.num(db,"select sys_pk from venta where sys_guid=@sys_guid",venta)

        if parse.bool(@@(params,"$homedelivery"))
        {
            
            ref dmns_destino=record.copy(data,"nombre,telefono,direccion,notas")
            using dmns_destino
            {
                @"sys_TimeStamp*":now()
                @"sys_guid":uuid()
                @"sys_DTCreated*":now()
                @"sys_Exported":0
                @"sys_DTExported*":now()
            }
            destino=@@(data,"#sys_pk")
            if destino < 1
            {
                do dbr.insert(db,"dmns_destino",dmns_destino)
                destino=dbr.num(db,"SELECT sys_pk from dmns_destino where sys_guid=@sys_guid",dmns_destino)
            }
            else
            {
                do field.remove(dmns_destino,"sys_guid")
                do field.remove(dmns_destino,"sys_DTCreated")
                do field.remove(dmns_destino,"sys_DTExported")

                do dbr.update(db,"dmns_destino",dmns_destino,"sys_pk=@sys_pk",data)
            }

            new dmns_entrega
            {
                @"Sys_TimeStamp*":now()
                @"Sys_GUID":uuid()
                @"Sys_DTCreated*":now()
                @"Sys_Exported":0
                @"Sys_DTExported*":now()
                @"destino":destino
                @"venta":@@(params,"#id_table")
            }
            do dbr.insert(db,"dmns_entrega",dmns_entrega)
        }

        if start_transaction { do dbr.commit(db) }

        return get.mesa(db,params)
        exception
        {
            if start_transaction { do dbr.rollback(db) }
            do rise_error(99,last_error())
        }
    }

    _remove_sys_fields::&data
    {
        do field.remove(data,"sys_pk")
        do field.remove(data,"sys_guid")
        do field.remove(data,"sys_dtcreated")
        do field.remove(data,"sys_timestamp")
        do field.remove(data,"sys_info")
        do field.remove(data,"sys_user")
        do field.remove(data,"sys_lastuser")
        do field.remove(data,"sys_exported")
        do field.remove(data,"sys_dtexported")
        do field.remove(data,"sys_recver")
        do field.remove(data,"sys_deleted")
        do field.remove(data,"sys_lock")
    }

    //#region splitAccount
    /**
     * Transfiere las órdenes de una cuenta A a una cuenta B.
     *
     * @param integer source - Clave primaria de la cuenta origen
     * @param integer target - Clave primaria de la cuenta destino
     * @param object item - Producto a transferir
     * @param integer item.dventa - Clave primaria de la partida en la cuenta origen
     * @param decimal item.quantity - Cantidad del producto
     *
     * ---
     * Fecha: 01-09-2026
     * Autor: Francisco Ávila
     */
    splitAccount :: &db, &params, &data
    {
        if dbr.num(db,"SELECT sys_pk FROM venta WHERE sys_pk = @source",data) < 1 { do rise_error(404,"No se encontró la cuenta origen") }
        if dbr.num(db,"SELECT sys_pk FROM venta WHERE sys_pk = @target",data) < 1 { do rise_error(404,"No se encontró la cuenta destino") }
        if @@(data,"#item/quantity") <= 0 { do rise_error(400,"No se indicó una cantidad válida") }

        ref item = @@(data,"&item")

        sql = ftext("
        SELECT d.*, p.impuestos
        FROM dventa d
            INNER JOIN producto p ON d.iproducto = p.sys_pk
        WHERE
            d.sys_pk = #<@@(item,'#dventa')> AND
            d.fk_venta_detalle = @source
        ")
        ref dventa = dbr.rec(db,sql,data)
        if isnull(dventa) { do rise_error(404,"No se encontro el producto/receta en la cuenta origen") }

        pk_impuesto = @@(dventa,"#impuestos")
        remainder = @@(dventa,"#cantidad") - @@(item,"#quantity")
        remove = remainder <= 0
        
        if remainder < 0 { item<"quantity"> : @@(dventa,"#cantidad") }
        item<"iproducto"> : @@(dventa,"#iproducto")
        do field.remove(dventa,"impuestos")

        do dbr.begin(db)

        // -- ORIGEN --
        if remove
        {
            do dbr.delete(db,"trazapromocion","fk_dventa=@dventa",item)
            do dbr.delete(db,"dventa","sys_pk=@dventa",item)
        }
        else
        {
            new a
            {
                @"cantidad": remainder
                @"xfacturar": remainder
                @"xsalir": remainder
            }
            do dbr.update(db,"dventa",a,"sys_pk=@dventa",item)
        }

        params<"venta"> : @@(data,"#source")
        do apply_promo(db,params)
        do updateAmounts(db,@@(data,"#source"))

        // -- DESTINO --
        ref existing = dbr.rec(db,ftext("SELECT * FROM dventa WHERE fk_venta_detalle = @target AND iproducto = #<@@(item,'#iproducto')>"),data)
        quantity = @@(item,"#quantity") + @@(existing,"#cantidad")

        if isnull(existing)
        {
            do _remove_sys_fields(dventa)
            using dventa
            {
                @"sys_guid": uuid()
                @"sys_dtcreated*": dbr.sql("now()")
                @"sys_timestamp*": dbr.sql("now()")
                @"sys_recver": 0
                @"sys_deleted": @false

                @"cantidad": quantity
                @"xfacturar": quantity
                @"xsalir": quantity

                @"fk_venta_detalle": @@(data,"#target")
            }
            do dbr.insert(db,"dventa",dventa)
        }
        else
        {
            item<"existing"> : @@(existing,"#sys_pk")

            new b
            {
                @"cantidad": quantity
                @"xfacturar": quantity
                @"xsalir": quantity
            }
            do dbr.update(db,"dventa",b,"sys_pk=@existing",item)
        }

        params<"venta"> : @@(data,"#target")
        do apply_promo(db,params)
        do updateAmounts(db,@@(data,"#target"))

        do dbr.commit(db)
        return @null

        exception
        {
            if dbr.in_transaction(db) { do dbr.rollback(db) }
            do rise_error(500, last_error())
        }
    }

    //#region joinAccounts
    /**
     * Une dos o más cuentas (venta).
       - Todas las cuentas combinadas son canceladas.
       - Se reutiliza la cuenta más reciente y todos los conceptos de las cuentas a unir pasan a formar parte de esta.
       - Si se unen una cuenta abierta y otra libre, se reutiliza la cuenta abierta.
       - Si se unen dos cuentas libres, se abre una nueva cuenta (venta).
       - Solo queda abierta la cuenta resutilizada (o creada) con el nuevo 'id'.
     *
     * @param array data.accounts - Array de objetos donde cada elemento representa una cuenta a unir.
     * @param integer data.accounts[i].sys_pk - Clave primaria de la cuenta.
     * @param string data.accounts[i].key - Identificador de la cuenta.
     * @param string data.new_key - Identificador de la nueva cuenta.
     * @param string data.waiter - Código del mesero en sesión.
     * @param string data.cliente - Código de "(Público general)".
     * @param integer data.cc - Clave primaria del Centro de Consumo.
     *
     * @return get.mesa()
     * ---
     * Fecha: 26-08-2026
     * Autor: Francisco Ávila
     */
    joinAccounts :: &db, &params, &data
    {
        do dbr.begin(db)

        accounts_id = ""
        reuse_pk = 0
        new_key = trim(@@(data,"$new_key"))
        
        for i = 0; i < @count(@@(data,"&accounts"))
        {
            ref item = @item(@@(data,"&accounts"),i)
            sys_pk = @@(item,"#sys_pk")
            
            if sys_pk > 0 {
                accounts_id = accounts_id + ifstr(accounts_id!='',',','') + str(sys_pk)
                if sys_pk > reuse_pk { reuse_pk = sys_pk }
            }
        }

        if (reuse_pk > 0)
        {
            params<"reuse_pk"> : reuse_pk
            params<"new_key"> : new_key

            // Cancelar todas las cuentas
            sql = ftext("UPDATE venta SET statusadministrativo = 99 WHERE sys_pk in(#<accounts_id>)")
            do dbr.execute(db,sql,params)
            // Tranferir conceptos a la cuenta reutilizable.
            sql = ftext("UPDATE dventa SET fk_venta_detalle = @reuse_pk WHERE fk_venta_detalle in(#<accounts_id>)")
            do dbr.execute(db,sql,params)
            sql = ftext("UPDATE orden SET iventa = @reuse_pk WHERE iventa in(#<accounts_id>);")
            do dbr.execute(db,sql,params)
            // Actualizar cuenta reutilizada.
            sql = ftext("
            SELECT
                trim(now()) AS sys_timestamp,
                1 AS statusadministrativo,
                @new_key AS dmnsmesa,
                sum(ifnull(dmnspersonas,0)) AS dmnspersonas,
                trim(group_concat(ifnull(notas,'') SEPARATOR '\n')) AS notas
            FROM venta
            WHERE sys_pk in(#<accounts_id>)
            ")
            ref joined = dbr.rec(db,sql,params)
            do dbr.update(db,"venta",joined,"sys_pk=@reuse_pk",params)
            do updateAmounts(db,reuse_pk)

            params<"id_table"> : reuse_pk
            ref result = get.mesa(db,params)
        }
        else
        {
            new account
            {
                @"table": new_key
                @"num_people": 0
                @"notas": ""
                @"waiter": @@(data,"$waiter")
                @"cliente": @@(data,"$cliente")
                @"cc": @@(data,"$cc")
            }
            ref result = open.table(db,params,account)
        }

        do dbr.commit(db)
        return result

        exception
        {
            if dbr.in_transaction(db) { do dbr.rollback(db) }
            do rise_error(500, last_error())
        }
    }
    
    exist.table::&db,&params,&data
    {
        params<"code">:trim(@@(data,"$table"))
        params<"waiter">:trim(@@(data,"$waiter"))

        idtable=dbr.str(db,@exist_table,params)

        if idtable!=""{do rise_error(99,"Ya existe una mesa con el mismo nombre")}

        ispaid=dbr.num(db,@table_paid,params)
        if ispaid > 0{do rise_error(500,"La cuenta de la mesa no ha sido cobrada.")}
    }

    
    //abre la mesa señalada en id_table
    reopen.table::&db,&params,&data
    {
        new table{@"StatusAdministrativo":1}

        do dbr.update(db,"venta",table,"sys_pk=@id_table",params)

        return get.mesa(db,params)
    }
    
    //cierra la mesa señalada en id_table
    close.table::&db,params,&data
    {
        new table{@"StatusAdministrativo":2}
        
        ref printer= printer_ordertable(db,@@(params,"id_table"),data)

        do dbr.update(db,"venta",table,"sys_pk=@id_table",params)

        ref mesa=get.mesa(db,params)
        mesa<"printer*">:printer

        return mesa
    }

    table.enviar::&db,&params,&data
    {
        ref mesa=close.table(db,params,data)
        do dbr.execute(db,"UPDATE venta SET statusentrega=1 where sys_pk=@id_table",params)
        return mesa
    }

    get.lifespan::&db,sys_pk
    {
        new p{@"sys_pk":sys_pk}
        return dbr.rec(db,@lifespan,p)
    }

    
    get.barrs_line::&db,&item,&list_barrs
    {
        ref bars_line=dbr.list(db,@bars_line,item)
        if not(isnull(bars_line))
        {
            for t=0;t<list.count(bars_line)
            {
                ref itmbl=@item(bars_line,t)
                
                ref vall=split(@@(itmbl,"values"),",")
                ref lvl=list.create()
                for s=0;s<list.count(vall)
                {
                    new lvsl
                    {
                        @"text":list.str(vall,s)
                        @"amount":0
                    }
                    do list.add(lvl,lvsl)
                }
                itmbl<"values*">:lvl
                do list.add(list_barrs,itmbl)
            }
        }
    }

    
