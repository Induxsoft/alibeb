    dataventa::&db,&params
    {
        new p{@"id_table":@@(params,"id_table")}
        return dbr.rec(db,@dataventa,p)
    }
    
    execute.command::&db,&params,&postData
    {
        ref dt= token.data.validate(db,@false)
        if trim(@@(postData,"$waiter"))=="" && @@(dt,"$waiter")!=""{postData<"waiter">:@@(dt,"$waiter")}

        ref details=@@(postData,"&details")
        postData<"id_table">:@@(params,"$id_table")

        ref dic_orders=record.create()
        for i=0;i<@count(details)
        {
            ref itm_details=@item(details,i)
            ref prodcenter=@@(itm_details,"&prodcenter")
            clave=trim(@@(prodcenter,"code"))+"|"+str(@@(itm_details,"#time"))//+"|"+md5(@@(itm_details,"$notes"))
            
            dic_orders<clave+"*">:get.Details(db,clave,itm_details,dic_orders,postData)
        }
        
        do dbr.begin(db)
            do insert.ordenDorden(db,details,dic_orders)
            do updateinsert.ventaDventa(db,postData)
        do dbr.commit(db)

        new p{@"id_table":@@(params,"$id_table")}
        return dbr.rec(db,@dataventa,p)

        exception
        {
            if dbr.in_transaction(db){do dbr.rollback(db)}
            do rise_error(99,last_error())
        }
    }

    
    get.Details::&db,clave,&itm_details,&dic_orders,&postData
    {

        ref sku=@@(itm_details,"&sku")
        ref order=record.create()
        ref list_dorden=list.create()

        ref dorden=table.dorden(db,itm_details,postData)
        campo=campoPrecioR5(@PrecioVenta)
        dorden<"precio">:dbr.num(db,ftext("select #<campo> from producto where sys_pk=@sys_pk"),sku)
        if not(isnull(@@(dic_orders,"&"+clave)))
        {
            ref data=@@(dic_orders,"&"+clave)
            ref details=@@(data,"&dorden")

            key=@@(sku,"$sys_pk")+"|"+@@(dorden,"$precio")+md5(trim(@@(itm_details,"$notes")))
            // key=@@(sku,"$sys_pk")+"|"+@@(dt_imp,"$total")+md5(trim(@@(itm_details,"$notes")))
            flag=@false
            for i=0;i<@count(details)
            {
                ref or=@item(details,i)
                
                keyn=@@(or,"$iproducto")+"|"+@@(or,"$precio")+md5(trim(@@(or,"$especificaciones")))
                
                if key==keyn
                {
                    flag=@true
                    or<"cantidad">:@@(or,"#cantidad")+@@(itm_details,"#quantity")
                }
                do list.add(list_dorden,or)
            }
            if not(flag)
            {
                do list.add(list_dorden,dorden)
            }
            
        }
        else
        {
            do list.add(list_dorden,dorden)
        }
        order<"orden*">:table.order(db,itm_details,postData)
        order<"dorden*">:list_dorden
        return order
    }

    
    table.order::&db,&itm_details,&postData
    {
        ref now=now()
        ref prodc=@@(itm_details,"&prodcenter")
        new p{@"ag":@@(postData,"waiter")}
        
        ref waiter=dbr.rec(db,@waiter_cd,p)
        if isnull(waiter){do rise_error(500,"No se encontró datos del agente")}
        ref dataprodc=dbr.rec(db,@prodc,prodc)

        ref sku=@@(itm_details,"&sku")
        using p
        {
            @"sys_pk":@@(sku,"#sys_pk")
            @"cc":@@(sku,"cod_cc")
        }

        ref cc=dbr.rec(db,@ccxcode,p)
        ref product=dbr.rec(db,@prod,p)
        ref venta=dataventa(db,postData)
        new order
        {
            @"Sys_TimeStamp*":now
            @"Sys_GUID":toupper(cut(uuid(),30))
            @"Sys_DTCreated*":now
            @"Sys_DTExported*":now
            @"Auditada":0
            @"CDirecto":0
            @"CIndirecto":0
            @"CManoObra":0
            @"CMaquinaria":0
            @"Contabilizada":0
            @"D1":0
            @"D2":0
            @"fecha*":now
            @"FPrevista*":now
            @"FProduccion*":now
            @"Hora*":now
            @"HPrevista*":now
            @"HProduccion*":now
            @"Importe": 0
            @"notas":@@(itm_details,"$notes")
            @"Referencia":toupper(uuid())
            @"Status":0
            @"TiempoProduccion":0
            @"TiempoServicio":@@(itm_details,"#time")
            @"TipoCambio":dbr.num(db,"select tcambio from divisa where sys_pk=@idivisa",product)
            @"IAgente":@@(waiter,"sys_pk")
            @"ICConsumo":@@(cc,"#sys_pk")
            @"ICProduccion":@@(dataprodc,"#sys_pk")
            @"IDivisa":@@(product,"#idivisa")
            @"IVenta":@@(venta,"#sys_pk")
        }
        return order
    }

    
    table.dorden::&db,&itm_details,&postData
    {
        // do rise_error(0,to.json(@@(itm_details,"&variables")))
        ref list_dorders=list.create()
        ref sku=@@(itm_details,"&sku")
        new p{@"sys_pk":@@(sku,"#sys_pk")}

        ref product=dbr.rec(db,@prod,p)

        ref now=now()
        
        new dorden
        {
            @"Sys_TimeStamp*":now
            @"Sys_GUID":toupper(cut(uuid(),30))
            @"Sys_DTCreated*":now
            @"Sys_DTExported*":now
            @"Cantidad":@@(itm_details,"#quantity")
            @"CDirecto":0
            @"CIndirecto":0
            @"CManoObra":0
            @"CMaquinaria":0
            @"D1":0
            @"D2":0
            @"TiempoProduccion":0
            @"especificaciones":@@(itm_details,"$notes")
            @"TiempoServicio":@@(itm_details,"#time")
            @"TipoCambio":dbr.num(db,"select tcambio from divisa where sys_pk=@idivisa",product)
            @"IDivisa":@@(product,"#idivisa")
            @"IProducto":@@(product,"#sys_pk")
        }

        ref adds=get.adds(db,@@(itm_details,"&options"))
        do adds_variables(db,adds,@@(itm_details,"&variables"))
        
        dorden<"adds*">:adds
        return dorden
    }
    

    //subtotal con impuesto //ismp define si retorna el impuesto
    get.subtotalImpuesto::subtotal,isImp
    {
        if isImp
        {
            return round(subtotal * @tasa_iva,@DecimalesEnImportes)
        }
        return round(subtotal / (1+@tasa_iva),@DecimalesEnImportes)
    }
    
    adds_variables::&db,&adds,&variables
    {
        if isnull(variables){return}

        ref now=now()

        ref l=list.create_from_fields(variables)
        
        for i = 0; i < @count(l)
        {
            grupo=list.str(l,i)
            ref prod=@@(variables,"&"+grupo)
            
            if not(isnull(prod))
            {
                ref p=list.create_from_fields(prod)
                
                for j = 0; j < @count(p)
                {
                    pk_prod=list.str(p,j)
                    cantidad=@@(prod,"#"+pk_prod)

                    new params
                    {
                        @"grupo":grupo
                        @"prod":pk_prod
                    }

                    ref prd=dbr.rec(db,"select p.cdirecto,p.cindirecto,p.cmanoobra,p.cmaquinaria,p.precio1,
                    p.sys_pk,p.iclase,p.itipo,p.idivisa,p.unidad,p.impuestos
                    from producto p where p.sys_pk=@prod;",params)

                    amount= 0
                    ref dt_imp=GetDataImpuestos(db,amount,cantidad,0,0,@@(prd,"#impuestos"))

                    new item_adds
                    {
                        @"Sys_TimeStamp*":now
                        @"Sys_GUID":uuid()
                        @"Sys_DTCreated*":now
                        @"Sys_DTExported*":now
                        @"Cantidad": cantidad
                        @"CDirecto": 0 //@@(prd,"#cdirecto")
                        @"CIndirecto": 0 // @@(prd,"#cindirecto")
                        @"CManoObra": 0 //@@(prd,"#cmanoobraprom")
                        @"CMaquinaria": 0 //@@(prd,"#cmaquinariaprom")
                        @"Precio":@@(dt_imp,"#total")
                        @"IProducto":pk_prod
                    }

                    do list.add(adds,item_adds)
                }
            }
            
        }
    }
    get.adds::&db,&options
    {
        ref list_adds=list.create()

        for i=0;i<list.count(options)
        {
            ref op=@item(options,i)
            ref values=@@(op,"&values")
            for j=0;j<list.count(values)
            {
                ref val=@item(values,j)
                if trim(@@(val,"sku"))!=""
                {
                    ref prod=dbr.rec(db,@dataadds,val)
                    ref now=now()

                    ref dt_imp=GetDataImpuestos(db,@@(val,"#amount"),1,0,0,@@(prod,"#impuestos"))

                    new adds
                    {
                        @"Sys_TimeStamp*":now
                        @"Sys_GUID":toupper(cut(uuid(),30))
                        @"Sys_DTCreated*":now
                        @"Sys_DTExported*":now
                        @"Cantidad": 1
                        @"CDirecto": 0
                        @"CIndirecto": 0
                        @"CManoObra": 0
                        @"CMaquinaria": 0
                        @"Precio":@@(dt_imp,"#total")
                        @"IProducto":@@(prod,"#sys_pk")
                    }
                }
                else
                {
                    new adds
                    {
                        @"notes":@@(op,"name")+":"+@@(val,"text")+";"
                    }
                }
                do list.add(list_adds,adds)
            }
            
        }
        return list_adds
    }
    updateinsert.ventaDventa::&db,&postData
    {
        do update.totales(db,postData)
        
        exception
        {
            // if dbr.in_transaction(db){do dbr.rollback(db)}
            do rise_error(99,last_error())
        }
    }

    
    //actualiza los totales(venta y dventa)
    //inserta datos correspondientes a la tabla orden y de dorden
    insert.ordenDorden::&db,&params,&data
    {
        ref listcvs=list.create_from_fields(data)
        for i=0;i<list.count(listcvs)
        {
            clv=list.str(listcvs,i)
            ref ordenes=@@(data,"&"+clv)
            ref orden=@@(ordenes,"&orden")

            do dbr.insert(db,"orden",orden)

            sys_pk=dbr.num(db,@getordennew,orden)
            ref dorden=@@(ordenes,"&dorden")
            importe=0
           
            for j=0;j<list.count(dorden)
            {
                ref norden=@item(dorden,j)
                importe=importe + @@(norden,"#precio")
                norden<"FK_Orden_Detalle">:sys_pk
                ref adds=@@(norden,"&adds")

                if field.exist(norden,"adds"){do field.remove(norden,"adds")}
                
                do dbr.insert(db,"dorden",norden)
            
                especifications=""
                if list.count(adds)>0
                {
                    for a=0;a<list.count(adds)
                    {
                        ref add=@item(adds,a)
                        if trim(@@(add,"notes"))!=""
                        {
                            especifications=especifications + @@(add,"notes")
                        }
                        else
                        {
                            sys_pkad=dbr.num(db,@datadorden,norden)
                            add<"FK_DOrden_Adicionales">:sys_pkad
                            do dbr.insert(db,"dadicionales",add)
                        }
                    }
                }
                if especifications!=""
                {
                    new espe{@"Especificaciones":ifstr(@@(norden,"$Especificaciones")!="",@@(norden,"$Especificaciones")+";","")+especifications}
                    do dbr.update(db,"dorden",espe,"sys_guid=@sys_guid",norden)
                }
                
            }
           
            new im{@"importe":importe}
            do dbr.update(db,"orden",im,"sys_guid=@sys_guid",orden)

            do printer_command(db,@@(orden,"$sys_guid"))
        }
        exception
        {
            do rise_error(99,last_error())
        }
    }
    
    update.totales::&db,&postData
    {
        ref now=now()
        new p{@"id_table":@@(postData,"id_table")}
        ref dataVenta=dbr.rec(db,@dataventa,p)

        //eliminar todos datos de dventa de acuerdo a la mesa(venta) clase=2
        do dbr.execute(db,@deletedventa,dataVenta)

        new dventa
        {
            @"Sys_TimeStamp*":now
            @"Sys_DTCreated*":now
            @"Sys_DTExported*":now
            @"Factor":1
            @"Impuesto1":0
            @"Impuesto2":0
            @"Impuesto4":0
            @"Status":1
            @"TipoCambio":1
            @"IAlmacen":1
            @"FK_Venta_Detalle":@@(dataVenta,"#sys_pk")
        }
        ref dtventa=dbr.list(db,@getdorden,dataVenta)
        for i=0;i<list.count(dtventa)
        {
            ref dv=@item(dtventa,i)
        
            using dventa
            {
                @"Sys_GUID":toupper(cut(uuid(),30))
                @"cantidad":@@(dv,"#cantidad")
                @"precio":@@(dv,"#precio")
                @"iproducto":@@(dv,"iproducto")
                @"XFacturar":@@(dv,"#cantidad")
                @"XSalir":@@(dv,"#cantidad")
                @"unidad":"PZA"
                @"Descuento1":@@(dv,"#d1")
                @"Descuento2":@@(dv,"#d2")
            }
            _impuesto=dbr.num(db,"select impuestos from producto where sys_pk=@iproducto",dventa)
            // dventa<@campo_iva>:get.subtotalImpuesto(@@(dv,"#precio"),@true) * @@(dv,"#cantidad")
            ref dt_imp= GetDataImpuestos(db,@@(dv,"#precio"),@@(dv,"#cantidad"),@@(dv,"#d1"),@@(dv,"#d2"),_impuesto)

            dventa<"impuesto1">:@@(dt_imp,"#impuesto1")
            dventa<"impuesto2">:@@(dt_imp,"#impuesto2")
            dventa<"impuesto3">:@@(dt_imp,"#impuesto3")
            dventa<"impuesto4">:@@(dt_imp,"#impuesto4")

            do dbr.insert(db,"dventa",dventa)
        }

        ref totales=dbr.rec(db,@totaldventa,dataVenta)
        totales<"sys_pk">:@@(dataVenta,"#sys_pk")
        //se va a actualizar con sql directo primero meterlo en dventa ,despues actualizar los totales
        do dbr.execute(db,@updateventa,totales)
    }

    
    update.order::&db,&postData
    {
        quantity=@@(postData,"#quantity")
        new p{@"id_table":@@(postData,"id_table")}
        ref dataVenta=dbr.rec(db,@dataventa,p)

        new data
        {
            @"id_table":@@(dataVenta,"sys_pk")
            @"producto":@@(postData,"producto")
            @"pkdorden":@@(postData,"pkdorden")
        }
        quantity=1
        ref dorden=dbr.rec(db,@getdorden_prod,data)

        using data{@"pkorden":@@(dorden,"pkorden")}
        quantitycurrent=@@(dorden,"#cantidad")
        using data{@"cantidad":quantitycurrent - quantity}
        
        update=@false
        do dbr.begin(db)
            if quantitycurrent > quantity
            {
                //update
                do dbr.execute(db,@updatedorden,data)
                ref dv=dbr.rec(db,@getquantitydv,data)
                cantidadv=@@(dv,"#cantidad")

                if cantidadv > 1
                {
                    using data{@"cantidad":cantidadv - 1}

                    ref dt_imp=GetDataImpuestos(db,@@(dv,"#precio"),@@(data,"#cantidad"),@@(dv,"#descuento1"),@@(dv,"#descuento2"),@@(dv,"#impuestos"))
                    using data
                    {
                        @"i1": @@(dt_imp,"#impuesto1")
                        @"i2": @@(dt_imp,"#impuesto2")
                        @"i3": @@(dt_imp,"#impuesto3")
                        @"i4": @@(dt_imp,"#impuesto4")
                    }

                    do dbr.execute(db,ftext(@updatedvt),data)
                }
                else
                {
                    do dbr.execute(db,@deletedvt,data)
                }

                update=@true
            }
            else
            {
                do dbr.execute(db,@deleteadds,data)
                do dbr.execute(db,@deletedorden,data)
                if dbr.num(db,@countdorden,data)==0{do dbr.execute(db,@delete_orden,data)} 

                do updateinsert.ventaDventa(db,p)      
                
            }
            if update
            {
                 ref totales=dbr.rec(db,@totaldventa,dataVenta)
                totales<"sys_pk">:@@(dataVenta,"#sys_pk")
                //actualizar los totales
                do dbr.execute(db,@updateventa,totales)
            }
        
        postData<"id_table">:@@(dataVenta,"sys_pk")
        ref data_order=get.mesa(db,postData)
        
        do dbr.commit(db)

        
        return data_order

        exception
        {
            if dbr.in_transaction(db){do dbr.rollback(db)}
            do rise_error(99,last_error())
        }
    }

    cancel.table::&db,&params,&data
    {
        ordenes_listos=dbr.num(db," SELECT COUNT(*) FROM orden o WHERE o.iventa=@id_table AND o.`status` IN(1,2,3);",params)

        if ordenes_listos > 0{do rise_error(500,"No es posible cancelar la cuenta ya que contiene ordenes en preparación")}

        do dbr.begin(db)
        //cancelar ordenes
        do dbr.execute(db,"UPDATE orden set `status`=4 where iventa=@id_table",params)
        //cancelar venta
        do dbr.execute(db,"UPDATE venta set statusadministrativo=99 where sys_pk=@id_table",params)
        do dbr.commit(db)

        return @null

        exception
        {
            if dbr.in_transaction(db){do dbr.rollback(db)}
            do rise_error(last_error_code(),last_error())
        }
    }
    cortesia.table::&db,&params,&data
    {
        percentaje=@@(data,"#percentaje_cortesia")

        ref mesa=get.mesa(db,params)
        subtotal=@@(mesa,"#subtotal")
        
        new v
        {
            @"notas":"Descuento "+str(percentaje)+"% por cortesía"
            @"descuento1":(div(percentaje,100) * subtotal)
        }

        process_venta=(percentaje == 100)
        if process_venta
        {
            using v
            {
                @"impuesto1": 0
                @"impuesto2": 0
                @"impuesto3": 0
                @"impuesto4": 0
            }
        }
        do dbr.begin(db)
        do dbr.update(db,"venta",v,"sys_pk=@id_table",params)

        if process_venta
        {
            ref v=close.table(db,params,data)
            do dbr.execute(db,"UPDATE venta set statusadministrativo=3 where sys_pk=@id_table",params)
            v<"status">: 3
        }

        do dbr.commit(db)

        exception
        {
            if dbr.in_transaction(db){do dbr.rollback(db)}
            do rise_error(last_error_code(),last_error())
        }
        return v
    }

    table.setdealer::&db,&params,&data
    {
        params<"repartidor">:@@(data,"#repartidor")
        if dbr.num(db,"SELECT sys_pk FROM repartidor WHERE sys_pk=@repartidor;",params)<1{do rise_error(500,"No se encontró el repartidor indicado")}

        do dbr.execute(db,"UPDATE venta set irepartidor=@repartidor WHERE sys_pk=@id_table",params)
        ref mesa= table.enviar(db,params,data)

        return mesa
    }
    table.entregada::&db,&params,&data
    {
        // ref mesa=close.table(db,params,data)
        do dbr.execute(db,"UPDATE venta SET statusentrega=3 where sys_pk=@id_table",params)
        return @null
    }
    table.enviada::&db,&params,&data
    {
        // ref mesa=close.table(db,params,data)
        do dbr.execute(db,"UPDATE venta SET statusentrega=1 where sys_pk=@id_table",params)
        return @null
    }
    //#endregion
    
    // ********************************************************

    //#region Waiter(admin)
    get.code_waiter::&db
    {
        sys_pk=dbr.num(db,"select max(sys_pk) from agente",@null)
        code="000"+str(sys_pk+1)
        if length(code)>5{code=right(code,5)}
        return code
    }
    
    get.waiters::&db,&params
    {
        query=@getwaiters + " where true "

        if @@(params,"access")!=""{query=query+" AND u.access_movil"}
        query=query + " AND if(ifnull(@ub,'*')='*',true,ubicacion=@ub)"

        return dbr.list(db,query,params)
    }

    
    get.dataWaiter::&db,&params
    {
        return dbr.rec(db,replace(@getwaiter,"@_key",@@(params,"key")),params)
    }
    //#endregion
    

    //#region LOGIN
    SelectCorte::&db,&params,&postData
    {
        idcaja=dbr.num(db,"select ifnull(sys_pk,0) from caja where codigo=@caja",postData)
        postData<"pwdmd5e">:md5e(@@(postData,"$pwd"),"unicode")
        idcajero=dbr.num(db,"select ifnull(sys_pk,0) from cajero where codigo=@cajero AND (contrasena=MD5(@pwd) OR contrasena=@pwdmd5e)",postData)
        
        if idcajero < 1{do rise_error(500,"Usuario o contraseña incorrecta.")}
        if idcaja < 1{do rise_error(500,"La caja indicada no es válido")}

        params<"idcajero">:idcajero
        idwaiter=dbr.num(db,"select ifnull(agente,0) from cajero where sys_pk=@idcajero",params)

        using params
        {
            @"caja":idcaja
            @"cajero":idcajero
            @"waiter":idwaiter
        }
        //validar si la caja ya tiene un cajero
        sql="select  count(*) from corte ct inner join cajero cj on ct.icajero=cj.sys_pk 
        where ifnull(ct.cerrado,0)=0 
        and cj.sys_pk<>@cajero and ct.icaja=@caja"

        if dbr.num(db,sql,params) > 0{do rise_error(500,"La caja ya esta en uso por otro cajero")}
        //validar si el cajero ya tiene otra caja abierta
        sql="select  count(*) from corte ct inner join cajero cj on ct.icajero=cj.sys_pk 
        where ifnull(ct.cerrado,0)=0 
        and cj.sys_pk=@cajero and ct.icaja<>@caja"

        if dbr.num(db,sql,params) > 0{do rise_error(500,"Imposible iniciar sesión, el cajero indicado ha abierto una sesión en otra caja")}

        idcorte=dbr.num(db,"select * from corte as c where ifnull(c.cerrado,0)=0
                and c.icaja=@caja and c.icajero=@cajero",params)
            
        if idcorte < 1
        {
            new corte
            {
                @"sys_guid":uuid()
                @"sys_dtcreated*":dbr.sql("now()")
                @"sys_timestamp*":dbr.sql("now()")
                @"sys_exported":0
                @"sys_dtexported*":dbr.sql("now()")
                @"cerrado":0
                @"fapertura*":dbr.sql("now()")
                @"hapertura*":dbr.sql("now()")
                @"fcierre*":dbr.sql("now()")
                @"hcierre*":dbr.sql("now()")
                @"sys_recver":0
                @"icaja":idcaja
                @"icajero":idcajero
            }
            do dbr.insert(db,"corte",corte)
            idcorte =dbr.num(db,"select ifnull(sys_pk,0) from corte where sys_guid=@sys_guid",corte)
        }

        ref data=dbr.rec(db,"SELECT
                a.codigo,a.codnomina,a.email,a.nombre,a.notas,a.pcomision,a.telefono,
                ifnull(u.access_movil,0)access_movil,ifnull(u.cc,0)cc,ifnull(u.zn,0)zn 
                from agente a
                left JOIN ut_dm_tmm u ON a.Sys_PK=u.agente
                WHERE u.agente=@waiter",params)

        ref data=ifnull(data,record.create())

        ref zone=dbr.rec(db,@getzone,data)
        new d
        {
            @"key":@@(data,"codigo")
            @"caption":@@(data,"nombre")
            @"zone":@@(zone,"descripcion")
            @"cc":dbr.num(db,"select centroconsumo from caja where sys_pk=@caja",params)
            @"idcaja":@@(postData,"$caja")
            @"idcajero":@@(postData,"$cajero")
            @"corte":idcorte
        }
        data<"corte">:idcorte
        data<"datos*">:d
        data<"token">:uuid()
        do update.datatoken(db,d)
        ref datatoken=insert.datatoken(db,params,data)
        data<"datatoken*">:datatoken
        return data
    }
    
    login::&db,&params,&postdata
    {
        if field.exist(postdata,"caja") && field.exist(postdata,"cajero")
        {
            return SelectCorte(db,params,postdata)
        }
        ref data=dbr.rec(db,@login,postdata)
        if isnull(data){do rise_error(500,"Usuario o contraseña incorrecta.")}

        data<"key">:"sys_pk"

        data<"waiter">:@@(data,"agente")
        ref waiter=get.dataWaiter(db,data)//dbr.rec(db,@getdatapwd,data)//get.dataWaiter(db,data)
         
        ref zone=dbr.rec(db,@getzone,data)
        new d
        {
            @"key":@@(waiter,"codigo")
            @"caption":@@(waiter,"nombre")
            @"zone":@@(zone,"descripcion")
            @"cc":@@(data,"cc")
        }
        data<"datos*">:d
        data<"token">:uuid()
        do update.datatoken(db,d)
        ref datatoken=insert.datatoken(db,params,data)
        data<"datatoken*">:datatoken

        return data
    }
    access.config::&db,&params,&postData
    {
        privilegio="CA70"
        
        if @@(postData,"$sitem") == "cortesia"{privilegio="CA72"}
        else if @@(postData,"$sitem") == "cancelar"{privilegio="CA71"}

        do access(db,params,postData,privilegio)
    }
    access::&db,&params,&postData,privilegio
    {
        using params
        {
            @"uid":trim(@@(postData,"$user"))
            @"pwdmd5":md5(trim(@@(postData,"$pwd")))
            @"pwdmd5u":md5e(@@(postData,"$pwd"),"unicode")
        }
        ref user:dbr.rec(db,"select 
			sys_pk, ifnull(locked,0) locked 
			from tuser 
			where lower(userid)=@uid 
			and (lower(pwdmd5)=@pwdmd5 or lower(pwd)=@pwdmd5u)
			and ifnull(sys_deleted,0)=0",params)

        if isnull(user){do rise_error(500,"Usuario y contraseña incorrecto")}

        ref _db=dbr.login(@@(@http_context,"$session/idp/qname"),@@(params,"$uid"),trim(@@(postData,"$pwd")))
        if isnull(@@(@http_context,"&session/user")){@http_context<"session/user*">:record.create()}

        @http_context<"session/idp/database*">:_db
        @http_context<"session/user/uid">:@@(params,"$uid")
        @http_context<"session/user/ids">:dbr.getSID(_db)
        do dbr.apps.action.grant(privilegio)
    }
    //#endregion
    

    //#region TOKEN
    VerifyToken::&db,&data
    {
        ref datatoken=dbr.rec(db,"select * from ut_dn_dmm_token where token=@dm_token",data)
        if isnull(datatoken) || trim(@@(datatoken,"$datos"))==""{return @false}

        ref json=from.json(trim(@@(datatoken,"$datos")))

        if field.exist(json,"idcaja")
        {
            idcaja=dbr.num(db,"select sys_pk from caja where codigo=@idcaja",json)
            
            if idcaja > 0
            {
                data<"_icaja">:idcaja
                data<"icaja">:idcaja
            }
            corte=dbr.num(db,"SELECT sys_pk FROM corte c WHERE c.icaja=@_icaja AND IFNULL(c.cerrado,0)=0;",data)
            if corte < 1{do rise_error(500,"No hay un corte abierto para el cajero actual, cierre sesión e intente de nuevo")}
            data<"icorte">:corte
        }

        if field.exist(json,"idcajero")
        {
            ref cajero=dbr.rec(db,"select sys_pk,codigo,nombre,agente from cajero where codigo=@idcajero",json)
            if isnull(cajero){return @false}

            if @@(cajero,"#agente")< 1{do rise_error(500,"El cajero no tiene un agente relacionado para continuar")}

            ref dmtmmn=dbr.rec(db,"SELECT * FROM ut_dm_tmm u WHERE u.agente=@agente",cajero)
            if isnull(dmtmmn){do rise_error(500,"Se encontró una relación entre el cajero y el agente pero, no hay una configuración de centro de consumo")}

            ref zone=dbr.rec(db,@getzone,dmtmmn)
            ref agente=dbr.rec(db,"select codigo,nombre from agente where sys_pk=@agente",cajero)
            
            if @@(dmtmmn,"#cc") < 1{do rise_error(500,"No hay un centro de consumo configurado para el cajero")}

            using json
            {
                @"key":@@(agente,"$codigo")
                @"caption":@@(agente,"$nombre")
                @"zone":@@(zone,"$descripcion")
                @"cc":@@(dmtmmn,"#cc")
            }

            data<"waiter">:@@(agente,"$codigo")
            data<"iagente">:@@(cajero,"#agente")
            data<"cc">:@@(json,"#cc")
            
            new r{@"datos":to.json(json)}
            //actualizar datos del token
            do dbr.update(db,"ut_dn_dmm_token",r,"token=@dm_token",data)
        }
        else if @@(json,"$key")!="" && @@(data,"#icaja") < 1
        {
            if @@(json,"#cc") < 1{do rise_error(500,"No hay un centro de consumo configurado para el agente")}

            do GetCorteMesero(db,json,data)
        }

        
        return @true
    }
    update.datatoken::&db,&params
    {
        ref listwaiter=dbr.list(db,@getdatatoken,@null)
        for i=0;i<@count(listwaiter)
        {
            ref itm=@item(listwaiter,i)
            ref data=from.json(field.dstr(itm,"datos","{}"))
            exception{}
            if @@(data,"key")==@@(params,"key")
            {
                do dbr.execute(db,@updatedatatoken,itm)
            }
        }
    }

     
    insert.datatoken::&db,&params,&data
    {
        new config{@"cofig_expiracion":@@(data,"cofig_expiracion")}
        new datatoken
        {
            @"token":@@(data,"token")
            @"creacion*":now()
            @"expiracion*":str2dt(dbr.str(db,"SELECT NOW()+INTERVAL @cofig_expiracion minute AS DATE ",config))
            @"revocado":0
            @"datos":to.json(@@(data,"&datos"))
        }
        do dbr.insert(db,"ut_dn_dmm_token",datatoken)
        return datatoken
    }
    token.valid::&db,&params
    {
        query=@getdatatoken
        query=query+" where token=@token AND date(expiracion)>= date(NOW()) AND revocado=0 ;"
        ref json=dbr.rec(db,query,params)
        if isnull(json){return @null}
        
        json<"json*">:from.json(@@(json,"datos"))
        return json
    }


    get.token::&db,&params,&postData
    {
        query=@getdatatoken
        query=query+" where token=@token"
        ref json=dbr.rec(db,query,postData)
        if isnull(json){return @null}
        json<"json*">:from.json(@@(json,"datos"))
    
        return json
    }
   
    token.logout::&db,params
    {
        do dbr.delete(db,"ut_dn_dmm_token","token=@token",params)
        exception{}
        return @null
    }

    token.data.validate::&db,validar
    {
        new p
        {
            @"dm_token":@dmtoken
            @"token":@dmtoken
            @"validate":validar
        }
		if isnull(token.valid(db,p)){do rise_error(99,"El token es inválido o ha sido revocado.")}

        r= VerifyToken(db,p)
        if not(r){do rise_error(500,"Algo salió mal, cierre sesión e intente de nuevo")}

        return p
    }
    //#endregion
    

    //#region CONTROLADORES(DRIVERS)
    //====================CONTROLADORES=============================================================
    get.drivers::&db,&params
    {
        if not(file.exists(@path_file_device_drivers)){do rise_error(500,"No existe el archivo de configuración de controladores para el dispositivo")}

        ref drivers_servers=dbr.list(db,"select * from ut_dm_tmm_gprn",params)
        ref dserver=list.create()

        for i = 0; i < @count(drivers_servers)
        {
            ref ds=@item(drivers_servers,i)
            ref data=from.json(@@(ds,"$data"))
            new type{@"default":@@(data,"$type")}
            data<"type*">:type
            data<"name">:@@(ds,"$id")
            do list.add(dserver,data)
        }

        new drivers
        {
            @"server*":dserver
            @"device*":from.json(file.rtext(@path_file_device_drivers))
        }

        return drivers
    }
    //#endregion
    
    //#region DATOS DEL TICKET O CUENTA
    data.ticket::&db,&params
    {
        new p
        {
            @"id_table":@@(params,"#id_table")
            @"iventa":@@(params,"#id_table")
        }

        ref datamesa=dbr.rec(db,@data_mesa,params)
        if isnull(datamesa){do rise_error(99,"No se encontro datos del ticket.")}

        ref ticket=record.copyex(datamesa,@null,"*",",","code:mesa,reference:referencia,cliente:idcc,balance:total",":")
        
        using p
        {
            @"cliente":@@(ticket,"#idcc")
            @"cc":@@(ticket,"#cc")
            @"ag":@@(ticket,"#ag")
            @"code":@@(datamesa,"code")
            @"iventa":@@(params,"#id_table")
        }
        
        ticket<"fecha_actual">:date_str(now(),"yyyy-MM-dd  hh:mm:ss")
        ticket<"empresa">:dbr.str(db,"SELECT varvalue FROM globalvar g WHERE g.VarName='FXCA112';",@null)
        ticket<"status">:@@(ticket,"$text_status_admin")
        if @@(ticket,"#imovcaja") > 0 && @@(ticket,"#statusadministrativo") != 3 {ticket<"status">:"-PAGADO-"}

        ref cliente=dbr.rec(db,@customer,p)
        ticket<"cliente*">:cliente
        ticket<"cconsumo*">:dbr.rec(db,@cc,p)
        ticket<"mesero*">:dbr.rec(db,@waiter,p)
        ticket<"caja*">:dbr.rec(db,"select c.sys_pk,c.codigo,c.descripcion from caja c where c.sys_pk=@icaja;",ticket)
        ticket<"divisa*">:dbr.rec(db,"select sys_pk,codigo,descripcion,tcambio from divisa where sys_pk=@idivisa",ticket)

        ticket<"lifespan*">:get.lifespan(db,@@(ticket,"sys_pk"))
        ticket<"detalle*">:get.ordenes(db,p)

        ref corte=dbr.rec(db,"select c.sys_pk,
                trim(c.fapertura)fapertura,
                trim(c.hapertura)hapertura,
                trim(c.hcierre)hcierre,
                trim(c.fcierre) fcierre,
                c.cerrado,c.icajero,c.icaja
                from corte as c 
                where sys_pk=@icorte",ticket)
        ticket<"corte*">:corte
        ticket<"cajero*">:dbr.rec(db,"select sys_pk,codigo,nombre from cajero where sys_pk=@icajero",corte)

        ticket<"fpagos*">:ticket.fpagos(db,@@(params,"#id_table"),@@(ticket,"#imovcaja"))

        ticket<"comandas*">:ticket.comandas(db,@@(params,"#id_table"))
        ticket<"importe_letras">:Int2Ltr(@@(ticket,"#total"))+" "+Dec2Ltr(@@(ticket,"#total"))
        ticket<"text_footer">:dbr.str(db,"SELECT varvalue FROM globalvar g WHERE g.VarName='FXCA113';",@null)
        ticket<"nota_adicional">:"*NO ES UN COMPROBANTE DE PAGO*"

        //datos de entrega
        ref entrega=dbr.rec(db,"SELECT d.sys_pk,d.nombre,d.telefono,d.direccion,d.notas AS referencia FROM dmns_entrega e 
        INNER JOIN dmns_destino d ON e.destino=d.sys_pk
        WHERE e.venta=@iventa;",p)

        ticket<"entrega*">:entrega

        return ticket
    }
    ticket.fpagos::&db,venta,_movcaja
    {
        venta,_movcaja >> p

        ref movcaja=dbr.rec(db,"select
            mc.sys_pk,
            mc.efectivo,
            mc.tarjetas,
            mc.vales,
            mc.depositos,
            mc.cheques,
            mc.referencia,
            mc.auditado,
            mc.contabilizado,
            mc.documento,
            trim(mc.fecha) fecha_mov,
            trim(mc.hora) hora_mov,
            mc.notas,
            mc.tipocambio as tipocambio_mov,
            c.codigo categoria,
            d.codigo as divisa,
            ct.sys_guid as corte
        from
            movcaja mc
            inner join categoria c on mc.icategoria = c.sys_pk
            inner join divisa d on mc.idivisa = d.sys_pk
            inner join corte ct on mc.icorte = ct.sys_pk
        WHERE mc.sys_pk=@_movcaja",p)

        ref movcaja=ifnull(movcaja,record.create())

        movcaja<"tarjetas*">:dbr.list(db,"select 
        dt.sys_pk,dt.autorizacion,dt.cvv,dt.domicilio,
        dt.importe, dt.nombre,dt.numero,dt.tipocambio ,
        d.codigo as divisa,d.tcambio as tcambio_divisa,
        tc.codigo as tipo,dt.retiro
        from dtarjeta dt
        inner join divisa d on dt.idivisa=d.sys_pk
        inner join tarjetacredito tc on dt.tipo=tc.sys_pk
        where dt.fk_movcaja_detalletarjetas=@_movcaja",p)

        movcaja<"depositos*">:dbr.list(db,"select dd.sys_pk,dd.banco,dd.fecha,dd.referencia ,dd.importe,dd.tipocambio,
        dd.retiro,d.codigo as divisa
        from ddepositos dd 
        inner join divisa d on dd.idivisa=d.sys_pk
        where dd.fk_movcaja_detalledepositos=@_movcaja",p)

        movcaja<"cheques*">:dbr.list(db,"select dc.sys_pk,dc.banco,dc.beneficiario,dc.emisor,dc.importe,dc.notas,dc.numero,dc.tipocambio ,
        d.codigo as divisa,dc.retiro
        from dcheques dc
        inner join divisa d on dc.idivisa=d.sys_pk
        where dc.fk_movcaja_detallecheques=@_movcaja;",p)

        movcaja<"vales*">:dbr.list(db,"select dv.sys_pk,dv.fecha,dv.importe,dv.notas,dv.referencia,dv.tipocambio ,
        dv.retiro,d.codigo as divisa
        from dvales dv 
        inner join divisa d on dv.idivisa=d.sys_pk
        where dv.fk_movcaja_detallevales=@_movcaja;",p)

        return movcaja
    }
    ticket.comandas::&db,venta
    {
        venta >> p

        p<"sql">:@_list_dorden

        ref orders=dbr.list(db,"select 
        o.sys_pk,o.auditada,o.cdirecto,o.cindirecto,o.cmanoobra,o.cmaquinaria,o.contabilizada,o.d1,
        o.d2,trim(o.fecha)fecha,trim(o.fprevista)fprevista,trim(o.fproduccion)fproduccion,o.importe,o.notas,o.referencia,o.`status`,
        o.tiempoproduccion,o.tiemposervicio,o.tipocambio,
        cp.codigo as cprod,
        a.codigo as agente,
        cc.codigo as cconsumo
        from orden o
        inner join cproduccion cp on o.icproduccion=cp.sys_pk
        inner join agente a on o.iagente=a.sys_pk
        inner join cconsumo cc on o.icconsumo=cc.sys_pk
        where o.iventa=@venta",p)

        for i = 0; i < @count(orders)
        {
            ref o=@item(orders,i)
            p<"_orden">:@@(o,"#sys_pk")
            o<"detalle*">:get.ordenes(db,p)
        }
        return orders
    }
    //#endregion
}