    _CopyFieldsMov::&postData
    {
        ref data=record.copyex(postData,@null,"referencia,fecha,categoria,divisa,efectivo,descripcion",",","categoria:icategoria,divisa:idivisa,descripcion:notas",":")
        if trim(@@(data,"$fecha"))==""{do field.remove(data,"fecha")}

        return data
    }
    number_format::value
    {
        number = parse.num(value)
        format = @SYMBOLE_DIVISA+" #"+@THOUSANDS_SEPARATOR+"0"+@DECIMAL_SEPARATOR+padright("",@DECIMAL_PRECISION,"0")
        return format(number,format)
    }
    number_round::value
    {
        return round(value,@DECIMAL_PRECISION)
    }
    
    
    ParseHost::host_root
    {
        ref @__uri=_new("System.Uri",host_root)
        host=_get(@__uri,"Host")
        protocol=_get(@__uri,"Scheme")
        port=str(_get(@__uri,"Port"))
        absolutePath=_get(@__uri,"AbsolutePath")
        query=_get(@__uri,"Query")

        new _site
        {
            @"protocol":protocol
            @"host":host
            @"port":port
            @"absolutePath":absolutePath
            @"query":query
        }
        
        return _site

        exception{return @null}
    }
    CreateHost::&db,id,act
    {
        new p{@"id":trim(id)}
        img_linea_def=@img_default_lines
        img_foodbev=@img_default_foodbev
        url=""
        path=""
        guid_file=""
        url_root_foodbev=trim(dbr.vars.get(db,"pos_url_root_img_foot_line"))
        ref datahost=ParseHost(url_root_foodbev)

        new dt_img{}
        
        switch act
        {
            case "linea"
            {
                dt_img<"def_img">:img_linea_def
                dt_img<"img">:img_linea_def
                url=trim(dbr.vars.get(db,"prodserv_path_img_lns_url"))
                path=trim(dbr.vars.get(db,"prodserv_path_img_lns"))

                if url=="" || path=="" || url_root_foodbev=="" || isnull(datahost){return dt_img}
                
                //debe venir de la base de datos
                guid_file=trim(dbr.str(db,"SELECT img_file from linea WHERE codigo=@id",p))
                if guid_file==""{return dt_img}
                
                break
            }
            default
            {
                dt_img<"def_img">:img_foodbev
                dt_img<"img">:img_foodbev
                url=trim(dbr.vars.get(db,"prodserv_static_content_url"))
                path=trim(dbr.vars.get(db,"prodserv_path_static_content"))

                if url=="" || path=="" || url_root_foodbev=="" || isnull(datahost) {return dt_img}

                //debe venir de la base de datos
                guid_file=trim(dbr.str(db,"SELECT cp.guidimagen from carousel_producto cp WHERE cp.sku=@id",p))
                if guid_file==""{return dt_img}

                break
            }
        }

        datahost<"id">:id

        npath=ReplaceMacros(path,datahost)
        path_file=path.concat(npath,guid_file)

        // if not(file.exists(path_file))
        // {
        //     if act=="linea"{return img_linea_def}
            
        //     return img_foodbev
        // }
        nurl=ReplaceMacros(url,datahost)
        url_file=path.concat(nurl,guid_file)
        
        using dt_img{@"img":url_file}

        return dt_img
    }
    ReplaceMacros::urlOrPath,&datahost
    {
        urlOrPath=replace(urlOrPath,"@_protocol",@@(datahost,"$protocol"))
        urlOrPath=replace(urlOrPath,"@_host",@@(datahost,"$host"))
        urlOrPath=replace(urlOrPath,"@_port",@@(datahost,"$port"))
        urlOrPath=replace(urlOrPath,"@_id",@@(datahost,"$id"))
        urlOrPath=replace(urlOrPath,"@_sku",@@(datahost,"$id"))

        return urlOrPath
    }
