    get.adds.dmns::&db,params
    {
        ref adcs=dbr.list(db,@adcs_dmns,params)

        ref list_adcs=list.create()

        for i=0;i<list.count(adcs)
        {
            ref itm=@item(adcs,i)
            new ad
            {
                @"text":@@(itm,"text")
                @"sku":@@(itm,"sku")
                @"amount":aplImpuestos(@@(itm,campoPrecioAdcR5(@PrecioAdcs)),parseImpuesto(@@(itm,"i1venta"),@zonaImpuesto),parseImpuesto(@@(itm,"i2venta"),@zonaImpuesto),parseImpuesto(@@(itm,"i3venta"),@zonaImpuesto),parseImpuesto(@@(itm,"i4venta"),@zonaImpuesto))
            }
            do list.add(list_adcs,ad)
        }

        new adc
        {
            @"name":"__adds"
            @"type":"multiple"
            @"required":@false
            @"values*":list_adcs
        }
        return adc
    }

    
    dataventa::&db,&params
    {
        new p{@"id_table":@@(params,"id_table")}
        return dbr.rec(db,@dataventa,p)
    }
    
    execute.command::&db,&params,&postData
    {
        do getVarsConfig()
        if not(isset("@__from_sise")) { @__from_sise = @false }
        if not(@__from_sise)
        {
            ref dt = token.data.validate(db,@false)
            if trim(@@(postData,"$waiter"))=="" && @@(dt,"$waiter")!="" { postData<"waiter"> : @@(dt,"$waiter") }
        }
        
        ref details=@@(postData,"&details")
        postData<"id_table">:@@(params,"$id_table")

        /*
         * Summary:
         * Verificar si la venta existe , sí no crearla
        */

        if isnull(dataventa(db,params))
        {
            /*
             * Summary:
             * - Crear venta 
            */
            params<"gen_table_ff">:@true
            ref venta=open.table(db,params,postData)
            postData<"id_table">:@@(venta,"$sys_guid")
            params<"id_table">:@@(venta,"$sys_guid")
        }
        
        ref dic_orders=record.create()

        for i=0;i<@count(details)
        {
            ref itm_details=@item(details,i)
            ref prodcenter=@@(itm_details,"&prodcenter")
            
            code_prodcer=trim(@@(prodcenter,"$code"))
            if code_prodcer == ""{code_prodcer=md5(@@(itm_details,"$sku/sku"))}

            clave=code_prodcer+"|"+str(@@(itm_details,"#time"))//+"|"+md5(@@(itm_details,"$notes"))
            ref ord_details=get.Details(db,clave,itm_details,dic_orders,postData)

            if not(isnull(ord_details)){dic_orders<clave+"*">:ord_details}
        }

        do addVentas(postData)

        do dbr.begin(db)
            do insert.ordenDorden(db,details,dic_orders)
            do updateinsert.ventaDventa(db,postData)
        do dbr.commit(db)

        new p{@"id_table":@@(params,"$id_table")}
        ref detalle_venta=ifnull(dbr.rec(db,@dataventa,p),record.create())

        detalle_venta<"promociones*">:@data_promocion

        return detalle_venta

        exception
        {
            if dbr.in_transaction(db){do dbr.rollback(db)}
            do rise_error(99,last_error())
        }
    }

    
    get.Details::&db,clave,&itm_details,&dic_orders,&postData
    {
        ref sku=@@(itm_details,"&sku")
        ref order=record.create()
        ref list_dorden=list.create()

        @isventa=@false
        ref dorden=table.dorden(db,itm_details,postData)
        if isnull(dorden)
        {
            @isventa=@true
            ref dic_orders=@@(postData,"&lventas")
            ref dorden=table.dventa(db,itm_details,postData)
        }
        
        campo=campoPrecioR5(@PrecioVenta)
        dorden<"precio">:dbr.num(db,ftext("select #<campo> from producto where sys_pk=@sys_pk"),sku)
        if not(isnull(@@(dic_orders,"&"+clave)))
        {
            ref data=@@(dic_orders,"&"+clave)
            ref details=@@(data,"&dorden")

            key=@@(sku,"$sys_pk")+"|"+@@(dorden,"$precio")+md5(trim(@@(itm_details,"$notes")))
            // key=@@(sku,"$sys_pk")+"|"+@@(dt_imp,"$total")+md5(trim(@@(itm_details,"$notes")))
            flag=@false
            for i=0;i<@count(details)
            {
                ref or=@item(details,i)
                
                keyn=@@(or,"$iproducto")+"|"+@@(or,"$precio")+md5(trim(@@(or,"$especificaciones")))
                
                if key==keyn
                {
                    flag=@true
                    or<"cantidad">:@@(or,"#cantidad")+@@(itm_details,"#quantity")
                }
                do list.add(list_dorden,or)
            }
            
            if not(flag){do list.add(list_dorden,dorden)}
        }
        else
        {
            do list.add(list_dorden,dorden)
        }

        if not(@isventa)
        {
            order<"orden*">:table.order(db,itm_details,postData)
            order<"dorden*">:list_dorden
            return order
        }
        //si es venta
        if isnull(@@(postData,"&lventas")){postData<"lventas*">:record.create()}
        postData<"lventas/"+clave+"*">:record.create()
        postData<"lventas/"+clave+"/dorden*">:list_dorden

        return @null
    }
    arrayAdd::lo,&ld
    {
        for i = 0; i < @count(lo)
        {
            do list.add(ld,@item(lo,i))
        }
    }

    addVentas::&postData
    {
        postData<"dventas*">:list.create()

        ref klventas=list.create_from_fields(ifnull(@@(postData,"&lventas"),record.create()))
        for i = 0; i < @count(klventas)
        {
            k=list.str(klventas,i)
            ref lventas=@@(postData,"&lventas/"+k+"/dorden")
            do arrayAdd(lventas,@@(postData,"&dventas"))
        }
    }
    
    table.order::&db,&itm_details,&postData
    {
        if not(isset("@__from_sise")) { @__from_sise = @false }

        ref now=now()
        ref prodc=@@(itm_details,"&prodcenter")
        new p{@"ag":@@(postData,"waiter")}
        
        ref waiter=dbr.rec(db,@waiter_cd,p)
        if isnull(waiter) && not(@__from_sise) { do rise_error(500,"No se encontró datos del agente") }
        ref dataprodc=dbr.rec(db,@prodc,prodc)

        ref sku=@@(itm_details,"&sku")
        using p
        {
            @"sys_pk":@@(sku,"#sys_pk")
            @"cc":@@(sku,"cod_cc")
        }

        ref cc=dbr.rec(db,@ccxcode,p)
        ref product=dbr.rec(db,@prod,p)
        ref venta=dataventa(db,postData)
        new order
        {
            @"Sys_TimeStamp*":now
            @"Sys_GUID":toupper(cut(uuid(),30))
            @"Sys_DTCreated*":now
            @"Sys_DTExported*":now
            @"Auditada":0
            @"CDirecto":0
            @"CIndirecto":0
            @"CManoObra":0
            @"CMaquinaria":0
            @"Contabilizada":0
            @"D1":0
            @"D2":0
            @"fecha*":now
            @"FPrevista*":now
            @"FProduccion*":now
            @"Hora*":now
            @"HPrevista*":now
            @"HProduccion*":now
            @"Importe": 0
            @"notas":@@(itm_details,"$notes")
            @"Referencia":toupper(uuid())
            @"Status":0
            @"TiempoProduccion":0
            @"TiempoServicio":@@(itm_details,"#time")
            @"TipoCambio":dbr.num(db,"select tcambio from divisa where sys_pk=@idivisa",product)
            @"ICConsumo":@@(cc,"#sys_pk")
            @"ICProduccion":@@(dataprodc,"#sys_pk")
            @"IDivisa":@@(product,"#idivisa")
            @"IVenta":@@(venta,"#sys_pk")
        }

        if @@(waiter,"#sys_pk") > 0 { order<"IAgente"> : @@(waiter,"#sys_pk") }

        return order
    }

    
    table.dorden::&db,&itm_details,&postData
    {
        // do rise_error(0,to.json(@@(itm_details,"&variables")))
        ref sku=@@(itm_details,"&sku")
        new p{@"sys_pk":@@(sku,"#sys_pk")}

        ref product=dbr.rec(db,@prod,p)
        if @@(product,"#clase") != @clase_prod_receta{return @null}

        ref now=now()
        
        new dorden
        {
            @"Sys_TimeStamp*":now
            @"Sys_GUID":toupper(cut(uuid(),30))
            @"Sys_DTCreated*":now
            @"Sys_DTExported*":now
            @"Cantidad":@@(itm_details,"#quantity")
            @"CDirecto":0
            @"CIndirecto":0
            @"CManoObra":0
            @"CMaquinaria":0
            @"D1":0
            @"D2":0
            @"TiempoProduccion":0
            @"especificaciones":@@(itm_details,"$notes")
            @"TiempoServicio":@@(itm_details,"#time")
            @"TipoCambio":dbr.num(db,"select tcambio from divisa where sys_pk=@idivisa",product)
            @"IDivisa":@@(product,"#idivisa")
            @"IProducto":@@(product,"#sys_pk")
        }

        ref adds=get.adds(db,@@(itm_details,"&options"))
        do adds_variables(db,adds,@@(itm_details,"&variables"))
        
        dorden<"adds*">:adds
        return dorden
    }
    table.dventa::&db,&itm_details,&postData
    {
        ref sku=@@(itm_details,"&sku")
        new p{@"sys_pk":@@(sku,"#sys_pk")}

        ref product=dbr.rec(db,"select * from producto where sys_pk=@sys_pk",p)
        campo=campoPrecioR5(@PrecioVenta)

        if @@(product,"#clase") == @clase_prod_receta{return @null}

        new dventa
        {
            @"cantidad":@@(itm_details,"#quantity")
            @"d1": 0
            @"d2": 0
            @"precio": @@(product,"#"+campo)
            @"tipocambio": dbr.num(db,"select tcambio from divisa where sys_pk=@idivisa",product)
            @"iproducto":@@(product,"#sys_pk")
        }

        return dventa
    }

    //subtotal con impuesto //ismp define si retorna el impuesto
    get.subtotalImpuesto::subtotal,isImp
    {
        if isImp
        {
            return round(subtotal * @tasa_iva,@DecimalesEnImportes)
        }
        return round(subtotal / (1+@tasa_iva),@DecimalesEnImportes)
    }
    
    adds_variables::&db,&adds,&variables
    {
        if isnull(variables){return}

        ref now=now()

        ref l=list.create_from_fields(variables)
        
        for i = 0; i < @count(l)
        {
            grupo=list.str(l,i)
            ref prod=@@(variables,"&"+grupo)
            
            if not(isnull(prod))
            {
                ref p=list.create_from_fields(prod)
                
                for j = 0; j < @count(p)
                {
                    pk_prod=list.str(p,j)
                    cantidad=@@(prod,"#"+pk_prod)

                    new params
                    {
                        @"grupo":grupo
                        @"prod":pk_prod
                    }

                    ref prd=dbr.rec(db,"select p.cdirecto,p.cindirecto,p.cmanoobra,p.cmaquinaria,p.precio1,
                    p.sys_pk,p.iclase,p.itipo,p.idivisa,p.unidad,p.impuestos
                    from producto p where p.sys_pk=@prod;",params)

                    amount= 0
                    ref dt_imp=GetDataImpuestos(db,amount,cantidad,0,0,@@(prd,"#impuestos"))

                    new item_adds
                    {
                        @"sys_info":"variable"
                        @"Sys_TimeStamp*":now
                        @"Sys_GUID":uuid()
                        @"Sys_DTCreated*":now
                        @"Sys_DTExported*":now
                        @"Cantidad": cantidad
                        @"CDirecto": 0 //@@(prd,"#cdirecto")
                        @"CIndirecto": 0 // @@(prd,"#cindirecto")
                        @"CManoObra": 0 //@@(prd,"#cmanoobraprom")
                        @"CMaquinaria": 0 //@@(prd,"#cmaquinariaprom")
                        @"Precio":@@(dt_imp,"#total")
                        @"IProducto":pk_prod
                    }

                    do list.add(adds,item_adds)
                }
            }
        }
    }
    get.adds::&db,&options
    {
        ref list_adds=list.create()

        for i=0;i<list.count(options)
        {
            ref op=@item(options,i)
            ref values=@@(op,"&values")
            for j=0;j<list.count(values)
            {
                ref val=@item(values,j)
                if trim(@@(val,"sku"))!=""
                {
                    ref prod=dbr.rec(db,@dataadds,val)
                    ref now=now()

                    cantidad= 1
                    if @@(val,"#quantity") > 0{cantidad=@@(val,"#quantity")}
                    // ref dt_imp=GetDataImpuestos(db,@@(val,"#amount"),1,0,0,@@(prod,"#impuestos"))

                    new adds
                    {
                        @"Sys_TimeStamp*":now
                        @"Sys_GUID":toupper(cut(uuid(),30))
                        @"Sys_DTCreated*":now
                        @"Sys_DTExported*":now
                        @"Cantidad": cantidad
                        @"CDirecto": 0
                        @"CIndirecto": 0
                        @"CManoObra": 0
                        @"CMaquinaria": 0
                        @"Precio":@@(prod,"#"+campoPrecioAdcR5(@PrecioAdcs))//@@(dt_imp,"#total")
                        @"IProducto":@@(prod,"#sys_pk")
                    }
                }
                else
                {
                    new adds
                    {
                        @"notes":@@(op,"name")+":"+@@(val,"text")+";"
                    }
                }
                do list.add(list_adds,adds)
            }
            
        }
        return list_adds
    }
    updateinsert.ventaDventa::&db,&postData
    {
        do update.totales(db,postData)
        
        exception
        {
            // if dbr.in_transaction(db){do dbr.rollback(db)}
            do rise_error(99,last_error())
        }
    }

    
    //actualiza los totales(venta y dventa)
    //inserta datos correspondientes a la tabla orden y de dorden
    insert.ordenDorden::&db,&params,&data
    {
        if not(isset("@__from_sise")) { @__from_sise = @false }

        ref listcvs=list.create_from_fields(ifnull(data,record.create()))
        for i=0;i<list.count(listcvs)
        {
            clv=list.str(listcvs,i)
            ref ordenes=@@(data,"&"+clv)
            ref orden=@@(ordenes,"&orden")

            do dbr.insert(db,"orden",orden)

            sys_pk=dbr.num(db,@getordennew,orden)
            ref dorden=@@(ordenes,"&dorden")
            importe=0
           
            for j=0;j<list.count(dorden)
            {
                ref norden=@item(dorden,j)
                importe=importe + @@(norden,"#precio")
                norden<"FK_Orden_Detalle">:sys_pk
                ref adds=@@(norden,"&adds")

                if field.exist(norden,"adds"){do field.remove(norden,"adds")}
                
                do dbr.insert(db,"dorden",norden)
            
                especifications=""
                if list.count(adds)>0
                {
                    for a=0;a<list.count(adds)
                    {
                        ref add=@item(adds,a)
                        if trim(@@(add,"notes"))!=""
                        {
                            especifications=especifications + @@(add,"notes")
                        }
                        else
                        {
                            sys_pkad=dbr.num(db,@datadorden,norden)
                            add<"FK_DOrden_Adicionales">:sys_pkad
                            do dbr.insert(db,"dadicionales",add)
                        }
                    }
                }
                if especifications!=""
                {
                    new espe{@"Especificaciones":ifstr(@@(norden,"$Especificaciones")!="",@@(norden,"$Especificaciones")+";","")+especifications}
                    do dbr.update(db,"dorden",espe,"sys_guid=@sys_guid",norden)
                }
                
            }
           
            new im{@"importe":importe}
            do dbr.update(db,"orden",im,"sys_guid=@sys_guid",orden)

            if not(@__from_sise) { do printer_command(db,@@(orden,"$sys_guid")) }
        }
        exception
        {
            do rise_error(99,last_error())
        }
    }
    
    update.totales::&db,&postData
    {
        ref now=now()
        new p{@"id_table":@@(postData,"id_table")}
        ref dataVenta=dbr.rec(db,@dataventa,p)
        // do rise_error(0,"1")
        //eliminar todos datos de dventa de acuerdo a la mesa(venta) clase=2
        do dbr.execute(db,@deletedventa,dataVenta)
        
        ialmacen=dbr.num(db,"SELECT cc.ialmacen FROM cconsumo cc WHERE cc.sys_pk=@cc;",postData)
        if ialmacen < 1{ialmacen= 1 }
        new dventa
        {
            @"Sys_TimeStamp*":now
            @"Sys_DTCreated*":now
            @"Sys_DTExported*":now
            @"Factor":1
            @"Impuesto1":0
            @"Impuesto2":0
            @"Impuesto4":0
            @"Status":1
            @"TipoCambio":if(@@(dataVenta,"#tipocambio")> 0,@@(dataVenta,"#tipocambio"),1)
            @"IAlmacen":ialmacen
            @"FK_Venta_Detalle":@@(dataVenta,"#sys_pk")
        }
        
        ref dtventa=dbr.list(db,@getdorden,dataVenta)
        do insert.dventa(db,record.copy(dventa,"*"),dtventa)
        do insert.dventa(db,record.copy(dventa,"*"),@@(postData,"&dventas"))

        ref totales=dbr.rec(db,@totaldventa,dataVenta)
        totales<"sys_pk">:@@(dataVenta,"#sys_pk")
        //se va a actualizar con sql directo primero meterlo en dventa ,despues actualizar los totales
        do dbr.execute(db,@updateventa,totales)

        p<"venta">:@@(dataVenta,"#sys_pk")
        do apply_promo(db,p)
    }
    insert.dventa::&db,&dventa,&dtventa
    {
        for i=0;i<list.count(dtventa)
        {
            ref dv=@item(dtventa,i)

            sys_guid=toupper(uuid())
            if @@(dv,"#dorden") > 0
            {
                sys_guid=@@(dv,"$sys_guid")
                dv<"precio">:@@(dv,"#precio") + dbr.num(db,"SELECT ifnull(sum(IFNULL(d.cantidad,0) * IFNULL(d.precio,0)),0) FROM dadicionales d WHERE d.fk_dorden_adicionales=@dorden;",dv)
            }

            using dventa
            {
                @"Sys_GUID":sys_guid
                @"cantidad":@@(dv,"#cantidad")
                @"precio":@@(dv,"#precio")
                @"iproducto":@@(dv,"iproducto")
                @"XFacturar":@@(dv,"#cantidad")
                @"XSalir":@@(dv,"#cantidad")
                @"unidad":dbr.str(db,"SELECT unidad FROM producto p WHERE p.sys_pk=@iproducto;",dv)
                @"Descuento1":@@(dv,"#d1")
                @"Descuento2":@@(dv,"#d2")
            }
            _impuesto=dbr.num(db,"select impuestos from producto where sys_pk=@iproducto",dventa)
            // dventa<@campo_iva>:get.subtotalImpuesto(@@(dv,"#precio"),@true) * @@(dv,"#cantidad")
            ref dt_imp= GetDataImpuestos(db,@@(dv,"#precio"),@@(dv,"#cantidad"),@@(dv,"#d1"),@@(dv,"#d2"),_impuesto)
            
            dventa<"impuesto1">:@@(dt_imp,"#impuesto1")
            dventa<"impuesto2">:@@(dt_imp,"#impuesto2")
            dventa<"impuesto3">:@@(dt_imp,"#impuesto3")
            dventa<"impuesto4">:@@(dt_imp,"#impuesto4")

            do dbr.insert(db,"dventa",dventa)
        }
    }
    
    update.order::&db,&postData
    {
        quantity=@@(postData,"#quantity")
        new p{@"id_table":@@(postData,"id_table")}
        ref dataVenta=dbr.rec(db,@dataventa,p)

        new data
        {
            @"id_table":@@(dataVenta,"#sys_pk")
            @"producto":@@(postData,"#producto")
            @"pkdorden":@@(postData,"#pkdorden")
            @"dventa":@@(postData,"#dventa")
        }
        quantity=1
        ref dorden=dbr.rec(db,@getdorden_prod,data)
        if isnull(dorden){ref dorden=dbr.rec(db,"SELECT d.cantidad,d.precio FROM dventa d WHERE d.iproducto=@producto AND d.fk_venta_detalle=@id_table AND IF(IFNULL(@dventa,0)> 0,d.sys_pk=@dventa,true);",data)}
        
        using data{@"pkorden":@@(dorden,"pkorden")}
        quantitycurrent=@@(dorden,"#cantidad")
        using data{@"cantidad":quantitycurrent - quantity}
        
        update=@false
        do dbr.begin(db)
            if quantitycurrent > quantity
            {
                //update
                do dbr.execute(db,@updatedorden,data)
                ref dv=dbr.rec(db,@getquantitydv,data)
                cantidadv=@@(dv,"#cantidad")
                
                if cantidadv > 1
                {
                    using data{@"cantidad":cantidadv - 1}

                    ref dt_imp=GetDataImpuestos(db,@@(dv,"#precio"),@@(data,"#cantidad"),@@(dv,"#descuento1"),@@(dv,"#descuento2"),@@(dv,"#impuestos"))
                    using data
                    {
                        @"i1": @@(dt_imp,"#impuesto1")
                        @"i2": @@(dt_imp,"#impuesto2")
                        @"i3": @@(dt_imp,"#impuesto3")
                        @"i4": @@(dt_imp,"#impuesto4")
                    }

                    do dbr.execute(db,ftext(@updatedvt),data)
                }
                else
                {
                    do dbr.execute(db,@deletedvt,data)
                }

                update=@true
            }
            else
            {
                do dbr.execute(db,@deleteadds,data)
                do dbr.execute(db,@deletedorden,data)
                if dbr.num(db,@countdorden,data)==0{do dbr.execute(db,@delete_orden,data)} 

                do dbr.execute(db,@deletedvt,data)
                do updateinsert.ventaDventa(db,p)      
            }
            if update
            {
                 ref totales=dbr.rec(db,@totaldventa,dataVenta)
                totales<"sys_pk">:@@(dataVenta,"#sys_pk")
                //actualizar los totales
                do dbr.execute(db,@updateventa,totales)
            }
        
        postData<"id_table">:@@(dataVenta,"#sys_pk")
        p<"venta">:@@(dataVenta,"#sys_pk")
        do apply_promo(db,p)

        ref data_order=get.mesa(db,postData)
        data_order<"promociones*">:@data_promocion
        do dbr.commit(db)

        
        return data_order

        exception
        {
            if dbr.in_transaction(db){do dbr.rollback(db)}
            do rise_error(99,last_error())
        }
    }

    cancel.table::&db,&params,&data
    {
        ordenes_listos=dbr.num(db," SELECT COUNT(*) FROM orden o WHERE o.iventa=@id_table AND o.`status` IN(1,2,3);",params)

        if ordenes_listos > 0{do rise_error(500,"No es posible cancelar la cuenta ya que contiene ordenes en preparación")}

        do dbr.begin(db)
        //cancelar ordenes
        do dbr.execute(db,"UPDATE orden set `status`=4 where iventa=@id_table",params)
        //cancelar venta
        do dbr.execute(db,"UPDATE venta set statusadministrativo=99 where sys_pk=@id_table",params)
        do dbr.commit(db)

        return @null

        exception
        {
            if dbr.in_transaction(db){do dbr.rollback(db)}
            do rise_error(last_error_code(),last_error())
        }
    }
    cortesia.table::&db,&params,&data
    {
        percentaje=@@(data,"#percentaje_cortesia")

        ref mesa=get.mesa(db,params)
        subtotal=@@(mesa,"#subtotal")
        
        new v
        {
            @"notas":"Descuento "+str(percentaje)+"% por cortesía"
            @"descuento1":(div(percentaje,100) * subtotal)
        }

        process_venta=(percentaje == 100)
        if process_venta
        {
            using v
            {
                @"impuesto1": 0
                @"impuesto2": 0
                @"impuesto3": 0
                @"impuesto4": 0
            }
        }
        do dbr.begin(db)
        do dbr.update(db,"venta",v,"sys_pk=@id_table",params)

        if process_venta
        {
            ref v=close.table(db,params,data)
            do dbr.execute(db,"UPDATE venta set statusadministrativo=3 where sys_pk=@id_table",params)
            v<"status">: 3
        }

        do dbr.commit(db)

        exception
        {
            if dbr.in_transaction(db){do dbr.rollback(db)}
            do rise_error(last_error_code(),last_error())
        }
        return v
    }

    table.setdealer::&db,&params,&data
    {
        params<"repartidor">:@@(data,"#repartidor")
        if dbr.num(db,"SELECT sys_pk FROM repartidor WHERE sys_pk=@repartidor;",params)<1{do rise_error(500,"No se encontró el repartidor indicado")}

        do dbr.execute(db,"UPDATE venta set irepartidor=@repartidor WHERE sys_pk=@id_table",params)
        ref mesa= table.enviar(db,params,data)

        return mesa
    }
    table.entregada::&db,&params,&data
    {
        // ref mesa=close.table(db,params,data)
        do dbr.execute(db,"UPDATE venta SET statusentrega=3 where sys_pk=@id_table",params)
        return @null
    }
    table.enviada::&db,&params,&data
    {
        // ref mesa=close.table(db,params,data)
        do dbr.execute(db,"UPDATE venta SET statusentrega=1 where sys_pk=@id_table",params)
        return @null
    }
