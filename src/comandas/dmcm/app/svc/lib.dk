#include "dkli.dkh"
#!
module "lib.dk"
{
    ref lib_numeros = _import_library("induxsoft_dkl_NumeroAletrasCorregido.dll")

    do _map_function(lib_numeros,"induxsoft_dkl_NumeroAletrasCorregido.NumerosEnLetras","ParteEntera","Int2Ltr","System.Decimal","$")
    do _map_function(lib_numeros,"induxsoft_dkl_NumeroAletrasCorregido.NumerosEnLetras","ParteDecimal","Dec2Ltr","System.Decimal","$")

    ref lib_precfdi = _import_library("precfdi4lib.dll")

    do _map_function(lib_precfdi, "precfdi4lib.proc", "setDatabase", "ticket.set_db", "*System.Object", "void")
    do _map_function(lib_precfdi, "precfdi4lib.proc", "GenCodeTicket", "ticket.encode_folio", "*System.Object,*System.Object,*System.Object", "$") 
    do _map_function(lib_precfdi, "precfdi4lib.proc", "DecodeTicket", "ticket.decode_folio", "System.String, System.Boolean", "#") 
    do _map_function(lib_precfdi, "precfdi4lib.proc", "VentaXml", "ticket.xml", "System.Int32", "$")

    //#region PRCESOS
    //ingreso y egreso
    pos.ingreso::&db,&params,&postData
    {
        ref data=_CopyFieldsMov(postData)
        data<"documento">:@DOCUMENTO_INGRESO
        ref movcaja=_insertMovcaja(db,data)

        movcaja<"printer*">:PrintIngresoEgreso(db,movcaja,"INGRESO",@@(postData,"&_config_prn"),@true)
        
        return movcaja
    }
    pos.egreso::&db,&params,&postData
    {
        ref data=_CopyFieldsMov(postData)
        data<"documento">:@DOCUMENTO_EGRESO
        data<"efectivo">:@@(data,"#efectivo") * -1

        ref movcaja=_insertMovcaja(db,data)
        movcaja<"printer*">:PrintIngresoEgreso(db,movcaja,"EGRESO",@@(postData,"&_config_prn"),@false)
        return movcaja
    }
    PrintIngresoEgreso::&db,&movcaja,title,&config,is_ingreso
    {
        ref config=PrnParseConfig(db,config)
        if isnull(config){return @null}
        
        ref datacorte=GetCajaCorte(db)
        ref cajero=dbr.rec(db,"select cj.sys_pk,cj.codigo,cj.nombre from cajero cj
                    inner join corte ct on cj.sys_pk=ct.icajero
                    where ct.sys_pk=@corte",datacorte)

        ref caja=dbr.rec(db,"SELECT sys_pk,codigo,descripcion FROM caja WHERE sys_pk=@caja;",datacorte)
        ref categoria=dbr.rec(db,"SELECT sys_pk,codigo,descripcion FROM categoria c WHERE c.sys_pk=@icategoria;",movcaja)
        ref divisa=dbr.rec(db,"SELECT sys_pk,codigo,descripcion FROM divisa c WHERE c.sys_pk=@idivisa;",movcaja)

        new headers
        {
            @"cajero":"CAJERO: "+@@(cajero,"$nombre")
            @"caja":"CAJA: "+@@(caja,"$descripcion")
        }

        new body
        {
            @"referencia":"REFERENCIA: "+@@(movcaja,"$referencia")
            @"categoria":"CATEGORIA: "+@@(categoria,"$descripcion")
            @"divisa":"DIVISA: "+@@(divisa,"$descripcion")
        }

        new saldos
        {
            @"efectivo":"Efectivo: "
            @"str_efectivo":number_format(@@(movcaja,"#efectivo"))
            @"total":number_format(@@(movcaja,"#efectivo"))
        }

        new extras
        {
            @"notas":"NOTAS: "+@@(movcaja,"$notas")
        }

        new data
        {
            @"database*":db
            @"title":title
            @"headers*":headers
            @"body*":body
            @"saldos*":saldos
            @"extras*":extras
            
        }
        
        if @@(config,"#req_data"){return data}
        
        data<"movcaja*">:movcaja
        data<"http*">:@http_context
        data<"config*">:config
        
        do ExecutePrinter(db,GetFilePrn(ifstr(is_ingreso,"prn_ingreso.dkl","prn_egreso.dkl")),data)

        return @null
        
        exception{}
    }
    _insertMovcaja::&db,&data
    {
        corte=@@(data,"#corte")
        do field.remove(data,"corte")
        if corte < 1
        {
            ref datacorte=GetCajaCorte(db)
            corte=@@(datacorte,"#corte")
            if corte < 1{do rise_error(500,"No se econtró un corte de caja abierto")}
        }
        
        using data
        {
            @"sys_guid":uuid()
            @"sys_dtcreated*":dbr.sql("now()")
            @"sys_timestamp*":dbr.sql("now()")
            @"sys_exported":0
            @"sys_dtexported*":dbr.sql("now()")
            @"sys_recver":0
            @"icorte": corte  
        }
        if not(field.exist(data,"auditado")){data<"auditado">: 1}
        if not(field.exist(data,"cheques")){data<"cheques">: 0}
        if not(field.exist(data,"contabilizado")){data<"contabilizado">: 0}
        if not(field.exist(data,"depositos")){data<"depositos">: 0}
        if not(field.exist(data,"efectivo")){data<"efectivo">: 0}
        if not(field.exist(data,"referencia")){data<"referencia">: uuid()}
        if not(field.exist(data,"tarjetas")){data<"tarjetas">: 0}
        if not(field.exist(data,"tipocambio")){data<"tipocambio">: 1}
        if not(field.exist(data,"vales")){data<"vales">: 0}
        if not(field.exist(data,"fecha")){data<"fecha*">: dbr.sql("now()")}
        if not(field.exist(data,"hora")){data<"hora*">: dbr.sql("now()")}
        if not(field.exist(data,"idivisa")){data<"idivisa">: GetDivisaPredet(db)}


        do dbr.insert(db,"movcaja",data)

        return data
    }
    
    
    mesa.cobrar::&db,&params,&postData
    {
        sql="select
            qv.dmnsmesa as 'code',
            qv.sys_pk as 'sys_pk',
            qv.sys_guid as 'sys_guid',
            qv.referencia as 'reference',
            qv.statusadministrativo as 'status',
            qv.dmnspersonas as 'occupied_seats',
            qv.notas,
            qv.dmnsnota as 'notetable',
            qv.total as 'balance',
            '' as 'owner',
            0 as is_birthday,
            0 as is_celebration,
            qv.icliente as 'cliente',
            qv.icconsumo as 'cc',
            qv.iagente as 'ag',
            qv.idivisa AS 'divisa', 
            qv.tipocambio AS 'tcambio',
            qv.sys_info as service
        from
            qventasserviciomesa qv
        where
            qv.sys_pk = @venta "

        ref totales=@@(postData,"&totales")
        ref rsource=dbr.rec(db,sql,postData)
        if @@(rsource,"#balance") < 0.1{do rise_error(500,"No existe un monto a cobrar")}

        do token.data.validate(db,@true)

        ref datatoken=dbr.rec(db,"select * from ut_dn_dmm_token where token=@dm_token",postData)
        if isnull(datatoken){do rise_error(500,"Datos del token no econtrado")}
        if trim(@@(datatoken,"$datos"))==""{do rise_error(500,"No hay registrado del inicio de sesión, vuelva iniciar sesión")}

        ref datos=from.json(@@(datatoken,"$datos"))
        corte=@@(datos,"#corte")
        if  corte > 0 && field.exist(datos,"corte")
        {
            //verificar corte si esta abierto
            iscerradocorte=dbr.num(db,"select ifnull(cerrado,0) from corte where sys_pk=@corte",datos)
            if iscerradocorte{do rise_error(99,"El corte obtenido ya esta cerrado, vuelva iniciar sesión")}
        }
        else
        {
            ref cajas_agente=dbr.rec(db,"select caja,caja2 from agente where codigo=@key",datos)
            if @@(cajas_agente,"#caja")< 1 && @@(cajas_agente,"#caja2")< 1{do rise_error(500,"El agente no tiene una caja relacionada")}
            corte=dbr.num(db,"SELECT sys_pk FROM corte c WHERE c.icaja=@caja AND IFNULL(c.cerrado,0)=0;",cajas_agente)
            if corte < 1{corte=dbr.num(db,"SELECT sys_pk FROM corte c WHERE c.icaja=@caja2 AND IFNULL(c.cerrado,0)=0;",cajas_agente)}

            if corte < 1{do rise_error(500,"No se encontró un corte abierto en relación al agente")}
        }
        
        new movcaja
        {
            @"sys_recver": 0
            @"sys_guid":uuid()
            @"sys_timestamp*":dbr.sql("now()")
            @"sys_dtcreated*":dbr.sql("now()")
            @"sys_exported": 0
            @"sys_dtexported*":dbr.sql("now()")
            @"auditado": 1
            @"cheques": 0
            @"contabilizado": 0
            @"depositos": 0
            @"documento": @documento_venta //ticket
            @"efectivo":@@(postData,"#efectivo")
            @"fecha*":dbr.sql("now()")
            @"hora*":dbr.sql("now()")
            @"notas":" Cobro de venta con referencia "+@@(rsource,"$reference")
            @"referencia":toupper(uuid())
            @"tarjetas":@@(postData,"#importe_tarjeta")
            @"tipocambio": @@(rsource,"#tcambio")
            @"vales": 0
            @"icategoria":5
            @"icorte": corte 
            @"idivisa":@@(rsource,"#divisa")
        }
        
        do dbr.begin(db)
        
        ref divisa=dbr.rec(db,"select sys_pk,codigo,descripcion from divisa where sys_pk=@idivisa",movcaja)

        ref data_array=@@(postData,"&data_array")
        if field.exist(postData,"data_array") && @count(data_array) > 0{ref datarjeta=GetDataTarjeta(db,data_array)}
        else{ref datarjeta=GetDataTarjetaByVenta(db,@@(postData,"#venta"),@@(movcaja,"#idivisa"))}
        
        if @@(datarjeta,"#importetotal") >= @@(rsource,"#balance"){movcaja<"efectivo">: 0 }

        movcaja<"tarjetas">:@@(datarjeta,"#importetotal")
        pagos=@@(postData,"#efectivo") + @@(movcaja,"#tarjetas")

        if pagos <  @@(rsource,"#balance") {do rise_error(500,"El importe acumulado no cubre con la totalidad de la venta")}

        do dbr.insert(db,"movcaja",movcaja)
        idmovcaja=dbr.num(db,"select sys_pk from movcaja where sys_guid=@sys_guid",movcaja)

        //insertar tarjetas
        for i = 0; i < @count(@@(datarjeta,"&dtarjetas"))
        {
            ref dtarjeta=@item(@@(datarjeta,"&dtarjetas"),i)
            dtarjeta<"fk_movcaja_detalletarjetas">:idmovcaja
            do dbr.insert(db,"dtarjeta",dtarjeta)
        }
        //cargar datos del ticket antes de actualizar el estado de la venta
        params<"id_table">:@@(postData,"#venta")
        ref response=data.ticket(db,params)
        // new response
        // {
        //     @"totales*":totales
        // }
        // do DataTicket(db,@@(postData,"#venta"),response)

        statusentrega=dbr.num(db,"SELECT statusentrega from venta where sys_pk=@venta",postData)
        sta_entrega= 3
        // if statusentrega == 0{sta_entrega= 1}
        //actualizar venta
        new venta
        {
            @"importeadicional":@@(postData,"#propina")
            @"statusadministrativo": 3
            @"statusentrega":sta_entrega
            @"statusfacturacion":1
            @"icaja":dbr.num(db,"select icaja from corte where sys_pk=@icorte",movcaja)
            @"icorte":corte
            @"imovcaja":idmovcaja
        }
        if toupper(@@(rsource,"$service")) == "DS"{do field.remove(venta,"statusentrega")}
        do dbr.update(db,"venta",venta,"sys_pk=@venta",postData)

        //ACTULIZAR ORDEN
        new orden{@"status":3}
        do dbr.update(db,"orden",orden,"iventa=@venta",postData)
        
        //obetner datos del ticket
        //folio de la venta
        folio_factura=ticket.encode_folio(@@(response,"&fecha"),@@(response,"&sys_dtcreated"),@@(postData,"#venta"))
        
        using response
        {
            // @"cajero*":dbr.rec(db,"select codigo,nombre from cajero where codigo=@idcajero",datos)
            @"propina":@@(venta,"#importeadicional")
            @"efectivo":@@(movcaja,"#efectivo")
            @"tarjeta":@@(movcaja,"#tarjetas")
            @"cambio":@@(totales,"#cambio")
            // @"text_footer":"Gracias por su compra, esperamos regrese pronto!!!"
            @"folio_factura":folio_factura
            // @"divisa*":divisa
            @"url_redir":"/comandas/?view=vw_principal&dmtm_token="+@@(datatoken,"$token")
        }
        
        do dbr.commit(db)

        postData<"data_ticket*">:response

        do printer_ordertable(db,@@(postData,"#venta"),postData)

        return response

        exception
        {
            if dbr.in_transaction(db){do dbr.rollback(db)}
            do rise_error(500,last_error())
        }
        
    }
    pos.cortecaja::&db,&params,&postData
    {
        using postData{@"token":@dmtoken}
       
        ref datacorte=GetCajaCorte(db)
        caja=@@(datacorte,"#caja")
        corte=@@(datacorte,"#corte")
        if corte < 1{do rise_error(500,"No se econtró un corte de caja abierto")}

        @DECIMAL_PRECISION=parse.num(dbr.vars.get(db,"FXCA001"))
        using params
        {
            @"caja":caja
            @"corte":corte
        }
        //obtener variables globales al corte
        pos_cat_diferencia_al_corte=trim(dbr.vars.get(db,"pos_cat_diferencia_al_corte"))
        pos_cat_retiro_al_corte=trim(dbr.vars.get(db,"pos_cat_retiro_al_corte"))
        pos_cat_retiro_otras_fpago=trim(dbr.vars.get(db,"pos_cat_retiro_otras_fpago"))

        do dbr.begin(db)
        //validaciones
        efectivo_caja=@@(postData,"#efectivo_caja")
        retiro_corte=@@(postData,"#retiro_corte")
        importe_sig_turno=@@(postData,"#importe_sig_turno")

        if efectivo_caja < 0.1{do rise_error(500,"No ha indicado el efectivo en caja")}
        if importe_sig_turno < 0{do rise_error(500,"No ha indicado el fondo del siguiente turno")}

        //======================================================================================================
        //ingreso o egreso segun la diferencia entre efectivo en caja contra lo que se tiene en la base de datos
        saldo_inicial=GetSaldoInicial(db,corte,caja,0)//0 divisa predeterminada
        if saldo_inicial < 0{saldo_inicial= 0}

        saldocorte=SaldoEfectivo(db,corte) + saldo_inicial
        diferencia=saldocorte - efectivo_caja
        
        if diferencia != 0
        {
            if pos_cat_diferencia_al_corte==""{do rise_error(500,"No ha configurado una categoría para realizar ingreso/egreso de diferencia 'pos_cat_diferencia_al_corte' ")}
            //egreso
            if diferencia > 0
            {
                ref movcaja_egreso=PrepareMovCaja(db,GetCategoriaByCodigo(db,pos_cat_diferencia_al_corte),diferencia,"EGRESO POR DIFERENCIA AL CORTE")
                corte >> movcaja_egreso
                ref _egreso=pos.egreso(db,params,movcaja_egreso)
            }
            //ingreso
            else
            {
                ref movcaja_ingreso=PrepareMovCaja(db,GetCategoriaByCodigo(db,pos_cat_diferencia_al_corte),(diferencia * -1),"INGRESO POR DIFERENCIA AL CORTE")
                corte >> movcaja_ingreso
                ref _ingreso=pos.ingreso(db,params,movcaja_ingreso)
            }
        }
        //realizar retiro al corte de caja
        if retiro_corte > 0
        {
            if pos_cat_retiro_al_corte==""{do rise_error(500,"No ha configurado una categoría para realizar el retiro al corte 'pos_cat_retiro_al_corte' ")}

            ref movcaja=PrepareMovCaja(db,GetCategoriaByCodigo(db,pos_cat_retiro_al_corte),retiro_corte,"RETIRO AL CORTE")
            corte >> movcaja
            ref egreso=pos.egreso(db,params,movcaja)
        }
        
        
        //=============================================================================================================================================
        //Retiro por el importe de todas las demás formas de pago (depósitos, cheques, vales y tarjetas) 
        ref saldos=GetSaldoCorte(db,corte)
        cheques=@@(saldos,"#cheques")
        vales=@@(saldos,"#vales")
        despositos=@@(saldos,"#despositos")
        tarjetas =@@(saldos,"#tarjetas")

        tsaldos=cheques + vales + despositos + tarjetas
        if tsaldos > 0
        {
            if pos_cat_retiro_otras_fpago==""{do rise_error(500,"No ha configurado una categoría para realizar el retiro de otras formas de pagos 'pos_cat_retiro_otras_fpago' ")}
            ref movcaja_egreso_fpagos=_CopyFieldsMov(PrepareMovCaja(db,GetCategoriaByCodigo(db,pos_cat_retiro_otras_fpago),0,"EGRESO DE CAJA"))
            
            if cheques > 0{movcaja_egreso_fpagos<"cheques">:cheques * -1}
            if vales > 0{movcaja_egreso_fpagos<"vales">:vales * -1}
            if tarjetas > 0{movcaja_egreso_fpagos<"tarjetas">:tarjetas * -1}
            if despositos > 0{movcaja_egreso_fpagos<"despositos">:despositos * -1}

            corte >> movcaja_egreso_fpagos
            movcaja_egreso_fpagos<"documento">:@DOCUMENTO_EGRESO
            ref retiro_fpagos=_insertMovcaja(db,movcaja_egreso_fpagos)
        }
        
        //==========================================================================================================================
        //liberar venta y caja-corte
        sql="update venta set statusadministrativo=99 where statusfinanciero=0 and formapago=0 and subtotal=0 and statusadministrativo=1 and icorte is null and icaja=@caja"
        do dbr.execute(db,sql,params)

        sql="update corte set cerrado=1, fcierre=now(), hcierre=now() where sys_pk=@corte"
        do dbr.execute(db,sql,params)
        
        do token.logout(db,postData)
        module "imprimir arqueo"
        {
            ref arqueo=DataArqueo(db,corte)
            arqueo<"_config_prn*">:@@(postData,"&_config_prn")
            do PrintArqueo(db,arqueo)
            // exception{}
        }
        do dbr.commit(db)
        
        do field.remove(arqueo,"http")

        arqueo<"url_redir">:"/comandas/?view=login"
        
        return arqueo

        exception
        {
            if dbr.in_transaction(db){do dbr.rollback(db)}
            do rise_error(500,last_error())
        }
    }
    pos.arqueo::&db,&params,&postData
    {
        ref datacorte=GetCajaCorte(db)
        corte=@@(datacorte,"#corte")
        if corte < 1{do rise_error(500,"No se econtró un corte de caja abierto")}
        
        ref arqueo=DataArqueo(db,corte)
        arqueo<"_config_prn*">:@@(postData,"&_config_prn")
        
        do PrintArqueo(db,arqueo)
        do field.remove(arqueo,"http")
        return arqueo
    }
    //#endregion
    
    
    //#region OBTENER DATOS
    getRepartidores::&db,&params
    {
        return dbr.list(db," SELECT sys_pk,codigo,nombre FROM repartidor ;",params)
    }

    GetCajaCorte::&db
    {
        new p{@"token":@dmtoken}
        ref data=get.token(db,@null,p)
        
        ref dtjson=from.json(@@(data,"$datos"))
        if trim(@@(dtjson,"$idcaja"))=="" //si idcaja es vació se trata de un mesero
        {
            corte=GetCorteMesero(db,dtjson,p)
            if corte < 1{do rise_error(500,"El mesero no tiene un corte abierta, en las cajas relacionado")}
            p<"corte">:corte
            caja=dbr.num(db,"select icaja from corte where sys_pk=@corte",p)
        }
        else
        {
            caja=dbr.num(db,"select sys_pk from caja where codigo=@idcaja",dtjson)
            corte=@@(dtjson,"#corte")
            if corte < 1{do rise_error(500,"No hay un corte abierto para el cajero")}
        }

        using p
        {
            @"caja":caja
            @"corte":corte
        }

        if dbr.num(db,"SELECT sys_pk FROM corte c WHERE c.sys_pk=@corte AND IFNULL(c.cerrado,0)=1;",p){do rise_error(500,"El corte de caja encontrado ya fue cerrado")}

        return p
    }
    DataTicket::&db,venta,&ticket
    {
        new p
        {
            @"id_table":venta
            @"iventa":venta
        }
        ref totales=ifnull(@@(ticket,"&totales"),record.create())
        query_orden="select v.StatusAdministrativo as estadoA,cc.sys_pk pkcc,cc.codigo cod_cc,cc.descripcion desc_cc,a.sys_pk pkwaiter,a.codigo cod_waiter,a.nombre,v.sys_pk pktable,
        v.dmnsmesa,v.descuento1 'descuento1',v.descuento2 'descuento2',v.dmnsnota 'dmnsnota',v.impuesto1 'impuesto1',v.impuesto2 'impuesto2',
				v.impuesto3 'impuesto3',v.impuesto4 'impuesto4',v.notas 'notas',v.importeadicional 'importeadicional',v.referencia 'referencia',v.subtotal 'subtotal',
				c.sys_pk pkcliente,c.codigo cod_cliente,c.nombre name_cliente,
				v.total 'total'
				from qventasserviciomesa v
				inner join cconsumo cc on v.icconsumo=cc.sys_pk
				inner join agente a on v.iagente=a.sys_pk
				inner join cliente c on v.icliente=c.sys_pk
				where v.sys_pk=@id_table limit 1;"

	    query="select producto.codigo AS sku,producto.sys_pk,producto.ilinea as linea,dorden.sys_pk as pkdorden,dorden.fk_orden_detalle AS pkorden, dorden.sys_timestamp, 
                        dorden.cantidad,producto.descripcion,dorden.especificaciones,dorden.precio,dorden.d1,dorden.d2,dorden.tiemposervicio as tiempo, 
                        cfgimpuesto.i1venta,cfgimpuesto.i2venta,cfgimpuesto.i3venta,cfgimpuesto.i4venta,producto.unidad  from (dorden inner join (orden inner join 
                        venta on orden.iventa=venta.sys_pk) on dorden.fk_orden_detalle=orden.sys_pk) 
                        inner join (producto inner join cfgimpuesto on producto.impuestos=cfgimpuesto.sys_pk) on dorden.iproducto=producto.sys_pk where orden.iventa=@id_table"

        query_empresa="SELECT sys_pk,sys_guid,varvalue FROM globalvar g WHERE g.VarName='FXCA112';"

        ref data_orden=ifnull(dbr.rec(db,query_orden,p),record.create())
        ref data_empresa=ifnull(dbr.rec(db,query_empresa,@null),record.create())
        //lista de ordenes
        // "orders": 
        // [
        //     {
        //         "pkdorden": 55,
        //         "pkorden": 42,
        //         "linea": 6,
        //         "sku": "00020001",
        //         "sys_pk": 37,
        //         "created": "10/03/2025 16:46:36",
        //         "description": "Prueba",
        //         "quantity": 1.00000000,
        //         "price": 191.40,
        //         "discount": 0,
        //         "total": 191.40,
        //         "notes": "",
        //         "time": "0",
        //         "adds": []
        //     }
        // ]
        ref list_dorden=get.ordenes(db,p)

        if @@(totales,"#total") > 0{data_orden<"total">:@@(totales,"#total")}
        else {totales<"importe">:@@(data_orden,"#total")}

        using ticket
        {
            @"fecha":date_str(now(),"yyyy-MM-dd  hh:mm:ss")
            @"data_orden*":data_orden
            @"data_empresa*":data_empresa
            @"list_dorden*":list_dorden
            @"total_letras":Int2Ltr(@@(data_orden,"#total"))+" "+Dec2Ltr(@@(data_orden,"#total"))
        }
        return ticket
    }
    GetDataTarjetaByVenta::&db,venta,divisa
    {
        if not(TableExist(db,"globalpay")){return record.create()}

        new p{@"idt":venta}
        ref dtglobaypay=dbr.list(db,@sql_transaciones_realizadas,p)
        
        total= 0
        ref ldtarjeta=list.create()
        for i = 0; i < @count(dtglobaypay)
        {
            ref row=@item(dtglobaypay,i)
            ref response=from.json(@@(row,"$response"))
            if @@(response,"$AuthResultCode") == "00"
            {
                total= total + @@(row,"#amount")
                new pms
                {
                    @"tipo":@@(response,"$CardTypeDescription")
                    @"divisa":@@(response,"$CurrencyDescription")
                }
                new dtarjeta
                {
                    @"sys_guid":uuid()
                    @"sys_dtcreated*":dbr.sql("now()")
                    @"sys_timestamp*":dbr.sql("now()")
                    @"sys_exported":0
                    @"sys_dtexported*":dbr.sql("now()")
                    @"sys_recver":0
                    @"importe":@@(row,"#amount")
                    @"autorizacion":@@(response,"$AuthCode")
                    @"cvv":@@(response,"$AuthCode")
                    @"nombre":@@(response,"$CardAppName")
                    @"numero":@@(response,"$CardNumber")
                }
                switch toupper(@@(response,"$CurrencyDescription"))
                {
                    case "MEX"
                    {
                        idivisa=dbr.num(db,"select sys_pk from divisa where codigo=@divisa_mxn",@cobro_tarjeta)
                        break
                    }
                    case "USD"
                    {
                        idivisa=dbr.num(db,"select sys_pk from divisa where codigo=@divisa_usd",@cobro_tarjeta)
                        break
                    }
                    default
                    {
                        idivisa=dbr.num(db,"select sys_pk from divisa where codigo=@divisa",pms)
                        break
                    }
                }
                if idivisa < 1{idivisa=divisa}

                pms<"divisa">:idivisa

                tipo=dbr.num(db,"select sys_pk from tarjetacredito where codigo=@tipo",pms)
                if tipo < 1
                {
                    pos_type_card=trim(dbr.vars.get(db,"pos_type_card"))
                    if pos_type_card==""{do rise_error(500,"No ha configurado un tipo de tarjeta `pos_type_card`")}

                    pms<"tipo">:pos_type_card
                    tipo=dbr.num(db,"select sys_pk from tarjetacredito where codigo=@tipo",pms)

                    if tipo < 1{do rise_error(500,"No se encontró datos del tipo de tarjeta configurado en `pos_type_card`")}
                }

                dtarjeta<"tipocambio">:dbr.num(db,"select ifnull(tcambio,0) from divisa where sys_pk=@divisa",pms)

                dtarjeta<"tipo">:tipo
                dtarjeta<"idivisa">:idivisa

                do list.add(ldtarjeta,dtarjeta)
            }
        }
        new dtarjeta
        {
            @"importetotal":total
            @"dtarjetas*":ldtarjeta
        }

        return dtarjeta
    }
    GetDataTarjeta::&db,&array
    {
        total= 0
        ref ldtarjeta=list.create()
        for i = 0; i < @count(array)
        {
            ref itm=@item(array,i)

            total=total + @@(itm,"#importe")

            new dtarjeta
            {
                @"sys_guid":uuid()
                @"sys_dtcreated*":dbr.sql("now()")
                @"sys_timestamp*":dbr.sql("now()")
                @"sys_exported":0
                @"sys_dtexported*":dbr.sql("now()")
                @"sys_recver":0
                @"importe":@@(itm,"#importe")
                @"autorizacion":@@(itm,"$noautorizacion")
                @"cvv":@@(itm,"$cvv")
                @"nombre":@@(itm,"$nombre")
                @"numero":@@(itm,"$numero")
                @"domicilio":@@(itm,"$domicilio")
                @"tipocambio":@@(itm,"#tcambio")
                @"tipo":@@(itm,"#tipo")
                @"idivisa":@@(itm,"#divisa")
            }

            do list.add(ldtarjeta,dtarjeta)
        }

        new dtarjeta
        {
            @"importetotal":total
            @"dtarjetas*":ldtarjeta
        }

        return dtarjeta
    }
    get.clientes::&db,&params
    {
        // return dbr.list(db,"SELECT c.codigo,c.nombre,c.telefonos telefono,CONCAT_WS(' ',d1.codpos,d1.colonia,d1.direccion)direccion 
		// 		FROM cliente c 
		// 		LEFT JOIN domicilio d1 ON c.domicilio1=d1.sys_pk
		// 		WHERE CONCAT_WS(' ',c.codigo,c.nombre) LIKE CONCAT('%',@s,'%');",params)

        return dbr.list(db,"SELECT
            0 sys_pk,
            c.codigo,
            c.nombre,
            c.telefonos telefono,
            CONCAT_WS(' ', d1.codpos, d1.colonia, d1.direccion) direccion,
            '' notas
        FROM
            cliente c
            LEFT JOIN domicilio d1 ON c.domicilio1 = d1.sys_pk
        WHERE
            CONCAT_WS(' ', c.codigo, c.nombre,d1.codpos, d1.colonia, d1.direccion) LIKE CONCAT('%', @s, '%')
        UNION
        SELECT
            d.sys_pk,
            d.sys_pk codigo,
            d.nombre,
            d.telefono,
            d.direccion,
            d.notas
        FROM
            dmns_destino d
        WHERE
            CONCAT_WS(' ', d.telefono, d.nombre, d.direccion, d.notas,d.sys_pk) LIKE CONCAT('%', @s, '%');",params)
            
    }
    GetCategoriaByCodigo::&db,codcat
    {
        new p{@"codigo":codcat}
        categoria=dbr.num(db,"select sys_pk from categoria where codigo=@codigo",p)

        if categoria < 1{do rise_error(500,"No se contró la categoría con el código indicado: "+codcat)}
        
        return categoria
    }
    GetDivisaPredet::&db
    {
        divisa =parse.num(dbr.vars.get(db,"FXCA013"))
        if divisa < 1{do rise_error(500,"No hay divisa predeterminada 'FXCA013' ")}

        return divisa
    }

    SaldoCaja::&db,caja,divisa,forma
    {
        if divisa < 1{divisa=GetDivisaPredet(db)}

        new p
        {
            @"caja":caja
            @"divisa":divisa
        }
        sql="SELECT * FROM qrySaldosCaja WHERE icaja=@caja AND idivisa=@divisa"
        ref rescaja=dbr.rec(sb,sql,p)
        if isnull(rescaja){do rise_error(500,"No se encontró datos de la caja con la divisa indicado")}

        efectivo=@@(rescaja,"#efectivo")
        cheques=@@(rescaja,"#cheques")
        tarjetas=@@(rescaja,"#tarjetas")
        depositos=@@(rescaja,"#depositos")
        vales= @@(rescaja,"#vales")

        saldocaja = 0
        switch forma
        {
            case 0 //cTodos
            {
                saldocaja = cheques + depositos + efectivo + tarjetas + vales
            }
            case 1 //cMetalico
            {
                saldocaja = efectivo
            }
            case 2 //cCheques
            {
                saldocaja = cheques
            }
            case 3 //cTarjetas
            {
                saldocaja = tarjetas
            }
            case 4 //cDepositos
            {
                saldocaja = deposito
            }
            case 5 //cVales
            {
                saldocaja = vales
            }
        }

        return saldocaja
    }
    SaldoInicial::&db,corte,caja
    {
        new p
        {
            @"caja":caja
            @"corte":corte
        }

        sql="SELECT SUM(total) as saldoi from qryDetalleCorte where icorte < @corte AND icaja=@caja" 
        ref data=dbr.rec(sb,sql,p)

        return @@(data,"#saldoi")
    }
    GetSaldoInicial::&db,corte,caja,divisa
    {
        if divisa < 1{divisa=GetDivisaPredet(db)}

        new p
        {
            @"caja":caja
            @"corte":corte
            @"divisa":divisa
        }

        sql="select sum(ifnull(movcaja.cheques,0)+ifnull(movcaja.depositos,0)+ifnull(movcaja.efectivo,0)+ifnull(movcaja.tarjetas,0)+ifnull(movcaja.vales,0)) as saldo 
			from corte inner join movcaja on corte.sys_pk = movcaja.icorte 
			where movcaja.icorte<@corte and corte.icaja=@caja and movcaja.idivisa=@divisa;"
        
        ref data=dbr.rec(db,sql,p)

        saldo=@@(data,"#saldo")
        //se agregó que el saldo inicial no sea negativo
        // if saldo < 0{saldo = 0}

        return saldo
    }
    IngresoEgresoXCategoria::&db,sql,&p
    {
        ref data=dbr.list(db,sql,p)
        total= 0
        for i = 0; i < @count(data)
        {
            ref dt=@item(data,i)
            total=total + @@(dt,"#total")
        }
        return total
    }
    GetSaldoCorte::&db,corte
    {
        new p{@"corte":corte}
        sql="SELECT SUM(total) AS total,SUM(efectivo)AS efectivo,SUM(cheques)cheques,SUM(vales)vales,SUM(depositos)despositos,SUM(tarjetas)tarjetas 
        from qryDetalleCorte where icorte=@corte;"

        return dbr.rec(db,sql,p)
    }
    //saldo final , efectivo,tarjeta,vales,deposito,cheques
    SaldoFinal::&db,corte{return @@(GetSaldoCorte(db,corte),"#total")}
    SaldoEfectivo::db,corte{return @@(GetSaldoCorte(db,corte),"#efectivo")}

    
    DataArqueo::&db,pkcorte
    {
        if pkcorte < 1{do rise_error(500,"No ha indicado un corte válido")}

        new p
        {
            @"corte":pkcorte
            @"divisa":GetDivisaPredet(db)
        }

        sql="select 
        date_format(corte.fapertura,'%Y-%m-d')fapertura, 
        date_format(corte.fcierre,'%Y-%m-d')fcierre,
        date_format(corte.hapertura,'%H-%i-%s')hapertura, 
        date_format(corte.hcierre,'%H-%i-%s')hcierre, 
        corte.cerrado,
        caja.sys_pk as pkcaja,
        caja.codigo as codcaja, caja.descripcion as desccaja, 
        cajero.codigo as codcajero, cajero.nombre as nombrecajero 
        from cajero 
        inner join (caja inner join corte on caja.sys_pk = corte.icaja) on cajero.sys_pk = corte.icajero 
        where corte.sys_pk=@corte"

        ref corte=dbr.rec(db,sql,p)
        if isnull(corte){do rise_error(500,"No se encontrarón datos del corte")}

        sql="select venta.referencia, venta.formapago,venta.statusfacturacion,venta.statusadministrativo, 
        ((venta.subtotal-venta.descuento1-venta.descuento2)+venta.impuesto1+ venta.impuesto2+ venta.impuesto3+ venta.impuesto4) as total, 
        venta.importeadicional,
		  (case venta.statusadministrativo
		  	when 0 then '-SIN USO-'
		  	when 1 then '-ABIERTO-'
		  	when 2 then '-CERRADO-'
		  	when 3 then ''
		  	when 4 then '-POR ENTREGAR-'
		  	when 5 then '-REPARTO-'
		  	when 99 then '-CANCELADO-'
		  END) text_status
        from venta where venta.documento=6 and ((venta.icorte=@corte
        and venta.statusadministrativo>=3) or venta.statusadministrativo<3) 
        order by venta.referencia"

        ref detalle=dbr.list(db,sql,p)

        cerrado=@@(corte,"#cerrado")
        estado=ifstr(cerrado,"CERRADO","ABIERTO")

        fa=@@(corte,"$fapertura")
		fc=@@(corte,"$fcierre")
		ha=@@(corte,"$hapertura")
		hc=@@(corte,"$hcierre")
        p<"caja">:@@(corte,"#pkcaja")
        
        new response
        {
            @"fecha":date_str(now(),"yyyy-MM-dd HH:mm:ss")
            @"title":ifstr(cerrado,"- CORTE DE CAJA -","- ARQUEO DE CAJA -")
            @"header":dbr.vars.get(db,"FXCA112")
            @"text_corte":"CORTE #: "+str(pkcorte) + " "+estado
            @"text_del":"DEL: "+fa+" "+ha
            @"text_al":"AL : "+ifstr(cerrado,fc,date_str(now(),"yyyy-MM-dd")) +" "+ifstr(cerrado,hc,date_str(now(),"HH:mm:ss"))
            @"text_caja":"CAJA: "+@@(corte,"$codcaja")+" "+ @@(corte,"$desccaja")
            @"text_cajero":"CAJERO: "+@@(corte,"$codcajero") +" "+@@(corte,"$nombrecajero")
            @"venta_detalle*":GetDetalleVentaTicket(db,detalle)
            @"saldo_inicial":GetSaldoInicial(db,pkcorte,@@(corte,"#pkcaja"),0)//divisa predeterminado
            @"text_saldoinicial":"SALDO INICIAL"
            @"text_venta":"- VENTAS -"
            @"text_ingreso":"- INGRESOS -"
            @"text_egreso":"- EGRESOS -"
            @"divisa_predet":GetDivisaPredet(db)
            @"divisa_movcaja*":GetIngresosEgresosByDivisa(db,pkcorte,@@(corte,"#pkcaja"))
            @"http*":@http_context
        }

        return response
    }
    GetIngresos::&db,corte,divisa
    {
        new p
        {
            @"corte":corte
            @"divisa":divisa
        }

        sql="select categoria.descripcion as movcategoria, sum(movcaja.cheques+movcaja.depositos+movcaja.efectivo+ movcaja.tarjetas + movcaja.vales) as total 
        from categoria inner join movcaja on categoria.sys_pk = movcaja.icategoria where movcaja.icorte=@corte
        and movcaja.idivisa=@divisa and (movcaja.cheques>=0 and  movcaja.depositos>=0 and movcaja.efectivo>=0 and movcaja.tarjetas>=0 
        and movcaja.vales>=0) group by categoria.descripcion;"

        return dbr.list(db,sql,p)
    }
    GetEgresos::&db,corte,divisa
    {
        new p
        {
            @"corte":corte
            @"divisa":divisa
        }
        sql="select categoria.descripcion as movcategoria, sum(movcaja.cheques+movcaja.depositos+movcaja.efectivo+ movcaja.tarjetas + movcaja.vales) as total 
        from categoria inner join movcaja on categoria.sys_pk = movcaja.icategoria 
        where movcaja.icorte=@corte and movcaja.idivisa=@divisa
        and (movcaja.cheques<=0 and  movcaja.depositos<=0 
        and movcaja.efectivo<=0 and movcaja.tarjetas<=0 and movcaja.vales<=0)
        group by categoria.descripcion; "

        return dbr.list(db,sql,p)
    }
    GetFmpagos::&db,corte,divisa
    {
        new p
        {
            @"corte":corte
            @"divisa":divisa
        }
        sql="select
            sum(movcaja.cheques) as cheques,
            sum(movcaja.depositos) as depositos,
            sum(movcaja.efectivo) as efectivo,
            sum(movcaja.tarjetas) as tarjetas,
            sum(movcaja.vales) as vales
        from
            movcaja
        where
            movcaja.icorte = @corte
            and movcaja.idivisa = @divisa
            and (
                movcaja.cheques >= 0
                and movcaja.depositos >= 0
                and movcaja.efectivo >= 0
                and movcaja.tarjetas >= 0
                and movcaja.vales >= 0
            );"

        return dbr.rec(db,sql,p)
    }
    GetDetalleVentaTicket::&db,&detalle
    {
        contado= 0
        propinascaja= 0
        propinas= 0
        credito= 0

        for i = 0; i < @count(detalle)
        {
            ref dt=@item(detalle,i)
            tag=""
            total=@@(dt,"#total")

            if @@(dt,"#statusadministrativo")== 3
            {
                // facturado
                if @@(dt,"#statusfacturacion")== 3 {tag="F"}

                switch @@(dt,"#formapago")
                {
                    case 1 //contado
                    {
                        contado=contado + total
                        propinascaja=propinascaja + @@(dt,"#importeadicional")
                        if tag==""{tag=" "}
                        break
                    }
                    case 2 //credito
                    {
                        credito= credito + total
                        tag=tag+"C"
                        break
                    }
                }

                propinas= propinas + @@(dt,"#importeadicional")
                dt<"text_status">:number_format(total)+tag
            }
        }

        new response
        {
            @"detalle*":detalle
            @"text_total":"TOTAL:"
            @"str_total":number_format(contado+credito)
            @"total":contado+credito
            @"text_credito":"CRÉDITO"
            @"str_credito":number_format(credito)
            @"credito":credito
            @"text_contado":"CONTADO"
            @"str_contado":number_format(contado)
            @"contado":contado
            @"text_propina":"PROPINAS"
            @"str_propinas":number_format(propinas)
            @"propinas":propinas
            @"text_ingreso_caja":"INGRESOS EN CAJA"
            @"str_ingreso_caja":number_format(contado + propinascaja)
            @"ingreso_caja":contado + propinascaja
            @"text_footer":"(INCLUYE PROPINAS)"
        }
        return response
    }
    GetIngresosEgresosByDivisa::&db,corte,caja
    {
        new p
        {
            @"corte":corte
            @"caja":caja
        }

        sql="select distinct divisa.descripcion,movcaja.idivisa, movcaja.tipocambio 
        from divisa 
        inner join movcaja on divisa.sys_pk = movcaja.idivisa 
        where movcaja.icorte=@corte group by divisa.descripcion,movcaja.idivisa,movcaja.tipocambio;"

        ref divisa_movcaja=dbr.list(db,sql,p)
        for i = 0; i < @count(divisa_movcaja)
        {
            ref itm=@item(divisa_movcaja,i)
            itm<"saldo_inicial">:GetSaldoInicial(db,corte,caja,@@(itm,"#idivisa"))
            itm<"ingresos_categoria*">:GetIngresos(db,corte,@@(itm,"#idivisa"))
            itm<"egresos_categoria*">:GetEgresos(db,corte,@@(itm,"#idivisa"))
            itm<"formas_ing_pagos*">:GetFmpagos(db,corte,@@(itm,"#idivisa"))
        }
        
        return divisa_movcaja
    }
    get.cajeros::&db,&params
    {
        return dbr.list(db,"
                select codigo,nombre as descripcion from cajero where ifnull(sys_deleted,0)=0 AND if(ifnull(@ub,'*')='*',true,ubicacion=@ub);",params)
    }
    get.cajas::&db,&params
    {
        return dbr.list(db,"
                select codigo,descripcion from caja where ifnull(sys_deleted,0)=0 AND if(ifnull(@ub,'*')='*',true,ubicacion=@ub);",params)
    }

    
    get.ubicaciones::&db,&params
    {
        return dbr.list(db,"SELECT '*' codigo, 'Cualquiera' descripcion
                UNION 
                select sys_pk as codigo,descripcion from ubicacion where ifnull(sys_deleted,0)=0;",params)
    }
