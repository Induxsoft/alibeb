    //#region LOGIN
    SelectCorte::&db,&params,&postData
    {
        idcaja=dbr.num(db,"select ifnull(sys_pk,0) from caja where codigo=@caja",postData)
        postData<"pwdmd5e">:md5e(@@(postData,"$pwd"),"unicode")
        idcajero=dbr.num(db,"select ifnull(sys_pk,0) from cajero where codigo=@cajero AND (contrasena=MD5(@pwd) OR contrasena=@pwdmd5e)",postData)
        
        if idcajero < 1{do rise_error(500,"Usuario o contraseña incorrecta.")}
        if idcaja < 1{do rise_error(500,"La caja indicada no es válido")}

        params<"idcajero">:idcajero
        idwaiter=dbr.num(db,"select ifnull(agente,0) from cajero where sys_pk=@idcajero",params)

        using params
        {
            @"caja":idcaja
            @"cajero":idcajero
            @"waiter":idwaiter
        }
        //validar si la caja ya tiene un cajero
        sql="select  count(*) from corte ct inner join cajero cj on ct.icajero=cj.sys_pk 
        where ifnull(ct.cerrado,0)=0 
        and cj.sys_pk<>@cajero and ct.icaja=@caja"

        if dbr.num(db,sql,params) > 0{do rise_error(500,"La caja ya esta en uso por otro cajero")}
        //validar si el cajero ya tiene otra caja abierta
        sql="select  count(*) from corte ct inner join cajero cj on ct.icajero=cj.sys_pk 
        where ifnull(ct.cerrado,0)=0 
        and cj.sys_pk=@cajero and ct.icaja<>@caja"

        if dbr.num(db,sql,params) > 0{do rise_error(500,"Imposible iniciar sesión, el cajero indicado ha abierto una sesión en otra caja")}

        idcorte=dbr.num(db,"select * from corte as c where ifnull(c.cerrado,0)=0
                and c.icaja=@caja and c.icajero=@cajero",params)
            
        if idcorte < 1
        {
            new corte
            {
                @"sys_guid":uuid()
                @"sys_dtcreated*":dbr.sql("now()")
                @"sys_timestamp*":dbr.sql("now()")
                @"sys_exported":0
                @"sys_dtexported*":dbr.sql("now()")
                @"cerrado":0
                @"fapertura*":dbr.sql("now()")
                @"hapertura*":dbr.sql("now()")
                @"fcierre*":dbr.sql("now()")
                @"hcierre*":dbr.sql("now()")
                @"sys_recver":0
                @"icaja":idcaja
                @"icajero":idcajero
            }
            do dbr.insert(db,"corte",corte)
            idcorte =dbr.num(db,"select ifnull(sys_pk,0) from corte where sys_guid=@sys_guid",corte)
        }

        ref data=dbr.rec(db,"SELECT
                a.codigo,a.codnomina,a.email,a.nombre,a.notas,a.pcomision,a.telefono,
                ifnull(u.access_movil,0)access_movil,ifnull(u.cc,0)cc,ifnull(u.zn,0)zn 
                from agente a
                left JOIN ut_dm_tmm u ON a.Sys_PK=u.agente
                WHERE u.agente=@waiter",params)

        ref data=ifnull(data,record.create())

        ref zone=dbr.rec(db,@getzone,data)
        new d
        {
            @"key":@@(data,"codigo")
            @"caption":@@(data,"nombre")
            @"zone":@@(zone,"descripcion")
            @"cc":dbr.num(db,"select centroconsumo from caja where sys_pk=@caja",params)
            @"idcaja":@@(postData,"$caja")
            @"idcajero":@@(postData,"$cajero")
            @"corte":idcorte
        }
        data<"corte">:idcorte
        data<"datos*">:d
        data<"token">:uuid()
        do update.datatoken(db,d)
        ref datatoken=insert.datatoken(db,params,data)
        data<"datatoken*">:datatoken
        return data
    }
    
    login::&db,&params,&postdata
    {
        if field.exist(postdata,"caja") && field.exist(postdata,"cajero")
        {
            return SelectCorte(db,params,postdata)
        }
        ref data=dbr.rec(db,@login,postdata)
        if isnull(data){do rise_error(500,"Usuario o contraseña incorrecta.")}

        data<"key">:"sys_pk"

        data<"waiter">:@@(data,"agente")
        ref waiter=get.dataWaiter(db,data)//dbr.rec(db,@getdatapwd,data)//get.dataWaiter(db,data)
         
        ref zone=dbr.rec(db,@getzone,data)
        new d
        {
            @"key":@@(waiter,"codigo")
            @"caption":@@(waiter,"nombre")
            @"zone":@@(zone,"descripcion")
            @"cc":@@(data,"cc")
        }
        data<"datos*">:d
        data<"token">:uuid()
        do update.datatoken(db,d)
        ref datatoken=insert.datatoken(db,params,data)
        data<"datatoken*">:datatoken

        return data
    }
    access.config::&db,&params,&postData
    {
        privilegio="CA70"
        
        if @@(postData,"$sitem") == "cortesia"{privilegio="CA72"}
        else if @@(postData,"$sitem") == "cancelar"{privilegio="CA71"}

        do access(db,params,postData,privilegio)
    }
    access::&db,&params,&postData,privilegio
    {
        using params
        {
            @"uid":trim(@@(postData,"$user"))
            @"pwdmd5":md5(trim(@@(postData,"$pwd")))
            @"pwdmd5u":md5e(@@(postData,"$pwd"),"unicode")
        }
        ref user:dbr.rec(db,"select 
			sys_pk, ifnull(locked,0) locked 
			from tuser 
			where lower(userid)=@uid 
			and (lower(pwdmd5)=@pwdmd5 or lower(pwd)=@pwdmd5u)
			and ifnull(sys_deleted,0)=0",params)

        if isnull(user){do rise_error(500,"Usuario y contraseña incorrecto")}

        do dbr.setHashUnicode(@true)
        
        ref _db=dbr.login(@@(@http_context,"$session/idp/qname"),@@(params,"$uid"),trim(@@(postData,"$pwd")))
        if isnull(@@(@http_context,"&session/user")){@http_context<"session/user*">:record.create()}

        @http_context<"session/idp/database*">:_db
        @http_context<"session/user/uid">:@@(params,"$uid")
        @http_context<"session/user/ids">:dbr.getSID(_db)
        do dbr.apps.action.grant(privilegio)
    }
    //#endregion
    

    //#region TOKEN
    VerifyToken::&db,&data
    {
        ref datatoken=dbr.rec(db,"select * from ut_dn_dmm_token where token=@dm_token",data)
        if isnull(datatoken) || trim(@@(datatoken,"$datos"))==""{return @false}

        ref json=from.json(trim(@@(datatoken,"$datos")))

        if field.exist(json,"idcaja")
        {
            idcaja=dbr.num(db,"select sys_pk from caja where codigo=@idcaja",json)
            
            if idcaja > 0
            {
                data<"_icaja">:idcaja
                data<"icaja">:idcaja
            }
            corte=dbr.num(db,"SELECT sys_pk FROM corte c WHERE c.icaja=@_icaja AND IFNULL(c.cerrado,0)=0;",data)
            if corte < 1{do rise_error(500,"No hay un corte abierto para el cajero actual, cierre sesión e intente de nuevo")}
            data<"icorte">:corte
        }

        if field.exist(json,"idcajero")
        {
            ref cajero=dbr.rec(db,"select sys_pk,codigo,nombre,agente from cajero where codigo=@idcajero",json)
            if isnull(cajero){return @false}

            if @@(cajero,"#agente")< 1{do rise_error(500,"El cajero no tiene un agente relacionado para continuar")}

            ref dmtmmn=dbr.rec(db,"SELECT * FROM ut_dm_tmm u WHERE u.agente=@agente",cajero)
            if isnull(dmtmmn){do rise_error(500,"Se encontró una relación entre el cajero y el agente pero, no hay una configuración de centro de consumo")}

            ref zone=dbr.rec(db,@getzone,dmtmmn)
            ref agente=dbr.rec(db,"select codigo,nombre from agente where sys_pk=@agente",cajero)
            
            if @@(dmtmmn,"#cc") < 1{do rise_error(500,"No hay un centro de consumo configurado para el cajero")}

            using json
            {
                @"key":@@(agente,"$codigo")
                @"caption":@@(agente,"$nombre")
                @"zone":@@(zone,"$descripcion")
                @"cc":@@(dmtmmn,"#cc")
            }

            data<"waiter">:@@(agente,"$codigo")
            data<"iagente">:@@(cajero,"#agente")
            data<"cc">:@@(json,"#cc")
            
            new r{@"datos":to.json(json)}
            //actualizar datos del token
            do dbr.update(db,"ut_dn_dmm_token",r,"token=@dm_token",data)
        }
        else if @@(json,"$key")!="" && @@(data,"#icaja") < 1
        {
            if @@(json,"#cc") < 1{do rise_error(500,"No hay un centro de consumo configurado para el agente")}

            do GetCorteMesero(db,json,data)
        }

        
        return @true
    }
    update.datatoken::&db,&params
    {
        ref listwaiter=dbr.list(db,@getdatatoken,@null)
        for i=0;i<@count(listwaiter)
        {
            ref itm=@item(listwaiter,i)
            ref data=from.json(field.dstr(itm,"datos","{}"))
            exception{}
            if @@(data,"key")==@@(params,"key")
            {
                do dbr.execute(db,@updatedatatoken,itm)
            }
        }
    }

     
    insert.datatoken::&db,&params,&data
    {
        new config{@"cofig_expiracion":@@(data,"cofig_expiracion")}
        new datatoken
        {
            @"token":@@(data,"token")
            @"creacion*":now()
            @"expiracion*":str2dt(dbr.str(db,"SELECT NOW()+INTERVAL @cofig_expiracion minute AS DATE ",config))
            @"revocado":0
            @"datos":to.json(@@(data,"&datos"))
        }
        do dbr.insert(db,"ut_dn_dmm_token",datatoken)
        return datatoken
    }
    token.valid::&db,&params
    {
        query=@getdatatoken
        query=query+" where token=@token AND date(expiracion)>= date(NOW()) AND revocado=0 ;"
        ref json=dbr.rec(db,query,params)
        if isnull(json){return @null}
        
        json<"json*">:from.json(@@(json,"datos"))
        return json
    }


    get.token::&db,&params,&postData
    {
        query=@getdatatoken
        query=query+" where token=@token"
        ref json=dbr.rec(db,query,postData)
        if isnull(json){return @null}
        json<"json*">:from.json(@@(json,"datos"))
    
        return json
    }
   
    token.logout::&db,params
    {
        do dbr.delete(db,"ut_dn_dmm_token","token=@token",params)
        exception{}
        return @null
    }

    token.data.validate::&db,validar
    {
        new p
        {
            @"dm_token":@dmtoken
            @"token":@dmtoken
            @"validate":validar
        }
		if isnull(token.valid(db,p)){do rise_error(99,"El token es inválido o ha sido revocado.")}

        r= VerifyToken(db,p)
        if not(r){do rise_error(500,"Algo salió mal, cierre sesión e intente de nuevo")}

        return p
    }
    //#endregion
    

    //#region CONTROLADORES(DRIVERS)
    //====================CONTROLADORES=============================================================
    get.drivers::&db,&params
    {
        if not(file.exists(@path_file_device_drivers)){do rise_error(500,"No existe el archivo de configuración de controladores para el dispositivo")}

        ref drivers_servers=dbr.list(db,"select * from ut_dm_tmm_gprn",params)
        ref dserver=list.create()

        for i = 0; i < @count(drivers_servers)
        {
            ref ds=@item(drivers_servers,i)
            ref data=from.json(@@(ds,"$data"))
            new type{@"default":@@(data,"$type")}
            data<"type*">:type
            data<"name">:@@(ds,"$id")
            do list.add(dserver,data)
        }

        new drivers
        {
            @"server*":dserver
            @"device*":from.json(file.rtext(@path_file_device_drivers))
        }

        return drivers
    }
    //#endregion
    
    //#region DATOS DEL TICKET O CUENTA
    data.ticket::&db,&params
    {
        new p
        {
            @"id_table":@@(params,"#id_table")
            @"iventa":@@(params,"#id_table")
        }

        ref datamesa=dbr.rec(db,@data_mesa,params)
        if isnull(datamesa){do rise_error(99,"No se encontro datos del ticket.")}
        
        ref ticket=record.caseinsensitive(record.copyex(datamesa,@null,"*",",","code:mesa,reference:referencia,cliente:idcc,balance:total",":"))
        
        ticket<"credito">: 0
        
        using p
        {
            @"cliente":@@(ticket,"#idcc")
            @"cc":@@(ticket,"#cc")
            @"ag":@@(ticket,"#ag")
            @"code":@@(datamesa,"code")
            @"iventa":@@(params,"#id_table")
        }
        
        ticket<"fecha_actual">:date_str(now(),"yyyy-MM-dd  hh:mm:ss")
        ticket<"empresa">:dbr.str(db,"SELECT varvalue FROM globalvar g WHERE g.VarName='FXCA112';",@null)
        ticket<"status">:@@(ticket,"$text_status_admin")
        if @@(ticket,"#imovcaja") > 0 && @@(ticket,"#statusadministrativo") != 3 {ticket<"status">:"-PAGADO-"}

        ref cliente=dbr.rec(db,@customer,p)
        ticket<"cliente*">:cliente
        ticket<"cconsumo*">:dbr.rec(db,@cc,p)
        ticket<"mesero*">:dbr.rec(db,@waiter,p)
        ticket<"caja*">:dbr.rec(db,"select c.sys_pk,c.codigo,c.descripcion from caja c where c.sys_pk=@icaja;",ticket)
        ticket<"divisa*">:dbr.rec(db,"select sys_pk,codigo,descripcion,tcambio from divisa where sys_pk=@idivisa",ticket)

        ticket<"lifespan*">:get.lifespan(db,@@(ticket,"sys_pk"))
        ticket<"detalle*">:get.ordenes(db,p)

        ref corte=dbr.rec(db,"select c.sys_pk,
                trim(c.fapertura)fapertura,
                trim(c.hapertura)hapertura,
                trim(c.hcierre)hcierre,
                trim(c.fcierre) fcierre,
                c.cerrado,c.icajero,c.icaja
                from corte as c 
                where sys_pk=@icorte",ticket)
        ticket<"corte*">:corte
        ticket<"cajero*">:dbr.rec(db,"select sys_pk,codigo,nombre from cajero where sys_pk=@icajero",corte)

        ref movcaja=ticket.fpagos(db,@@(params,"#id_table"),@@(ticket,"#imovcaja"))
        ticket<"fpagos*">:movcaja

        ticket<"comandas*">:ticket.comandas(db,@@(params,"#id_table"))
        ticket<"importe_letras">:Int2Ltr(@@(ticket,"#total"))+" "+Dec2Ltr(@@(ticket,"#total"))
        ticket<"text_footer">:dbr.str(db,"SELECT varvalue FROM globalvar g WHERE g.VarName='FXCA113';",@null)
        ticket<"nota_adicional">:"*NO ES UN COMPROBANTE DE PAGO*"

        //datos de entrega
        ref entrega=dbr.rec(db,"SELECT d.sys_pk,d.nombre,d.telefono,d.direccion,d.notas AS referencia FROM dmns_entrega e 
        INNER JOIN dmns_destino d ON e.destino=d.sys_pk
        WHERE e.venta=@iventa;",p)

        ticket<"entrega*">:entrega
        
        if @count(list.create_from_fields(movcaja)) > 0  || @@(ticket,"#formapago") == @fp_credito
        {
            folio_factura=ticket.encode_folio(@@(ticket,"$fecha"),@@(ticket,"$sys_dtcreated"),from.json(@@(ticket,"$sys_pk")))
            // er=getLastError()
            // if folio_factura == ""{do rise_error(0,er)}
            using ticket
            {
                @"propina":@@(ticket,"#importeadicional")
                @"efectivo":@@(movcaja,"#efectivo")
                @"tarjeta":@@(movcaja,"#tarjetas")
                @"folio_factura":folio_factura
            }
        }

        if @@(ticket,"#formapago") == @fp_credito
        {
            ticket<"credito">: @@(ticket,"#total")
        }

        return ticket
    }
    ticket.fpagos::&db,venta,_movcaja
    {
        venta,_movcaja >> p

        ref movcaja=dbr.rec(db,"select
            mc.sys_pk,
            mc.efectivo,
            mc.tarjetas,
            mc.vales,
            mc.depositos,
            mc.cheques,
            mc.referencia,
            mc.auditado,
            mc.contabilizado,
            mc.documento,
            trim(mc.fecha) fecha_mov,
            trim(mc.hora) hora_mov,
            mc.notas,
            mc.tipocambio as tipocambio_mov,
            c.codigo categoria,
            d.codigo as divisa,
            ct.sys_guid as corte
        from
            movcaja mc
            inner join categoria c on mc.icategoria = c.sys_pk
            inner join divisa d on mc.idivisa = d.sys_pk
            inner join corte ct on mc.icorte = ct.sys_pk
        WHERE mc.sys_pk=@_movcaja",p)

        if isnull(movcaja)
        {
            return record.create()
        }
        

        movcaja<"tarjetas*">:dbr.list(db,"select 
        dt.sys_pk,dt.autorizacion,dt.cvv,dt.domicilio,
        dt.importe, dt.nombre,dt.numero,dt.tipocambio ,
        d.codigo as divisa,d.tcambio as tcambio_divisa,
        tc.codigo as tipo,dt.retiro
        from dtarjeta dt
        inner join divisa d on dt.idivisa=d.sys_pk
        inner join tarjetacredito tc on dt.tipo=tc.sys_pk
        where dt.fk_movcaja_detalletarjetas=@_movcaja",p)

        movcaja<"depositos*">:dbr.list(db,"select dd.sys_pk,dd.banco,dd.fecha,dd.referencia ,dd.importe,dd.tipocambio,
        dd.retiro,d.codigo as divisa
        from ddepositos dd 
        inner join divisa d on dd.idivisa=d.sys_pk
        where dd.fk_movcaja_detalledepositos=@_movcaja",p)

        movcaja<"cheques*">:dbr.list(db,"select dc.sys_pk,dc.banco,dc.beneficiario,dc.emisor,dc.importe,dc.notas,dc.numero,dc.tipocambio ,
        d.codigo as divisa,dc.retiro
        from dcheques dc
        inner join divisa d on dc.idivisa=d.sys_pk
        where dc.fk_movcaja_detallecheques=@_movcaja;",p)

        movcaja<"vales*">:dbr.list(db,"select dv.sys_pk,dv.fecha,dv.importe,dv.notas,dv.referencia,dv.tipocambio ,
        dv.retiro,d.codigo as divisa
        from dvales dv 
        inner join divisa d on dv.idivisa=d.sys_pk
        where dv.fk_movcaja_detallevales=@_movcaja;",p)

        return movcaja
    }
    // EspecificarKind :: &mifecha, kind
    // {
    //     ref resultado = DateTimeSpecifyKind(mifecha, kind)
    //     return resultado
    // }
    EspecificarKind :: &mifecha, kind
    {
        ref tipoKind   = _gettype(-1, "System.DateTimeKind")
        ref valorKind  = EnumToObject(tipoKind, kind)        // construye el enum en runtime
        ref resultado  = DateTimeSpecifyKind(mifecha, valorKind)
        return resultado
    }
    ticket.comandas::&db,venta
    {
        venta >> p

        p<"sql">:@_list_dorden

        ref orders=dbr.list(db,"select 
        o.sys_pk,o.auditada,o.cdirecto,o.cindirecto,o.cmanoobra,o.cmaquinaria,o.contabilizada,o.d1,
        o.d2,trim(o.fecha)fecha,trim(o.fprevista)fprevista,trim(o.fproduccion)fproduccion,o.importe,o.notas,o.referencia,o.`status`,
        o.tiempoproduccion,o.tiemposervicio,o.tipocambio,
        cp.codigo as cprod,
        a.codigo as agente,
        cc.codigo as cconsumo
        from orden o
        inner join cproduccion cp on o.icproduccion=cp.sys_pk
        inner join agente a on o.iagente=a.sys_pk
        inner join cconsumo cc on o.icconsumo=cc.sys_pk
        where o.iventa=@venta",p)

        for i = 0; i < @count(orders)
        {
            ref o=@item(orders,i)
            p<"_orden">:@@(o,"#sys_pk")
            o<"detalle*">:get.ordenes(db,p)
        }
        return orders
    }
    //#endregion
}