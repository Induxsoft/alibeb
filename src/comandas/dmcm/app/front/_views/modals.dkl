        {
            thead(class="table-dark sticky-top")
            {
                th{"SKU"}
                th{"Descripción"}
                th{"Precio"}
                th{"Existencia"}
                // th{""}
            }
            tbody(id="tbody-products-selected"){$""}
        }
    }
}

// nota de cada cuenta
div(id="modal-note-account" class="show_modal_center open-table hidde_control modal-responsive modal-md" style="top:15% !important")
{
    div(class="d-flex" onclick="controller.hide_modal(\'#modal-note-account\');")
    {
        div(class="just-cont-center d-flex flex-grow-1" )
        {
            h4(id="id_account"){$""}br{}br{}
        }
        svg(xmlns="http://www.w3.org/2000/svg" id="cancel_modal" width="22" height="22" fill="#ccc" title="Cerrar" class="bi bi-x-lg" viewBox="0 0 16 16")
        {
            path(d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8 2.146 2.854Z")
        }
    }
    
    div(class="mt-2" )
    {
        label(class="fw-bold" "for"=""){"Nota:"}
        textarea(class="form-control w-100" name="lblnotavnt" id="lblnotavnt" rows="5"){""}

        div(class="d-flex justify-content-end gap-2 mt-2")
        {
            button(class="btn rounded-0" type="button" id="btn_mdl_save_note"){$"Guardar"}
            button(class="btn rounded-0" type="button" onclick="controller.hide_modal(\'#modal-note-account\');"){$"Cerrar"}
        }
    }
}

// casignar cliente
div(id="modal-change-client" class="show_modal_center open-table hidde_control modal-responsive modal-sm" style="top:15% !important")
{
    div(class="d-flex" onclick="controller.hide_modal(\'#modal-change-client\');")
    {
        div(class="just-cont-center d-flex flex-grow-1" )
        {
            h4(id="id_account"){$"Cambiar cliente"}br{}br{}
        }
        svg(xmlns="http://www.w3.org/2000/svg" id="cancel_modal" width="22" height="22" fill="#ccc" title="Cerrar" class="bi bi-x-lg" viewBox="0 0 16 16")
        {
            path(d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8 2.146 2.854Z")
        }
    }
    
    div(class="mt-2" )
    {
        label(class="fw-bold" "for"=""){"Cliente:"}
        "input-key"(
            class="d-flex w-100"
            name="client" 
            id="client" 
            "data-key"="sys_pk" 
            "data-search"="codigo" 
            "data-text"="nombre" 
            "data-source"="/dmcm/pos/dinner/clientes/?admin=1&s=@search" 
            "data-value"="{}" 
            required="true"
            columns="codigo,nombre" 
            colcaptions="Código,Nombre"
            "hide-searcher"="true"
            "control-styles"="
            #container{width:100%;}
            #search_container, #description_container {
                padding: 0 !important;
                width:100%;
            }
            "
        ){$""}

        div(class="d-flex justify-content-end gap-2 mt-2")
        {
            button(class="btn rounded-0" type="button" onclick="controller.changeClient()"){$"Aceptar"}
            button(class="btn rounded-0" type="button" onclick="controller.hide_modal(\'#modal-change-client\');"){$"Cerrar"}
        }
    }
}
//modal de promociones
div
{
    $'<!-- Modal de promociones de la venta -->
    <div class="modal fade" id="modalPromociones" tabindex="-1"
        aria-labelledby="modalPromocionesLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">

        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">

            <div class="modal-content promociones-modal">

                <!-- HEADER -->
                <div class="modal-header promociones-header">
                    <div>
                        <h5 class="modal-title mb-1" id="modalPromocionesLabel">
                            Promociones de la venta
                        </h5>
                        <small id="promocionesVentaReferencia" class="text-white-50"></small>
                    </div>

                    <button type="button"
                            class="btn-close btn-close-white d-none"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>
                </div>


                <!-- BODY -->
                <div class="modal-body">

                    <!-- =====================================================
                        1. PRODUCTOS CON DESCUENTO
                        ===================================================== -->
                    <section class="promo-section promo-descuentos">

                        <div class="promo-section-header">
                            <div class="promo-section-icon">
                                <i class="bi bi-tags-fill"></i>
                            </div>

                            <div>
                                <h6 class="promo-section-title">
                                    Productos con descuento
                                </h6>

                                <small class="promo-section-subtitle">
                                    Productos beneficiados por promociones
                                </small>
                            </div>

                            <span id="promocionesCantidadDescuentos"
                                class="badge rounded-pill promo-badge ms-auto">
                                0
                            </span>
                        </div>

                        <div id="promocionesProductos"
                            class="promo-section-content">
                            <!-- JS -->
                        </div>

                    </section>


                    <!-- =====================================================
                        2. OBSEQUIOS
                        ===================================================== -->
                    <section class="promo-section promo-obsequios">

                        <div class="promo-section-header">
                            <div class="promo-section-icon">
                                <i class="bi bi-gift-fill"></i>
                            </div>

                            <div>
                                <h6 class="promo-section-title">
                                    Obsequios
                                </h6>

                                <small class="promo-section-subtitle">
                                    Productos que puedes recibir
                                </small>
                            </div>

                            <span id="promocionesCantidadObsequios"
                                class="badge rounded-pill promo-badge ms-auto">
                                0
                            </span>
                        </div>

                        <div id="promocionesObsequios"
                            class="promo-section-content">
                            <!-- JS -->
                        </div>

                    </section>


                    <!-- =====================================================
                        3. NOTIFICACIONES
                        ===================================================== -->
                    <section class="promo-section promo-notificaciones">

                        <div class="promo-section-header">
                            <div class="promo-section-icon">
                                <i class="bi bi-info-circle-fill"></i>
                            </div>

                            <div>
                                <h6 class="promo-section-title">
                                    Notificaciones
                                </h6>

                                <small class="promo-section-subtitle">
                                    Información relacionada con promociones
                                </small>
                            </div>

                            <span id="promocionesCantidadNotificaciones"
                                class="badge rounded-pill promo-badge ms-auto">
                                0
                            </span>
                        </div>

                        <div id="promocionesNotificaciones"
                            class="promo-section-content">
                            <!-- JS -->
                        </div>

                    </section>

                </div>


                <!-- FOOTER -->
                <div class="modal-footer promociones-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            _data-bs-dismiss="modal" id="btn_promos">
                        Cerrar
                    </button>

                </div>

            </div>
        </div>
    </div>'
}
