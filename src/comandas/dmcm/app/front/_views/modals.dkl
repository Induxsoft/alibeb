#!

function base_url(withPort)
{
    prot = ifstr(parse.bool(@@(@http_context,"$request/headers/HTTPS")),"https","http")
    host = @@(@http_context, "$request/headers/HTTP_HOST")
    port = @@(@http_context, "$request/headers/SERVER_PORT")

    if parse.bool(withPort) { return prot+"://"+host+":"+port }
    return prot+"://"+host
}

function printDeliveriDrivers()
{
    url_repartidores = path.concat(base_url(@false), "/dmcm/pos/dinner/repartidores/?admin=1&s=%")
    
    repartidores_json = http.get(url_repartidores)
    
    ref repartidores = list.create()
    codeblock "Parsear respuesta"
    {
        ref repartidores:from.json(repartidores_json)
        exception{ do pop_exception() }
    }

    for i = 0; i < list.count(repartidores)
    {
        ref item = list.obj(repartidores,i)
        nombre = @@(item,"$nombre")

        #$
        button(
            class="btn"
            type="button"
            onclick="views.changeDeliveryDriver(#<to.json(item)>)"
            style="
            padding: 1rem .5rem !important;
            font-size: 1.25rem !important;
            border-radius: .3rem !important;
            border: 1px solid gray !important;
            "
        ){"#<nombre>"}        
        #!
    }
}

