    //modal ingresos o egresos
    div(class="modal fade " id="modal_ingreso_egreso" tabindex="-1" "data-bs-backdrop"="false" "data-bs-keyboard"="false") //"aria-hidden"="true"
        {
            div(class="modal-dialog modal-lg modal-dialog-centered mx-auto") // modal-dialog-scrollable modal-dialog-centered
            {
                div(class="modal-content rounded-0 p-0 border shadow")
                {
                    div(class="modal-header p-3")
                    {
                        h6(class="modal-title fw-bold" id="modal_ingreso_egreso_title"){$""}
                        div(class="w-100 rounded" role="alert" style="height:8px; background-color:#FCFCFC"){$""}
                        button(type="button" class="btn-close btn-sm" "data-bs-dismiss"="modal" "aria-label"="Close"){$""}
                    }
                    div(class="modal-body py-0 px-2 pt-2" )
                    {
                        form(id="frm_ingreso_egreso" onsubmit="return false" class="form-table d-flex")
                        {
                            div(class="row")
                            {
                                div(class="col-md-4")
                                {
                                    label(class="fw-bold" "for"="referencia"){"Referencia:"}
                                    input(class="input-login" type="" name="referencia" value="" id="referencia" maxLength="50" onfocus="views.SelectAll(this)" required="")
                                }
                                div(class="col-md-3")
                                {
                                    label(class="" "for"="fecha"){"Fecha:"}
                                    input(class="input-login" type="date" name="fecha" value="#<date_str(now(),'yyyy-MM-dd')>" id="fecha" maxLength="32" onfocus="views.SelectAll(this)")
                                }
                                div(class="col-md-6")
                                {
                                    label(class="fw-bold" "for"="importe"){"Categoría:"}
                                    select(class="input-login form-select shadow-none" name="categoria" id="categoria" required="")
                                    {$""
                                        #!
                                        if isset("categorias")
                                        {
                                            for i = 0; i < @count(categorias)
                                            {
                                                ref cat=@item(categorias,i)
                                                #$ option(value="#<@@(cat,'$sys_pk')>" tipo="#<@@(cat,'#tipo')>"){"#<@@(cat,'$descripcion')>"}
                                            }
                                        }
                                        #$
                                    }
                                }
                                div(class="col-md-6")
                                {
                                    label(class="fw-bold" "for"="divisa"){"Divisa:"}
                                    select(class="input-login form-select shadow-none" name="divisa" id="divisa" required="")
                                    {$""
                                        #!
                                        if isset("divisas")
                                        {
                                            #!
                                            for i = 0; i < @count(divisas)
                                            {
                                                ref d=@item(divisas,i)
                                                selected=@@(@__divisa,"#sys_pk") == @@(d,"#sys_pk")
                                                #$ option(value="#<@@(d,'$sys_pk')>" "#<ifstr(selected,'selected','')>"="true"){"#<@@(d,'$descripcion')>"}
                                            }
                                        }
                                        #$
                                    }
                                }
                                div(class="col-md-12")
                                {
                                    label(class="" "for"="descripcion"){"Descripción:"}
                                    textarea(class="input-login" name="descripcion" id="descripcion" maxLength="1024" onfocus="views.SelectAll(this)"){""}
                                }
                                div(class="col-md-3")
                                {
                                    label(class="fw-bold" "for"="tcambio"){"Efectivo:"}
                                    input(class="input-login" type="number" name="efectivo" value="0" min="0.1" max="9999999999999" step="0.000001" id="efectivo" onfocus="views.SelectAll(this)" required="")
                                }
                                
                            }
                        }
                    }
                    div(class="modal-footer")
                    {
                        button(class="btn-admin" type="button" onclick="controller.ProcessMovimiento()"){$"Aceptar"}
                    }
                }
            }
        }

