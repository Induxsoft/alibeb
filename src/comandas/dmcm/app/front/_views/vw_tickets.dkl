#include "dkli.dkh"
#!
module ""
{
    @action=@@(@GET,"$--action")
    @search=parse.bool(@@(@GET,"$--search"))
    @not_loaded=parse.bool(@@(@GET,"$--not-loaded"))
    @condition=trim(@@(@GET,"$--condition"))
    
    #$
    div(class="container" style="height:85%;")
    {
        h5{"Tickets"}

        #!
        if @search
        {
            #$
            div(class="mb-2")
            {
                input(class="form-control w-100" type="search" name="search" value="" id="search" placeholder="Buscar..." onchange="controller.loadTickets('#<@action>','?search='+encodeURIComponent(this.value)+'&condition=#<@condition>');")
            }
        }
        #$
        div(class="table-responsive" style="height:95%;")
        {
            table(class="table table-bordered table-hover table-selectable")
            {
                thead(class="table-dark sticky-top")
                {
                    th{"Venta"}
                    th{"Creación"}
                    th{"Forma de pago"}
                    th{"Cliente"}
                    th{"Total"}
                    th
                    {
                        #!
                        if trim(@action) == ""
                        {
                            #$
                            span{$'<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-printer" viewBox="0 0 16 16">
                            <path d="M2.5 8a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1"/>
                            <path d="M5 1a2 2 0 0 0-2 2v2H2a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h1v1a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2v-1h1a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-1V3a2 2 0 0 0-2-2zM4 3a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2H4zm1 5a2 2 0 0 0-2 2v1H2a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v-1a2 2 0 0 0-2-2zm7 2v3a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1"/>
                            </svg>'}
                            #!
                        }
                        else
                        {
                            #$
                            h6{"Acciones"}
                        }
                        
                    }
                }
                tbody(id="tbody-tickets"){$""}
            }
        }
    }

    #!
    if not(@not_loaded)
    {
        #$
        script(type="text/javascript")
        {$'
            document.addEventListener("DOMContentLoaded",()=>
            {
                controller.loadTickets("#<@action>");
            });
            
        '}
    }
    
}