#include "dkli.dkh"
#!
module "login"
{
    #$
    div(class="dk-login" id="login")
    {
		link(href="/_/dmcm/app/front/_css/login.css" rel="stylesheet"){""}

        div(class="dk-login__panel mx-auto")
        {
            div(class="dk-login__location")
            {
                label("for"="ubicacion" class="fw-bold dk-login__label"){"Ubicación:"}
                select(
                    class="form-select dk-login__control"
                    type="text"
                    name="ubicacion"
                    id="ubicacion"
                    disabled=""
                ){$""}
            }

            hr(class="dk-login__separator"){}

            div(class="dk-login__roles")
            {
				div
				{
					input(
						class="btn-check"
						type="radio"
						name="opt"
						id="rdomesero"
						checked=""
						autocomplete="off"
						onclick="views.ShowFormulario('container-mesero')"
					)
					label(class="btn-outline-primary px-2 py-1 border border-primary rounded" "for"="rdomesero"){"Vendedor"}
				}
				div
				{
					input(
						class="btn-check"
						type="radio"
						name="opt"
						id="rdocajero"
						autocomplete="off"
						onclick="views.ShowFormulario('container-cajero')"
					)
					label(class="btn-outline-primary px-2 py-1 border border-primary rounded" "for"="rdocajero"){"Cajero"}
				}
            }

            div(
                id="container-cajero"
                class="dk-login__section"
                style="display:none"
            )
            {
                div(class="dk-login__field")
                {
                    label("for"="selectcaja" class="fw-bold dk-login__label"){"Caja:"}
                    select(
                        class="form-select dk-login__control"
                        id="selectcaja"
                        name="caja"
                        disabled=""
                    ){$""}
                }

                div(class="dk-login__field")
                {
                    label("for"="selectcajero" class="fw-bold dk-login__label"){"Cajero:"}
                    select(
                        class="form-select dk-login__control"
                        id="selectcajero"
                        name="cajero"
                        disabled=""
                    ){$""}
                }

                div(class="dk-login__field")
                {
                    label("for"="pwd" class="dk-login__label"){"Contraseña:"}
                    input(
                        class="form-control dk-login__control"
                        type="password"
                        name="pwd"
                        id="pwd-cajero"
                        placeholder=""
                        autocomplete="current-password"
                    )
                }
            }

            div(
                id="container-mesero"
                class="dk-login__section"
            )
            {
                div(class="dk-login__field")
                {
                    label("for"="selectwaiter" class="fw-bold dk-login__label"){"Vendedor:"}
                    select(
                        class="form-select dk-login__control"
                        id="selectwaiter"
                        name="waiter"
                        disabled=""
                    ){$""}
                }

                div(class="dk-login__field")
                {
                    label("for"="pwdlogin" class="dk-login__label"){"Contraseña:"}
                    input(
                        class="form-control dk-login__control"
                        type="password"
                        id="pwdlogin"
                        placeholder=""
                        name="pwd"
                        autocomplete="current-password"
                    )
                }
            }

            div(class="dk-login__actions")
            {
                button(
                    class="btn-primary dk-login__button"
                    id="btnlogin"
                    type="button"
                    onclick="controller.login(this)"
                ){"Aceptar"}
            }
        }
    }

    script
    {
        $'
        $(document).ready(function()
        {
            controller.getUbicaciones();
        });
        '
    }
}