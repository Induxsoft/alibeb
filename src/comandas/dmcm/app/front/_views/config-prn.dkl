#include "dkli.dkh"
#!
module ""
{

    url_redir=preserveQSParams("/?view=vw_principal")
    #$
    div(class="container1")
    {
        div(class="card")
        {
            div(class="card-header d-flex")
            {
                h5(class="text-center w-100"){"Configuración de impresión"}
            }
            div(class="card-body")
            {
                form(id="form-config-prn")
                {
                    div(class="row")
                    {
                        div(class="col-md-6")
                        {
                            label(style="width: -webkit-fill-available;" class="fw-bold" "for"=""){"Id. dispositivo"}
                            input(class="input-admin" type="" name="id_device" id="id_device" maxlength="32")

                            div(class="form-check d-flex align-items-center gap-2")
                            {
                                input(class="form-check-input" type="radio" name="rdo_prn" id="rdo_server")
                                label(class="form-check-label" "for"="rdo_server"){"Impresión a través del servidor"}
                            }
                            
                            div(class="ms-4 w-75" "for"="")
                            {
                                "Impresora:"

                                select(class="input-login" name="select_server" id="select_server" disabled="true"){$""}
                            }

                            div(class="form-check d-flex align-items-center gap-2")
                            {
                                input(class="form-check-input" type="radio" name="rdo_prn" id="rdo_device")
                                label(class="form-check-label" "for"="rdo_device"){"Impresión directa del dispositivo"}
                            }

                            div(class="ms-4 w-75" "for"="")
                            {
                                "Controlador"
                                select(class="input-login" name="select_device" id="select_device" disabled="true"){$""}
                            }
                            
                        }
                        div(class="col-md-6")
                        {
                            div(class="row" id="row_data_prn")
                            {
                                div(class="col-md-6")
                                {
                                    label(class="" "for"=""){"Driver:"}
                                    input(class="input-login" type="" name="driver"id="driver" disabled="true")
                                }
                                div(class="col-md-6")
                                {
                                    label(class="" "for"=""){"Type:"}
                                    input(class="input-login" type="" name="type" id="type" disabled="true")
                                }
                                div(class="col-md-6")
                                {
                                    label(class="" "for"=""){"Address:"}
                                    input(class="input-login" type="" name="address" id="address" disabled="true")
                                }
                                div(class="col-md-6")
                                {
                                    label(class="" "for"=""){"Port:"}
                                    input(class="input-login" type="" name="port" id="port" disabled="true")
                                }
                                
                                div(class="col-md-6")
                                {
                                    label(class="" "for"=""){"Timeout:"}
                                    input(class="input-login" type="number" name="timeout" id="timeout" disabled="true")
                                }
                                div(class="col-md-6")
                                {
                                    label(class="" "for"=""){"Dpi:"}
                                    input(class="input-login" type="number" name="dpi" id="dpi" disabled="true")
                                }
                                div(class="col-md-6")
                                {
                                    label(class="" "for"=""){"PrintWidth:"}
                                    input(class="input-login" type="number" name="printWidth" id="printWidth" disabled="true")
                                }
                                div(class="col-md-6")
                                {
                                    label(class="" "for"=""){"CharsPerLine:"}
                                    input(class="input-login" type="number" name="charsPerLine" id="charsPerLine" disabled="true")
                                }
                            }
                        }
                    }
                }
            }
            div(class="card-footer")
            {
                div(class="d-flex gap-2")
                {
                    button(class="btn-admin bg-danger text-white" type="button" id="btn_del_config" "data-url"="#<url_redir>" onclick="model_prn.view.ClearData()" title="Eliminar configuración"){$"Eliminar configuración"}
                    span(class="flex-grow-1"){""}
                    button(class="btn-admin" type="button" id="btn_save_config" "data-url"="#<url_redir>"){$"Aceptar"}
                }
            }

            script(type="text/javascript")
            {$'
                document.addEventListener("DOMContentLoaded",()=>
                {
                    model_prn.view.init();
                });
                
            '}
        }

        div(class="card")
        {
            div(class="card-header d-flex")
            {
                h5(class="text-center w-100"){"Otras configuraciones"}
            }
            div(class="card-body")
            {
                form(action="" method="POST" id="form-other-cfg" "name-storage"="cfg-others")
                {
                    div(class="row")
                    {
                        div(class="col-md-4")
                        {
                            div(class="form-check d-flex align-items-center gap-2")
                            {
                                input(class="form-check-input" type="checkbox" name="set_focus_barra" id="check-focus-barra")
                                label(class="form-check-label" "for"="check-focus-barra"){"Mantener foco en barra de captura"}
                            }
                        }
                    }
                }
            }
            div(class="card-footer")
            {
                div(class="d-flex gap-2")
                {
                    span(class="flex-grow-1"){""}
                    button(class="btn-admin" type="button" onclick="model_prn.view.SaveDataForm('form-other-cfg','#<url_redir>')"){$"Aceptar"}
                }
            }
        }

        style
        {
            $'
            input[type="checkbox"]
            {
                border-radius: 0 !important;
                width: 1.5rem;
                height: 1.5rem;
            }
            input[type="radio"]
            {
                width: 1.5rem;
                height: 1.5rem;
            }
            '
        }

        script(type="text/javascript")
        {$'
            document.addEventListener("DOMContentLoaded",()=>
            {
                document.querySelectorAll("form[name-storage]").forEach(form => {
                    model_prn.view.SetDataConfigFromForm(form.id);
                });
            });
            
        '}
    }
}