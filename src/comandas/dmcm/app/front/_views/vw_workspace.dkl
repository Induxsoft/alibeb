#include "dkli.dkh"

#!
module "login"
{
	#$
	// Antes esta vista envolvia su contenido en otro .container-all y volvia a
	// incluir navbar.dkl, quedando DOS navbars anidados dentro del shell de
	// index.dkl. No se notaba porque ambos eran position:fixed y se
	// superponian; con el navbar ya en flujo normal se verian dos barras.
	div(class="container-workspace")
	{
		div(class="container-login #<@token>")
		{
			div(class="module-all")
			{
				div(class="module-login")
				{
					label("for"="idws"){"Id workspace:"}
					input(class="input-login" type="" id="idws" placeholder="")

					div(class="module-click")
					{
						button(class="btn-admin" id="btnws" onclick="controller.workspace()"){"Aceptar"}
					}
					
				}
			}
						
		}
	}
}