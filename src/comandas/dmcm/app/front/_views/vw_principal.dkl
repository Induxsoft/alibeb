#include "dkli.dkh"
#!
module "terminal de mesero"
{
	ref getData=@@(@http_context,"&request/get")
	
	@only_account_predef = parse.bool(dbr.vars.get(@database,"comandas.only_account_predef"))
	@join_accounts = parse.bool(dbr.vars.get(@database,"comandas.join_accounts"))
	@min_to_join = parse.num(dbr.vars.get(@database,"comandas.min_to_join"))
	@max_to_join = parse.num(dbr.vars.get(@database,"comandas.max_to_join"))
	@join_free_account = parse.bool(dbr.vars.get(@database,"comandas.join_free_account"))

	if @min_to_join < 2 { @min_to_join = 2 }
	if @max_to_join < 2 { @max_to_join = 2 }

	#$
	div(class="container-main d-lg-grid d-flex" id="container-main")
	{
		div(class="column")
		{
			div(class="content")
			{
				div(class="card cmn-header")
				{
					div(class="card-header d-sm-flex d-block " style="align-items: center;" id="card_header_actions")
					{
						button(class="btn img mr-2 #<ifstr(@join_accounts,'','d-none')>" type="button" onclick="controller.joinAccounts(#<@min_to_join>, #<@max_to_join>, #<@join_free_account>)")
						{
							$'
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-link-45deg" viewBox="0 0 16 16">
								<path d="M4.715 6.542 3.343 7.914a3 3 0 1 0 4.243 4.243l1.828-1.829A3 3 0 0 0 8.586 5.5L8 6.086a1 1 0 0 0-.154.199 2 2 0 0 1 .861 3.337L6.88 11.45a2 2 0 1 1-2.83-2.83l.793-.792a4 4 0 0 1-.128-1.287z"/>
								<path d="M6.586 4.672A3 3 0 0 0 7.414 9.5l.775-.776a2 2 0 0 1-.896-3.346L9.12 3.55a2 2 0 1 1 2.83 2.83l-.793.792c.112.42.155.855.128 1.287l1.372-1.372a3 3 0 1 0-4.243-4.243z"/>
							</svg>
							'
							span(class="vb m-width ms-1"){"Unir cuentas"}
						}

						buttom(class="btn img mr-2 #<@@(@config_default,'$show_cuentas')>" onclick="controller.openAccount(#<@only_account_predef>);")
						{
							svg(xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-plus-lg" viewBox="0 0 16 16"){path("fill-rule"="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2Z")}
							span(class="vb m-width ms-1"){"Abrir cuenta"}
						}
						button(class="btn btn-admin img mr-2 #<@@(@config_default,'$show_foodfast')>" onclick="controller.fastFoot();")
						{
							// img(src="/$/img/comida-rapida.png" width="20" height="20" style="display: inline !important;")
							$'<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 512 512" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round" stroke-linejoin="round">
								<!-- Pan -->
								<rect x="80" y="300" width="320" height="120" rx="40"/>
								
								<!-- Carne -->
								<path d="M100 260 Q160 200 220 260 Q280 200 340 260 L340 300 L100 300 Z"/>

								<!-- Pan superior -->
								<rect x="80" y="180" width="320" height="120" rx="60"/>

								<!-- Semillas -->
								<circle cx="140" cy="220" r="6"/>
								<circle cx="180" cy="240" r="6"/>
								<circle cx="220" cy="220" r="6"/>

								<!-- Cronómetro -->
								<circle cx="320" cy="180" r="120"/>
								<circle cx="320" cy="180" r="90"/>

								<!-- Botón arriba -->
								<rect x="290" y="40" width="60" height="40" rx="10"/>

								<!-- Patas -->
								<line x1="240" y1="80" x2="220" y2="60"/>
								<line x1="400" y1="80" x2="420" y2="60"/>

								<!-- Aguja -->
								<line x1="320" y1="180" x2="320" y2="110"/>
								<line x1="320" y1="180" x2="380" y2="180"/>

								<!-- Marca curva -->
								<path d="M260 240 A80 80 0 0 0 380 260"/>
								</svg>'
							span(class="vb m-width ms-1"){"Venta rápida"}
						}
						button(class="btn img mr-2 #<@@(@config_default,'$show_foofhome')>" onclick="controller.showDialogDS();")
						{
							// img(src="/$/img/servicio-a-domicilio.png" width="20" height="20" style="display: inline !important;")
							$'<svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round">

										<!-- Casa -->
										<path d="M150 110 L200 70 L250 110"/>
										<rect x="170" y="110" width="60" height="60" rx="8"/>

										<!-- Puerta -->
										<rect x="195" y="135" width="15" height="35"/>

										<!-- Moto -->
										<!-- Ruedas -->
										<circle cx="60" cy="180" r="25"/>
										<circle cx="130" cy="180" r="25"/>

										<!-- Base -->
										<line x1="35" y1="180" x2="105" y2="180"/>
										<line x1="85" y1="140" x2="105" y2="180"/>

										<!-- Asiento -->
										<rect x="70" y="120" width="50" height="25" rx="6"/>

										<!-- Caja delivery -->
										<rect x="40" y="110" width="35" height="30" rx="5"/>

										<!-- Manubrio -->
										<line x1="120" y1="130" x2="140" y2="115"/>
										<line x1="140" y1="115" x2="155" y2="115"/>

										</svg>'
							// svg(xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-arrow-clockwise" viewBox="0 0 16 16"){
							// 	path("fill-rule"="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z")
							// 	path(d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z")
							// }
							span(class="vb m-width ms-1"){"Servicio a domicilio"}
						}
						
						a(href="#<preserveQSParams('./?view=corte-caja')>" class="btn img mr-2 only-cashier d-none")
						{
							$'<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-clock" viewBox="0 0 16 16">
							<path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71z"/>
							<path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0"/>
							</svg>'
							span(class="vb m-width"){"Corte caja"}
						}
						button(class="btn img mr-2 only-cashier d-none" onclick="controller.Movimiento();" )
						{
							$'<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-cash" viewBox="0 0 16 16">
							<path d="M8 10a2 2 0 1 0 0-4 2 2 0 0 0 0 4"/>
							<path d="M0 4a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1zm3 0a2 2 0 0 1-2 2v4a2 2 0 0 1 2 2h10a2 2 0 0 1 2-2V6a2 2 0 0 1-2-2z"/>
							</svg>'
							span(class="vb m-width"){"Ingreso"}
						}
						button(class="btn img mr-2 only-cashier d-none" onclick="controller.Movimiento(2);" )
						{
							$'<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-cash-stack" viewBox="0 0 16 16">
							<path d="M1 3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1zm7 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4"/>
							<path d="M0 5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1zm3 0a2 2 0 0 1-2 2v4a2 2 0 0 1 2 2h10a2 2 0 0 1 2-2V7a2 2 0 0 1-2-2z"/>
							</svg>'
							span(class="vb m-width"){"Egreso"}
						}
						button(class="btn img mr-2 only-cashier d-none" onclick="controller.Arqueo();")
						{
							$'<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-journal-text" viewBox="0 0 16 16">
							<path d="M5 10.5a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5m0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5m0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5m0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5"/>
							<path d="M3 0h10a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2v-1h1v1a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v1H1V2a2 2 0 0 1 2-2"/>
							<path d="M1 5v-.5a.5.5 0 0 1 1 0V5h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1zm0 3v-.5a.5.5 0 0 1 1 0V8h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1zm0 3v-.5a.5.5 0 0 1 1 0v.5h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1z"/>
							</svg>'
							span(class="vb m-width"){"Arqueo"}
						}
						button(class="btn img mr-2 " onclick="controller.resfresh_tables();")
						{
							svg(xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-arrow-clockwise" viewBox="0 0 16 16"){
								path("fill-rule"="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z")
								path(d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z")
							}
							span(class="vb m-width"){"Actualizar"}
						}
						span(class="flex-grow-1"){""}


						div
						{
							#$
							div(class="input-group w-auto #<@@(@config_default,'$show_filter')>")
							{
								select(class="form-select form-select-sm" name="cuentas" id="cuentas" onchange="controller.resfresh_tables()")
								{
									option(value="*"){"Todas las cuentas"}
									#! if @@(@config_default,'$show_cuentas') == ""{#$ option(value="sm"){"Servicio a la cuenta"}}
									#! if @@(@config_default,'$show_foodfast') == ""{#$ option(value="ff"){"Venta rápida"}}
									#! if @@(@config_default,'$show_foofhome') == ""
									{
										#$
										option(value="ds"){"A domicilio — todas"}
										option(value="ds-enviar"){"A domicilio — por enviar"}
										option(value="ds-reparto"){"A domicilio — en reparto"}
										option(value="ds-entregada"){"A domicilio — entregadas"}
									}
									#$
								}
								button(class="input-group-text p-2 border" onclick="controller.resfresh_tables()")
								{
									$'<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-funnel" viewBox="0 0 16 16">
									<path d="M1.5 1.5A.5.5 0 0 1 2 1h12a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-.128.334L10 8.692V13.5a.5.5 0 0 1-.342.474l-3 1A.5.5 0 0 1 6 14.5V8.692L1.628 3.834A.5.5 0 0 1 1.5 3.5zm1 .5v1.308l4.372 4.858A.5.5 0 0 1 7 8.5v5.306l2-.666V8.5a.5.5 0 0 1 .128-.334L13.5 3.308V2z"/>
									</svg>'
								}
							}
							button(class="btn " id="btn-settings" title="Configuración")
							{
								$'<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-gear" viewBox="0 0 16 16">
									<path d="M8 4.754a3.246 3.246 0 1 0 0 6.492 3.246 3.246 0 0 0 0-6.492M5.754 8a2.246 2.246 0 1 1 4.492 0 2.246 2.246 0 0 1-4.492 0"/>
									<path d="M9.796 1.343c-.527-1.79-3.065-1.79-3.592 0l-.094.319a.873.873 0 0 1-1.255.52l-.292-.16c-1.64-.892-3.433.902-2.54 2.541l.159.292a.873.873 0 0 1-.52 1.255l-.319.094c-1.79.527-1.79 3.065 0 3.592l.319.094a.873.873 0 0 1 .52 1.255l-.16.292c-.892 1.64.901 3.434 2.541 2.54l.292-.159a.873.873 0 0 1 1.255.52l.094.319c.527 1.79 3.065 1.79 3.592 0l.094-.319a.873.873 0 0 1 1.255-.52l.292.16c1.64.893 3.434-.902 2.54-2.541l-.159-.292a.873.873 0 0 1 .52-1.255l.319-.094c1.79-.527 1.79-3.065 0-3.592l-.319-.094a.873.873 0 0 1-.52-1.255l.16-.292c.893-1.64-.902-3.433-2.541-2.54l-.292.159a.873.873 0 0 1-1.255-.52zm-2.633.283c.246-.835 1.428-.835 1.674 0l.094.319a1.873 1.873 0 0 0 2.693 1.115l.291-.16c.764-.415 1.6.42 1.184 1.185l-.159.292a1.873 1.873 0 0 0 1.116 2.692l.318.094c.835.246.835 1.428 0 1.674l-.319.094a1.873 1.873 0 0 0-1.115 2.693l.16.291c.415.764-.42 1.6-1.185 1.184l-.291-.159a1.873 1.873 0 0 0-2.693 1.116l-.094.318c-.246.835-1.428.835-1.674 0l-.094-.319a1.873 1.873 0 0 0-2.692-1.115l-.292.16c-.764.415-1.6-.42-1.184-1.185l.159-.291A1.873 1.873 0 0 0 1.945 8.93l-.319-.094c-.835-.246-.835-1.428 0-1.674l.319-.094A1.873 1.873 0 0 0 3.06 4.377l-.16-.292c-.415-.764.42-1.6 1.185-1.184l.292.159a1.873 1.873 0 0 0 2.692-1.115z"/>
									</svg>'
								span(class="vb m-width"){""}
							}

							button(class="btn ms-2 dropdown-toggle btn-options" id="btn-settings" title="Herramientas" "data-bs-toggle"="dropdown")
							{
								$'<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-tools" viewBox="0 0 16 16">
								<path d="M1 0 0 1l2.2 3.081a1 1 0 0 0 .815.419h.07a1 1 0 0 1 .708.293l2.675 2.675-2.617 2.654A3.003 3.003 0 0 0 0 13a3 3 0 1 0 5.878-.851l2.654-2.617.968.968-.305.914a1 1 0 0 0 .242 1.023l3.27 3.27a.997.997 0 0 0 1.414 0l1.586-1.586a.997.997 0 0 0 0-1.414l-3.27-3.27a1 1 0 0 0-1.023-.242L10.5 9.5l-.96-.96 2.68-2.643A3.005 3.005 0 0 0 16 3q0-.405-.102-.777l-2.14 2.141L12 4l-.364-1.757L13.777.102a3 3 0 0 0-3.675 3.68L7.462 6.46 4.793 3.793a1 1 0 0 1-.293-.707v-.071a1 1 0 0 0-.419-.814zm9.646 10.646a.5.5 0 0 1 .708 0l2.914 2.915a.5.5 0 0 1-.707.707l-2.915-2.914a.5.5 0 0 1 0-.708M3 11l.471.242.529.026.287.445.445.287.026.529L5 13l-.242.471-.026.529-.445.287-.287.445-.529.026L3 15l-.471-.242L2 14.732l-.287-.445L1.268 14l-.026-.529L1 13l.242-.471.026-.529.445-.287.287-.445.529-.026z"/>
								</svg>'
								span(class="vb m-width"){""}
							}

							//dropdawn menu
							ul(class="dropdown-menu p-2")
							{
								li{a(href="#<preserveQSParams('./?view=printer_tickets')>"){"Reimpresión de ticket"}}
								li{a(href="#" onclick="controller.PrintCorte()"){"Imprimir el último corte de caja"}}
								li{a(href="#<preserveQSParams('./?view=cancel-tickets&action=cancel-ticket')>"){"Cancelar ticket"}}
								li{a(href="#" onclick="toggleDebug()"){$"Activar / desactivar debug"}}
							}
						}
					}
				}
			}

			div(class="card card-mesas")
			{
				div(class="container-tables")
				{
					div(class="body-mesas"){$""}
				}
			}	
		}
		
		div(class="card card-info placeholder-glow d-none d-lg-block" id="card-info" style="padding:0px;pointer-events:none;opacity:.4;")
		{
			div(class="body-info h-100" id="container-info-orders")
			{
				#!
				#include "./vw_detail_infocuenta.dkl"
				#$
			}
		}
	}
	
	script(src="/_/dmcm/app/front/_js/select_account.js"){""}
	script(src="/_/dmcm/app/front/_js/join_accounts.js"){""}
	script
	{$'
		$(document).ready(function()
		{
			controller.only_account_predef = #<@only_account_predef>;
			if("#<idt>"!="")
			{
				views.table_selected="#<idt>";
			}
		});
	'}
}