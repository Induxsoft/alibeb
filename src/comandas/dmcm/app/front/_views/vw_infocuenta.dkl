#include "dkli.dkh"
#!
module "infocuenta"
{
	id_table=@@(@http_context,"request/get/id_table")
	idt=@@(@http_context,"request/get/idt")
	if idt!="" && id_table==""{id_table=idt}

	@split_accounts = parse.bool(dbr.vars.get(@database,"comandas.split_accounts"))

	#$
	div(class="container1")
	{
		// card-info--page: aqui el panel ES la pagina completa, asi que debe
		// verse tambien por debajo del punto de corte del panel lateral.
		div(class="card card-info card-info--page" id="card-info" style="padding:0px;")
		{
			div(class="body-info")
			{
				#!
				#include "./vw_detail_infocuenta.dkl"
				#$
			}
		}
	}
	#!
	if id_table!=""
	{
		#$
		script(src="/_/dmcm/app/front/_js/pick_account.js"){""}
		script(src="/_/dmcm/app/front/_js/split_account.js"){""}
		script
		{$'
			document.addEventListener("DOMContentLoaded",function()
			{
				controller.split_accounts = #<@split_accounts>;

				controller.get_table("#<id_table>");
				event.hide_loading();
			});
		'}
		#!
	}
}