#include "dkli.dkh"
#!
module ""
{
    #include "comandas/list_query.dk"
    #include "comandas/kds/app/svc/lib.dk"
    @model_js=path.concat(@path_absolute_pds,"_js/model.js")
	@views_js=path.concat(@path_absolute_pds,"_js/view.js")
	@driver_js=path.concat(@path_absolute_pds,"_js/controller.js")
    
    if trim(@@(@GET,"$cuenta")) == ""{@GET<"cuenta">:-9999}
    
    @GET<"detalle">:@true
    ref db=getDatabase("")
    ref ordenes=kdf.get.ordenes(db,@GET)

    #$
    div(class="container-fluid")
    {
        div(class="content-commands placeholder-glow" id="content-commands")
        {
            div(class="c-command placeholder")
            {
                $""
            }
            div(class="c-command placeholder")
            {
                $""
            }
        }

        script(type="text/javascript")
        {$'
            document.addEventListener("DOMContentLoaded",()=>
            {
                views.print_commands(#<to.json(ordenes)>,false,"content-commands",false,true);
            })
            
        '}

        #$
	style{
		$'
			.kdf-all
			{
				display: flex; 
			  flex-direction: column;
			  height: 100%;
			  background-color: #F5F5F5 !important;
			}
			.kdf-container
			{
				width: 100%;
			    margin-top: 4.63rem;
			    padding-right: var(--bs-gutter-x,.75rem);
			    padding-left: var(--bs-gutter-x,.75rem);
			    margin-right: auto;
			    margin-left: auto;
			    height: 90%;
			    overflow:auto;
			}
			.content-commands
			{
				width: 100%;
			    display: grid;
			    grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
			    grid-auto-rows: 30rem;
			    gap: 0.5rem;
			    padding: 10px;
			    height: 100%;
			}
			.c-command
			{
				    width: 100%;
				    max-height: 100%;
				    display: flex;
				    text-decoration: none;
				    color: black;
				    // align-items: center;
				    flex-flow: column;
				    cursor: pointer;
				    // padding: 8px;
				    box-shadow: 1px 2px 5px 0 #ddd;
				    position: relative;
				    overflow: hidden;
				    transition-duration: .3s;
			    background-color: #FFF !important;
				padding:10px;
			}
			.cmmd-header
			{
				padding:3px;
				height:10%;
				// background:red;
			}
			.cmmd-body
			{
				padding-top:3px;
				height:80%;
				// background:green;
				overflow: auto;
			}
			.cmmd-footer
			{
				height:30%;
				// background:yellow;
				padding-top:3px;
			}
			.cmmd-details
			{
				padding-left:5px;
				width: 100%;
			}
			.datails-adcs
			{
				padding-left:20px;
				color:#787878;
				background: antiquewhite;
			}
			.details
			{
				width:100%;
			}

			.button{
				width:80px;
				heigth:60px;
				margin-left:75%;
				background:white;
				color:black;
				cursor: pointer;
				align-items: center;
    			display: flex;
				transition:.8s;
				font-size: 16px;
				border-color: antiquewhite;
				
				
			}
			.button:hover{
				background:#540883;
				color:white;
			}
			.order-notes
			{
				padding-left:20px;
				color:#787878;
				background: aliceblue;
			}
			.btn-icon
			{
				display: flex; 
			  background-color: #F5F5F5 !important;
			  margin-top:5px;
			  
			}
			.f-grow-1{flex-grow: 1 !important;}
			.btn-update 
			{
				width:77px;
				heigth:60px;
				background:#540883;
				color:white;
				cursor: pointer;
				font-size:14px;
				outline:none;
				border:none;

			
			}
			.icon{
				margin-right:5px;
				color:black;
				cursor:pointer;
			}
			.icon:hover
			{
				// background:var(--purple);
				color:green;
			}
			.order-time
			{
				color:green;
			}
			.mr-10{margin-right: 10px !important;}
			.btn-kds {
			    display: inline-block;
			    font-weight: 500 !important;
			    color: #000 !important;
			    text-align: center;
			    text-decoration: none;
			    cursor: pointer;
			    -webkit-user-select: none;
			    -moz-user-select: none;
			    user-select: none;
			    padding: 4px 8px !important;
			    font-size: 1rem !important;
			    transition-duration: 0.4s;
			    border: none !important;
			    display: flex;
			    align-items: center;
			    justify-content: start;
			    background-color: transparent !important;
			    border:1px solid var(--purple) !important;
			}
			.btn-kds:hover
			{
				background-color: var(--purple) !important;
    			color: white !important;
			}
			.ctn-h
			{
				display: grid;
    			grid-template-columns: 70% 30%;
    			padding-left:3px;
    			padding-right:3px;
    			grid-auto-rows: 3rem;
			}
			.order-hours
			{
				display:flex;
				align-items:center;
			}
		'
	}
    }
}