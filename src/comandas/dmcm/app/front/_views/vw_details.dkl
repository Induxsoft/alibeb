#include "dkli.dkh"
#!
module ""
{
    #include "comandas/list_query.dk"
    #include "comandas/kds/app/svc/lib.dk"
    @model_js=path.concat(@path_absolute_pds,"_js/model.js")
	@views_js=path.concat(@path_absolute_pds,"_js/view.js")
	@driver_js=path.concat(@path_absolute_pds,"_js/controller.js")
    
    if trim(@@(@GET,"$cuenta")) == ""{@GET<"cuenta">:-9999}
    
	@GET<"atendido">:"all"
    ref db=getDatabase("")
	ref cuenta=dbr.rec(db,"SELECT sys_pk,referencia,sys_guid,dmnsmesa from venta where sys_pk=@cuenta",@GET)
    ref ordenes=kdf.get.ordenes(db,@GET)
	ref articulos=pds.get.dventas(db,@GET)
	
    #$
    div(class="container-fluid")
    {
		div(class="d-flex flex-wrap")
		{
			div(class="flex-grow-1")
			{
				h5(class="m-0 p-0"){"Ticket: #<@@(cuenta,'$referencia')>"}
				h5{"Cuenta: #<@@(cuenta,'$dmnsmesa')>"}
			}
			a(class="btn d-flex justify-content-center" type="button" id="" href="" style="width: 5rem;" title="Actualizar")
			{
				$'<svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-arrow-clockwise" viewBox="0 0 16 16">
				<path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2z"/>
				<path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466"/>
				</svg>'
			}
		}
		

		div(class="d-flex")
		{
			hr(class="w-50"){}
			h4(class="fw-bold text-center ps-2 pe-2"){"Órdenes"}
			hr(class="w-50"){}
		}
		
        div(class="content-commands placeholder-glow" id="content-commands")
        {
            div(class="c-command placeholder"){$""}
            div(class="c-command placeholder"){$""}
        }
        script(type="text/javascript")
        {$'
            document.addEventListener("DOMContentLoaded",()=>
            {
                views.print_commands(#<to.json(ordenes)>,false,"content-commands",false,true);
                views.printDventas(#<to.json(articulos)>,"#content-commands",true);
            })
            
        '}

        #$
	style{
		$'
			.kdf-all
			{
				display: flex; 
			  flex-direction: column;
			  height: 100%;
			  background-color: #F5F5F5 !important;
			}
			.kdf-container
			{
				width: 100%;
			    margin-top: 4.63rem;
			    padding-right: var(--bs-gutter-x,.75rem);
			    padding-left: var(--bs-gutter-x,.75rem);
			    margin-right: auto;
			    margin-left: auto;
			    height: 90%;
			    overflow:auto;
			}
			.content-commands
			{
				width: 100%;
			    display: grid;
			    grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
			    grid-auto-rows: 30rem;
			    gap: 0.5rem;
			    padding: 10px;
			    height: 100%;
			}
			.c-command
			{
				    width: 100%;
				    max-height: 100%;
				    display: flex;
				    text-decoration: none;
				    color: black;
				    // align-items: center;
				    flex-flow: column;
				    cursor: pointer;
				    // padding: 8px;
				    box-shadow: 1px 2px 5px 0 #ddd;
				    position: relative;
				    overflow: hidden;
				    transition-duration: .3s;
			    background-color: #FFF !important;
				padding:10px;
			}
			.cmmd-header
			{
				padding:3px;
				height:10%;
				// background:red;
			}
			.cmmd-body
			{
				padding-top:3px;
				height:80%;
				// background:green;
				overflow: auto;
			}
			.cmmd-footer
			{
				height:30%;
				// background:yellow;
				padding-top:3px;
			}
			.cmmd-details
			{
				padding-left:5px;
				width: 100%;
			}
			.datails-adcs
			{
				padding-left:20px;
				color:#787878;
				background: antiquewhite;
			}
			.details
			{
				width:100%;
			}

			.button{
				width:80px;
				heigth:60px;
				margin-left:75%;
				background:white;
				color:black;
				cursor: pointer;
				align-items: center;
    			display: flex;
				transition:.8s;
				font-size: 16px;
				border-color: antiquewhite;
				
				
			}
			.button:hover{
				background:#540883;
				color:white;
			}
			.order-notes
			{
				padding-left:20px;
				color:#787878;
				background: aliceblue;
			}
			.btn-icon
			{
				display: flex; 
			  background-color: #F5F5F5 !important;
			  margin-top:5px;
			  
			}
			.f-grow-1{flex-grow: 1 !important;}
			.btn-update 
			{
				width:77px;
				heigth:60px;
				background:#540883;
				color:white;
				cursor: pointer;
				font-size:14px;
				outline:none;
				border:none;

			
			}
			.icon{
				margin-right:5px;
				color:black;
				cursor:pointer;
			}
			.icon:hover
			{
				// background:var(--purple);
				color:green;
			}
			.order-time
			{
				color:green;
			}
			.mr-10{margin-right: 10px !important;}
			.btn-kds {
			    display: inline-block;
			    font-weight: 500 !important;
			    color: #000 !important;
			    text-align: center;
			    text-decoration: none;
			    cursor: pointer;
			    -webkit-user-select: none;
			    -moz-user-select: none;
			    user-select: none;
			    padding: 4px 8px !important;
			    font-size: 1rem !important;
			    transition-duration: 0.4s;
			    border: none !important;
			    display: flex;
			    align-items: center;
			    justify-content: start;
			    background-color: transparent !important;
			    border:1px solid var(--purple) !important;
			}
			.btn-kds:hover
			{
				background-color: var(--purple) !important;
    			color: white !important;
			}
			.ctn-h
			{
				display: grid;
    			grid-template-columns: 70% 30%;
    			padding-left:3px;
    			padding-right:3px;
    			grid-auto-rows: 3rem;
			}
			.order-hours
			{
				display:flex;
				align-items:center;
			}
		'
	}
    }
}