#$
div(class="info-total" id="info-vnt" style="background-color:#FFF;")
{
    div(class="div-footer" style="height: 100%;")
    {
        div(class="d-flex ")
        {
            div(class="flex-grow-1")
            {
                p(id="name_table" class="p-0 m-0"){"---"}
                // label(class="w-100"){""}
                label(id="lblticket"){"---"} 
            }
            div(class="mt-2 just-mgn-4 d-flex just-cont-end just-itm-center" ){""h3(id="lbltotal" style="color:var(--purple);"){"$ 0.00"} }
        }

        div(class="d-flex justify-content-between")
        {
            button(class="btn btn-link collapsed" type="button" "data-bs-toggle"="collapse" "data-bs-target"="#collapseTotales" "aria-expanded"="false" "aria-controls"="collapseTotales"){$"Totales"}
            div(id="collapseTotales" class="collapse" "aria-labelledby"="headingTotales")
            {
                small(class="d-block text-end" id="lbl_subtotal"){"---"}
                small(class="d-block text-end" id="lbl_descuento"){"---"}
                small(class="d-block text-end" id="lbl_impuestos"){"---"}
            }
        }

        small(id="account_dealer" style="font-size: small;"){"---"}
        small(id="account_client" style="font-size: small;"){"---"}
    }
    
}
div(id="module-nota" class="info-total" style="background-color:#FFF;height:auto;")//
{
    div(class="pb-2" style="padding-left:20px;padding-right:20px")
    {
        button(class="btn" type="button" title="Indicar notas" onclick="controller.show_modal(\'#modal-note-account\');")
        {
            $'<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-journal-text" viewBox="0 0 16 16">
                <path d="M5 10.5a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5m0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5m0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5m0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5"/>
                <path d="M3 0h10a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2v-1h1v1a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v1H1V2a2 2 0 0 1 2-2"/>
                <path d="M1 5v-.5a.5.5 0 0 1 1 0V5h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1zm0 3v-.5a.5.5 0 0 1 1 0V8h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1zm0 3v-.5a.5.5 0 0 1 1 0v.5h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1z"/>
            </svg>'
        }
        button(class="btn ms-2" type="button" title="Cambiar cliente" onclick="controller.show_modal(\'#modal-change-client\');")
        {
            $'<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-person-fill" viewBox="0 0 16 16">
                <path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6"/>
            </svg>'
        }
        button(class="btn ms-2" type="button" title="Número de personas" onclick="controller.changeNumPeople();")
        {
            $'<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-people-fill" viewBox="0 0 16 16">
                <path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6m-5.784 6A2.24 2.24 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.3 6.3 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1zM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5"/>
            </svg>'
        }
        button(class="btn ms-2" id="btn-cancelar" href="#" "data-href"="#<preserveQSParams('./?view=cobrar')>")
        {
            div(class="d-flex align-items-center")
            {
                $'<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="bi bi-file-x" viewBox="0 0 16 16">
                <path d="M6.146 6.146a.5.5 0 0 1 .708 0L8 7.293l1.146-1.147a.5.5 0 1 1 .708.708L8.707 8l1.147 1.146a.5.5 0 0 1-.708.708L8 8.707 6.854 9.854a.5.5 0 0 1-.708-.708L7.293 8 6.146 6.854a.5.5 0 0 1 0-.708"/>
                <path d="M4 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2zm0 1h8a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1"/>
                </svg>'
                span(class="d-none d-md-flex"){"Cancelar"}
            }
        }
        button(class="btn ms-2" id="btn-show-cortesia" href="#" "data-href"="#<preserveQSParams('./?view=cobrar')>" onclick='')
        {
            div(class="d-flex align-items-center")
            {
                $'<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round">

                <!-- Base de la caja -->
                <rect x="40" y="100" width="176" height="100" rx="10"/>

                <!-- Tapa -->
                <rect x="30" y="70" width="196" height="40" rx="10"/>

                <!-- Cinta vertical -->
                <line x1="128" y1="70" x2="128" y2="200"/>

                <!-- Cinta horizontal -->
                <line x1="40" y1="120" x2="216" y2="120"/>

                <!-- Moño -->
                <path d="M128 70 
                        C110 40, 70 50, 90 80
                        C105 100, 128 85, 128 70"/>
                
                <path d="M128 70 
                        C146 40, 186 50, 166 80
                        C151 100, 128 85, 128 70"/>

                </svg>'
                span(class="d-none d-md-flex"){"Cortesía"}
            }
        }
        a(class="btn ms-2 mt-1" id="btn-detalles" href="#" "data-href"="#<preserveQSParams('./?view=detail-acount')>")
        {
            $'<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-ticket-detailed-fill" viewBox="0 0 16 16">
            <path d="M0 4.5A1.5 1.5 0 0 1 1.5 3h13A1.5 1.5 0 0 1 16 4.5V6a.5.5 0 0 1-.5.5 1.5 1.5 0 0 0 0 3 .5.5 0 0 1 .5.5v1.5a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 0 11.5V10a.5.5 0 0 1 .5-.5 1.5 1.5 0 1 0 0-3A.5.5 0 0 1 0 6zm4 1a.5.5 0 0 0 .5.5h7a.5.5 0 0 0 0-1h-7a.5.5 0 0 0-.5.5m0 5a.5.5 0 0 0 .5.5h7a.5.5 0 0 0 0-1h-7a.5.5 0 0 0-.5.5M4 8a1 1 0 0 0 1 1h6a1 1 0 1 0 0-2H5a1 1 0 0 0-1 1"/>
            </svg>'
            "Detalles"
        }
    }
}
div(class="card cmmd-account" id="mol_cmmd_account" style="background-color:#FFF;")
{
    div(class="row-grid")
    {
        button(class="btn " id="new_command")
        {
            svg(xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="bi bi-file-text-fill" viewBox="0 0 16 16"){
                path(d="M12 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2zM5 4h6a.5.5 0 0 1 0 1H5a.5.5 0 0 1 0-1zm-.5 2.5A.5.5 0 0 1 5 6h6a.5.5 0 0 1 0 1H5a.5.5 0 0 1-.5-.5zM5 8h6a.5.5 0 0 1 0 1H5a.5.5 0 0 1 0-1zm0 2h3a.5.5 0 0 1 0 1H5a.5.5 0 0 1 0-1z")
            }
            "Nueva comanda"
        }
        button(class="btn " id="imp_close")
        {
            div(class="div-img"){
                svg(xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-lock-fill" viewBox="0 0 16 16"){path(d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z")}
            }
            "Cerrar"
        }
        button(class="btn disabled" id="re_print")
        {
            div(class="div-img")
            {
                svg(xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="bi bi-printer-fill" viewBox="0 0 16 16"){
                    path(d="M5 1a2 2 0 0 0-2 2v1h10V3a2 2 0 0 0-2-2H5zm6 8H5a1 1 0 0 0-1 1v3a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-3a1 1 0 0 0-1-1z")
                    path(d="M0 7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2h-1v-2a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v2H2a2 2 0 0 1-2-2V7zm2.5 1a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1z")
                }
            }
            "Reimprimir"
        }
        button(class="btn " id="btn-cobrar" href="#" "data-href"="#<preserveQSParams('./?view=cobrar')>")
        {
            div(class="div-img")
            {
                $'<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="bi bi-currency-dollar" viewBox="0 0 16 16">
                <path d="M4 10.781c.148 1.667 1.513 2.85 3.591 3.003V15h1.043v-1.216c2.27-.179 3.678-1.438 3.678-3.3 0-1.59-.947-2.51-2.956-3.028l-.722-.187V3.467c1.122.11 1.879.714 2.07 1.616h1.47c-.166-1.6-1.54-2.748-3.54-2.875V1H7.591v1.233c-1.939.23-3.27 1.472-3.27 3.156 0 1.454.966 2.483 2.661 2.917l.61.162v4.031c-1.149-.17-1.94-.8-2.131-1.718zm3.391-3.836c-1.043-.263-1.6-.825-1.6-1.616 0-.944.704-1.641 1.8-1.828v3.495l-.2-.05zm1.591 1.872c1.287.323 1.852.859 1.852 1.769 0 1.097-.826 1.828-2.2 1.939V8.73z"/>
                </svg>'
            }
            "Cobrar"
        }

        //ds
        button(class="btn #<@@(@config_default,'$show_foofhome')>" id="btn-enviar" href="#" "data-href"="#<preserveQSParams('./?view=cobrar')>")
        {
            div(class="div-img")
            {
                $'<svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round">

                <!-- Ruedas -->
                    <circle cx="70" cy="180" r="25"/>
                    <circle cx="170" cy="180" r="25"/>

                    <!-- Base moto -->
                    <line x1="45" y1="180" x2="145" y2="180"/>
                    <line x1="100" y1="140" x2="145" y2="180"/>

                    <!-- Caja de comida -->
                    <rect x="50" y="100" width="70" height="50" rx="8"/>

                    <!-- Vapor (comida caliente) -->
                    <path d="M70 90 C70 80, 80 80, 80 70"/>
                    <path d="M90 90 C90 80, 100 80, 100 70"/>

                    <!-- Manubrio -->
                    <line x1="145" y1="140" x2="165" y2="120"/>
                    <line x1="165" y1="120" x2="185" y2="120"/>

                    <!-- Flecha (envío) -->
                    <line x1="190" y1="80" x2="230" y2="80"/>
                    <polyline points="215,65 230,80 215,95"/>

                    </svg>'
            }
            "Enviar"
        }
        button(class="btn #<@@(@config_default,'$show_foofhome')>" id="btn-entregada" href="#" "data-href"="#<preserveQSParams('./?view=cobrar')>")
        {
            div(class="div-img")
            {
                $'<svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round">

                <!-- Caja -->
                <rect x="50" y="90" width="100" height="80" rx="10"/>
                <line x1="50" y1="120" x2="150" y2="120"/>
                <line x1="100" y1="90" x2="100" y2="170"/>

                <!-- Check (entregado) -->
                <circle cx="180" cy="150" r="30"/>
                <path d="M165 150 L178 163 L200 140"/>

                </svg>'
            }
            "Entregada"
        }
        button(class="btn #<@@(@config_default,'$show_foofhome')>" id="btn-change-dealer" href="#" "data-href"="#<preserveQSParams('./?view=cobrar')>")
        {
            div(class="div-img")
            {
                $'<svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round">

                <!-- Repartidor 1 (izquierda) -->
                <circle cx="70" cy="90" r="15"/>
                <rect x="50" y="110" width="40" height="50" rx="8"/>

                <!-- Repartidor 2 (derecha) -->
                <circle cx="186" cy="90" r="15"/>
                <rect x="166" y="110" width="40" height="50" rx="8"/>

                <!-- Flecha superior (izq → der) -->
                <line x1="90" y1="70" x2="166" y2="70"/>
                <polyline points="150,55 166,70 150,85"/>

                <!-- Flecha inferior (der → izq) -->
                <line x1="166" y1="190" x2="90" y2="190"/>
                <polyline points="106,175 90,190 106,205"/>

                </svg>'
            }
            "Cambiar repartidor"
        }
        button(class="btn #<@@(@config_default,'$show_foofhome')>" id="btn-enviada" href="#" "data-href"="#<preserveQSParams('./?view=cobrar')>")
        {
            div(class="div-img")
            {
                $'<svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round">

                <!-- Caja -->
                <rect x="40" y="80" width="90" height="90" rx="10"/>
                <line x1="40" y1="120" x2="130" y2="120"/>
                <line x1="85" y1="80" x2="85" y2="170"/>

                <!-- Flecha (envío) -->
                <line x1="140" y1="120" x2="210" y2="120"/>
                <polyline points="190,100 210,120 190,140"/>

                <!-- Líneas de movimiento -->
                <line x1="20" y1="100" x2="40" y2="100"/>
                <line x1="10" y1="120" x2="40" y2="120"/>
                <line x1="20" y1="140" x2="40" y2="140"/>

                </svg>'
            }
            "Enviada"
        }
    }
}
