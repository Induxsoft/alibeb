#include "dkli.dkh"
#!
module "nueva commanda"
{
	ref vars = getVarsConfig()
	
	decimal_money = @@(vars,"#decimal_money")
	decimal_visible_money = @@(vars,"#decimal_visible_money")
	decimal_volumen = @@(vars,"#decimal_volumen")
	decimal_visible_volumen = @@(vars,"#decimal_visible_volmen")
	fractions_group_rule = parse.num(GetVars("comandas.fractions_group_rule"))
	fractions_group = parse.num(GetVars("comandas.fractions_group"))

	line = @@(@http_context,"request/get/line")
	sku = @@(@http_context,"request/get/sku")
	
	#$
	div(class="container-command" id="")
	{
		$""
		input(type="checkbox" class="checkbox" id="check" name="")
		label(class="hidden-panel menu hidde_control" "for"="check")
		{
			$""
			span(class="counter"){
				$""
				span(id="count"){$""}
				svg(xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-caret-right-fill" viewBox="0 0 16 16")
				{
					path(d="m12.14 8.753-5.482 4.796c-.646.566-1.658.106-1.658-.753V3.204a1 1 0 0 1 1.659-.753l5.48 4.796a1 1 0 0 1 0 1.506z"){""}
				}
			}	
		}
		// div(class="name_table")
		// {
		// 	h3{"-#<namet>  "}
		// 	h3{"-#<ticket>"}
		// 	h3(id="totalcurrent" total="#<totalcurrent>"){"$ #<totalcurrent>"}
		// }
		div(class="command")
		{
			div(class="command-product left-panel")
			{
				div(class="list-products")
				{
					$""
					ul(class="list-group list-products-li mb-4"){$""}
					// div(class="total-all"){h2{$"$ 0.00"}}
				}
				div(id="div-total-all" class="total-center")
				{
					span(class="c-none"){""}
					span{$"Total: 0.00"}
					$'
					<div class="c-none d-flex align-items-center fw-bold">
						<small style="">
						0
						<svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-cart4" viewBox="0 0 16 16">
								<path d="M0 2.5A.5.5 0 0 1 .5 2H2a.5.5 0 0 1 .485.379L2.89 4H14.5a.5.5 0 0 1 .485.621l-1.5 6A.5.5 0 0 1 13 11H4a.5.5 0 0 1-.485-.379L1.61 3H.5a.5.5 0 0 1-.5-.5M3.14 5l.5 2H5V5zM6 5v2h2V5zm3 0v2h2V5zm3 0v2h1.36l.5-2zm1.11 3H12v2h.61zM11 8H9v2h2zM8 8H6v2h2zM5 8H3.89l.5 2H5zm0 5a1 1 0 1 0 0 2 1 1 0 0 0 0-2m-2 1a2 2 0 1 1 4 0 2 2 0 0 1-4 0m9-1a1 1 0 1 0 0 2 1 1 0 0 0 0-2m-2 1a2 2 0 1 1 4 0 2 2 0 0 1-4 0"/>
						</svg>
						</small>
					</div>
					'
				}
			}
			
			div(class="command-content")
			{
				div(class="barr-atr"){$""}
				div(class="content-grid"){
					div(class="column-content"){$""}
				}
				div(class="input-group footer-fixed md-width-i l-0-i" style="width: 69%;left:30%;")
				{
					input(class="form-control border no-shadow h-100 m-0" style="background-color:white;" autofocus="true" name="search_prod" value="" id="search_prod" placeholder="Buscar por código, Código de barras y descripción...")
					div(class="input-group-prepend border")
					{
						button(class="input-group-text btn btn-sm" type="button" onclick="controller.SearchProd()"){$"OK"}
					}
				}
			}
		}
	}

	script
	{$'
		$(document).ready(function(){
			var line="#<line>";
			var sku="#<sku>";
			
			controller.decimal_money = #<decimal_money>;
			controller.decimal_volumen = #<decimal_volumen>;
			controller.decimal_visible_money = #<decimal_visible_money>;
			controller.decimal_visible_volumen = #<decimal_visible_volumen>;
			controller.fractions_group_rule = #<fractions_group_rule>;
			controller.fractions_group = #<fractions_group>;

			controller.get_adds_dmns();
			
			if(line!="") {
				controller.foodbev(null,"",line,"",sku);	
			}
			else {
				controller.get_lines();
			}

			const titleNavBar = document.querySelector(".name_waiter");
			titleNavBar.style="width:0;";
			if(titleNavBar) titleNavBar.innerHTML="";	

			const nav_info = document.getElementById("nav_info");
			if(nav_info) nav_info.style.width="100%";		
		});
	'}
}