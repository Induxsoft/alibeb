#include "dkli.dkh"
#set "meta-xml-declaration" "<!DOCTYPE html>\r\n"
#!
module "index"
{
	#include "functions.dkh"
	#include "serialize.dkh"
	#include "dbr.dkh"
	#include "webcl.dkh"
	#include "config.dkl"
	#include "website.dkl"
	#include "uielements.dkl"
	#include "dbr.vars.dkl"

	do getVarsConfig()
	@name_company=@@(@config_default,"$pos_titulo_encabezado")
	@as_company=@@(@config_default,"$pos_subtitulo_encabezado")
	ref @GET=@@(@http_context,"&request/get")
	view=@@(@http_context,"request/get/view")
	
	ref @waiter=from.json(@json)

	@idtable=@@(@http_context,"request/get/idtable")
	@token=@@(@http_context,"request/get/dmtm_token")
	@ws=@@(@http_context,"request/get/dm_scr")
	
	@file_css_principal=path.concat(@path_css,"principal.css")
	@url_redir=trim(@@(@http_context,"$request/get/url_redir"))
	if @url_redir!=""{@url_redir=url_dcode(@url_redir)}

	if @use_bdconfig
	{
	 	@ws=@@(@config,"connection")
	 	if view=="vw_workspace"{view=""}
	}

	if @ws=="" && (@token!="" || @token==""){view="vw_workspace"}
	else if @token==""{view=""}

	@module=""
	file_include=""
	ref @__divisa=@null
	pos_card_procesor=""
	pos_refrescar_mesas= 0
	switch view
	{
		case "vw_principal"
		{
			@module="login"
			ref @__divisa=GetDataDivisaPred()
			ref divisas=GetDivisas()
			ref categorias=GetCategorias("1,2")
			file_include= path.concat(@path_view,"vw_principal.dkl")
			pos_refrescar_mesas=parse.num(GetVars("pos_refrescar_mesas"))
			break
		}
		case "vw_infocuenta"
		{
			@module="vw_principal"
			file_include=path.concat(@path_view,"vw_infocuenta.dkl")
			break
		}
		case "newcommand"
		{
			@command=@true
			@module="vw_infocuenta"
			file_include=path.concat(@path_view,"new_command.dkl")
			break
		}
		case "vw_workspace"
		{
			@token=""
			file_include=path.concat(@path_view,"vw_workspace.dkl")
			break
		}
		case "cobrar"
		{
			ref @__divisa=GetDataDivisaPred()
			pos_card_procesor=trim(GetVars("pos_card_procesor"))
			@module="vw_principal"
			file_include=path.concat(@path_view,"payments.dkl")
			break
		}
		case "corte-caja"
		{
			ref @__divisa=GetDataDivisaPred()
			@module="vw_principal"
			file_include=path.concat(@path_view,"cortecaja.dkl")
			break
		}
		case "config-prn"
		{
			@module="vw_principal"
			file_include=path.concat(@path_view,"config-prn.dkl")
			break
		}
		case "printer_tickets"
		{
			@module="vw_principal"
			file_include=path.concat(@path_view,"vw_tickets.dkl")
			break
		}
		case "fpagos"
		{
			@module="vw_principal"
			file_include=path.concat(@path_view,"vw_fpagos.dkl")
			break
		}
		case "cancel-tickets"
		{
			@GET<"--action">:"cancel-ticket"
			@GET<"--search">:@true
			@GET<"--condition">:"where"
			@module="vw_principal"
			file_include=path.concat(@path_view,"vw_tickets.dkl")
			break
		}
		default
		{
			@token=""
			file_include=path.concat(@path_view,"login.dkl")
		}
			
	}
	
	#$
	div(style="height: 100%;")
	{
		#!
		#include "_views/modals.dkl"	 
		#$
		script(src="#<@js_epos_prn>"){""}
		script(src="#<@js_epos_prn_imin>"){""}
		script(src="#<@js_epos_prn_dantsu>"){""}
		script(src="#<@js_epos_imin_printer>"){""}
		script(src="/_js/bootstrap.bundle.min.js"){""}
		script(src="/_js/induxsoft.controls.js"){""}
		//para test desde android
		script(src="/_js/vconsole.min.js"){""}

		style
		{
			$'
			#<ftext(file.rtext(@file_css_principal))>
			'
		}
		

		div(class="container-all" style="overflow:auto" id="container-all")
		{
			#!
            include path.concat(@path_include,"navbar.dkl")

			include file_include
            #$
		}
		
		script(src="#<GetFilePrn('prn_generic.js')>"){""}
		script(src="#<GetFilePrn('model_prn.js')>"){""}
		script(src="#<GetFilePrn('prn_arqueo.js')>"){""}
		script(src="#<GetFilePrn('prn_egreso.js')>"){""}
		script(src="#<GetFilePrn('prn_ingreso.js')>"){""}
		script(src="#<GetFilePrn('prn_ticket.js')>"){""}
		
		script
		{
			$'
			var ws="#<@ws>";
			var token="#<@token>";
			var view_first="vw_principal";
			var view_second="vw_infocuenta";
			var idtable="#<@idtable>"
			var name_addcs="__adds";

			var module="#<ifstr(@module=="login" && view=="vw_principal",1,0)>";
			#<ftext(file.rtext(@styles_js))>
			#<ftext(file.rtext(@views_js))>
			#<ftext(file.rtext(@model_js))>
			#<ftext(file.rtext(@driver_js))>

			views.icon_mesa=\'#<@icon_mesa>\';
			var $cc="#<@@(@waiter,"cc")>";
			var waiter_key="#<@@(@waiter,"key")>";
			var caption="#<@@(@waiter,"caption")>";
			var zone="#<@@(@waiter,"zone")>";

			const css_class_mesa="mesas";

			controller.decimals=#<@@(@config_default,"#decimal_visible_money")>;
			controller.decimals_backend=#<@@(@config_default,"#decimal_money")>;

			if(token!=""){controller.gettoken("#<@token>");}

			controller.getData=#<to.json(@GET)>;
			controller.url_redir="#<@url_redir>";
			views.interval_refresh_data_tables=#<pos_refrescar_mesas>;
			views.InitInterval();
			views.config_default=#<to.json(@config_default)>;

			'
		}

		#!

	}
	
	
}