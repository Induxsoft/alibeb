#include "dkli.dkh"
#!
program ""
{
    #include "functions.dkh"
	#include "serialize.dkh"
	#include "dbr.dkh"
	#include "esc_pos.dkh"
    ref @http_context=@@(@printer_context,"&http")
    #include "website.dkl"

    @character_width= 45
    TextBetween::text,tleft
    {
        lt=length(text)+length(tleft)
        if lt >= @character_width {return text+tleft}
        l=abs(@character_width - lt)
        return text + padright("",l," ") + tleft
    }

    CreatePrinter::&data,showfecha
    {
        ref ldata=list.create_from_fields(data)
        if @count(ldata) > 0
        {
            do escpos.printline(@divider_full)
            if showfecha {do escpos.printline(date_str(now(),"yyyy-MM-dd HH:mm:ss"))}

            for i = 0; i < @count(ldata)
            {
                lkey=list.str(ldata,i)
                do escpos.printline(@@(data,lkey))
            }
        }
    }
    
    @divider_full=padright("",@character_width,"=")
    spacing_left=TextBetween("","============")

    ref data=@printer_context
	ref cfg=@@(data,"&config")

 	if isnull(cfg){do rise_error(99,"No se encontro una configuración de impresión.")}
	
	ref db=@@(data,"&database")
    ref headers=ifnull(@@(data,"&headers"),record.create())
    ref body=ifnull(@@(data,"&body"),record.create())
    ref saldos=ifnull(@@(data,"&saldos"),record.create())
    ref extras=ifnull(@@(data,"&extras"),record.create())

    do escpos.centeralign()
	do escpos.set.styles(128)
    
    do escpos.printline(@@(data,"$title"))
    do escpos.leftalign()
    do escpos.printline("\n")

    //headers
    do CreatePrinter(headers,@true)
    
    //body
    do CreatePrinter(body,@false)

    //saldos
    
    ref ldata=list.create_from_fields(saldos)
    
    if @count(ldata) > 0
    {
        for i = 0; i < @count(ldata)
        {
            lkey=list.str(ldata,i)
            if lkey!="total" && not(contains(lkey,"str_"))
            {
                do escpos.printline(TextBetween(@@(saldos,"$"+lkey),@@(saldos,"$str_"+lkey)))
            }
        }
        if trim(@@(saldos,"$total"))!=""
        {
            do escpos.printline(spacing_left)
            do escpos.printline(TextBetween("TOTAL:",@@(saldos,"$total")))
        }
    }
    //adicionales
    do CreatePrinter(extras,@false)

    do escpos.fullcut_afterfeed(50)

    //imprimir
 	log=printer.print(cfg)

	do escpos.clear()
}